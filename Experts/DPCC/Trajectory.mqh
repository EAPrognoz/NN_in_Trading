   bool                   m_live_prepared;
   bool                   m_price_forward_only, m_price_quote_basis_resolved, m_price_h1_ohlc_targets;
   bool                   m_raw_identity_bound;
   bool                   m_ready_encoder_restored, m_ready_encoder_live;
   int                    m_ready_encoder_cursor;
   ulong                  m_ready_encoder_generation;
   string                 m_price_server, m_price_symbol;
   ENUM_TIMEFRAMES         m_price_timeframe;
   ENUM_SYMBOL_CHART_MODE m_price_quote_mode;
   CBufferFloat           m_price_native, m_price_target;
   bool                   m_price_joint;
   float                  m_price_lambda, m_price_huber, m_price_rho_tolerance;
   double                 m_price_loss_sum;
   ulong                  m_price_joint_ompb_fingerprint, m_price_latent_decoder_fingerprint;
   ulong                  m_price_joint_updates;
   uint                   m_price_study_phase;
   uint                   m_price_joint_epoch_limit, m_price_joint_epochs_completed;
   ulong                  m_price_joint_update_limit;
   uint                   m_price_adapt_epoch_limit, m_price_adapt_epochs_completed;
   ulong                  m_price_adapt_update_limit;
   string                 m_price_phase_terminal_status;
   SDPCCM05OMPBProfile     m_ompb_profile;
   bool                   m_ompb_configured, m_ompb_reference_complete, m_ompb_epoch_started;
   bool                   m_ompb_source_pending;
   bool                   m_ompb_calibration_completed, m_ompb_stage02_quality_pass;
   //--- Lanes: BYPASS source/target, pre-INFERENCE source/target, post-INFERENCE source/target.
   int                    m_ompb_evaluation_stage, m_ompb_evaluation_cursor;
   double                 m_ompb_evaluation_loss[6], m_ompb_evaluation_valid[6], m_ompb_evaluation_invalid[6];
   ulong                  m_ompb_evaluation_posterior;
   int                    m_ompb_source_evaluation[], m_ompb_target_evaluation[];
   int                    m_ompb_reference[], m_ompb_calibration[], m_ompb_reference_cursor;
   uint                   m_ompb_epoch, m_ompb_reference_capacity, m_ompb_current_capacity;
   ulong                  m_ompb_target_updates, m_ompb_source_updates, m_ompb_frozen_fingerprint;
   ulong                  m_ompb_initial_fingerprint;
   uint                   m_ompb_forecast_steps[3], m_ompb_decoder_updates;
   uint                   m_ompb_epoch_source_updates;
