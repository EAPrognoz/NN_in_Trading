                           DPCCResourceReadString(manifest, root, "role", role, read_reason, "manifest.role") &&
                           DPCCResourceReadString(manifest, root, "task_id", task, read_reason, "manifest.task") &&
                           DPCCResourceReadString(manifest, root, "stage", manifest_stage, read_reason,
