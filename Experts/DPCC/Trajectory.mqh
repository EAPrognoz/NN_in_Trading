                           DPCCResourceReadString(manifest, root, "ompb_state_owner", manifest_owner, read_reason,
                              "manifest.ompb_owner") &&
                           DPCCResourceReadString(manifest, root, "runtime_restore", restore, read_reason,
                              "manifest.runtime_restore") &&
                           DPCCResourceReadBool(manifest, root, "ready", ready, read_reason, "manifest.ready") &&
                           DPCCResourceReadString(manifest, presets, "market_sha256", market_preset_sha, read_reason,
                              "manifest.market_preset") &&
