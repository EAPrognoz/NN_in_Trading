#include "..\\NeuroNet_DNG\\NeuroNet.mqh"
//+------------------------------------------------------------------+
//| Resolve a generated Action6 plan consistently across DPCC EAs    |
//+------------------------------------------------------------------+
bool DPCCResolveAction6Output(CNeuronDPCCOCL *actor, const bool forwarded,
                              float &action[], string &reason)
  {
   ArrayFree(action);
   reason = "";
   if(CheckPointer(actor) == POINTER_INVALID)
     {
      reason = "action6.actor_invalid";
      return(false);
     }
   const ENUM_DPCC_STATUS status = actor.LastStatus();
   if(forwarded && status == DPCC_NO_FEASIBLE_CANDIDATE && !actor.HasValidDecision())
     {
      if(ArrayResize(action, 6) != 6)
        {
         reason = "action6.no_plan_output_allocation";
         return(false);
        }
      ArrayInitialize(action, 0.0f);
      return(true);
     }
   if(!forwarded || status != DPCC_OK || !actor.HasValidDecision() ||
      actor.getOutputVal(action) != 6 || ArraySize(action) != 6)
     {
      reason = "action6.forward_or_output";
      return(false);
     }
   for(int i = 0; i < 6; i++)
      if(!MathIsValidNumber(action[i]))
        {
         ArrayFree(action);
         reason = StringFormat("action6.nonfinite.%d", i);
         return(false);
        }
   return(true);
  }
//+------------------------------------------------------------------+
//| Shared chart-local stop button used by long DPCC training stages |
//+------------------------------------------------------------------+
class CDPCCStopButton
  {
private:
   string            m_name, m_prefix;
public:
                     CDPCCStopButton(void) { m_name = ""; m_prefix = ""; }
   string            Name(void) const { return(m_name); }
   bool              Create(const string stage, const string caption)
     {
      m_prefix = "DPCC_STOP_" + stage + "_" + (string)ChartID() + "_";
      ObjectsDeleteAll(0, m_prefix, 0, OBJ_BUTTON);
      m_name = m_prefix + (string)GetMicrosecondCount();
      if(!ObjectCreate(0, m_name, OBJ_BUTTON, 0, 0, 0))
        {
         m_name = "";
         return(false);
        }
      const int button_width = 160;
      const int right_margin = 20;
      bool configured = true;
      configured = ObjectSetInteger(0, m_name, OBJPROP_CORNER, CORNER_RIGHT_UPPER) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_XDISTANCE, button_width + right_margin) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_YDISTANCE, 5) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_XSIZE, button_width) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_YSIZE, 28) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_COLOR, clrWhite) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_BGCOLOR, clrFireBrick) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_BORDER_COLOR, clrMaroon) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_SELECTABLE, true) && configured;
      configured = ObjectSetInteger(0, m_name, OBJPROP_HIDDEN, false) && configured;
      configured = ObjectSetString(0, m_name, OBJPROP_TEXT, caption) && configured;
      if(!configured)
        {
         ObjectDelete(0, m_name);
         m_name = "";
         return(false);
        }
      ChartRedraw();
      return(true);
     }
   bool              Clicked(const int id, const string object_name) const
     {               return(id == CHARTEVENT_OBJECT_CLICK && m_name != "" && object_name == m_name); }
   bool              SetText(const string caption)
     {
      if(m_name == "" || !ObjectSetString(0, m_name, OBJPROP_TEXT, caption))
         return(false);
      ChartRedraw();
      return(true);
     }
   void              RemoveAdvisor(void)
     {
      EventKillTimer();
      Comment("");
      Delete();
      ExpertRemove();
     }
   void              Delete(void)
     {
      if(m_prefix != "")
         ObjectsDeleteAll(0, m_prefix, 0, OBJ_BUTTON);
      else
         if(m_name != "")
            ObjectDelete(0, m_name);
      m_name = "";
      m_prefix = "";
      ChartRedraw();
     }
  };

