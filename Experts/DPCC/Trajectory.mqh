            string contract = "", revision = "", role = "", task = "", manifest_stage = "", abi = "", data = "",
               archive = "",
                   profile_task = "", manifest_profile_sha = "", manifest_market_profile_sha = "",
                   time_basis = "", restore = "", manifest_owner = "",
