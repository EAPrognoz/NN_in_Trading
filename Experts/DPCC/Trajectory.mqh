//+------------------------------------------------------------------+
//| StudyForecastCore.mqh                                            |
//+------------------------------------------------------------------+
#ifndef DPCC_STUDY_FORECAST_CORE_MQH
#define DPCC_STUDY_FORECAST_CORE_MQH
//--- These existing device operations are protected on CNeuronBaseOCL.
class CDPCCStudyForecastGradientOps : public CNeuronBaseOCL
  {
private:
   CBufferFloat      m_finite_flags, m_finite_status;
public:
   bool              Bind(COpenCLMy *context)
     {
      OpenCL = context;
      if(CheckPointer(OpenCL) == POINTER_INVALID)
         return(false);
      if(!m_finite_flags.BufferInit(36288, 0.0f))
         return(false);
      if(!m_finite_status.BufferInit(1, 0.0f))
         return(false);
      if(!m_finite_flags.BufferCreate(OpenCL))
         return(false);
      if(!m_finite_status.BufferCreate(OpenCL))
         return(false);
      return(true);
     }
   bool              BuildTargetDelta(CBufferFloat *zero, CBufferFloat *prediction, CBufferFloat *negative,
                         CBufferFloat *future, CBufferFloat *delta, const uint dimension, const uint variables)
     {
      return(Different(zero, prediction, negative, (int)dimension) &&
             SumVecMatrix(negative, future, delta, dimension, variables));
     }
   bool              Copy(CBufferFloat *source, CBufferFloat *destination, const uint count)
                     {return(CopyBufferRaw(source, destination, count));}
   bool              CopyFinite(CBufferFloat *source, CBufferFloat *destination, const uint count)
     {
      if(!source || !destination || CheckPointer(OpenCL) == POINTER_INVALID ||
         count == 0 || count != 36288 || source == destination ||
         source.GetOpenCL() != OpenCL || destination.GetOpenCL() != OpenCL ||
         source.GetIndex() < 0 || destination.GetIndex() < 0 ||
         (uint)source.Total() != count || (uint)destination.Total() != count ||
         OpenCL.GetBufferSize(source.GetIndex()) != (ulong)count * sizeof(float) ||
         OpenCL.GetBufferSize(destination.GetIndex()) != (ulong)count * sizeof(float) ||
         m_finite_flags.GetOpenCL() != OpenCL || m_finite_status.GetOpenCL() != OpenCL ||
         m_finite_flags.GetIndex() < 0 || m_finite_status.GetIndex() < 0 ||
         m_finite_flags.Total() != (int)count || m_finite_status.Total() != 1 ||
         OpenCL.GetBufferSize(m_finite_flags.GetIndex()) != (ulong)count * sizeof(float) ||
         OpenCL.GetBufferSize(m_finite_status.GetIndex()) != sizeof(float))
         return(false);
      if(source.GetIndex() == destination.GetIndex() || source.GetIndex() == m_finite_flags.GetIndex() ||
         source.GetIndex() == m_finite_status.GetIndex() || destination.GetIndex() == m_finite_flags.GetIndex() ||
         destination.GetIndex() == m_finite_status.GetIndex() ||
         m_finite_flags.GetIndex() == m_finite_status.GetIndex())
         return(false);
      if(!OpenCL.SetArgumentBuffer(def_k_DPCCActivationForward, 0, source.GetIndex()) ||
         !OpenCL.SetArgumentBuffer(def_k_DPCCActivationForward, 1, destination.GetIndex()) ||
         !OpenCL.SetArgumentBuffer(def_k_DPCCActivationForward, 2, m_finite_flags.GetIndex()) ||
         !OpenCL.SetArgument(def_k_DPCCActivationForward, 3, (int)None) ||
         !OpenCL.SetArgument(def_k_DPCCActivationForward, 4, count))
         return(false);
      const uint offset[] = {0}, global[] = {count};
      if(!OpenCL.Execute(def_k_DPCCActivationForward, 1, offset, global))
         return(false);
      if(!OpenCL.SetArgumentBuffer(def_k_DPCCOperatorReduce, 0, m_finite_flags.GetIndex()) ||
         !OpenCL.SetArgumentBuffer(def_k_DPCCOperatorReduce, 1, m_finite_status.GetIndex()) ||
         !OpenCL.SetArgument(def_k_DPCCOperatorReduce, 2, count))
         return(false);
      const uint reduce_global[] = {1};
      if(!OpenCL.Execute(def_k_DPCCOperatorReduce, 1, offset, reduce_global))
         return(false);
      if(!m_finite_status.BufferRead() || m_finite_status[0] != 0.0f)
         return(false);
      return(true);
     }
  };
//+------------------------------------------------------------------+
//| Adapter for the existing AC-SRM Stage 02 calibration inputs      |
//+------------------------------------------------------------------+
//--- VERIFY limits are independent of donor OMPB calibration parameters.
struct SDPCCM05VerifyProfile
  {
   double            atol, rtol, max_price_error, min_scenario_coverage;
   uint              min_distinct_scenarios;
   bool              has_max_price_error, has_min_scenario_coverage, has_min_distinct_scenarios;
  };

struct SDPCCM05OMPBProfile
  {
   string            profile_sha256, raw_sha256;
   string            assigned_profile_sha256, market_profile_sha256;
   string            calibration_preset_path, calibration_preset_sha256;
   ulong             noise_seed;
   string            market_preset_path, market_preset_sha256;
   datetime          latent_start, latent_end;
   uint              latent_epochs;
   datetime          reference_start, reference_split, reference_end;
   datetime          calibration_start, calibration_split, calibration_end;
   int               reference_first_bar, reference_end_bar;
   int               reference_split_bar;
   int               calibration_first_bar, calibration_end_bar;
   int               calibration_split_bar;
   uint              epochs, source_anchor_period;
   uint              price_joint_epochs, price_adapt_epochs;
   ulong             price_joint_max_updates, price_adapt_max_updates;
   uint              price_joint_early_stop_patience, price_adapt_early_stop_patience;
   float             tau, lambda_dis, lambda_kl, lambda_alpha, alpha_prior, max_kl;
   ENUM_APPLIED_PRICE rsi_price, cci_price, macd_price;
  };
//+------------------------------------------------------------------+
//| M05 owner snapshot at a completed call boundary                  |
//+------------------------------------------------------------------+
struct SDPCCM05CompletedBoundary
  {
   string            stage, subphase, profile_sha256, market_profile_sha256, source_preset_sha256, raw_sha256;
   ulong             noise_seed, completed_updates, price_joint_updates, price_adapt_updates;
   ulong             ompb_target_updates, ompb_source_updates;
   uint              rng_state[5];
   uint              latent_epochs_completed, price_joint_epochs_completed, price_adapt_epochs_completed;
   uint              ompb_epoch, ompb_epoch_source_updates;
   int               next_record, ompb_reference_cursor;
   bool              epoch_started, ompb_reference_complete, ompb_epoch_started, ompb_source_pending;
  };
//--- Read-only chart snapshot. This is not part of checkpoint serialization.
struct SDPCCM05ChartMetrics
  {
   string            subphase;
   uint              epoch, epoch_limit;
   int               evaluation_stage;
   float             disagreement, kl, alpha_prior;
   uint              invalid_fallbacks, kl_rejects;
   bool              diagnostics_ready;
  };
//+------------------------------------------------------------------+
//| Strict DTO for the section-200 M05 resume record                 |
//+------------------------------------------------------------------+
struct SDPCCM05ResumeRecord
  {
   string            stage, subphase, record_order, profile_sha256, market_profile_sha256;
   string            source_preset_sha256, raw_sha256;
   string            time_basis, runtime_restore, cause, terminal_status, verify_status;
   ulong             epoch, next_record, cursor, fit_limit, holdout_cursor, noise_seed, replay_from_bar, next_bar;
   ulong             completed_transitions, policy_updates, target_updates;
   ulong             rng_state[5];
   bool              target_order_flag, journal_path_null, journal_sha256_null, pending_null, finished;
   ulong             completed_updates, price_joint_updates, price_adapt_updates, ompb_target_updates,
      ompb_source_updates;
   ulong             latent_epochs_completed, price_joint_epochs_completed, price_adapt_epochs_completed;
   bool              epoch_started, ompb_epoch_started;
   ulong             ompb_epoch, ompb_epoch_source_updates, ompb_reference_cursor, ompb_reference_capacity;
   ulong             ompb_current_capacity, ompb_reference_count, ompb_current_count;
   bool              ompb_reference_complete, ompb_source_pending;
   ulong             ompb_evaluation_stage, ompb_evaluation_cursor;
   double            ompb_evaluation_loss[6];
   ulong             ompb_evaluation_valid[6], ompb_evaluation_invalid[6];
   bool              calibration_completed, stage02_quality_pass;
   double            price_joint_loss_sum, price_adapt_loss_sum;
   ulong             teacher_initial_fingerprint, price_joint_ompb_fingerprint, latent_decoder_fingerprint;
   ulong             ompb_frozen_fingerprint, ompb_initial_fingerprint, ompb_evaluation_posterior;
   ulong             price_adapt_frozen_fingerprint, verify_market_fingerprint, verify_target_fingerprint;
   ulong             ompb_decoder_step_baseline, price_adapt_decoder_step_baseline;
   ulong             ompb_forecast_step_baselines[3];
   bool              verify_started;
   ulong             verify_snapshots, verify_covered, verify_min_distinct;
   double            verify_max_price_error, verify_coverage, verify_error_sum[48];
  };
//--- The caller resolves these counts from the admitted bars and the donor preset.
struct SDPCCM05ResumeBounds
  {
   ulong             fit_limit, holdout_count, reference_count, reference_capacity, current_capacity;
   ulong             source_evaluation_count, target_evaluation_count, calibration_count;
  };
//+------------------------------------------------------------------+
//| Function DPCCM05ResumeUnsigned                                   |
//+------------------------------------------------------------------+
bool DPCCM05ResumeUnsigned(CDPCCJsonDocument &document, const int object, const string name,
                           const ulong maximum, ulong &value, string &reason)
  {
   const int node = document.FindMember(object, name);
   if(node < 0 || document.Type(node) != DPCC_JSON_NUMBER ||
      !DPCCCheckpointReadUnsigned(document.Text(node), ULONG_MAX, value) || value > maximum)
     {
      reason = "M05_RESUME.unsigned." + name;
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCM05ResumeNumber                                     |
//+------------------------------------------------------------------+
bool DPCCM05ResumeNumber(CDPCCJsonDocument &document, const int object, const string name,
                         double &value, string &reason)
  {
   const int node = document.FindMember(object, name);
   if(node < 0 || !document.TryNumber(node, value) || value < 0 || !MathIsValidNumber(value))
     {
      reason = "M05_RESUME.number." + name;
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCM05ResumeBoolean                                    |
//+------------------------------------------------------------------+
bool DPCCM05ResumeBoolean(CDPCCJsonDocument &document, const int object, const string name,
                          bool &value, string &reason)
  {
   const int node = document.FindMember(object, name);
   if(node < 0 || document.Type(node) != DPCC_JSON_BOOLEAN)
     {
      reason = "M05_RESUME.boolean." + name;
      return(false);
     }
   value = (document.Text(node) == "true");
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCM05ResumeString                                     |
//+------------------------------------------------------------------+
bool DPCCM05ResumeString(CDPCCJsonDocument &document, const int object, const string name,
                         string &value, string &reason)
  {
   const int node = document.FindMember(object, name);
   if(node < 0 || document.Type(node) != DPCC_JSON_STRING)
     {
      reason = "M05_RESUME.string." + name;
      return(false);
     }
   value = document.Text(node);
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCM05ResumeNull                                       |
//+------------------------------------------------------------------+
bool DPCCM05ResumeNull(CDPCCJsonDocument &document, const int object, const string name,
                       bool &is_null, string &reason)
  {
   const int node = document.FindMember(object, name);
   if(node < 0 || document.Type(node) != DPCC_JSON_NULL)
     {
      reason = "M05_RESUME.null." + name;
      return(false);
     }
   is_null = true;
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCParseM05ResumeRecord                                |
//+------------------------------------------------------------------+
bool DPCCParseM05ResumeRecord(const string text, const SDPCCM05ResumeBounds &bounds,
                              const string expected_market_profile_sha256,
                              const string expected_source_preset_sha256,
                              const string expected_raw_sha256,
                              SDPCCM05ResumeRecord &record, string &reason)
  {
   ZeroMemory(record);
   reason = "";
   if(!DPCCResolverLowerSha256(expected_market_profile_sha256) ||
      !DPCCResolverLowerSha256(expected_source_preset_sha256) ||
      !DPCCResolverLowerSha256(expected_raw_sha256) || bounds.fit_limit == 0 ||
      bounds.fit_limit > (ulong)INT_MAX || bounds.holdout_count > (ulong)INT_MAX ||
      bounds.reference_count > (ulong)INT_MAX || bounds.source_evaluation_count > (ulong)INT_MAX ||
      bounds.target_evaluation_count > (ulong)INT_MAX || bounds.calibration_count > (ulong)INT_MAX ||
      bounds.reference_capacity > (ulong)UINT_MAX || bounds.current_capacity > (ulong)UINT_MAX)
     {
      reason = "M05_RESUME.expected_identity_or_bounds";
      return(false);
     }
   CDPCCJsonDocument document;
   if(!document.Parse(text, reason))
      return(false);
   if(document.Type(document.Root()) != DPCC_JSON_OBJECT)
     {
      reason = "M05_RESUME.object_required";
      return(false);
     }
   if(!DPCCM05KnownMembers(document, document.Root(),
                           "|stage|subphase|epoch|next_record|cursor|fit_limit|holdout_cursor|record_order|completed_transitions|policy_updates|target_updates|target_order_flag|rng_state|noise_seed|profile_sha256|market_profile_sha256|source_preset_sha256|raw_sha256|journal_path|journal_sha256|time_basis|replay_from_bar|next_bar|pending|runtime_restore|cause|finished|terminal_status|completed_updates|price_joint_updates|price_adapt_updates|ompb_target_updates|ompb_source_updates|latent_epochs_completed|price_joint_epochs_completed|price_adapt_epochs_completed|epoch_started|ompb_epoch_started|ompb_epoch|ompb_epoch_source_updates|ompb_reference_cursor|ompb_reference_capacity|ompb_current_capacity|ompb_reference_count|ompb_current_count|ompb_reference_complete|ompb_source_pending|ompb_evaluation_stage|ompb_evaluation_cursor|ompb_evaluation|calibration_completed|stage02_quality_pass|price_joint_loss_sum|price_adapt_loss_sum|teacher_initial_fingerprint|price_joint_ompb_fingerprint|latent_decoder_fingerprint|ompb_frozen_fingerprint|ompb_initial_fingerprint|ompb_evaluation_posterior|price_adapt_frozen_fingerprint|verify_market_fingerprint|verify_target_fingerprint|ompb_decoder_step_baseline|price_adapt_decoder_step_baseline|ompb_forecast_step_baselines|verify_started|verify_status|verify_snapshots|verify_covered|verify_min_distinct|verify_max_price_error|verify_coverage|verify_error_sum|",
                           "M05_RESUME", reason))
      return(false);
   const int root = document.Root();
   if(!DPCCM05ResumeString(document, root, "stage", record.stage, reason) ||
      !DPCCM05ResumeString(document, root, "subphase", record.subphase, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "epoch", UINT_MAX, record.epoch, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "next_record", (ulong)INT_MAX, record.next_record, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "cursor", (ulong)INT_MAX, record.cursor, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "fit_limit", (ulong)INT_MAX, record.fit_limit, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "holdout_cursor", (ulong)INT_MAX, record.holdout_cursor, reason) ||
      !DPCCM05ResumeString(document, root, "record_order", record.record_order, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "completed_transitions", ULONG_MAX, record.completed_transitions,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "policy_updates", ULONG_MAX, record.policy_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "target_updates", ULONG_MAX, record.target_updates, reason) ||
      !DPCCM05ResumeBoolean(document, root, "target_order_flag", record.target_order_flag, reason))
      return(false);
   if(record.record_order != "CHRONOLOGICAL_TERMINAL_BARS" || record.completed_transitions != 0 ||
      record.policy_updates != 0 || record.target_updates != 0 || record.target_order_flag)
     {
      reason = "M05_RESUME.fixed_order_invariant";
      return(false);
     }
   const int rng = document.FindMember(root, "rng_state");
   if(rng < 0 || document.Type(rng) != DPCC_JSON_ARRAY || document.ChildCount(rng) != 5)
     {
      reason = "M05_RESUME.rng_state.shape";
      return(false);
     }
   for(int i = 0; i < 5; i++)
      if(!DPCCCheckpointReadUnsigned(document.Text(document.ChildAt(rng, i)), UINT_MAX, record.rng_state[i]) ||
         document.Type(document.ChildAt(rng, i)) != DPCC_JSON_NUMBER)
        {
         reason = "M05_RESUME.rng_state.value";
         return(false);
        }
   if(!DPCCM05ResumeUnsigned(document, root, "noise_seed", ULONG_MAX, record.noise_seed, reason) ||
      !DPCCM05ResumeString(document, root, "profile_sha256", record.profile_sha256, reason) ||
      !DPCCM05ResumeString(document, root, "market_profile_sha256", record.market_profile_sha256, reason) ||
      !DPCCM05ResumeString(document, root, "source_preset_sha256", record.source_preset_sha256, reason) ||
      !DPCCM05ResumeString(document, root, "raw_sha256", record.raw_sha256, reason) ||
      !DPCCM05ResumeNull(document, root, "journal_path", record.journal_path_null, reason) ||
      !DPCCM05ResumeNull(document, root, "journal_sha256", record.journal_sha256_null, reason) ||
      !DPCCM05ResumeString(document, root, "time_basis", record.time_basis, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "replay_from_bar", (ulong)LONG_MAX, record.replay_from_bar, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "next_bar", (ulong)LONG_MAX, record.next_bar, reason) ||
      !DPCCM05ResumeNull(document, root, "pending", record.pending_null, reason) ||
      !DPCCM05ResumeString(document, root, "runtime_restore", record.runtime_restore, reason) ||
      !DPCCM05ResumeString(document, root, "cause", record.cause, reason) ||
      !DPCCM05ResumeBoolean(document, root, "finished", record.finished, reason) ||
      !DPCCM05ResumeString(document, root, "terminal_status", record.terminal_status, reason))
      return(false);
   if(!DPCCResolverLowerSha256(record.profile_sha256) ||
      !DPCCResolverLowerSha256(record.market_profile_sha256) ||
      record.market_profile_sha256 != expected_market_profile_sha256 ||
      !DPCCResolverLowerSha256(record.source_preset_sha256) ||
      record.source_preset_sha256 != expected_source_preset_sha256 ||
      !DPCCResolverLowerSha256(record.raw_sha256) || record.raw_sha256 != expected_raw_sha256 ||
      record.time_basis != "TERMINAL_SERVER" || record.runtime_restore != "WARMUP_FROM_LATEST_WEIGHTS" ||
      (record.cause != "PHASE_COMPLETED" && record.cause != "CONTROLLED_STOP" && record.cause != "VERIFY_COMPLETED" &&
       record.cause != "USER_ACCEPTED_LATENT_PREPARE" && record.cause != "EPOCH_COMPLETED" &&
       record.cause != "USER_ACCEPTED_PARTIAL_OMPB" && record.cause != "USER_SELECTED_PHASE") ||
      (record.terminal_status != "" && record.terminal_status != "STOPPED_COMPLETE_UPDATE" &&
       record.terminal_status != "PHASE_COMPLETED" && record.terminal_status != "PASS" &&
       record.terminal_status != "FAIL" && record.terminal_status != "BLOCKED_MISSING_LIMITS" &&
       record.terminal_status != "INSUFFICIENT_DATA"))
     {
      reason = "M05_RESUME.identity_or_fixed_invariant";
      return(false);
     }
   if(!DPCCM05ResumeUnsigned(document, root, "completed_updates", ULONG_MAX, record.completed_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_joint_updates", ULONG_MAX, record.price_joint_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_adapt_updates", ULONG_MAX, record.price_adapt_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_target_updates", ULONG_MAX, record.ompb_target_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_source_updates", ULONG_MAX, record.ompb_source_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "latent_epochs_completed", UINT_MAX, record.latent_epochs_completed,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_joint_epochs_completed", UINT_MAX,
         record.price_joint_epochs_completed, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_adapt_epochs_completed", UINT_MAX,
         record.price_adapt_epochs_completed, reason) ||
      !DPCCM05ResumeBoolean(document, root, "epoch_started", record.epoch_started, reason) ||
      !DPCCM05ResumeBoolean(document, root, "ompb_epoch_started", record.ompb_epoch_started, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_epoch", UINT_MAX, record.ompb_epoch, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_epoch_source_updates", UINT_MAX, record.ompb_epoch_source_updates,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_reference_cursor", ULONG_MAX, record.ompb_reference_cursor,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_reference_capacity", ULONG_MAX, record.ompb_reference_capacity,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_current_capacity", ULONG_MAX, record.ompb_current_capacity,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_reference_count", ULONG_MAX, record.ompb_reference_count, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_current_count", ULONG_MAX, record.ompb_current_count, reason) ||
      !DPCCM05ResumeBoolean(document, root, "ompb_reference_complete", record.ompb_reference_complete, reason) ||
      !DPCCM05ResumeBoolean(document, root, "ompb_source_pending", record.ompb_source_pending, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_evaluation_stage", 6, record.ompb_evaluation_stage, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_evaluation_cursor", ULONG_MAX, record.ompb_evaluation_cursor,
         reason))
      return(false);
   const int evaluation = document.FindMember(root, "ompb_evaluation");
   if(evaluation < 0 || document.Type(evaluation) != DPCC_JSON_ARRAY || document.ChildCount(evaluation) != 6)
     {
      reason = "M05_RESUME.ompb_evaluation.shape";
      return(false);
     }
   for(int i = 0; i < 6; i++)
     {
      const int item = document.ChildAt(evaluation, i);
      if(!DPCCM05KnownMembers(document, item, "|loss|valid|invalid|", "M05_RESUME.ompb_evaluation", reason) ||
         document.ChildCount(item) != 3 ||
         !DPCCM05ResumeNumber(document, item, "loss", record.ompb_evaluation_loss[i], reason) ||
         !DPCCM05ResumeUnsigned(document, item, "valid", ULONG_MAX, record.ompb_evaluation_valid[i], reason) ||
         !DPCCM05ResumeUnsigned(document, item, "invalid", ULONG_MAX, record.ompb_evaluation_invalid[i], reason))
        {
         if(reason == "")
            reason = "M05_RESUME.ompb_evaluation.item";
         return(false);
        }
     }
   if(!DPCCM05ResumeBoolean(document, root, "calibration_completed", record.calibration_completed, reason) ||
      !DPCCM05ResumeBoolean(document, root, "stage02_quality_pass", record.stage02_quality_pass, reason) ||
      !DPCCM05ResumeNumber(document, root, "price_joint_loss_sum", record.price_joint_loss_sum, reason) ||
      !DPCCM05ResumeNumber(document, root, "price_adapt_loss_sum", record.price_adapt_loss_sum, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "teacher_initial_fingerprint", ULONG_MAX,
         record.teacher_initial_fingerprint, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_joint_ompb_fingerprint", ULONG_MAX,
         record.price_joint_ompb_fingerprint, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "latent_decoder_fingerprint", ULONG_MAX, record.latent_decoder_fingerprint,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_frozen_fingerprint", ULONG_MAX, record.ompb_frozen_fingerprint,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_initial_fingerprint", ULONG_MAX, record.ompb_initial_fingerprint,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_evaluation_posterior", ULONG_MAX, record.ompb_evaluation_posterior,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_adapt_frozen_fingerprint", ULONG_MAX,
         record.price_adapt_frozen_fingerprint, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "verify_market_fingerprint", ULONG_MAX, record.verify_market_fingerprint,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "verify_target_fingerprint", ULONG_MAX, record.verify_target_fingerprint,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_decoder_step_baseline", UINT_MAX, record.ompb_decoder_step_baseline,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_adapt_decoder_step_baseline", UINT_MAX,
         record.price_adapt_decoder_step_baseline, reason))
      return(false);
   const int forecast = document.FindMember(root, "ompb_forecast_step_baselines");
   if(forecast < 0 || document.Type(forecast) != DPCC_JSON_ARRAY || document.ChildCount(forecast) != 3)
     {
      reason = "M05_RESUME.ompb_forecast_step_baselines.shape";
      return(false);
     }
   for(int i = 0; i < 3; i++)
      if(document.Type(document.ChildAt(forecast, i)) != DPCC_JSON_NUMBER ||
         !DPCCCheckpointReadUnsigned(document.Text(document.ChildAt(forecast, i)), UINT_MAX,
                                     record.ompb_forecast_step_baselines[i]))
        {
         reason = "M05_RESUME.ompb_forecast_step_baselines.value";
         return(false);
        }
   if(!DPCCM05ResumeBoolean(document, root, "verify_started", record.verify_started, reason) ||
      !DPCCM05ResumeString(document, root, "verify_status", record.verify_status, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "verify_snapshots", UINT_MAX, record.verify_snapshots, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "verify_covered", UINT_MAX, record.verify_covered, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "verify_min_distinct", 21, record.verify_min_distinct, reason) ||
      !DPCCM05ResumeNumber(document, root, "verify_max_price_error", record.verify_max_price_error, reason) ||
      !DPCCM05ResumeNumber(document, root, "verify_coverage", record.verify_coverage, reason) ||
      record.verify_coverage > 1.0)
      return(false);
   const int errors = document.FindMember(root, "verify_error_sum");
   if(errors < 0 || document.Type(errors) != DPCC_JSON_ARRAY || document.ChildCount(errors) != 48)
     {
      reason = "M05_RESUME.verify_error_sum.shape";
      return(false);
     }
   for(int i = 0; i < 48; i++)
      if(!document.TryNumber(document.ChildAt(errors, i), record.verify_error_sum[i]) ||
         record.verify_error_sum[i] < 0 || !MathIsValidNumber(record.verify_error_sum[i]))
        {
         reason = "M05_RESUME.verify_error_sum.value";
         return(false);
        }
   if(record.verify_status != "" && record.verify_status != "NOT_RUN" &&
      record.verify_status != "RUNNING" && record.verify_status != "PASS" &&
      record.verify_status != "FAIL" && record.verify_status != "BLOCKED_MISSING_LIMITS" &&
      record.verify_status != "INSUFFICIENT_DATA")
     {
      reason = "M05_RESUME.verify_status.domain";
      return(false);
     }
   if((record.verify_started && (record.verify_status == "" || record.verify_status == "NOT_RUN")) ||
      (!record.verify_started && record.verify_status != "" && record.verify_status != "NOT_RUN"))
     {
      reason = "M05_RESUME.verify_lifecycle";
      return(false);
     }
   if(record.fit_limit != bounds.fit_limit ||
      (record.cursor > bounds.fit_limit && record.cursor > bounds.holdout_count) ||
      record.holdout_cursor > bounds.holdout_count || record.ompb_reference_cursor > bounds.reference_count ||
      record.ompb_reference_capacity != bounds.reference_capacity ||
      record.ompb_current_capacity != bounds.current_capacity ||
      record.ompb_reference_count > record.ompb_reference_capacity ||
      record.ompb_reference_count > bounds.reference_count ||
      record.ompb_current_count > record.ompb_current_capacity ||
      record.verify_snapshots > bounds.holdout_count ||
      record.ompb_epoch_source_updates > record.ompb_source_updates ||
      record.verify_covered > record.verify_snapshots ||
      record.completed_updates < record.price_joint_updates || record.completed_updates < record.price_adapt_updates ||
      record.completed_updates < record.ompb_target_updates || record.completed_updates < record.ompb_source_updates ||
      record.ompb_target_updates > record.completed_updates - record.ompb_source_updates ||
      (record.replay_from_bar > 0 && record.next_bar > 0 && record.next_bar < record.replay_from_bar))
     {
      reason = "M05_RESUME.count_or_cursor_bounds";
      return(false);
     }
   ulong evaluation_cursor_limit = bounds.source_evaluation_count;
   if(bounds.target_evaluation_count > evaluation_cursor_limit)
      evaluation_cursor_limit = bounds.target_evaluation_count;
   if(record.ompb_evaluation_cursor > evaluation_cursor_limit ||
      (record.ompb_reference_complete && record.ompb_reference_count != record.ompb_reference_capacity))
     {
      reason = "M05_RESUME.stage02_or_evaluation_state";
      return(false);
     }
   const ulong expected_epoch = (record.stage == "LATENT_PREPARE" ? record.latent_epochs_completed :
                                 (record.stage == "PRICE_JOINT" ? record.price_joint_epochs_completed :
                                  (record.stage == "OMPB_CALIBRATE" ? record.ompb_epoch :
                                     record.price_adapt_epochs_completed)));
   if(record.epoch != expected_epoch)
     {
      reason = "M05_RESUME.epoch_phase_mismatch";
      return(false);
     }
   if(record.stage == "OMPB_CALIBRATE")
     {
      ulong next_limit = 0;
      bool phase_ok = false;
      if(record.subphase == "REFERENCE")
        {
         phase_ok = !record.ompb_reference_complete &&
                    record.ompb_reference_cursor < bounds.reference_count &&
                    record.next_record == record.ompb_reference_cursor;
         next_limit = bounds.reference_count;
        }
      else
         if(record.subphase == "SOURCE_ANCHOR")
           {
            phase_ok = record.ompb_reference_complete && record.ompb_source_pending;
            next_limit = bounds.calibration_count;
           }
         else
            if(record.subphase == "CALIBRATION")
              {
               phase_ok = record.ompb_reference_complete && !record.ompb_source_pending &&
                          record.ompb_evaluation_stage >= 4 && !record.calibration_completed;
               next_limit = bounds.calibration_count;
              }
            else
               if(StringFind(record.subphase, "EVALUATION_") == 0)
                 {
                  const string expected_subphase = "EVALUATION_" + (string)record.ompb_evaluation_stage;
                  next_limit = (record.ompb_evaluation_stage % 2 == 0 ? bounds.source_evaluation_count :
                                bounds.target_evaluation_count);
                  phase_ok = record.subphase == expected_subphase && !record.ompb_source_pending &&
                             (record.ompb_evaluation_stage < 4 || record.calibration_completed) &&
                             next_limit > 0 && record.ompb_evaluation_cursor < next_limit;
                  phase_ok = phase_ok && record.next_record == record.ompb_evaluation_cursor;
                 }
      if(!phase_ok || record.next_record > next_limit || record.cursor > bounds.calibration_count ||
         (record.ompb_source_pending && (!record.ompb_reference_complete || record.calibration_completed ||
                                         record.ompb_evaluation_stage < 4)) ||
         (record.ompb_epoch_started && (record.subphase != "CALIBRATION" && record.subphase != "SOURCE_ANCHOR")) ||
         (record.calibration_completed && record.ompb_evaluation_stage < 4) ||
         (record.stage02_quality_pass && !record.calibration_completed))
        {
         reason = "M05_RESUME.ompb_phase_state";
         return(false);
        }
     }
   else
     {
      ulong phase_limit = 0;
      if(record.stage == "LATENT_PREPARE" || record.stage == "PRICE_JOINT" || record.stage == "PRICE_ADAPT")
         phase_limit = bounds.fit_limit;
      else
         if(record.stage == "VERIFY")
            phase_limit = bounds.holdout_count;
         else
           {
            reason = "M05_RESUME.stage.domain";
            return(false);
           }
      if(record.subphase != record.stage || record.next_record != record.cursor ||
         record.next_record > phase_limit)
        {
         reason = "M05_RESUME.phase_cursor";
         return(false);
        }
     }
   if(record.verify_coverage > 0 && record.verify_snapshots == 0)
     {
      reason = "M05_RESUME.verify_without_snapshots";
      return(false);
     }
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Bind model-only loading to the source generation, without        |
//| cursors                                                          |
//+------------------------------------------------------------------+
bool DPCCParseM05ModelBoundary(const string text, SDPCCM05ResumeRecord &record, string &reason)
  {
   ZeroMemory(record);
   reason = "";
   CDPCCJsonDocument document;
   if(!document.Parse(text, reason))
      return(false);
   const int root = document.Root();
   if(document.Type(root) != DPCC_JSON_OBJECT ||
      !DPCCM05ResumeString(document, root, "stage", record.stage, reason) ||
      !DPCCM05ResumeString(document, root, "profile_sha256", record.profile_sha256, reason) ||
      !DPCCM05ResumeString(document, root, "market_profile_sha256", record.market_profile_sha256, reason) ||
      !DPCCM05ResumeString(document, root, "source_preset_sha256", record.source_preset_sha256, reason) ||
      !DPCCM05ResumeString(document, root, "raw_sha256", record.raw_sha256, reason) ||
      !DPCCM05ResumeString(document, root, "time_basis", record.time_basis, reason) ||
      !DPCCM05ResumeString(document, root, "runtime_restore", record.runtime_restore, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "noise_seed", ULONG_MAX, record.noise_seed, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "completed_updates", ULONG_MAX, record.completed_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_reference_capacity", UINT_MAX, record.ompb_reference_capacity,
         reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_current_capacity", UINT_MAX, record.ompb_current_capacity, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_reference_count", UINT_MAX, record.ompb_reference_count, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "ompb_current_count", UINT_MAX, record.ompb_current_count, reason) ||
      !DPCCM05ResumeBoolean(document, root, "finished", record.finished, reason) ||
      !DPCCM05ResumeBoolean(document, root, "calibration_completed", record.calibration_completed, reason) ||
      !DPCCM05ResumeBoolean(document, root, "stage02_quality_pass", record.stage02_quality_pass, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_adapt_updates", ULONG_MAX, record.price_adapt_updates, reason) ||
      !DPCCM05ResumeUnsigned(document, root, "price_adapt_epochs_completed", UINT_MAX,
                             record.price_adapt_epochs_completed, reason) ||
      !DPCCM05ResumeString(document, root, "verify_status", record.verify_status, reason))
      return(false);
   if((record.stage != "LATENT_PREPARE" && record.stage != "PRICE_JOINT" && record.stage != "OMPB_CALIBRATE" &&
       record.stage != "PRICE_ADAPT" && record.stage != "VERIFY") ||
      !DPCCResolverLowerSha256(record.profile_sha256) ||
      !DPCCResolverLowerSha256(record.market_profile_sha256) ||
      !DPCCResolverLowerSha256(record.source_preset_sha256) || !DPCCResolverLowerSha256(record.raw_sha256) ||
      record.time_basis != "TERMINAL_SERVER" || record.runtime_restore != "WARMUP_FROM_LATEST_WEIGHTS" ||
      record.price_adapt_updates > record.completed_updates ||
      record.ompb_reference_capacity == 0 || record.ompb_current_capacity == 0 ||
      record.ompb_reference_count > record.ompb_reference_capacity ||
      record.ompb_current_count > record.ompb_current_capacity)
     {
      reason = "M05_SELECT.source_model_identity";
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCM05JsonEqual                                        |
//+------------------------------------------------------------------+
bool DPCCM05JsonEqual(CDPCCJsonDocument &left, const int left_node,
                      CDPCCJsonDocument &right, const int right_node)
  {
   if(left_node < 0 || right_node < 0 || left.Type(left_node) != right.Type(right_node) ||
      left.ChildCount(left_node) != right.ChildCount(right_node))
      return(false);
   const ENUM_DPCC_JSON_TYPE type = left.Type(left_node);
   if(type == DPCC_JSON_OBJECT)
     {
      for(int child = left.FirstChild(left_node); child >= 0; child = left.NextSibling(child))
        {
         const int other = right.FindMember(right_node, left.Key(child));
         if(other < 0 || !DPCCM05JsonEqual(left, child, right, other))
            return(false);
        }
      return(true);
     }
   if(type == DPCC_JSON_ARRAY)
     {
      for(int i = 0; i < left.ChildCount(left_node); i++)
         if(!DPCCM05JsonEqual(left, left.ChildAt(left_node, i), right, right.ChildAt(right_node, i)))
            return(false);
      return(true);
     }
   return(left.Text(left_node) == right.Text(right_node));
  }
//+------------------------------------------------------------------+
//| Read the profile-owned cap for one new Market price phase        |
//+------------------------------------------------------------------+
bool DPCCReadM05PricePhaseBudget(CDPCCJsonDocument &document, const int phases,
                                 const string phase, uint &epochs, ulong &max_updates,
                                 uint &early_stop_patience, string &reason)
  {
   epochs = 0;
   max_updates = 0;
   early_stop_patience = 0;
   const string path = "profile.market_phases." + phase;
   const int node = document.FindMember(phases, phase);
   if(node < 0 || !DPCCM05KnownMembers(document, node, "|epochs|max_updates|early_stop_patience|", path, reason))
     {
      if(reason == "")
         reason = path + ".required";
      return(false);
     }
   long epoch_value = 0, update_value = 0;
   if(!DPCCResourceReadLong(document, node, "epochs", epoch_value, reason, path + ".epochs") ||
      !DPCCResourceReadLong(document, node, "max_updates", update_value, reason, path + ".max_updates"))
      return(false);
   if(epoch_value <= 0 || epoch_value > UINT_MAX || update_value < 0)
     {
      reason = path + ".positive_epochs_and_nonnegative_max_updates_required";
      return(false);
     }
   const int patience_node = document.FindMember(node, "early_stop_patience");
   if(patience_node >= 0 && document.Type(patience_node) != DPCC_JSON_NULL)
     {
      long patience_value = 0;
      if(!DPCCResourceReadLong(document, node, "early_stop_patience", patience_value, reason,
                               path + ".early_stop_patience") ||
         patience_value <= 0 || patience_value > UINT_MAX)
        {
         if(reason == "")
            reason = path + ".early_stop_patience_positive_or_null";
         return(false);
        }
      early_stop_patience = (uint)patience_value;
      reason = path + ".early_stop_monitor_undefined";
      return(false);
     }
   epochs = (uint)epoch_value;
   max_updates = (ulong)update_value;
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Resolve zero cap from the admitted FIT rows and configured       |
//| epochs                                                           |
//+------------------------------------------------------------------+
bool DPCCResolveM05PricePhaseBudget(const int fit_count, const uint epochs, const ulong requested_cap,
                                    ulong &resolved_cap, string &reason)
  {
   resolved_cap = 0;
   if(fit_count <= 0 || epochs == 0)
     {
      reason = "profile.market_phase_budget.positive_fit_count_and_epochs_required";
      return(false);
     }
   if((ulong)fit_count > ULONG_MAX / (ulong)epochs)
     {
      reason = "profile.market_phase_budget.fit_count_times_epochs_overflow";
      return(false);
     }
   resolved_cap = (requested_cap == 0 ? (ulong)fit_count * (ulong)epochs : requested_cap);
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Reject names outside the consumed execution-profile vocabulary   |
//+------------------------------------------------------------------+
bool DPCCM05KnownMembers(CDPCCJsonDocument &document, const int node, const string vocabulary,
                         const string path, string &reason)
  {
   if(document.Type(node) != DPCC_JSON_OBJECT)
     {
      reason = path + ".object_required";
      return(false);
     }
   for(int i = 0; i < document.ChildCount(node); i++)
     {
      const string key = document.Key(document.ChildAt(node, i));
      if(key == "" || StringFind(key, "|") >= 0 || StringFind(vocabulary, "|" + key + "|") < 0)
        {
         reason = path + ".unknown_key." + key;
         return(false);
        }
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Parse required Stage01 or Stage02 keys without input fallbacks   |
//+------------------------------------------------------------------+
bool DPCCParseM05DonorPreset(const string source, SDPCCM05OMPBProfile &profile, string &reason,
                             const uint expected_stage = 2)
  {
   ZeroMemory(profile);
   const string names[] = {"TimeFrame", "RSIPeriod", "RSIPrice", "CCIPeriod", "CCIPrice", "ATRPeriod",
                           "FastPeriod", "SlowPeriod", "SignalPeriod", "MACDPrice", "InpStart", "InpEnd", "InpEpochs",
                           "InpOMPBStage", "InpOMPBSmoke", "InpOMPBEpochs", "InpOMPBReferenceStart",
                              "InpOMPBReferenceEnd",
                           "InpOMPBCalibrationStart", "InpOMPBCalibrationEnd", "InpOMPBSourcePeriod", "InpOMPBTau",
                           "InpOMPBLambdaDis", "InpOMPBLambdaKL", "InpOMPBLambdaAlpha", "InpOMPBAlphaPrior",
                              "InpOMPBMaxKL",
                           "InpRecoverySmoke", "InpRecoverySmokeBatches", "InpRecoverySmokeAge"
                          };
   string values[];
   if(ArrayResize(values, ArraySize(names)) != ArraySize(names))
     {
      reason = "DONOR_PRESET_INVALID.capacity";
      return(false);
     }
   for(int i = 0; i < ArraySize(values); i++)
      values[i] = "";
   string lines[];
   const int count = StringSplit(source, '\n', lines);
   for(int i = 0; i < count; i++)
     {
      string line = lines[i];
      StringTrimLeft(line);
      StringTrimRight(line);
      if(line == "" || StringGetCharacter(line, 0) == ';')
         continue;
      const int separator = StringFind(line, "=");
      if(separator <= 0 || StringFind(line, "=", separator + 1) >= 0)
        {
         reason = "DONOR_PRESET_INVALID.line." + (string)(i + 1);
         return(false);
        }
      string key = StringSubstr(line, 0, separator);
      string value = StringSubstr(line, separator + 1);
      StringTrimRight(key);
      StringTrimLeft(value);
      int index = -1;
      for(int j = 0; j < ArraySize(names); j++)
         if(names[j] == key)
           {
            index = j;
            break;
           }
      if(index < 0 || value == "" || values[index] != "")
        {
         reason = "DONOR_PRESET_INVALID." + (index < 0 ? "unknown_key." : "duplicate_or_empty_key.") + key;
         return(false);
        }
      values[index] = value;
     }
//--- Check all donor types before adapting the calibration fields.
   double numbers[];
   if(ArrayResize(numbers, ArraySize(names)) != ArraySize(names))
     {
      reason = "DONOR_PRESET_INVALID.capacity";
      return(false);
     }
   ArrayInitialize(numbers, 0.0);
   for(int i = 0; i < ArraySize(names); i++)
     {
      if(values[i] == "")
        {
         reason = "DONOR_PRESET_INVALID.missing_key." + names[i];
         return(false);
        }
      if(i == 0)
         continue;
      if(i == 14 || i == 27)
        {
         if(values[i] != "true" && values[i] != "false")
           {
            reason = "DONOR_PRESET_INVALID.boolean." + names[i];
            return(false);
           }
         continue;
        }
      if(i >= 21 && i <= 26)
        {
         CDPCCJsonDocument number_document;
         if(!number_document.Parse(values[i], reason) ||
            !number_document.TryNumber(number_document.Root(), numbers[i]) ||
            !MathIsValidNumber((float)numbers[i]))
           {
            reason = "DONOR_PRESET_INVALID.number." + names[i];
            return(false);
           }
        }
      else
        {
         ulong number = 0;
         if(!DPCCCheckpointReadUnsigned(values[i], 32535215999, number) ||
            ((i < 10 || i == 12 || i == 13 || i == 15 || i == 20 || i >= 28) && number > (ulong)UINT_MAX))
           {
            reason = "DONOR_PRESET_INVALID.integer." + names[i];
            return(false);
           }
         numbers[i] = (double)number;
        }
     }
//--- Donor TimeFrame is provenance; DPCC history follows the selected chart period.
   if((values[0] != "PERIOD_CURRENT" && !DPCCStudyForecastTimeframeName(values[0])) ||
      numbers[1] <= 0 || numbers[3] <= 0 || numbers[5] <= 0 || numbers[6] <= 0 ||
      numbers[7] <= 0 || numbers[8] <= 0 || numbers[12] <= 0)
     {
      reason = "MARKET_INPUT_PROFILE_MISMATCH.donor_timeframe_or_capture_preprocessing";
      return(false);
     }
   if(!DPCCStudyForecastAppliedPriceValid((long)numbers[2]) ||
      !DPCCStudyForecastAppliedPriceValid((long)numbers[4]) ||
      !DPCCStudyForecastAppliedPriceValid((long)numbers[9]))
     {
      reason = "DONOR_PRESET_INVALID.applied_price";
      return(false);
     }
   if(numbers[10] <= 0 || numbers[11] <= numbers[10] || numbers[12] <= 0 ||
      (expected_stage != 1 && expected_stage != 2) || numbers[13] != (double)expected_stage ||
      values[14] != "false" || values[27] != "false")
     {
      reason = "DONOR_PRESET_INVALID.production_stage_required." + (string)expected_stage;
      return(false);
     }
   if(numbers[20] == 0)
     {
      reason = "DONOR_PRESET_INVALID.InpOMPBSourcePeriod_positive_required";
      return(false);
     }
   profile.latent_start = (datetime)(long)numbers[10];
   profile.latent_end = (datetime)(long)numbers[11];
   profile.latent_epochs = (uint)numbers[12];
   profile.reference_start = (datetime)(long)numbers[16];
   profile.reference_end = (datetime)(long)numbers[17];
   profile.calibration_start = (datetime)(long)numbers[18];
   profile.calibration_end = (datetime)(long)numbers[19];
   profile.epochs = (uint)numbers[15];
   profile.source_anchor_period = (uint)numbers[20];
   profile.rsi_price = (ENUM_APPLIED_PRICE)(long)numbers[2];
   profile.cci_price = (ENUM_APPLIED_PRICE)(long)numbers[4];
   profile.macd_price = (ENUM_APPLIED_PRICE)(long)numbers[9];
   profile.tau = (float)numbers[21];
   profile.lambda_dis = (float)numbers[22];
   profile.lambda_kl = (float)numbers[23];
   profile.lambda_alpha = (float)numbers[24];
   profile.alpha_prior = (float)numbers[25];
   profile.max_kl = (float)numbers[26];
   if(profile.epochs == 0 || profile.reference_start < (datetime)(long)numbers[10] ||
      profile.reference_end <= profile.reference_start || profile.reference_end > profile.calibration_start ||
      profile.calibration_end <= profile.calibration_start || profile.calibration_end > (datetime)(long)numbers[11] ||
      profile.tau <= 0 || profile.tau > 1 ||
      profile.lambda_dis < 0 || profile.lambda_kl < 0 || profile.lambda_alpha < 0 || profile.max_kl < 0)
     {
      reason = "DONOR_PRESET_INVALID.calibration_domain";
      return(false);
     }
   reason = "";
   return(true);
  }
//--- Direct M05 settings come from advisor inputs; AC-SRM calibration is adapted in memory.
struct SDPCCM05DirectInputs
  {
   string            task_id, task_directory;
   ENUM_TIMEFRAMES   timeframe;
   ulong             noise_seed, max_file_bytes;
   datetime          latent_start, latent_end, reference_start, reference_end, calibration_start, calibration_end;
   uint              latent_epochs, ompb_epochs, source_anchor_period;
   uint              rsi_period, cci_period, price_atr_period, fast_period, slow_period, signal_period;
   ENUM_APPLIED_PRICE rsi_price, cci_price, macd_price;
   float             tau, lambda_dis, lambda_kl, lambda_alpha, alpha_prior, max_kl;
   uint              price_joint_epochs, price_adapt_epochs;
   ulong             price_joint_max_updates, price_adapt_max_updates;
   float             lambda_price, huber_delta, rho_tolerance;
   double            verify_atol, verify_rtol, verify_max_price_error, verify_min_scenario_coverage;
   uint              verify_min_distinct_scenarios;
  };
//+------------------------------------------------------------------+
//| Function DPCCM05IdentityVectorJSON                               |
//+------------------------------------------------------------------+
string DPCCM05IdentityVectorJSON(const float value)
  {
   string json = "[";
   for(int i = 0; i < 109; i++)
      json += (i == 0 ? "" : ",") + StringFormat("%.9g", (double)value);
   return(json + "]");
  }
//+------------------------------------------------------------------+
//| Function DPCCBuildM05ExecutionProfileFromInputs                  |
//+------------------------------------------------------------------+
bool DPCCBuildM05ExecutionProfileFromInputs(SDPCCExecutionControl &control,
      const SDPCCM05DirectInputs &direct,
      const bool verify_enabled,
      SDPCCM05OMPBProfile &profile,
      SDPCCM05VerifyProfile &verify_profile,
      float &lambda_price, float &huber_delta,
      float &rho_tolerance, string &reason)
  {
   ZeroMemory(profile);
   ZeroMemory(verify_profile);
   lambda_price = 0;
   huber_delta = 0;
   rho_tolerance = 0;
   reason = "";
   const double finite_values[] = {(double)direct.tau, (double)direct.lambda_dis, (double)direct.lambda_kl, (
      double)direct.lambda_alpha,
                                   (double)direct.alpha_prior, (double)direct.max_kl, (double)direct.lambda_price, (
                                      double)direct.huber_delta, (double)direct.rho_tolerance,
                                   direct.verify_atol, direct.verify_rtol, direct.verify_max_price_error,
                                      direct.verify_min_scenario_coverage
                                  };
   for(int i = 0; i < ArraySize(finite_values); i++)
      if(!MathIsValidNumber(finite_values[i]) || !MathIsValidNumber((float)finite_values[i]))
        {reason = "M05_INPUT.nonfinite"; return(false);}
   if(control.stage != DPCC_STAGE_STUDYFORECAST || direct.task_id == "" || direct.task_directory == "" ||
      direct.timeframe <= PERIOD_CURRENT || PeriodSeconds(direct.timeframe) <= 0 || direct.noise_seed == 0 ||
      direct.max_file_bytes == 0 || direct.latent_start <= 0 || direct.latent_end <= direct.latent_start ||
      direct.reference_start < direct.latent_start || direct.reference_end <= direct.reference_start ||
      direct.reference_end > direct.calibration_start || direct.calibration_end <= direct.calibration_start ||
      direct.calibration_end > direct.latent_end || direct.latent_epochs == 0 || direct.ompb_epochs == 0 ||
      direct.source_anchor_period == 0 || direct.rsi_period == 0 || direct.cci_period == 0 || direct.price_atr_period ==
         0 ||
      direct.fast_period == 0 || direct.slow_period == 0 || direct.signal_period == 0 ||
      !DPCCStudyForecastAppliedPriceValid((long)direct.rsi_price) ||
      !DPCCStudyForecastAppliedPriceValid((long)direct.cci_price) ||
      !DPCCStudyForecastAppliedPriceValid((long)direct.macd_price) || direct.price_joint_epochs == 0 ||
      direct.price_adapt_epochs == 0 || direct.lambda_price <= 0 || direct.huber_delta <= 0 ||
      direct.rho_tolerance <= 0 || direct.rho_tolerance >= 1 || direct.verify_atol <= 0 || direct.verify_rtol <= 0 ||
      direct.verify_max_price_error <= 0 || direct.verify_min_scenario_coverage <= 0 ||
      direct.verify_min_scenario_coverage > 1 || direct.verify_min_distinct_scenarios == 0 ||
      direct.verify_min_distinct_scenarios > 21)
     {reason = "M05_INPUT.domain"; return(false);}
//--- The shared AC-SRM parser validates an in-memory projection of its calibration preset.
   const string donor_prefix = "TimeFrame=" + EnumToString(direct.timeframe) + "\n" +
                               "RSIPeriod=" + (string)direct.rsi_period + "\nRSIPrice=" + (string)direct.rsi_price +
                                  "\n" +
                               "CCIPeriod=" + (string)direct.cci_period + "\nCCIPrice=" + (string)direct.cci_price +
                                  "\n" +
                               "ATRPeriod=" + (string)direct.price_atr_period + "\nFastPeriod=" + (
                                  string)direct.fast_period + "\n" +
                               "SlowPeriod=" + (string)direct.slow_period + "\nSignalPeriod=" + (
                                  string)direct.signal_period + "\n" +
                               "MACDPrice=" + (string)direct.macd_price + "\nInpStart=" + (string)(
                                  long)direct.latent_start + "\n" +
                               "InpEnd=" + (string)(long)direct.latent_end + "\nInpEpochs=" + (
                                  string)direct.latent_epochs + "\n";
   const string donor_tail = "InpOMPBSmoke=false\nInpOMPBEpochs=" + (string)direct.ompb_epochs + "\n" +
                             "InpOMPBReferenceStart=" + (string)(long)direct.reference_start + "\n" +
                             "InpOMPBReferenceEnd=" + (string)(long)direct.reference_end + "\n" +
                             "InpOMPBCalibrationStart=" + (string)(long)direct.calibration_start + "\n" +
                             "InpOMPBCalibrationEnd=" + (string)(long)direct.calibration_end + "\n" +
                             "InpOMPBSourcePeriod=" + (string)direct.source_anchor_period + "\n" +
                             "InpOMPBTau=" + StringFormat("%.9g", (double)direct.tau) + "\n" +
                             "InpOMPBLambdaDis=" + StringFormat("%.9g", (double)direct.lambda_dis) + "\n" +
                             "InpOMPBLambdaKL=" + StringFormat("%.9g", (double)direct.lambda_kl) + "\n" +
                             "InpOMPBLambdaAlpha=" + StringFormat("%.9g", (double)direct.lambda_alpha) + "\n" +
                             "InpOMPBAlphaPrior=" + StringFormat("%.9g", (double)direct.alpha_prior) + "\n" +
                             "InpOMPBMaxKL=" + StringFormat("%.9g", (double)direct.max_kl) + "\n" +
                             "InpRecoverySmoke=false\nInpRecoverySmokeBatches=2000\nInpRecoverySmokeAge=512\n";
   const string market_source = donor_prefix + "InpOMPBStage=1\n" + donor_tail;
   const string calibration_source = donor_prefix + "InpOMPBStage=2\n" + donor_tail;
   SDPCCM05OMPBProfile market_donor, calibration_donor;
   if(!DPCCParseM05DonorPreset(market_source, market_donor, reason, 1) ||
      !DPCCParseM05DonorPreset(calibration_source, calibration_donor, reason, 2))
     {reason = "M05_INPUT.AC_SRM_adapter:" + reason; return(false);}
   if(market_donor.rsi_price != calibration_donor.rsi_price ||
      market_donor.cci_price != calibration_donor.cci_price || market_donor.macd_price != calibration_donor.macd_price)
     {reason = "M05_INPUT.AC_SRM_stage_mismatch"; return(false);}
   string market_donor_sha = "", calibration_donor_sha = "";
   if(!DPCCCheckpointTextSHA(market_source, market_donor_sha, reason) ||
      !DPCCCheckpointTextSHA(calibration_source, calibration_donor_sha, reason))
      return(false);
   profile = calibration_donor;
   profile.noise_seed = direct.noise_seed;
   profile.price_joint_epochs = direct.price_joint_epochs;
   profile.price_joint_max_updates = direct.price_joint_max_updates;
   profile.price_adapt_epochs = direct.price_adapt_epochs;
   profile.price_adapt_max_updates = direct.price_adapt_max_updates;
   profile.market_preset_path = "EA_INPUTS/AC-SRM/StudyForecast";
   profile.market_preset_sha256 = market_donor_sha;
   profile.calibration_preset_path = "EA_INPUTS/AC-SRM/02Calibration";
   profile.calibration_preset_sha256 = calibration_donor_sha;
   profile.raw_sha256 = "";
   lambda_price = direct.lambda_price;
   huber_delta = direct.huber_delta;
   rho_tolerance = direct.rho_tolerance;
   verify_profile.atol = direct.verify_atol;
   verify_profile.rtol = direct.verify_rtol;
   verify_profile.max_price_error = direct.verify_max_price_error;
   verify_profile.min_scenario_coverage = direct.verify_min_scenario_coverage;
   verify_profile.min_distinct_scenarios = direct.verify_min_distinct_scenarios;
   verify_profile.has_max_price_error = verify_enabled;
   verify_profile.has_min_scenario_coverage = verify_enabled;
   verify_profile.has_min_distinct_scenarios = verify_enabled;
   const string profile_text = "{\"contract_id\":" + DPCCExecutionJSONString(DPCC_AP_CONTRACT) +
                               ",\"revision\":\"CNET_ACTION6_20261014\",\"profile_kind\":\"USER_ASSIGNED\"" +
                               ",\"task_id\":" + DPCCExecutionJSONString(direct.task_id) +
                               ",\"symbol_source\":\"CHART_SYMBOL\",\"timeframe\":" + DPCCExecutionJSONString(
                                  EnumToString(direct.timeframe)) +
                               ",\"shape\":{},\"diffusion\":{\"seed\":" + (string)direct.noise_seed + "}" +
                               ",\"price\":{\"atr_period\":" + (string)direct.price_atr_period +
                               ",\"lambda_price\":" + StringFormat("%.9g", (double)direct.lambda_price) +
                               ",\"huber_delta\":" + StringFormat("%.9g", (double)direct.huber_delta) +
                               ",\"rho_tolerance\":" + StringFormat("%.9g", (double)direct.rho_tolerance) + "}" +
                               ",\"action\":{},\"projection\":{},\"numeric\":{\"atol\":" + DoubleToString(
                                  direct.verify_atol, 9) +
                               ",\"rtol\":" + DoubleToString(direct.verify_rtol, 9) + "},\"data\":{},\"finance\":{}" +
                               ",\"templates\":{},\"limits\":{\"max_price_error\":" + DoubleToString(
                                  direct.verify_max_price_error, 9) +
                               ",\"min_scenario_coverage\":" + DoubleToString(direct.verify_min_scenario_coverage, 9) +
                               ",\"min_distinct_scenarios\":" + (string)direct.verify_min_distinct_scenarios + "}" +
                               ",\"persistence\":{\"task_directory\":" + DPCCExecutionJSONString(
                                  direct.task_directory) +
                               ",\"max_file_bytes\":" + (string)direct.max_file_bytes + "},\"acceptance\":{}" +
                               ",\"condition\":{\"normalization_source\":\"DIRECT_Z_ACCOUNT_IDENTITY_V1\"" +
                               ",\"scale\":" + DPCCM05IdentityVectorJSON(1.0f) + ",\"bias\":" +
                                  DPCCM05IdentityVectorJSON(0.0f) + "}" +
                               ",\"donor\":{\"market_preset\":{\"file\":\"EA_INPUTS/AC-SRM/StudyForecast\",\"sha256\":\"" + market_donor_sha + "\"}" +
                               ",\"ompb_calibration_preset\":{\"file\":\"EA_INPUTS/AC-SRM/02Calibration\",\"sha256\":\"" + calibration_donor_sha + "\"}}" +
                               ",\"market_phases\":{\"latent_prepare\":{\"start\":" + (string)(
                                  long)direct.latent_start +
                               ",\"end\":" + (string)(long)direct.latent_end + ",\"epochs\":" + (
                                  string)direct.latent_epochs + "}" +
                               ",\"price_joint\":{\"epochs\":" + (string)direct.price_joint_epochs +
                               ",\"max_updates\":" + (string)direct.price_joint_max_updates + "}" +
                               ",\"ompb_calibrate\":{\"epochs\":" + (string)direct.ompb_epochs +
                               ",\"source_anchor_period\":" + (string)direct.source_anchor_period + "}" +
                               ",\"price_adapt\":{\"epochs\":" + (string)direct.price_adapt_epochs +
                               ",\"max_updates\":" + (string)direct.price_adapt_max_updates + "}}" +
                               ",\"resource_target\":{}}";
   string assigned_sha = "", market_sha = "";
   CDPCCJsonDocument document;
   if(!DPCCCheckpointTextSHA(profile_text, assigned_sha, reason) || !document.Parse(profile_text, reason) ||
      !DPCCExecutionMarketProfileSHA(document, document.Root(), market_sha, reason))
     {reason = "M05_INPUT.profile:" + reason; return(false);}
   control.profile_text = profile_text;
   control.profile_sha256 = assigned_sha;
   control.market_profile_sha256 = market_sha;
   control.task_id = direct.task_id;
   profile.assigned_profile_sha256 = assigned_sha;
   profile.market_profile_sha256 = market_sha;
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Encode metadata strings without changing their UTF-8 contents    |
//+------------------------------------------------------------------+
string DPCCAPJSONString(const string value)
  {
   return(DPCCExecutionJSONString(value));
  }
//+------------------------------------------------------------------+
//| Describe the actual native graph used by this Market writer      |
//+------------------------------------------------------------------+
bool DPCCAPM05Graph(CNet &model, const int count, string &graph, string &reason)
  {
   graph = "[";
   for(int i = 0; i < count; i++)
     {
      CNeuronBaseOCL *layer = model.Layer(i);
      if(!layer)
        {
         reason = "M05_SAVE.graph.layer_missing";
         return(false);
        }
      uint abi = 0;
      if(layer.Type() == defNeuronScenarioForecastPriceOCL)
        {
         CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(layer);
         if(!price)
            return(false);
         abi = price.ABI();
        }
      else
         if(layer.Type() == defNeuronScenarioDecoderOCL)
           {
            CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(layer);
            if(!decoder)
               return(false);
            abi = decoder.ABI();
           }
      if(i > 0)
         graph += ",";
      CLayerDescription *description = layer.GetLayerInfo();
      if(!description)
        {
         reason = "M05_SAVE.graph.description_missing";
         return(false);
        }
      graph += "{\"index\":" + (string)i + ",\"type\":" + (string)layer.Type() +
               ",\"abi\":" + (string)abi + ",\"neurons\":" + (string)layer.Neurons() +
               ",\"count\":" + (string)description.count + ",\"window\":" + (string)description.window +
               ",\"window_out\":" + (string)description.window_out + ",\"step\":" + (string)description.step +
               ",\"layers\":" + (string)description.layers + ",\"batch\":" + (string)description.batch +
               ",\"variables\":" + (string)description.variables +
               ",\"activation\":" + (string)description.activation +
               ",\"optimization\":" + (string)description.optimization +
               ",\"probability\":" + StringFormat("%.9g", (double)description.probability) + ",\"units\":[";
      for(int j = 0; j < ArraySize(description.units); j++)
         graph += (j == 0 ? "" : ",") + (string)description.units[j];
      graph += "],\"windows\":[";
      for(int j = 0; j < ArraySize(description.windows); j++)
         graph += (j == 0 ? "" : ",") + (string)description.windows[j];
      graph += "],\"heads\":[";
      for(int j = 0; j < ArraySize(description.heads); j++)
         graph += (j == 0 ? "" : ",") + (string)description.heads[j];
      graph += "]}";
      delete description;
     }
   graph += "]";
   if(model.Layer(count) != NULL)
     {
      reason = "M05_SAVE.graph.extra_layer";
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Describe one native Trading CNet graph and its published layer   |
//| ABI                                                              |
//+------------------------------------------------------------------+
bool DPCCAPTradingGraph(CNet &model, const int count, string &graph, string &reason)
  {
   graph = "[";
   if(count < 2 || count > 16)
     {
      reason = "TRADING_SAVE.graph.count";
      return(false);
     }
   for(int i = 0; i < count; i++)
     {
      CNeuronBaseOCL *layer = model.Layer(i);
      CLayerDescription *description = (CheckPointer(layer) == POINTER_INVALID ? NULL : layer.GetLayerInfo());
      uint abi = 0;
      if(CheckPointer(layer) == POINTER_INVALID || CheckPointer(description) == POINTER_INVALID ||
         !DPCCAPNativeLayerABI(layer, description, abi))
        {
         if(CheckPointer(description) != POINTER_INVALID)
            delete description;
         reason = "TRADING_SAVE.graph.layer_or_abi";
         return(false);
        }
      if(i > 0)
         graph += ",";
      graph += "{\"index\":" + (string)i + ",\"type\":" + (string)layer.Type() +
               ",\"abi\":" + (string)abi + ",\"neurons\":" + (string)layer.Neurons() +
               ",\"count\":" + (string)description.count + ",\"window\":" + (string)description.window +
               ",\"window_out\":" + (string)description.window_out + ",\"step\":" + (string)description.step +
               ",\"layers\":" + (string)description.layers + ",\"batch\":" + (string)description.batch +
               ",\"variables\":" + (string)description.variables +
               ",\"activation\":" + (string)description.activation +
               ",\"optimization\":" + (string)description.optimization +
               ",\"probability\":" + StringFormat("%.9g", (double)description.probability) + ",\"units\":[";
      for(int j = 0; j < ArraySize(description.units); j++)
         graph += (j == 0 ? "" : ",") + (string)description.units[j];
      graph += "],\"windows\":[";
      for(int j = 0; j < ArraySize(description.windows); j++)
         graph += (j == 0 ? "" : ",") + (string)description.windows[j];
      graph += "],\"heads\":[";
      for(int j = 0; j < ArraySize(description.heads); j++)
         graph += (j == 0 ? "" : ",") + (string)description.heads[j];
      graph += "]}";
      delete description;
     }
   graph += "]";
   if(model.Layer(count) != NULL)
     {
      reason = "TRADING_SAVE.graph.extra_layer";
      return(false);
     }
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Hard-copy the same ABI3 Action6 roles into fresh frozen targets  |
//+------------------------------------------------------------------+
bool DPCCSyncAction6TradingTargets(CNet &market, CNet &actor, CNet &q1, CNet &q2,
                                   CNet &target_actor, CNet &target_q1, CNet &target_q2,
                                   string &reason)
  {
   reason = "";
   CNet *nets[] = {GetPointer(market), GetPointer(actor), GetPointer(q1), GetPointer(q2),
                   GetPointer(target_actor), GetPointer(target_q1), GetPointer(target_q2)
                  };
   const int layer_counts[] = {8, 2, 5, 5, 2, 5, 5};
   COpenCLMy *context = market.GetOpenCL();
   if(CheckPointer(context) == POINTER_INVALID || !market.IsOpenCLTransferReady() ||
      market.WeightsUpdateEnabled() || market.Layer(8) != NULL)
     {
      reason = "TRADING_SAVE.action6.market_context_or_frozen";
      return(false);
     }
   for(int i = 0; i < ArraySize(nets); i++)
     {
      if(CheckPointer(nets[i]) == POINTER_INVALID || !nets[i].IsOpenCLTransferReady() ||
         nets[i].GetOpenCL() != context)
        {
         reason = StringFormat("TRADING_SAVE.action6.net_context.%d", i);
         return(false);
        }
      for(int a = 0; a < layer_counts[i]; a++)
         if(CheckPointer(nets[i].Layer(a)) == POINTER_INVALID ||
            nets[i].Layer(a).GetOpenCL() != context || (i == 0 && nets[i].Layer(a).TrainMode()))
           {
            reason = StringFormat("TRADING_SAVE.action6.layer_context_or_market_train.%d", i);
            return(false);
           }
      for(int j = 0; j < i; j++)
        {
         if(nets[i] == nets[j])
           {
            reason = "TRADING_SAVE.action6.net_alias";
            return(false);
           }
         for(int a = 0; a < layer_counts[i]; a++)
            for(int b = 0; b < layer_counts[j]; b++)
               if(nets[i].Layer(a) == nets[j].Layer(b))
                 {
                  reason = "TRADING_SAVE.action6.layer_alias";
                  return(false);
                 }
        }
     }
   CNeuronDPCCOCL *online_top = dynamic_cast<CNeuronDPCCOCL*>(actor.Layer(1));
   CNeuronDPCCOCL *target_top = dynamic_cast<CNeuronDPCCOCL*>(target_actor.Layer(1));
   if(actor.Layer(2) != NULL || target_actor.Layer(2) != NULL || !online_top || !target_top ||
      online_top.Type() != defNeuronDPCCOCL || target_top.Type() != defNeuronDPCCOCL ||
      online_top.ActorABI() != 3 || target_top.ActorABI() != 3 ||
      online_top.GetOpenCL() != context || target_top.GetOpenCL() != context ||
      (online_top.LastStatus() != DPCC_OK &&
       online_top.LastStatus() != DPCC_NO_FEASIBLE_CANDIDATE) ||
      (target_top.LastStatus() != DPCC_OK &&
       target_top.LastStatus() != DPCC_NO_FEASIBLE_CANDIDATE) ||
      !NNQCriticGraph(GetPointer(q1)) || !NNQCriticGraph(GetPointer(q2)) ||
      !NNQCriticGraph(GetPointer(target_q1)) || !NNQCriticGraph(GetPointer(target_q2)))
     {
      reason = "TRADING_SAVE.action6.graph_contract";
      return(false);
     }
//--- Bind each Actor to the exact same Market and its corresponding Q pair.
//--- This public ABI3 check also clears any stale, unpublished decision state.
   if(!online_top.BindPolicyNetworks(GetPointer(market), GetPointer(q1), GetPointer(q2)) ||
      !target_top.BindPolicyNetworks(GetPointer(market), GetPointer(target_q1), GetPointer(target_q2)))
     {
      reason = "TRADING_SAVE.action6.policy_binding";
      return(false);
     }
   string actor_graph = "", target_actor_graph = "", q1_graph = "", target_q1_graph = "",
          q2_graph = "", target_q2_graph = "";
   if(!DPCCAPTradingGraph(actor, 2, actor_graph, reason) ||
      !DPCCAPTradingGraph(target_actor, 2, target_actor_graph, reason) ||
      !DPCCAPTradingGraph(q1, 5, q1_graph, reason) ||
      !DPCCAPTradingGraph(target_q1, 5, target_q1_graph, reason) ||
      !DPCCAPTradingGraph(q2, 5, q2_graph, reason) ||
      !DPCCAPTradingGraph(target_q2, 5, target_q2_graph, reason))
      return(false);
   if(actor_graph != target_actor_graph || q1_graph != target_q1_graph || q2_graph != target_q2_graph)
     {
      reason = "TRADING_SAVE.action6.target_graph_mismatch";
      return(false);
     }
//--- Freeze every target before copying. CNet::WeightsUpdate(tau=1) copies
//--- parameters without enabling training or modifying optimizer state.
   CNet *targets[] = {GetPointer(target_actor), GetPointer(target_q1), GetPointer(target_q2)};
   for(int i = 0; i < ArraySize(targets); i++)
     {
      const int target_layers = (i == 0 ? 2 : 5);
      if(!targets[i].TrainMode(false) || !targets[i].SetWeightsUpdate(false) ||
         targets[i].WeightsUpdateEnabled())
        {
         reason = StringFormat("TRADING_SAVE.action6.target_freeze.%d", i);
         return(false);
        }
      for(int l = 0; l < target_layers; l++)
         if(targets[i].Layer(l).TrainMode())
           {
            reason = StringFormat("TRADING_SAVE.action6.target_layer_train.%d.%d", i, l);
            return(false);
           }
     }
   if(!target_q1.WeightsUpdate(GetPointer(q1), 1.0f))
     {
      reason = "TRADING_SAVE.action6.target_q1_copy";
      return(false);
     }
   if(!target_q2.WeightsUpdate(GetPointer(q2), 1.0f))
     {
      reason = "TRADING_SAVE.action6.target_q2_copy";
      return(false);
     }
   if(!target_actor.WeightsUpdate(GetPointer(actor), 1.0f))
     {
      reason = "TRADING_SAVE.action6.target_actor_copy";
      return(false);
     }
   if(target_top.LastStatus() != DPCC_OK || target_actor.WeightsUpdateEnabled() ||
      target_q1.WeightsUpdateEnabled() || target_q2.WeightsUpdateEnabled())
     {
      reason = "TRADING_SAVE.action6.target_post_copy_state";
      return(false);
     }
   for(int i = 0; i < ArraySize(targets); i++)
     {
      const int target_layers = (i == 0 ? 2 : 5);
      for(int l = 0; l < target_layers; l++)
         if(targets[i].Layer(l).TrainMode())
           {
            reason = StringFormat("TRADING_SAVE.action6.target_post_copy_train.%d.%d", i, l);
            return(false);
           }
     }
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Stream a bounded metadata section directly into its role frame   |
//+------------------------------------------------------------------+
bool DPCCAPWriteJSON(CDPCCAPRoleWriter &writer, const uint section, const string text, string &reason)
  {
   CDPCCJsonDocument document;
   if(!document.Parse(text, reason))
      return(false);
   uchar bytes[];
   int length = StringToCharArray(text, bytes, 0, WHOLE_ARRAY, CP_UTF8);
   if(length <= 1 || length > 1048577)
     {
      reason = "dpccap.metadata.size";
      return(false);
     }
   if(bytes[length - 1] == 0)
      length--;
   int handle = INVALID_HANDLE;
   if(!writer.BeginSection(section, 1, handle, reason))
      return(false);
   if(FileWriteArray(handle, bytes, 0, length) != (uint)length)
     {
      reason = "dpccap.metadata.write";
      return(false);
     }
   return(writer.EndSection(reason));
  }
//+------------------------------------------------------------------+
//| Check an older Market generation using its recorded source ABI   |
//+------------------------------------------------------------------+
bool DPCCAPValidateMarketFile(const string path, const ulong maximum, string &reason)
  {
   const int handle = FileOpen(path, FILE_READ | FILE_BIN | FILE_COMMON);
   if(handle == INVALID_HANDLE)
     {
      reason = "M05_SAVE.existing.open";
      return(false);
     }
   uchar header[];
   SDPCCAPSection sections[];
   const bool valid = (DPCCAPReadRecord(handle, 0, DPCC_AP_HEADER_BYTES, header, reason) &&
                       DPCCAPValidateHandle(handle, 1, DPCCAPReadSHA(header, 40), maximum, 64, sections, reason));
   FileClose(handle);
   return(valid);
  }
//+------------------------------------------------------------------+
//| Accept only a complete Trading frame with its six native roles   |
//+------------------------------------------------------------------+
bool DPCCAPValidateTradingFile(const string path, const bool common, const ulong maximum, string &reason)
  {
   reason = "";
   const int common_flag = (common ? FILE_COMMON : 0);
   const int handle = FileOpen(path, FILE_READ | FILE_BIN | common_flag);
   if(handle == INVALID_HANDLE)
     {
      reason = "TRADING_SAVE.existing.open";
      return(false);
     }
   uchar header[];
   SDPCCAPSection sections[];
   bool valid = DPCCAPReadRecord(handle, 0, DPCC_AP_HEADER_BYTES, header, reason) &&
                DPCCAPMagic(header, 0, "DPCCAP01") && DPCCAPReadUnsigned(header, 12, 4) == 2 &&
                DPCCAPValidateHandle(handle, 2, DPCCAPReadSHA(header, 40), maximum, 8, sections, reason) &&
                ArraySize(sections) == 8;
   if(valid)
     {
      const uint expected_ids[] = {1, 110, 111, 112, 113, 114, 115, 200};
      for(int i = 0; i < 8; i++)
         if(sections[i].id != expected_ids[i] ||
            sections[i].encoding != (i == 0 || i == 7 ? 1 : 2))
           {
            valid = false;
            reason = "TRADING_SAVE.existing.sections";
            break;
           }
     }
   if(valid)
     {
      uchar bytes[];
      string text = "";
      const int length = (int)sections[0].length;
      if(length <= 0 || length > 1048576 || ArrayResize(bytes, length) != length ||
         !FileSeek(handle, (long)sections[0].offset, SEEK_SET) ||
         FileReadArray(handle, bytes, 0, length) != (uint)length ||
         !DPCCStrictUtf8Decode(bytes, length, 1048576, text, reason))
        {
         valid = false;
         if(reason == "")
            reason = "TRADING_SAVE.existing.manifest_read";
        }
      else
        {
         CDPCCJsonDocument document;
         if(!document.Parse(text, reason))
           {
            valid = false;
            FileClose(handle);
            return(false);
           }
         const int root = document.Root();
         string contract = "", revision = "", role = "", source_abi = "", market_dependency = "";
         const string header_abi = DPCCAPReadSHA(header, 40);
         if(!DPCCResourceReadString(document, root, "contract_id", contract, reason, "trading.manifest.contract") ||
            !DPCCResourceReadString(document, root, "revision", revision, reason, "trading.manifest.revision") ||
            !DPCCResourceReadString(document, root, "role", role, reason, "trading.manifest.role") ||
            !DPCCResourceReadString(document, root, "source_abi_sha256", source_abi, reason, "trading.manifest.abi") ||
            !DPCCResourceReadString(document, root, "market_dependency_sha256", market_dependency, reason,
                                    "trading.manifest.market_dependency") ||
            contract != DPCC_AP_CONTRACT || revision != DPCC_TRADING_REVISION || role != "Trading" ||
            source_abi != header_abi || !DPCCResolverLowerSha256(market_dependency))
           {
            valid = false;
            if(reason == "")
               reason = "TRADING_SAVE.existing.manifest_binding";
           }
        }
     }
   FileClose(handle);
   return(valid);
  }
//+------------------------------------------------------------------+
//| Publish six roles once under the shared current/backup writer    |
//| lock                                                             |
//+------------------------------------------------------------------+
bool DPCCAPSaveTradingGeneration(const string directory, const bool common, const ulong maximum,
                                 const string source_abi, const string manifest_text, const string resume_text,
                                 CNet &actor, CNet &q1, CNet &q2, CNet &target_actor, CNet &target_q1, CNet &target_q2,
                                 const string source_path, const string source_sha,
                                 string &output_path, string &output_sha, string &reason)
  {
   output_path = "";
   output_sha = "";
   reason = "";
   const string current = directory + "/Trading.current.dpc";
   const string backup = directory + "/Trading.bak.dpc";
   const string lock_path = directory + "/Trading.writer.lock";
   string canonical = "";
   if(!DPCCCheckpointCanonicalPath(current, canonical, reason) || canonical != current ||
      !DPCCCheckpointCanonicalPath(backup, canonical, reason) || canonical != backup ||
      !DPCCCheckpointCanonicalPath(lock_path, canonical, reason) || canonical != lock_path ||
      (source_path != "" && source_path != current && source_path != backup) ||
      (source_path == "" ? source_sha != "" : !DPCCResolverLowerSha256(source_sha)))
     {
      reason = "TRADING_SAVE.canonical_or_source_binding:" + reason;
      return(false);
     }
   CDPCCJsonDocument json;
   if(!json.Parse(manifest_text, reason) || !json.Parse(resume_text, reason))
      return(false);
   const int common_flag = (common ? FILE_COMMON : 0);
   const int lock = FileOpen(lock_path, FILE_READ | FILE_WRITE | FILE_BIN | common_flag);
   if(lock == INVALID_HANDLE)
     {
      reason = "TRADING_SAVE.writer_lock";
      return(false);
     }
   CDPCCAPRoleWriter writer;
   bool saved = false;
   do
     {
      //--- Recheck the loaded source after obtaining exclusive publication ownership.
      if(source_path != "")
        {
         string observed = "";
         if(!DPCCCheckpointFileSHA(source_path, common, maximum, observed, reason) || observed != source_sha)
           {
            reason = "TRADING_SAVE.loaded_generation_changed:" + reason;
            break;
           }
        }
      if(FileIsExist(current, common_flag))
        {
         string current_reason = "";
         if(DPCCAPValidateTradingFile(current, common, maximum, current_reason))
           {
            if(source_path == backup)
              {
               reason = "TRADING_SAVE.new_current_supersedes_loaded_backup";
               break;
              }
            if(!FileMove(current, common_flag, backup, common_flag | FILE_REWRITE))
              {
               reason = "TRADING_SAVE.current_to_bak";
               break;
              }
           }
         else
           {
            if(!FileIsExist(backup, common_flag) || !DPCCAPValidateTradingFile(backup, common, maximum, reason))
              {
               reason = "TRADING_SAVE.current_invalid_without_valid_bak:" + current_reason;
               break;
              }
            if(!FileDelete(current, common_flag))
              {
               reason = "TRADING_SAVE.invalid_current_remove";
               break;
              }
           }
        }
      CNet *roles[] = {GetPointer(actor), GetPointer(q1), GetPointer(q2), GetPointer(target_actor),
                       GetPointer(target_q1), GetPointer(target_q2)
                      };
      if(!writer.Open(current, common, 2, source_abi, 8, maximum, reason) ||
         !DPCCAPWriteJSON(writer, 1, manifest_text, reason))
         break;
      bool roles_written = true;
      for(int role = 0; role < 6 && roles_written; role++)
         roles_written = writer.WriteTradingNativeSection((uint)(110 + role), *roles[role], reason);
      if(!roles_written || !DPCCAPWriteJSON(writer, 200, resume_text, reason) || !writer.Finish(reason))
         break;
      if(!DPCCCheckpointFileSHA(current, common, maximum, output_sha, reason))
         break;
      output_path = current;
      saved = true;
     }
   while(false);
   writer.Close();
   FileClose(lock);
   return(saved);
  }
//+------------------------------------------------------------------+
//| Frozen Market prefix that preserves the loaded Decoder layer     |
//+------------------------------------------------------------------+
class CDPCCMarketCNet : public CNet
  {
private:
   bool              m_prefix_failed;
public:
                     CDPCCMarketCNet(void) : m_prefix_failed(false) {}
   //+------------------------------------------------------------------+
   //| Run only the existing encoder layers on one admitted input       |
   //+------------------------------------------------------------------+
   bool              ForwardEncoderPrefix(CBufferFloat *market_input, string &reason)
     {
      reason = "";
      if(m_prefix_failed || IsStopped() || !IsOpenCLTransferReady() || bWeightsUpdate ||
         CheckPointer(opencl) == POINTER_INVALID || CheckPointer(layers) == POINTER_INVALID ||
         layers.Total() != 8 || CheckPointer(market_input) == POINTER_INVALID)
        {
         reason = "market_prefix.owner_or_boundary";
         return(false);
        }
      CNeuronBaseOCL *nodes[7];
      const int types[] = {defNeuronBaseOCL, defNeuronBatchNormOCL, defNeuronDropoutOCL,
                           defNeuronCogDriverData, defNeuronCogDriverRankTCM, defNeuronOMPBOCL,
                           defNeuronScenarioForecastPriceOCL
                          };
      for(int i = 0; i < 7; i++)
        {
         CLayer *layer = dynamic_cast<CLayer*>(layers.At(i));
         if(!layer || layer.Total() != 1)
           {
            reason = "market_prefix.layer_shape." + (string)i;
            return(false);
           }
         nodes[i] = dynamic_cast<CNeuronBaseOCL*>(layer.At(0));
         if(!nodes[i] || nodes[i].Type() != types[i] || nodes[i].GetOpenCL() != opencl ||
            nodes[i].TrainMode() || (i > 0 && !nodes[i].CanStartForward()))
           {
            reason = "market_prefix.layer_policy." + (string)i;
            return(false);
           }
         if(nodes[i].OwnsBufferOrDeviceSlot(market_input))
           {
            reason = "market_prefix.input_alias." + (string)i;
            return(false);
           }
        }
      CNeuronScenarioForecastPriceOCL *forecast = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(nodes[6]);
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(nodes[5]);
      CBufferFloat *destination = nodes[0].getOutput();
      const ulong count = (ulong)nodes[0].Neurons();
      if(!forecast || forecast.ABI() != defScenarioForecastPriceABI || forecast.CodebookUpdate() ||
         forecast.PricePhase() != defForecastPriceVerify || !ompb || ompb.Mode() != OMPB_INFERENCE ||
         ompb.SourceAnchor() || !NNQValid(opencl, market_input, count) || market_input.Total() != (int)count ||
         !NNQValid(opencl, destination, count) || destination.Total() != (int)count)
        {
         reason = "market_prefix.input_or_forecast_contract";
         return(false);
        }
      //--- The phase setter rejects a still-live Forecast frame before trunk state can advance.
      if(!forecast.SetPricePhase(defForecastPriceVerify))
        {
         reason = "market_prefix.forecast_frame_pending";
         return(false);
        }
      const int copy_kernel = def_k_CopyBufferRaw;
      const uint copy_offset[] = {0};
      const uint copy_size[] = {(uint)count};
      if(!opencl.SetArgumentBuffer(copy_kernel, 0, market_input.GetIndex()))
        {
         m_prefix_failed = true;
         reason = "market_prefix.input_copy.source_argument";
         return(false);
        }
      if(!opencl.SetArgumentBuffer(copy_kernel, 1, destination.GetIndex()))
        {
         m_prefix_failed = true;
         reason = "market_prefix.input_copy.destination_argument";
         return(false);
        }
      if(!opencl.SetArgument(copy_kernel, 2, (int)count))
        {
         m_prefix_failed = true;
         reason = "market_prefix.input_copy.count_argument";
         return(false);
        }
      if(!opencl.Execute(copy_kernel, 1, copy_offset, copy_size))
        {
         m_prefix_failed = true;
         reason = "market_prefix.input_copy.execute";
         return(false);
        }
      for(int i = 1; i < 7; i++)
        {
         if(IsStopped() || !nodes[i].FeedForward(nodes[i - 1]))
           {
            m_prefix_failed = true;
            reason = "market_prefix.forward." + (string)i;
            return(false);
           }
        }
      return(true);
     }
  };
//+------------------------------------------------------------------+
//| Declaration CDPCCStudyForecastCore                               |
//+------------------------------------------------------------------+
class CDPCCStudyForecastCore
  {
private:
   CDPCCMarketCNet        m_market;
   CNet                   m_target;
   CDPCCStudyForecastGradientOps m_gradient_ops;
   SDPCCStudyForecastBar  m_bars[];
   int                    m_fit[], m_holdout[], m_latent_fit[];
   uint                   m_latent_epochs_completed;
   CBufferFloat           m_state, m_future, m_future_latent, m_zero, m_negative, m_delta;
   ulong                  m_updates;
   int                    m_cursor, m_holdout_cursor, m_fit_limit;
   uint                   m_max_updates;
   string                 m_raw_sha, m_root;
   bool                   m_ready, m_finished, m_failed, m_epoch_started, m_full_run, m_holdout_started;
   double                 m_holdout_latent, m_holdout_valid, m_holdout_invalid;
   ulong                  m_holdout_market_fingerprint, m_holdout_target_fingerprint;
   ulong                  m_decoder_market_fingerprint, m_decoder_target_fingerprint;
   bool                   m_restore_only;
   bool                   m_encoder_only;
   ulong                  m_teacher_initial_fingerprint;
   bool                   m_z_available;
