      (statistics_source == "FIT_FIXED" && !examples.CheckFixedPriceNorm(fixed_profile, fit_receipt.data_cutoff,
         reason)) ||
      !decoder_plan.Admit(admitted, DPCC_ROLE_DECODER, candidate.config.shape.J, examples, candidate.validation_repeat,
                          candidate.decoder_fit, candidate.decoder_validation, candidate.decoder_plan_sha, reason) ||
      !denoiser_plan.Admit(admitted, DPCC_ROLE_DENOISER, candidate.config.shape.J, examples,
         candidate.validation_repeat,
                           candidate.denoiser_fit, candidate.denoiser_validation, candidate.denoiser_plan_sha, reason))
      return(false);
   const int outputs = envelope.FindMember(root, "outputs");
   if(!DPCCStageOutputPath(envelope, outputs, "checkpoint_stem", candidate.package_root, candidate.containing_json,
      candidate.checkpoint_stem, reason) ||
      !DPCCStageOutputPath(envelope, outputs, "result_path", candidate.package_root, candidate.containing_json,
         candidate.result_path, reason) ||
      !DPCCStageReadUnsigned(envelope, root, "maximum_checkpoint_bytes", ULONG_MAX, candidate.maximum_checkpoint_bytes,
         reason) || candidate.maximum_checkpoint_bytes == 0)
      return(DPCCStageBlocked(reason, "output_capacity_paths"));
   if(phase == "OFFLINE_ORACLE" &&
      (!DPCCStageReadOfflineOutputs(envelope, outputs, candidate.package_root, candidate.containing_json,
                                    common_files, candidate, reason) ||
       !DPCCStageAdmitOfflineClock(candidate.package_root, common_files, candidate, reason)))
      return(false);
   if(phase != "DECODER_TRAIN")
     {
      SDPCCArtifactResolveResult boundary, selected;
      string ignored = "";
      if(!DPCCStageResolve(envelope, root, "boundary", candidate.package_root, candidate.containing_json, common_files,
         boundary, ignored, reason) ||
         !DPCCStageResolve(envelope, root, "selected_decoder", candidate.package_root, candidate.containing_json,
            common_files, selected, ignored, reason))
         return(false);
      candidate.boundary_path = boundary.canonical_path;
      candidate.boundary_sha = boundary.observed_sha256;
      candidate.selected_decoder_path = selected.canonical_path;
      candidate.selected_decoder_sha = selected.observed_sha256;
      if(phase == "OFFLINE_ORACLE" && candidate.offline_policy.decoder_sha256 != selected.observed_sha256)
         return(DPCCStageBlocked(reason, "offline_frozen_decoder_binding"));
      //--- Consumer's fresh owner replay checks authority/role/full native history.
     }
   if(phase == "ASSEMBLE")
     {
      if(!DPCCStageOutputPath(envelope, outputs, "actor_path", candidate.package_root, candidate.containing_json,
         candidate.actor_path, reason))
         return(DPCCStageBlocked(reason, "assembly_actor_output"));
      if(statistics_source == "FIT_FIXED")
        {
         candidate.normalization_record = -1;
        }
      else
         if(statistics_source == "INPUT_WINDOW")
           {
            ulong index = 0;
            if(!DPCCStageReadUnsigned(envelope, root, "normalization_record", INT_MAX, index, reason) || index >= (
               ulong)materialized_count)
               return(DPCCStageBlocked(reason, "assembly_causal_record_output"));
            candidate.normalization_record = (int)index;
           }
         else
            return(DPCCStageBlocked(reason, "normalization_source_unsupported"));
     }
//--- Recheck trusted envelope immediately before publication. Linked immutable
//--- artifacts are re-resolved again by the executing owner, never DTO-authorized.
   if(!DPCCReadArtifactBytes(normalized, common_files, DPCC_RESOLVER_MAX_JSON_BYTES, bytes, reason) ||
      !DPCCSHA256Lower(bytes, observed, reason) || observed != expected_sha)
      return(DPCCStageBlocked(reason, "envelope_changed"));
   if(retain_online_records)
     {
      if(phase != "OFFLINE_ORACLE")
         return(DPCCStageBlocked(reason, "online_record_phase"));
      if(ArrayResize(candidate.online_records, materialized_count) != materialized_count)
         return(DPCCStageBlocked(reason, "online_record_capacity"));
      if(ArrayResize(candidate.online_witnesses, materialized_count) != materialized_count)
         return(DPCCStageBlocked(reason, "online_witness_capacity"));
      for(int i = 0; i < materialized_count; i++)
        {
         if(!examples.CopyAdmittedRecord(i, candidate.online_records[i], reason))
            return(false);
         if(!DPCCStageOfflineWitness(candidate.online_records[i], candidate.keys[i],
                                     candidate.online_witnesses[i], reason))
            return(false);
        }
     }
   out = candidate;
   loaded_phase = phase;
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCLoadStudyStageInput                                 |
//+------------------------------------------------------------------+
bool DPCCLoadStudyStageInput(const string path, const string expected_sha, const bool common_files,
                             SDPCCStudyStageInput &out, string &loaded_phase, string &reason)
  {
   const bool accepted = DPCCLoadStudyStageInputImpl(path, expected_sha, common_files, out, loaded_phase, reason);
   if(!accepted && StringFind(reason, "BLOCKED:") != 0 && StringFind(reason, "FAIL:") != 0)
      reason = "BLOCKED:study_input." + reason;
   return(accepted);
  }
//+------------------------------------------------------------------+
//| Retain admitted rows from the existing loader transaction        |
//+------------------------------------------------------------------+
bool DPCCLoadStudyStageInput(const string path, const string expected_sha, const bool common_files,
                             SDPCCStudyStageInput &out, string &loaded_phase, string &reason,
                             const bool retain_online_records)
  {
   const bool accepted = DPCCLoadStudyStageInputImpl(path, expected_sha, common_files, out, loaded_phase, reason,
                         retain_online_records);
   if(!accepted && StringFind(reason, "BLOCKED:") != 0 && StringFind(reason, "FAIL:") != 0)
      reason = "BLOCKED:study_input." + reason;
   return(accepted);
  }
//--- Fixed requested API. A dispatch consumer should use the overload above and
//--- compare its local loaded_phase against the stage it is about to execute.
bool DPCCLoadStudyStageInput(const string path, const string expected_sha, const bool common_files,
                             SDPCCStudyStageInput &out, string &reason)
  {
   string loaded_phase = "";
   return(DPCCLoadStudyStageInput(path, expected_sha, common_files, out, loaded_phase, reason));
  }
//+------------------------------------------------------------------+
//| Build one financial row from pinned raw and indexed clock        |
//+------------------------------------------------------------------+
bool DPCCBuildOracleHistoryRow(const SDPCCOracleHistoryInput &source, const int position,
                               CDPCCMarketClock &clock, SDPCCOracleHistoryRow &out, string &reason)
  {
   ZeroMemory(out);
   if(position < 0 || position >= ArraySize(source.fit_indices) ||
      ArraySize(source.fit_indices) != ArraySize(source.decision_bars))
      return(DPCCStageBlocked(reason, "history.row.index_shape"));
   out.decision_bar = source.decision_bars[position];
   if(!DPCCBuildHistoricalFinancialRow(source.config, source.financial_profile, source.raw_bars,
                                       source.fit_indices[position], out.decision_bar, position == 0, clock,
                                          out.context, out.native_ohlc,
                                       out.timeline_opens, out.timeline_closes, reason))
      return(false);
   out.time_domain = clock.TimeDomain();
   return(DPCCOfflineValidateFiniteFloats(out.context, reason));
  }
//+------------------------------------------------------------------+
//| DPCCLoadOracleHistoryInput loads Study inputs and derives        |
//| provenance                                                       |
//+------------------------------------------------------------------+
bool DPCCLoadOracleHistoryInput(const string package_root_relative, const datetime training_start,
   const datetime training_end,
                                const SDPCCRuntimeConfig &runtime, const float &limits[],
                                const string raw_path, const string output_stem_relative,
                                const float &coordinate_deltas[], const bool common_files,
                                const ENUM_TIMEFRAMES timeframe,
                                const string market_path, const string market_profile_text,
                                const SDPCCAPNativeLoadContract &market_contract,
                                SDPCCOracleHistoryInput &out, string &reason)
  {
   ZeroMemory(out);
   reason = "";
   string root_path = "", container = "StudyInput.runtime.json";
   if(training_start <= 0 || training_end <= training_start || ArraySize(coordinate_deltas) != 6 || ArraySize(limits) !=
      24 ||
      !DPCCResolverPreparePath(package_root_relative, root_path, reason, "history.package") ||
      !DPCCNormalizePackagePath(root_path, container, output_stem_relative, out.output_stem, reason) ||
      ArrayCopy(out.deltas, coordinate_deltas) != 6)
      return(DPCCStageBlocked(reason, "history.direct_inputs"));
   if(timeframe <= PERIOD_CURRENT || PeriodSeconds(timeframe) <= 0 ||
      !DPCCValidateFixedConfig(runtime.financial.shape, runtime.financial) ||
      ArraySize(runtime.beta) != (int)runtime.financial.shape.J + 1 ||
      ArraySize(runtime.alpha_bar) != (int)runtime.financial.shape.J + 1 ||
      ArraySize(runtime.sigma) != (int)runtime.financial.shape.J + 1 ||
      market_path == "")
     {reason = "history.direct_runtime_or_market"; return(false);}
   CDPCCJsonDocument market_profile;
   string profile_sha = "", market_scope_sha = "";
   if(!DPCCCheckpointTextSHA(market_profile_text, profile_sha, reason) ||
      profile_sha != market_contract.profile_sha256 || !market_profile.Parse(market_profile_text, reason) ||
      !DPCCExecutionMarketProfileSHA(market_profile, market_profile.Root(), market_scope_sha, reason) ||
      market_scope_sha != market_contract.market_profile_sha256)
     {reason = "history.market_profile_binding:" + reason; return(false);}
   out.clock.package_root = root_path;
   out.clock.containing_json = container;
   out.clock.offline_clock_server_calendar = true;
   out.config = runtime.financial;
   if(ArrayCopy(out.actor_beta, runtime.beta) != ArraySize(runtime.beta) ||
      ArrayCopy(out.actor_alpha_bar, runtime.alpha_bar) != ArraySize(runtime.alpha_bar) ||
      ArrayCopy(out.actor_sigma, runtime.sigma) != ArraySize(runtime.sigma) ||
      !DPCCEncodeAction6ModelRuntime(runtime, limits, out.model_text, reason) ||
      !DPCCCheckpointTextSHA(out.model_text, out.model_sha, reason))
      return(DPCCStageBlocked(reason, "history.runtime_metadata"));
//--- Read the complete source once; later stages consume these decoded bars directly.
   int fit[], holdout[];
   string source_indicator_params = "";
   long raw_successor = 0;
   string source_server = "", source_symbol = "", source_timeframe = "";
   if(!DPCCReadStudyForecastRawEx(raw_path, "", out.raw_bars, out.raw_sha, raw_successor, reason,
                                  source_server, source_symbol, source_timeframe, source_indicator_params, common_files,
                                     "", false, false, false))
     {
      if(reason == "")
         reason = "raw_decode_or_structure";
      Print("DPCC_STUDY_RAW_INPUT_FAIL phase=decode reason=", reason);
      return(DPCCStageBlocked(reason, "history.raw_input"));
     }
   out.source_server = source_server;
   out.raw_sha = "";
   out.raw_successor_open_server = raw_successor;
   out.raw_indicator_params = source_indicator_params;
   out.timeframe = timeframe;
   if(!DPCCCheckpointCanonicalPath(raw_path, out.raw_path, reason))
      return(DPCCStageBlocked(reason, "history.raw_path"));
   if(!DPCCBuildStudyForecastSplits(out.raw_bars, fit, holdout, reason, true, training_start, training_end) ||
      !DPCCFilterStudyForecastPriceTargets(out.raw_bars, out.raw_bars[0].chart_quote_mode,
                                           out.raw_bars[0].raw_version == 3, fit, holdout, reason, timeframe))
     {
      if(reason == "")
         reason = "raw_split_or_target_filter";
      Print("DPCC_STUDY_RAW_INPUT_FAIL phase=split_filter reason=", reason);
      return(DPCCStageBlocked(reason, "history.raw_input"));
     }
//--- Financial context uses the selected terminal symbol and current native properties.
   SDPCCExecutionProfileSnapshot execution;
   string execution_payload = "";
   if(!DPCCCaptureExecutionProfile(_Symbol, timeframe, "", 0, execution, execution_payload,
                                   out.execution_sha, reason, true))
      return(false);
   if(!DPCCSupportedHistoricalNativeExecution(execution, out.config.margin_fx_profile))
      return(DPCCStageBlocked(reason, "history.execution.symbol_server_currency"));
   if(!DPCCPrepareHistoricalFinancialProfile(out.config, limits, execution, execution_payload, true, false,
         out.financial_profile, reason, out.clock.offline_clock_server_calendar, true))
      return(false);
   if(!DPCCPrepareHistoricalFxCloses(out.config, execution, out.raw_bars, timeframe, out.financial_profile, reason))
      return(false);
   out.execution_sha = out.financial_profile.sha256;
   const int count = ArraySize(fit);
   if(ArrayCopy(out.fit_indices, fit) != count || ArrayResize(out.decision_bars, count) != count)
      return(DPCCStageBlocked(reason, "history.stream.capacity"));
   for(int i = 0; i < count; i++)
      out.decision_bars[i] = fit[i];
   const string recipe_path = out.output_stem + ".financial_profile." + out.financial_profile.sha256 + ".txt";
   if(!FileIsExist(recipe_path, common_files ? FILE_COMMON : 0))
      if(!DPCCCheckpointWriteText(recipe_path, common_files, out.financial_profile.payload, reason))
         return(false);
   string recipe_sha = "";
   if(!DPCCCheckpointFileSHA(recipe_path, common_files, 1048576, recipe_sha, reason) ||
      recipe_sha != out.financial_profile.sha256)
      return(DPCCStageBlocked(reason, "history.profile.receipt_changed"));
   out.rows_sha = out.financial_profile.sha256;
//--- Only the derived financial recipe is a file-backed source; runtime settings came from EA inputs.
   const int source_count = 1;
   if(ArrayResize(out.source_labels, source_count) != source_count ||
      ArrayResize(out.source_paths, source_count) != source_count || ArrayResize(out.source_hashes, source_count) !=
         source_count)
      return(DPCCStageBlocked(reason, "history.provenance.capacity"));
   out.source_labels[0] = "derived_financial_profile";
   if(!DPCCCheckpointCanonicalPath(recipe_path, out.source_paths[0], reason))
      return(false);
   out.source_hashes[0] = out.financial_profile.sha256;
   string current = "";
   if(!DPCCCheckpointFileSHA(out.source_paths[0], common_files, DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES,
                             current, reason) || current != out.source_hashes[0])
     {reason = "BLOCKED:study.history.provenance.source_changed.derived_financial_profile:" + reason; return(false);}
   if(!DPCCOracleHistoryConfigSHA(out.config, out.config_sha, reason) ||
      !DPCCOracleHistoryDeltasSHA(out.deltas, out.deltas_sha, reason))
      return(false);
   reason = "";
   return(true);
  }

#endif
#ifndef DPCC_STUDY_STAGE_CONSUMER_MQH
#define DPCC_STUDY_STAGE_CONSUMER_MQH
//+------------------------------------------------------------------+
//| StudyForecastCore.mqh                                            |
//+------------------------------------------------------------------+
//--- Native Oracle-history training consumer; admission remains the existing loader.
class CDPCCStudyStageConsumer
  {
private:
   bool              m_initialized, m_failed;
   //--- Encoder outlives every native policy/rollout borrowing its context.
   CDPCCStudyForecastCore m_forecast;
   //--- Declared after m_forecast so this device buffer is released before its context owner.
   CBufferFloat      m_z_latent;
   CBufferFloat      m_action6_snapshot_work, m_action6_context_work, m_action6_flags_work, m_action6_status_work;
   CNet              m_offline_factual, m_offline_scoring;
   SDPCCConfig       m_offline_config;
   CNet              m_z_actor, m_z_q1, m_z_q2;
   //--- Action6 owns only the trainable policy graphs; Market/context are borrowed from m_forecast.
   CNet              *m_action6_actor, *m_action6_q1, *m_action6_q2;
   SDPCCRuntimeConfig m_action6_runtime;
   bool              m_action6_history;
   string            m_action6_market_sha, m_action6_market_data_sha, m_action6_profile_sha;
   string            m_action6_market_path, m_action6_profile_text, m_action6_task_id;
   ulong             m_action6_market_max_bytes;
   bool              m_z_history, m_z_floor;
   uint              m_z_step, m_z_rows, m_z_resume_cursor;
   long              m_z_last_bar, m_z_first_server_bar, m_z_next_server_bar;
   string            m_z_resume_manifest, m_z_resume_sha;
   float             m_z_state[], m_z_deltas[];
   SDPCCSimulatedPositionMetadata m_z_position;
   string            m_z_raw_sha, m_z_raw_path, m_z_receipt_sha;
   string            m_z_output_stem;
   string            m_z_source_labels[], m_z_source_paths[], m_z_source_hashes[];
   string            m_z_model_text, m_z_model_sha;
   string            m_z_config_sha, m_z_deltas_sha, m_z_execution_sha, m_z_time_domain, m_z_account_currency;
   uint              m_z_account_currency_digits;
   bool              m_z_provenance_bound, m_z_common_files;
   bool              Fail(const string cause, string &reason)
     {
      m_failed = true;
      reason = (StringLen(cause) > 0 ? cause : "study.operation_failed");
      return(false);
     }
   bool              SameFinancialProfileExceptSnapshotTimesAndTerminalBuild(const string older, const string current,
      string &reason)
     {
      string payloads[2], normalized[2];
      payloads[0] = older;
      payloads[1] = current;
      normalized[0] = "";
      normalized[1] = "";
      bool has_terminal_build[2];
      ArrayInitialize(has_terminal_build, false);
      for(int which = 0; which < 2; which++)
        {
         int pos = 0;
         while(pos < StringLen(payloads[which]))
           {
            const int end = StringFind(payloads[which], "\n", pos);
            if(end < pos)
              {
               reason = "study.history.restore.profile_line_termination";
               return(false);
              }
            const string line = StringSubstr(payloads[which], pos, end - pos);
            const int first = StringFind(line, "|"), second = (first < 0 ? -1 : StringFind(line, "|", first + 1));
            ulong declared = 0;
            if(first <= 0 || second <= first + 1 ||
               !DPCCCheckpointReadUnsigned(StringSubstr(line, first + 1, second - first - 1), 1048576, declared) ||
               StringLen(StringSubstr(line, second + 1)) != (int)declared)
              {reason = "study.history.restore.profile_record"; return(false);}
            const string key = StringSubstr(line, 0, first), value = StringSubstr(line, second + 1);
            if(key == "clock_mapping_id" || key == "snapshot_time_utc_epoch" ||
               key == "snapshot_time_utc" || key == "snapshot_time_server")
              {
               //--- Legacy/volatile clock metadata is provenance, not a model compatibility gate.
              }
            else
               if(key == "terminal_build")
                 {
                  ulong build = 0;
                  if(has_terminal_build[which] ||
                     !DPCCCheckpointReadUnsigned(value, (ulong)LONG_MAX, build) || build == 0)
                    {reason = "study.history.restore.profile_terminal_build"; return(false);}
                  has_terminal_build[which] = true;
                  normalized[which] += "terminal_build|<validated terminal build>\n";
                 }
               else
                  normalized[which] += StringSubstr(payloads[which], pos, end - pos + 1);
            pos = end + 1;
           }
         if(!has_terminal_build[which])
           {reason = "study.history.restore.profile_terminal_build"; return(false);}
        }
      if(normalized[0] != normalized[1])
        {reason = "study.history.restore.profile_non_exception_difference"; return(false);}
      reason = "";
      return(true);
     }
   bool              Action6TrainingPaths(const string base, const bool common_files,
                             string &actor_path, string &q1_path, string &q2_path,
                             string &manifest_path, string &reason)
     {
      actor_path = "";
      q1_path = "";
      q2_path = "";
      manifest_path = "";
      string canonical = "";
      if(base == "" || StringLen(base) > 220 ||
         !DPCCCheckpointCanonicalPath(base, canonical, reason) || canonical != base)
        {
         reason = "study.action6.training_state_path";
         return(false);
        }
      actor_path = base + ".actor.dpct";
      q1_path = base + ".q1.dpct";
      q2_path = base + ".q2.dpct";
      manifest_path = base + ".manifest";
      string paths[4];
      paths[0] = actor_path;
      paths[1] = q1_path;
      paths[2] = q2_path;
      paths[3] = manifest_path;
      for(int i = 0; i < ArraySize(paths); i++)
         if(!DPCCCheckpointCanonicalPath(paths[i], canonical, reason) || canonical != paths[i])
           {
            reason = "study.action6.training_state_path";
            return(false);
           }
      int slash = StringFind(base, "/");
      while(slash > 0)
        {
         FolderCreate(StringSubstr(base, 0, slash), common_files ? FILE_COMMON : 0);
         slash = StringFind(base, "/", slash + 1);
        }
      reason = "";
      return(true);
     }
   bool              Action6SavePolicyState(CNet *net, const string path, const bool common_files,
                               string &sha, string &reason)
     {
      sha = "";
      if(CheckPointer(net) == POINTER_INVALID)
        {
         reason = "study.action6.training_state.network";
         return(false);
        }
      ResetLastError();
      const int handle = FileOpen(path, FILE_WRITE | FILE_BIN | (common_files ? FILE_COMMON : 0));
      if(handle == INVALID_HANDLE)
        {
         reason = StringFormat("study.action6.training_state.open.%d", GetLastError());
         return(false);
        }
      ResetLastError();
      CNeuronDPCCOCL *action6_actor = dynamic_cast<CNeuronDPCCOCL*>(net.Layer(1));
      bool saved = false;
      if(CheckPointer(action6_actor) != POINTER_INVALID && action6_actor.Type() == defNeuronDPCCOCL &&
         action6_actor.ActorABI() == 3 && net.Layer(2) == NULL)
         saved = action6_actor.Save(handle);
      else
         saved = net.Save(handle);
      FileFlush(handle);
      saved = saved && GetLastError() == 0;
      FileClose(handle);
      if(!saved || !DPCCCheckpointFileSHA(path, common_files, 536870912, sha, reason))
        {
         if(reason == "")
            reason = "study.action6.training_state.write";
         return(false);
        }
      return(true);
     }
   bool              Action6LoadPolicyState(CNet *net, const string path, const bool common_files,
                               string &reason)
     {
      if(CheckPointer(net) == POINTER_INVALID)
        {
         reason = "study.action6.training_state.network";
         return(false);
        }
      ResetLastError();
      const int handle = FileOpen(path, FILE_READ | FILE_BIN | FILE_SHARE_READ |
                                  (common_files ? FILE_COMMON : 0));
      if(handle == INVALID_HANDLE)
        {
         reason = StringFormat("study.action6.training_state.open.%d", GetLastError());
         return(false);
        }
      CNeuronDPCCOCL *action6_actor = dynamic_cast<CNeuronDPCCOCL*>(net.Layer(1));
      const bool action6_actor_graph = (CheckPointer(action6_actor) != POINTER_INVALID &&
                                        action6_actor.Type() == defNeuronDPCCOCL && action6_actor.ActorABI() == 3 &&
                                           net.Layer(2) == NULL);
      bool loaded = false;
      if(action6_actor_graph)
        {
         //--- The direct Actor save includes its layer type; CNeuronDPCCOCL::Load expects CLayer to consume it.
         if(FileTell(handle) + INT_VALUE > FileSize(handle) ||
            FileReadInteger(handle, INT_VALUE) != (int)action6_actor.Type())
           {
            FileClose(handle);
            reason = "study.action6.training_state.actor_type_prefix";
            return(false);
           }
         const bool actor_loaded = action6_actor.Load(handle);
         const int actor_status = (int)action6_actor.LastStatus();
         const ulong actor_offset = FileTell(handle);
         const bool actor_complete = (actor_loaded && FileTell(handle) == FileSize(handle) && GetLastError() == 0);
         loaded = actor_loaded && actor_complete;
         if(loaded && (!net.TrainMode(true) || !net.SetWeightsUpdate(true)))
           {
            loaded = false;
            reason = "study.action6.training_state.trainable_restore";
           }
         FileClose(handle);
         if(!actor_loaded)
            reason = StringFormat("study.action6.training_state.actor_layer_load.status_%d.offset_%I64u",
                                  actor_status, actor_offset);
         else
            if(!actor_complete)
               reason = "study.action6.training_state.actor_file_end";
        }
      else
        {
         //--- CNet::Load owns and closes the file handle after reading the network.
         if(!net.IsOpenCLTransferReady())
           {
            FileClose(handle);
            reason = "study.action6.training_state.cnet_transfer_not_ready";
           }
         else
           {
            loaded = net.Load(handle);
            if(!loaded)
               reason = "study.action6.training_state.cnet_layer_load";
           }
        }
      if(!loaded)
        {
         if(reason == "")
            reason = "study.action6.training_state.restore";
         return(false);
        }
      return(true);
     }
   bool              Action6ManifestNextLine(const string &source, int &position, string &line)
     {
      line = "";
      const int end = StringFind(source, "\n", position);
      if(end < position)
         return(false);
      line = StringSubstr(source, position, end - position);
      position = end + 1;
      return(true);
     }
   bool              Action6ParseTrainingManifest(const string &source, string &actor_sha,
                                     string &q1_sha, string &q2_sha, string &reason)
     {
      actor_sha = "";
      q1_sha = "";
      q2_sha = "";
      int position = 0;
      string lines[5];
      for(int i = 0; i < ArraySize(lines); i++)
         if(!Action6ManifestNextLine(source, position, lines[i]))
           {
            reason = "study.action6.training_state.manifest_lines";
            return(false);
           }
      if(position != StringLen(source) || lines[0] != "DPCC_ACTION6_TRAINING_STATE_V1" ||
         lines[4] != "END_DPCC_ACTION6_TRAINING_STATE_V1" ||
         !DPCCResolverLowerSha256(lines[1]) || !DPCCResolverLowerSha256(lines[2]) ||
         !DPCCResolverLowerSha256(lines[3]))
        {
         reason = "study.action6.training_state.manifest_format";
         return(false);
        }
      actor_sha = lines[1];
      q1_sha = lines[2];
      q2_sha = lines[3];
      reason = "";
      return(true);
     }
public:
                     CDPCCStudyStageConsumer(void)
     {
      m_initialized = false;
      m_failed = false;
      m_z_history = false;
      m_action6_actor = NULL;
      m_action6_q1 = NULL;
      m_action6_q2 = NULL;
      m_action6_history = false;
      m_action6_market_sha = "";
      m_action6_profile_sha = "";
      m_action6_market_path = "";
      m_action6_profile_text = "";
      m_z_model_text = "";
      m_z_model_sha = "";
      m_action6_task_id = "";
      m_action6_market_max_bytes = 0;
      m_z_output_stem = "";
      m_z_provenance_bound = false;
      m_z_common_files = false;
      m_z_floor = false;
      m_z_step = 0;
      m_z_rows = 0;
      m_z_resume_cursor = 0;
      m_z_resume_manifest = "";
      m_z_resume_sha = "";
      m_z_last_bar = -1;
      m_z_first_server_bar = 0;
      m_z_next_server_bar = 0;
      m_z_account_currency = "";
      m_z_account_currency_digits = 0;
      ZeroMemory(m_z_position);
     }
                    ~CDPCCStudyStageConsumer(void)
     {
      if(CheckPointer(m_action6_actor) != POINTER_INVALID)
         delete m_action6_actor;
      if(CheckPointer(m_action6_q2) != POINTER_INVALID)
         delete m_action6_q2;
      if(CheckPointer(m_action6_q1) != POINTER_INVALID)
         delete m_action6_q1;
     }
   //+------------------------------------------------------------------+
   //| Reset transient policy/account state after one full history pass |
   //+------------------------------------------------------------------+
   bool              BeginAction6HistoryPass(string &reason)
     {
      reason = "";
      if(!m_initialized || m_failed || !m_action6_history || !m_z_history ||
         !m_z_provenance_bound || m_z_rows == 0 || m_z_step != m_z_rows || m_z_floor ||
         CheckPointer(m_action6_actor) == POINTER_INVALID ||
         CheckPointer(m_action6_q1) == POINTER_INVALID ||
         CheckPointer(m_action6_q2) == POINTER_INVALID)
        {
         reason = "study.action6.history_pass.requires_complete_prior_pass";
         return(false);
        }
      CNeuronDPCCOCL *actor_layer = dynamic_cast<CNeuronDPCCOCL*>(m_action6_actor.Layer(1));
      CNeuronBaseOCL *q1_last = m_action6_q1.Layer(-1);
      CNeuronBaseOCL *q2_last = m_action6_q2.Layer(-1);
      if(CheckPointer(actor_layer) == POINTER_INVALID || actor_layer.Type() != defNeuronDPCCOCL ||
         actor_layer.ActorABI() != 3 || !actor_layer.CanStartForward() ||
         CheckPointer(q1_last) == POINTER_INVALID || CheckPointer(q2_last) == POINTER_INVALID ||
         !q1_last.CanStartForward() || !q2_last.CanStartForward())
        {
         reason = "study.action6.history_pass.pending_policy_generation";
         return(false);
        }
      //--- The forecast owner rejects a live Market generation before its
      //--- recurrent buffers are reset. Policy Clear methods are transient-only:
      //--- ABI3 Actor clears execution state and frame-mode denoiser slots;
      //--- CNet::Clear preserves trainable parameters and optimizer moments.
      if(!m_forecast.ResetReadyEncoderHistoryPass(reason))
         return(false);
      if(!m_action6_actor.Clear() || !m_action6_q1.Clear() || !m_action6_q2.Clear())
        {
         reason = "study.action6.history_pass.policy_clear";
         return(false);
        }
      ArrayInitialize(m_z_state, 0.0f);
      ZeroMemory(m_z_position);
      m_z_floor = false;
      m_z_step = 0;
      m_z_resume_cursor = 0;
      m_z_resume_manifest = "";
      m_z_resume_sha = "";
      m_z_last_bar = -1;
      m_z_first_server_bar = 0;
      m_z_next_server_bar = 0;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Restore a profile-bound Market and initialize native Action6/Qs  |
   //+------------------------------------------------------------------+
   bool              InitializeAction6History(const SDPCCConfig &config, const uint rows, const float &deltas[],
                                 const double &beta[], const double &alpha_bar[], const double &sigma[],
                                 const ENUM_DPCC_MODE selected_mode,
                                 const ENUM_TIMEFRAMES timeframe, const SDPCCStudyForecastBar &raw_bars[],
                                 const string raw_server, const string raw_indicator_params,
                                 const long raw_successor, const string raw_path, const string market_profile_text,
                                 const string market_path,
                                 const SDPCCAPNativeLoadContract &market_contract,
                                 const float &condition_scale[], const float &condition_bias[],
                                 const bool common_files, string &reason)
     {
      SDPCCConfig operational = config;
      operational.mode = selected_mode;
      string canonical_market = "", canonical_profile = "", assigned_profile_sha = "", profile_text = market_profile_text;
      uchar profile_bytes[];
      if(!DPCCCheckpointCanonicalPath(market_path, canonical_market, reason) || canonical_market != market_path ||
         profile_text == "" ||
         !DPCCCheckpointTextSHA(profile_text, assigned_profile_sha, reason) ||
         assigned_profile_sha != market_contract.profile_sha256)
         return(Fail("BLOCKED:study.action6.market_profile_input_binding:" + reason, reason));
      CDPCCJsonDocument assigned_profile;
      string market_profile_sha = "";
      if(!assigned_profile.Parse(profile_text, reason) ||
         !DPCCExecutionMarketProfileSHA(assigned_profile, assigned_profile.Root(), market_profile_sha, reason) ||
         market_profile_sha != market_contract.market_profile_sha256 ||
         !DPCCResolverLowerSha256(market_contract.profile_sha256))
         return(Fail("BLOCKED:study.action6.market_profile_stage_binding:" + reason, reason));
      if(m_initialized || m_failed || rows == 0 || rows > 16777216 || ArraySize(deltas) != 6 ||
         selected_mode < DPCC_P0 || selected_mode > DPCC_P2 ||
         timeframe <= PERIOD_CURRENT || PeriodSeconds(timeframe) <= 0 ||
         !DPCCValidateFixedConfig(operational.shape, operational) || config.shape.K != 21 || config.shape.H != 12 ||
         market_path == "" || market_contract.role != 1 || market_contract.section_id != 100 ||
         market_contract.task_id == "" || market_contract.stage == "" ||
         !m_forecast.RestoreReadyEncoderFromBars(market_path, common_files, raw_bars, raw_server,
               raw_indicator_params, raw_successor, timeframe, market_contract, reason, true))
         return(Fail(reason == "" ? "BLOCKED:study.action6.market_profile_binding" : reason, reason));
      for(int i = 0; i < 6; i++)
         if(!MathIsValidNumber(deltas[i]) || deltas[i] <= 0 || deltas[i] > 1)
            return(Fail("study.action6.oracle_delta", reason));
      CNet *market = m_forecast.ReadyMarketNetwork();
      COpenCLMy *context = m_forecast.ReadyEncoderContext();
      if(CheckPointer(market) == POINTER_INVALID || CheckPointer(context) == POINTER_INVALID ||
         market.GetOpenCL() != context || !market.IsOpenCLTransferReady() || market.WeightsUpdateEnabled())
         return(Fail("BLOCKED:study.action6.frozen_market_unavailable", reason));
      string market_sha = "";
      if(!DPCCCheckpointFileSHA(market_path, common_files, market_contract.max_native_bytes, market_sha, reason) ||
         !DPCCResolverLowerSha256(market_sha) ||
         !DPCCResolverLowerSha256(market_contract.profile_sha256))
         return(Fail("BLOCKED:study.action6.market_identity:" + reason, reason));
      SDPCCLayout action_layout;
      if(!DPCCBuildRolloutLayout(config.shape, action_layout) ||
         action_layout.offsets[7] > (ulong)INT_MAX || action_layout.total > (ulong)INT_MAX ||
         action_layout.offsets[7] < action_layout.lengths[0] ||
         !m_action6_snapshot_work.BufferInit((uint)(action_layout.offsets[7] - action_layout.lengths[0]), 0) ||
         !m_action6_context_work.BufferInit((uint)action_layout.total, 0) ||
         !m_action6_flags_work.BufferInit((uint)action_layout.total, 0) ||
         !m_action6_status_work.BufferInit(1, 0) ||
         !m_action6_snapshot_work.BufferCreate(context) || !m_action6_context_work.BufferCreate(context) ||
         !m_action6_flags_work.BufferCreate(context) || !m_action6_status_work.BufferCreate(context))
         return(Fail("study.action6.context_workspace", reason));
      SDPCCConfig physical = config;
      physical.shape.K = 1;
      physical.shape.M = 1;
      physical.shape.Depth = 0;
      if(!DPCCCreateHistoricalRolloutNet(m_offline_factual, physical, context, reason) ||
         !DPCCCreateHistoricalRolloutNet(m_offline_scoring, physical, context, reason))
         return(Fail("study.action6.rollout_graph:" + reason, reason));
      SDPCCRuntimeConfig runtime;
      ZeroMemory(runtime);
      runtime.financial = operational;
      if(ArraySize(beta) != (int)config.shape.J + 1 || ArraySize(alpha_bar) != (int)config.shape.J + 1 ||
         ArraySize(sigma) != (int)config.shape.J + 1 ||
         ArraySize(condition_scale) != 109 || ArraySize(condition_bias) != 109 ||
         ArrayCopy(runtime.beta, beta) != ArraySize(beta) ||
         ArrayCopy(runtime.alpha_bar, alpha_bar) != ArraySize(alpha_bar) ||
         ArrayCopy(runtime.sigma, sigma) != ArraySize(sigma))
         return(Fail("study.action6.runtime_schedule_capacity", reason));
      for(int i = 0; i < 109; i++)
        {
         if(!MathIsValidNumber(condition_scale[i]) || condition_scale[i] <= 0 ||
            !MathIsValidNumber(condition_bias[i]))
            return(Fail(StringFormat("BLOCKED:study.action6.condition_profile_%d", i), reason));
         runtime.condition_scale[i] = condition_scale[i];
         runtime.condition_bias[i] = condition_bias[i];
        }
      CNet *q1 = NULL, *q2 = NULL, *actor = NULL;
      if(!DPCCCreateAction6CriticNet(q1, market, reason) ||
         !DPCCCreateAction6CriticNet(q2, market, reason))
        {
         if(CheckPointer(q2) != POINTER_INVALID)
            delete q2;
         if(CheckPointer(q1) != POINTER_INVALID)
            delete q1;
         return(Fail("study.action6.critic_graph:" + reason, reason));
        }
      CNeuronDPCCOCL *top = NULL;
      if(!DPCCCreateAction6ActorNet(actor, runtime, market, q1, q2, top, reason))
        {
         delete q2;
         delete q1;
         return(Fail("study.action6.actor_graph:" + reason, reason));
        }
      if(!actor.TrainMode(true) || !actor.SetWeightsUpdate(true) ||
         !q1.TrainMode(true) || !q1.SetWeightsUpdate(true) ||
         !q2.TrainMode(true) || !q2.SetWeightsUpdate(true))
        {
         delete actor;
         delete q2;
         delete q1;
         return(Fail("study.action6.trainable_graph", reason));
        }
      m_action6_actor = actor;
      m_action6_q1 = q1;
      m_action6_q2 = q2;
      if(!m_z_latent.BufferInit(21 * 9 * 12 * 16, 0) || !m_z_latent.BufferCreate(context))
         return(Fail("study.action6.market_latent_buffer", reason));
      if(ArrayCopy(m_z_deltas, deltas) != 6)
         return(Fail("study.action6.delta_capacity", reason));
      m_offline_config = operational;
      m_z_rows = rows;
      m_z_raw_sha = "";
      m_z_raw_path = raw_path;
      m_z_receipt_sha = "";
      m_action6_market_sha = market_sha;
      m_action6_market_data_sha = market_contract.data_sha256;
      m_action6_profile_sha = assigned_profile_sha;
      m_action6_market_path = market_path;
      m_action6_profile_text = profile_text;
      m_action6_task_id = market_contract.task_id;
      m_action6_market_max_bytes = market_contract.max_native_bytes;
      m_action6_runtime.financial = operational;
      if(ArrayCopy(m_action6_runtime.beta, beta) != ArraySize(beta) ||
         ArrayCopy(m_action6_runtime.alpha_bar, alpha_bar) != ArraySize(alpha_bar) ||
         ArrayCopy(m_action6_runtime.sigma, sigma) != ArraySize(sigma) ||
         ArrayCopy(m_action6_runtime.condition_scale, condition_scale) != 109 ||
         ArrayCopy(m_action6_runtime.condition_bias, condition_bias) != 109)
         return(Fail("study.action6.runtime_profile_copy", reason));
      m_z_common_files = common_files;
      m_z_history = true;
      m_action6_history = true;
      m_initialized = true;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Train one Action6 row and commit only its first operation        |
   //+------------------------------------------------------------------+
   bool              StepAction6History(CDPCCMarketClock &clock, const SDPCCOracleHistoryRow &row,
                           SDPCCOfflineRowResult &out, string &reason)
     {
      DPCCClearOfflineRowResult(out);
      const int horizon = (int)m_offline_config.shape.H;
      if(!m_action6_history || !m_initialized || m_failed || !m_z_provenance_bound || m_z_floor ||
         CheckPointer(m_action6_actor) == POINTER_INVALID || CheckPointer(m_action6_q1) == POINTER_INVALID ||
         CheckPointer(m_action6_q2) == POINTER_INVALID || m_z_step >= m_z_rows ||
         clock.TimeDomain() != m_z_time_domain || row.decision_bar < 0 ||
         (m_z_step > 0 && row.decision_bar != m_z_last_bar + 1) ||
         ArraySize(row.native_ohlc) != horizon * 4 || ArraySize(row.timeline_opens) != horizon ||
         ArraySize(row.timeline_closes) != horizon)
         return(Fail("study.action6.row_boundary", reason));
      long opens[], closes[], ordinals[];
      if(ArrayResize(opens, horizon) != horizon || ArrayResize(closes, horizon) != horizon ||
         ArrayResize(ordinals, horizon) != horizon)
         return(Fail("study.action6.time_capacity", reason));
      for(int h = 0; h < horizon; h++)
        {
         SDPCCClockBar bar;
         long open_time = 0, close_time = 0;
         if(!clock.IndexedTimelineBar(row.decision_bar + h, bar, open_time, close_time, reason) ||
            bar.ordinal != row.decision_bar + h || open_time != row.timeline_opens[h] ||
            close_time != row.timeline_closes[h])
            return(Fail("study.action6.time_join:" + reason, reason));
         opens[h] = bar.server_open;
         closes[h] = bar.server_close;
         ordinals[h] = bar.ordinal;
        }
      int raw_index = -1;
      if(!m_forecast.RawIndexForServerOpen(opens[0], false, raw_index, reason) ||
         !m_forecast.MatchesNativeOHLC(raw_index, row.native_ohlc, opens, reason))
         return(Fail("study.action6.raw_horizon_join:" + reason, reason));
      float context[];
      SDPCCLayout source_layout, unused_layout;
      uint tokens = 0;
      if(!DPCCCompositeLayouts(m_offline_config.shape, source_layout, unused_layout, tokens) ||
         ArraySize(row.context) != (int)source_layout.offsets[10] ||
         ArrayCopy(context, row.context) != ArraySize(row.context))
         return(Fail("study.action6.financial_context_shape", reason));
      if(m_z_step == 0)
        {
         SDPCCSnapshotMeta seed_meta;
         ZeroMemory(seed_meta);
         seed_meta.account_currency = m_z_account_currency;
         if(m_z_account_currency == "" ||
            !DPCCBuildHistoricalFlatSeed(1000, m_z_account_currency, m_z_account_currency_digits,
                                         seed_meta, m_offline_config, m_offline_config.shape, context, row.native_ohlc,
                                         m_z_state, m_z_position, reason))
            return(Fail(reason == "" ? "BLOCKED:study.action6.account_seed" : reason, reason));
        }
      for(int i = 0; i < 24; i++)
         context[(int)source_layout.offsets[4] + i] = m_z_state[i];
      if(!DPCCBindHistoricalFxReference(m_offline_config.shape, context, m_z_state, reason))
         return(Fail(reason, reason));
      float step_values[];
      ENUM_SYMBOL_CALC_MODE calculation = SYMBOL_CALC_MODE_FOREX;
      if(!DPCCBuildHistoricalBarStepValues(m_offline_config.shape, context, row.native_ohlc,
                                           row.decision_bar, opens, closes, ordinals, row.timeline_opens[0],
                                              row.timeline_closes[0],
                                           step_values, calculation, reason))
         return(Fail(reason, reason));
      CNeuronScenarioRolloutOCL *native =
         dynamic_cast<CNeuronScenarioRolloutOCL *>(m_offline_factual.Layer(1));
      CBufferFloat prior;
      SDPCCHistoricalPreparedBar prepared;
      if(!native || !DPCCPrepareHistoricalBar(*native, step_values, row.decision_bar,
                                              (ulong)row.decision_bar + 1, opens[0], closes[0], row.timeline_opens[0],
                                              row.timeline_closes[0], calculation, m_z_state, m_z_position, m_z_step,
                                              m_z_rows + horizon - 1, m_z_step == 0, prior, prepared, reason, false,
                                                 clock.TimeDomain()))
         return(Fail(reason, reason));
      //--- Causal Action6 input is Market's current forecast plus prepared Account13.
      ulong generation = 0;
      if(!m_forecast.InferReadyMarketScenario(opens[0], GetPointer(m_z_latent), generation, reason))
         return(Fail("study.action6.market_infer:" + reason, reason));
      CNet *market = m_forecast.ReadyMarketNetwork();
      CBufferFloat *predicted_ohlc = m_forecast.ReadyMarketNativeOHLC();
      if(CheckPointer(market) == POINTER_INVALID || CheckPointer(predicted_ohlc) == POINTER_INVALID ||
         generation == 0 || predicted_ohlc.GetOpenCL() != m_forecast.ReadyEncoderContext())
         return(Fail("study.action6.market_generation", reason));
      float account24[24], instrument48[48], limits24[24], execution24[24], event_counts[], calendar[];
      for(int i = 0; i < 24; i++)
        {
         account24[i] = prepared.state[i];
         instrument48[i] = context[(int)source_layout.offsets[5] + i];
         instrument48[24 + i] = context[(int)source_layout.offsets[5] + 24 + i];
         limits24[i] = context[(int)source_layout.offsets[6] + i];
         execution24[i] = context[(int)source_layout.offsets[7] + i];
        }
      //--- Bind the current decision's FX margin reference to the newly observed Ask.
      instrument48[14] = account24[16];
      if(ArrayResize(event_counts, horizon) != horizon ||
         ArrayResize(calendar, horizon * (int)m_offline_config.shape.E * 6) != horizon * (
            int)m_offline_config.shape.E * 6)
         return(Fail("study.action6.condition_capacity", reason));
      for(int h = 0; h < horizon; h++)
        {
         event_counts[h] = context[(int)source_layout.offsets[8] + h];
         const int source = (int)source_layout.offsets[9] + h * (int)m_offline_config.shape.E * 6;
         for(int j = 0; j < (int)m_offline_config.shape.E * 6; j++)
            calendar[h * (int)m_offline_config.shape.E * 6 + j] = context[source + j];
        }
      CBufferFloat *action_context = NULL;
      if(!DPCCBuildDecisionFinancialContext(m_offline_config, predicted_ohlc, account24, instrument48,
                                            limits24, execution24, row.timeline_opens[0], row.timeline_opens[0],
                                               row.timeline_opens,
                                            row.timeline_closes, event_counts, calendar, m_action6_snapshot_work,
                                               m_action6_context_work,
                                            m_action6_flags_work, m_action6_status_work, action_context, reason) ||
         CheckPointer(action_context) == POINTER_INVALID)
         return(Fail("study.action6.decision_context:" + reason, reason));
      const ulong decision_id = (ulong)row.decision_bar + 1;
      SDPCCDecisionMeta meta;
      ZeroMemory(meta);
      meta.decision_id = decision_id;
      meta.market_state_id = generation;
      meta.q1_state_id = decision_id;
      meta.q2_state_id = decision_id + 1;
      meta.noise_seed = decision_id;
      meta.decision_server_time = row.timeline_opens[0];
      meta.bar_index = row.decision_bar;
      meta.mode = (uint)m_offline_config.mode;
      meta.market_sha256 = m_action6_market_sha;
      meta.profile_sha256 = m_action6_profile_sha;
      CNeuronDPCCOCL *actor_top = dynamic_cast<CNeuronDPCCOCL*>(m_action6_actor.Layer(1));
      if(!actor_top || !actor_top.BindDecisionContext(action_context, meta))
         return(Fail("study.action6.bind_decision_context", reason));
      CBufferFloat actor_account;
      if(!actor_account.BufferInit(13, 0))
         return(Fail("study.action6.account_input", reason));
      for(int i = 0; i < 13; i++)
         if(!actor_account.Update(i, prepared.account13[i]))
            return(Fail("study.action6.account_input_value", reason));
      const bool actor_forward = m_action6_actor.feedForward(GetPointer(actor_account), 1, false, market, 6);
      const bool no_feasible_actor = !actor_top.HasValidDecision() &&
                                     actor_top.LastStatus() == DPCC_NO_FEASIBLE_CANDIDATE;
      if(!actor_forward ||
         (!no_feasible_actor && (actor_top.LastStatus() != DPCC_OK || !actor_top.HasValidDecision())))
         return(Fail(StringFormat("study.action6.actor_forward.status_%d", (int)actor_top.LastStatus()), reason));
      uint selected_candidate = UINT_MAX, plan_candidates = 0, plan_horizon = 0;
      COpenCLMy *actor_context = actor_top.GetOpenCL();
      CBufferFloat *candidate_buffer = NULL;
      float seed[], candidate_plans[], teacher_plan[], causal_action_plan[], no_trade_plan[];
      const ulong plan_stride = (ulong)horizon * 6;
      if(CheckPointer(actor_context) == POINTER_INVALID || plan_stride == 0 || plan_stride > UINT_MAX)
         return(Fail("study.action6.actor_plan_context_or_stride", reason));
      if(no_feasible_actor)
        {
         if(!actor_top.GetCheckedPlans(candidate_buffer) ||
            CheckPointer(candidate_buffer) == POINTER_INVALID || candidate_buffer.Total() <= 0 ||
            (ulong)candidate_buffer.Total() % plan_stride != 0 ||
            (ulong)candidate_buffer.Total() / plan_stride > UINT_MAX)
            return(Fail("study.action6.actor_fallback_candidates", reason));
         plan_candidates = (uint)((ulong)candidate_buffer.Total() / plan_stride);
         plan_horizon = (uint)horizon;
         selected_candidate = 0;
        }
      else
        {
         candidate_buffer = actor_top.GetCandidatePlans();
         if(!actor_top.GetSelectedCandidate(selected_candidate) ||
            !actor_top.GetAction6PlanShape(plan_candidates, plan_horizon))
            return(Fail("study.action6.actor_plan_selection", reason));
        }
      const ulong selected_offset_elements = (ulong)selected_candidate * plan_stride;
      if(CheckPointer(candidate_buffer) == POINTER_INVALID ||
         candidate_buffer.GetOpenCL() != actor_context || candidate_buffer.GetIndex() < 0 ||
         plan_horizon != (uint)horizon || plan_candidates == 0 || selected_candidate >= plan_candidates ||
         (ulong)candidate_buffer.Total() != (ulong)plan_candidates * plan_stride ||
         selected_offset_elements > (ulong)UINT_MAX / sizeof(float) ||
         selected_offset_elements + plan_stride > (ulong)candidate_buffer.Total() ||
         ArrayResize(seed, horizon * 6) != horizon * 6 ||
         (!no_feasible_actor && !actor_context.BufferRead(candidate_buffer.GetIndex(), seed,
                                   (uint)(selected_offset_elements * sizeof(float)), 0, (uint)plan_stride)))
         return(Fail("study.action6.actor_plan", reason));
      if(no_feasible_actor)
         ArrayInitialize(seed, 0.0f);
      for(int i = 0; i < horizon * 6; i++)
         if(!MathIsValidNumber((double)seed[i]))
            return(Fail(StringFormat("study.action6.actor_plan_nonfinite_%d", i), reason));
      int candidate_count = 0, teacher_source = -1, causal_source = -1;
      double teacher_score = 0.0, causal_score = 0.0;
      uchar teacher_mask[], causal_mask[];
      CBufferFloat *teacher_continuation = GetPointer(prior);
      CBufferFloat *causal_continuation = (m_z_step == 0 ? NULL : GetPointer(prior));
      if(!DPCCGenerateOracleCandidatePlans(seed, (uint)horizon, m_z_deltas, candidate_plans,
                                           candidate_count, reason) ||
         !DPCCSelectHistoricalOracleCandidateFromContinuation(m_offline_scoring,
               m_offline_config.shape, context, row.native_ohlc, opens[0], row.decision_bar, opens, closes,
               ordinals, candidate_plans, candidate_count, m_offline_config, 0, teacher_continuation,
               m_z_step, m_z_rows + horizon - 1, teacher_plan, teacher_score, teacher_source, teacher_mask, reason))
         return(Fail("study.action6.factual_oracle:" + reason, reason));
      if(no_feasible_actor)
        {
         if(ArrayResize(no_trade_plan, horizon * 6) != horizon * 6)
            return(Fail("study.action6.no_trade_plan_capacity", reason));
         ArrayInitialize(no_trade_plan, 0.0f);
         if(!DPCCSelectHistoricalOracleCandidateFromContinuation(m_offline_scoring,
               m_offline_config.shape, context, row.native_ohlc, opens[0], row.decision_bar, opens, closes,
               ordinals, no_trade_plan, 1, m_offline_config, 0, causal_continuation, m_z_step,
               m_z_rows + horizon - 1, causal_action_plan, causal_score, causal_source, causal_mask, reason, true))
            return(Fail("study.action6.no_trade_score:" + reason, reason));
        }
      else
         if(!DPCCSelectHistoricalOracleCandidateFromContinuation(m_offline_scoring,
               m_offline_config.shape, context, row.native_ohlc, opens[0], row.decision_bar, opens, closes,
               ordinals, seed, 1, m_offline_config, 0, causal_continuation, m_z_step, m_z_rows + horizon - 1,
               causal_action_plan, causal_score, causal_source, causal_mask, reason, true))
            return(Fail("study.action6.factual_oracle:" + reason, reason));
      float valid_steps[];
      if(ArrayResize(valid_steps, horizon) != horizon)
         return(Fail("study.action6.oracle_mask_capacity", reason));
      for(int h = 0; h < horizon; h++)
         valid_steps[h] = (float)teacher_mask[h];
      float account_action19[19];
      for(int i = 0; i < 13; i++)
         account_action19[i] = prepared.account13[i];
      float action[6];
      for(int i = 0; i < 6; i++)
        {
         action[i] = causal_action_plan[i];
         account_action19[13 + i] = action[i];
        }
      if(!ArrayResize(out.account13, 13) || !ArrayResize(out.pre_update_plan, horizon * 6) ||
         !ArrayResize(out.executed_action, 6) || !ArrayResize(out.teacher_plan, horizon * 6) ||
         !ArrayResize(out.valid_horizons, horizon) || !ArrayResize(out.state, 33))
         return(Fail("study.action6.result_capacity", reason));
      ArrayCopy(out.account13, prepared.account13);
      ArrayCopy(out.pre_update_plan, seed);
      ArrayCopy(out.executed_action, action);
      ArrayCopy(out.teacher_plan, teacher_plan);
      ArrayCopy(out.valid_horizons, teacher_mask);
      if(!DPCCUpdateAction6Critic(*m_action6_q1, *market, account_action19,
                                  (float)(causal_score - (double)prepared.preparation_reward), 1.0f, 1.0f, reason) ||
         !DPCCUpdateAction6Critic(*m_action6_q2, *market, account_action19,
                                  (float)(causal_score - (double)prepared.preparation_reward), 1.0f, 1.0f, reason) ||
         !DPCCUpdateAction6OraclePlanActor(*m_action6_actor, decision_id, teacher_plan, valid_steps,
                                           m_offline_config.gamma, reason))
         return(Fail("study.action6.train_update:" + reason, reason));
      if(!m_forecast.ReleaseReadyEncoderZ(generation, reason))
         return(Fail("study.action6.market_release:" + reason, reason));
      SDPCCHistoricalCommittedBar committed;
      if(!DPCCCommitHistoricalBar(*native, prepared, action, committed, reason))
         return(Fail("study.action6.commit:" + reason, reason));
      if(ArrayCopy(m_z_state, committed.state) != 33)
         return(Fail("study.action6.state_capacity", reason));
      m_z_position = committed.position;
      m_z_floor = committed.floor_reached;
      if(m_z_first_server_bar == 0)
         m_z_first_server_bar = opens[0];
      m_z_next_server_bar = opens[1];
      m_z_last_bar = row.decision_bar;
      m_z_step++;
      ArrayCopy(out.state, m_z_state);
      out.position = m_z_position;
      out.teacher_score = teacher_score;
      out.teacher_source = teacher_source;
      out.reward = committed.reward;
      out.next_row = m_z_step;
      out.decision_bar = row.decision_bar;
      out.committed = true;
      out.floor_reached = m_z_floor;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| InitializeHistory admits Encoder and fresh native policy graphs  |
   //+------------------------------------------------------------------+
   bool              InitializeHistory(const SDPCCConfig &config, const uint rows, const float &deltas[],
                          const string raw_path, const string raw_sha, const string encoder_root,
                          const string receipt_sha, const bool common_files, string &reason)
     {
      if(m_initialized || m_failed || rows == 0 || rows > 16777216 || ArraySize(deltas) != 6 ||
         !DPCCValidateFixedConfig(config.shape, config) || config.shape.K != 21 || config.shape.H != 12 ||
         (config.margin_fx_profile != DPCC_MARGIN_FOREX_SPOT_V1 &&
          config.margin_fx_profile != DPCC_MARGIN_EXTERNAL_V2 &&
          config.margin_fx_profile != DPCC_MARGIN_HISTORICAL_CLOSE_V1) || config.price_basis != DPCC_PRICE_BID ||
         !m_forecast.RestoreEncoderCompleted(raw_path, raw_sha, encoder_root, receipt_sha, reason, common_files))
         return(Fail(reason == "" ? "study.history.encoder_or_profile" : reason, reason));
      for(int i = 0; i < 6; i++)
         if(!MathIsValidNumber(deltas[i]) || deltas[i] <= 0 || deltas[i] > 1)
            return(Fail("study.history.oracle_delta", reason));
      SDPCCConfig physical = config;
      physical.shape.K = 1;
      physical.shape.M = 1;
      physical.shape.Depth = 0;
      COpenCLMy *context = m_forecast.EncoderContext();
      if(!m_z_latent.BufferInit(36288, 0) || !m_z_latent.BufferCreate(context))
         return(Fail("study.history.latent_buffer", reason));
      if(!DPCCCreateHistoricalRolloutNet(m_offline_factual, physical, context, reason))
         return(Fail(reason, reason));
      if(!DPCCCreateHistoricalRolloutNet(m_offline_scoring, physical, context, reason))
         return(Fail(reason, reason));
      if(!DPCCCreateZPolicyNet(m_z_actor, config.shape, false, context, reason))
         return(Fail(reason, reason));
      if(!DPCCCreateZPolicyNet(m_z_q1, config.shape, true, context, reason))
         return(Fail(reason, reason));
      if(!DPCCCreateZPolicyNet(m_z_q2, config.shape, true, context, reason))
         return(Fail(reason, reason));
      if(ArrayCopy(m_z_deltas, deltas) != 6)
         return(Fail("study.history.delta_capacity", reason));
      m_offline_config = config;
      m_z_rows = rows;
      m_z_raw_sha = raw_sha;
      m_z_receipt_sha = receipt_sha;
      m_z_common_files = common_files;
      m_z_history = true;
      m_initialized = true;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Bind admitted history and authenticated Market provenance        |
   //+------------------------------------------------------------------+
   bool              BindHistoryProvenance(const SDPCCOracleHistoryInput &source, string &reason)
     {
      if(!m_action6_history)
         return(Fail("BLOCKED:study.action6.provenance.market_required", reason));
      return(BindHistoryProvenance(source, "", "", reason));
     }
   //+------------------------------------------------------------------+
   //| Bind history provenance while retaining the legacy Encoder route |
   //+------------------------------------------------------------------+
   bool              BindHistoryProvenance(const SDPCCOracleHistoryInput &source, const string encoder_root,
                              const string encoder_receipt_sha, string &reason)
     {
      const int source_count = (m_action6_history ? 1 :
                                (source.clock.offline_clock_server_calendar ? 4 : 7));
      const int bound_count = source_count + 2;
      const int financial_index = (m_action6_history ? 0 : 2);
      string canonical_stem = "";
      if(!DPCCCheckpointCanonicalPath(source.output_stem, canonical_stem, reason) ||
         canonical_stem != source.output_stem)
         return(Fail("BLOCKED:study.history.provenance.output_stem", reason));
      if(!m_z_history || !m_initialized || m_failed || m_z_step != 0 || m_z_provenance_bound ||
         ArraySize(source.source_labels) != source_count || ArraySize(source.source_paths) != source_count ||
         ArraySize(source.source_hashes) != source_count ||
         (!m_action6_history && source.raw_sha != m_z_raw_sha) ||
         (!m_action6_history && encoder_receipt_sha != m_z_receipt_sha) ||
         ArraySize(source.decision_bars) != (int)m_z_rows ||
         !DPCCResolverLowerSha256(source.execution_sha))
         return(Fail("BLOCKED:study.history.provenance.admission", reason));
      //--- Keep the 24-slot financial schema; exposure cap is inactive for direct lots.
      string financial_sha = "";
      if(source.financial_profile.limits[0] != 0 || source.financial_profile.limits[20] != 8 ||
         source.financial_profile.limits[3] != 50 ||
         source.source_labels[financial_index] != "derived_financial_profile" ||
         source.financial_profile.account_currency == "" ||
         source.financial_profile.account_currency_digits < 0 || source.financial_profile.account_currency_digits > 8 ||
         source.financial_profile.sha256 != source.execution_sha ||
         source.source_hashes[financial_index] != source.financial_profile.sha256 ||
         !DPCCCheckpointTextSHA(source.financial_profile.payload, financial_sha, reason) ||
         financial_sha != source.financial_profile.sha256)
         return(Fail("BLOCKED:study.history.provenance.direct_lots_financial_profile", reason));
      string config_sha = "", deltas_sha = "";
      if(!DPCCOracleHistoryConfigSHA(source.config, config_sha, reason) || config_sha != source.config_sha ||
         !DPCCOracleHistoryDeltasSHA(m_z_deltas, deltas_sha, reason) || deltas_sha != source.deltas_sha)
         return(Fail("BLOCKED:study.history.provenance.config_or_deltas_changed", reason));
      if(ArrayResize(m_z_source_labels, bound_count) != bound_count || ArrayResize(m_z_source_paths, bound_count) !=
         bound_count ||
         ArrayResize(m_z_source_hashes, bound_count) != bound_count)
         return(Fail("BLOCKED:study.history.provenance.capacity", reason));
      for(int i = 0; i < source_count; i++)
        {
         m_z_source_labels[i] = source.source_labels[i];
         m_z_source_paths[i] = source.source_paths[i];
         m_z_source_hashes[i] = source.source_hashes[i];
        }
      if(m_action6_history)
        {
         m_z_source_labels[source_count] = "trained_market_model";
         m_z_source_paths[source_count] = "";
         m_z_source_hashes[source_count] = m_action6_market_sha;
         m_z_source_labels[source_count + 1] = "assigned_market_profile";
         m_z_source_paths[source_count + 1] = "";
         m_z_source_hashes[source_count + 1] = m_action6_profile_sha;
        }
      else
        {
         m_z_source_labels[source_count] = "encoder_receipt";
         m_z_source_paths[source_count] = encoder_root + "/EncoderTeacher.study.txt";
         m_z_source_hashes[source_count] = encoder_receipt_sha;
         m_z_source_labels[source_count + 1] = "trained_encoder_model";
         m_z_source_paths[source_count + 1] = encoder_root + "/Encoder.trained.nnw";
         SDPCCStudyEncoderReceipt receipt;
         if(!DPCCReadStudyEncoderReceipt(encoder_root, encoder_receipt_sha, m_z_raw_sha,
                                         m_forecast.FitCount(), m_forecast.HoldoutCount(), receipt, reason,
                                            m_z_common_files))
            return(Fail("BLOCKED:study.history.provenance.encoder_receipt:" + reason, reason));
         m_z_source_hashes[source_count + 1] = receipt.encoder_sha256;
        }
      for(int i = 0; i < bound_count; i++)
        {
         string observed = "";
         if(!DPCCResolverLowerSha256(m_z_source_hashes[i]))
            return(Fail("BLOCKED:study.history.provenance.source_hash." + m_z_source_labels[i], reason));
         if(m_action6_history && i == source_count)
           {
            if(!DPCCCheckpointTextSHA(source.model_text, observed, reason) ||
               observed != source.model_sha)
               return(Fail("BLOCKED:study.history.provenance.source_changed.action6_runtime:" + reason, reason));
            m_z_model_text = source.model_text;
            m_z_model_sha = source.model_sha;
           }
         else
            if(m_action6_history && i == source_count + 1)
              {
               if(!DPCCCheckpointTextSHA(m_action6_profile_text, observed, reason) ||
                  observed != m_action6_profile_sha || observed != m_z_source_hashes[i])
                  return(Fail("BLOCKED:study.history.provenance.source_changed." + m_z_source_labels[i] + ":" + reason,
                     reason));
              }
            else
              {
               if(!DPCCCheckpointFileSHA(m_z_source_paths[i], m_z_common_files,
                                         DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES, observed, reason) ||
                  observed != m_z_source_hashes[i])
                  return(Fail("BLOCKED:study.history.provenance.source_changed." + m_z_source_labels[i] + ":" + reason,
                     reason));
              }
        }
      //--- The restore path has authenticated the selected model and its assigned profile.
      m_z_time_domain = source.financial_profile.time_domain;
      if(m_z_time_domain != "UTC_SECONDS_V1" && m_z_time_domain != "SERVER_CALENDAR_SECONDS_V1")
         return(Fail("BLOCKED:study.history.provenance.time_domain", reason));
      m_z_account_currency = source.financial_profile.account_currency;
      m_z_account_currency_digits = (uint)source.financial_profile.account_currency_digits;
      m_z_execution_sha = source.execution_sha;
      m_z_config_sha = config_sha;
      m_z_deltas_sha = deltas_sha;
      m_z_output_stem = source.output_stem;
      m_z_provenance_bound = true;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Admit only the final compact V7 policy for bounded replay        |
   //+------------------------------------------------------------------+
   bool              RestoreHistoryModels(const SDPCCOracleHistoryInput &source, const string stem, string &reason)
     {
      if(!m_z_history || !m_initialized || m_failed || !m_z_provenance_bound || m_z_step != 0 || stem !=
         source.output_stem)
         return(Fail("study.history.restore_boundary", reason));
      string canonical = "";
      if(!DPCCCheckpointCanonicalPath(stem, canonical, reason) || canonical != stem)
         return(Fail("study.history.restore_stem", reason));
      uint newest = 0;
      const int common_flag = (m_z_common_files ? FILE_COMMON : 0);
      const bool final_latest = FileIsExist(stem + ".v7.latest.manifest", common_flag);
      if(!final_latest)
        {
         if(FileIsExist(stem + ".v7.latest.actor.dppt", common_flag) ||
            FileIsExist(stem + ".v7.latest.q1.dppt", common_flag) ||
            FileIsExist(stem + ".v7.latest.q2.dppt", common_flag))
            return(Fail("study.history.restore_latest_orphan_without_manifest", reason));
         //--- Per-row update snapshots predate final-only persistence.
         //--- They are intentionally ignored; start with fresh CNet weights.
         reason = "";
         return(true);
        }
      const string prefix = stem + ".v7.latest", receipt = prefix + ".manifest";
      string receipt_sha = "", wire = "";
      if(!DPCCCheckpointFileSHA(receipt, m_z_common_files, 65536, receipt_sha, reason) ||
         !DPCCZReadPinnedText(receipt, receipt_sha, wire, reason, m_z_common_files))
         return(Fail("study.history.restore_manifest_authentication:" + reason, reason));
      string paths[], hashes[];
      bool compact = false;
      SDPCCStudyEncoderReceipt enc;
      const int last = ArraySize(m_z_source_paths) - 1;
      const string root = StringSubstr(m_z_source_paths[last], 0, StringLen(m_z_source_paths[last]) - StringLen(
         "/Encoder.trained.nnw"));
      if(!DPCCReadStudyEncoderReceipt(root, m_z_receipt_sha, m_z_raw_sha, m_forecast.FitCount(),
         m_forecast.HoldoutCount(), enc, reason,
                                      m_z_common_files) ||
         !DPCCZReadStudyModelsEx(receipt, receipt_sha, m_z_raw_sha, m_z_receipt_sha, enc.encoder_sha256, paths, hashes,
            compact, reason,
                                 m_z_common_files) ||
         !compact || ArraySize(paths) != 3 || ArraySize(hashes) != 3)
         return(Fail("study.history.restore_manifest_decode:" + reason, reason));
      const string expected[3] = {prefix + ".actor.dppt", prefix + ".q1.dppt", prefix + ".q2.dppt"};
      for(int i = 0; i < 3; i++)
         if(paths[i] != expected[i])
            return(Fail("study.history.restore_model_path", reason));
      string fields[];
      int pos = StringLen("DPCC_Z_ORACLE_MODELS_V7\n"), count = 0;
      while(count < 34 && StringSubstr(wire, pos, 4) != "COMP")
        {
         string f = "";
         if(!DPCCZReadField(wire, pos, f, reason))
            return(Fail("study.history.restore_fields", reason));
         if(ArrayResize(fields, count + 1) != count + 1)
            return(Fail("study.history.restore_field_capacity", reason));
         fields[count++] = f;
        }
      bool cursor = false, rows = false, bar = false, execution = false, config = false, deltas = false;
      bool domain = (m_z_time_domain != "SERVER_CALENDAR_SECONDS_V1");
      string old_profile_path = "", old_profile_sha = "", old_execution_sha = "";
      int old_profile_path_count = 0, old_profile_sha_count = 0, old_execution_count = 0;
      for(int i = 0; i < count; i++)
        {
         if(StringFind(fields[i], "cursor=") == 0)
           {
            ulong cursor_value = 0;
            if(!DPCCCheckpointReadUnsigned(StringSubstr(fields[i], StringLen("cursor=")), m_z_rows, cursor_value) ||
               cursor_value == 0)
               return(Fail("study.history.restore_cursor", reason));
            newest = (uint)cursor_value;
            cursor = true;
           }
         if(fields[i] == "row_count=" + (string)m_z_rows)
            rows = true;
         if(fields[i] == "decision_bar=" + (string)source.decision_bars[(int)newest - 1])
            bar = true;
         if(fields[i] == "execution_profile.sha256=" + m_z_execution_sha)
            execution = true;
         if(StringFind(fields[i], "execution_profile.sha256=") == 0)
           {old_execution_sha = StringSubstr(fields[i], StringLen("execution_profile.sha256=")); old_execution_count++;}
         if(fields[i] == "config.sha256=" + m_z_config_sha)
            config = true;
         if(fields[i] == "oracle_deltas.sha256=" + m_z_deltas_sha)
            deltas = true;
         if(fields[i] == "time_domain=" + m_z_time_domain)
            domain = true;
         if(StringFind(fields[i], "derived_financial_profile.path=") == 0)
           {old_profile_path = StringSubstr(fields[i], StringLen("derived_financial_profile.path="));
              old_profile_path_count++;}
         if(StringFind(fields[i], "derived_financial_profile.sha256=") == 0)
           {old_profile_sha = StringSubstr(fields[i], StringLen("derived_financial_profile.sha256="));
              old_profile_sha_count++;}
        }
      bool profile_exception = false;
      const int financial_index = (m_action6_history ? 1 : 2);
      if(old_profile_path_count == 1 && old_profile_sha_count == 1 && old_execution_count == 1 &&
         DPCCResolverLowerSha256(old_profile_sha) && old_execution_sha == old_profile_sha &&
         m_z_source_labels[financial_index] == "derived_financial_profile" &&
         (old_profile_path != m_z_source_paths[financial_index] ||
          old_profile_sha != m_z_source_hashes[financial_index]))
        {
         string canonical_profile = "", observed_profile = "", old_payload = "";
         uchar profile_bytes[];
         const string required_old_path = stem + ".financial_profile." + old_profile_sha + ".txt";
         string text_sha = "";
         if(old_profile_path == required_old_path &&
            DPCCCheckpointCanonicalPath(old_profile_path, canonical_profile, reason) && canonical_profile ==
               old_profile_path &&
            DPCCCheckpointFileSHA(old_profile_path, m_z_common_files, 1048576, observed_profile, reason) &&
               observed_profile == old_profile_sha &&
            DPCCReadArtifactBytes(old_profile_path, m_z_common_files, 1048576, profile_bytes, reason) &&
            DPCCStrictUtf8Decode(profile_bytes, ArraySize(profile_bytes), 1048576, old_payload, reason) &&
            DPCCCheckpointTextSHA(old_payload, text_sha, reason) && text_sha == old_profile_sha &&
            SameFinancialProfileExceptSnapshotTimesAndTerminalBuild(old_payload, source.financial_profile.payload,
               reason))
            profile_exception = true;
        }
      for(int i = 0; i < ArraySize(m_z_source_labels); i++)
        {
         bool pp = false, hh = false;
         for(int j = 0; j < count; j++)
           {
            if(fields[j] == m_z_source_labels[i] + ".path=" + m_z_source_paths[i])
               pp = true;
            if(fields[j] == m_z_source_labels[i] + ".sha256=" + m_z_source_hashes[i])
               hh = true;
           }
         if(!pp || !hh)
           {
            if(i != 2 || !profile_exception)
               return(Fail("study.history.restore_source_pin." + m_z_source_labels[i] + ":" + reason, reason));
           }
        }
      const int expected_fields = (m_z_time_domain == "SERVER_CALENDAR_SECONDS_V1" ? 28 : 33);
      //--- Accept the prior receipt layout with its extra clock_identity field.
      if(!cursor || !rows || !bar || !config || !deltas || !domain || newest == 0 || newest > m_z_rows ||
         old_profile_path_count != 1 || old_profile_sha_count != 1 || old_execution_count != 1 ||
         (!execution && !profile_exception) ||
         (count != expected_fields && count != expected_fields + 1))
         return(Fail("study.history.restore_provenance", reason));
      CNet *nets[] = {GetPointer(m_z_actor), GetPointer(m_z_q1), GetPointer(m_z_q2)};
      for(int i = 0; i < 3; i++)
         if(!DPCCLoadCompactPolicyTrainingState(*nets[i], paths[i], hashes[i], m_z_common_files,
                                                DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES, reason))
            return(Fail("study.history.restore_state:" + reason, reason));
      for(int i = 0; i < 3; i++)
         if(!nets[i].Clear() || !nets[i].TrainMode(true) || !nets[i].SetWeightsUpdate(true))
            return(Fail("study.history.restore_transient", reason));
      m_z_resume_cursor = newest;
      m_z_resume_manifest = receipt;
      m_z_resume_sha = receipt_sha;
      reason = "";
      return(true);
     }
   bool              ReplayingHistory(void) { return(m_z_resume_cursor > 0 && m_z_step > 0 && m_z_step <=
      m_z_resume_cursor); }
   uint              ResumeCursor(void) { return(m_z_resume_cursor); }
   //+------------------------------------------------------------------+
   //| StepHistory trains on pinned history and commits one operation   |
   //+------------------------------------------------------------------+
   bool              StepHistory(CDPCCMarketClock &clock, const long decision_bar,
                    const float &admitted_context[],
                    const float &native_ohlc[], const long &timeline_opens[], const long &timeline_closes[],
                    SDPCCOfflineRowResult &out, string &reason)
     {
      DPCCClearOfflineRowResult(out);
      const int horizon = (int)m_offline_config.shape.H;
      if(!m_z_history || !m_initialized || m_failed || !m_z_provenance_bound || m_z_floor || m_z_step >= m_z_rows ||
         clock.TimeDomain() != m_z_time_domain || decision_bar < 0 ||
         (m_z_step > 0 && decision_bar != m_z_last_bar + 1) ||
         ArraySize(native_ohlc) != horizon * 4 || ArraySize(timeline_opens) != horizon ||
         ArraySize(timeline_closes) != horizon)
         return(Fail("study.history.row_boundary", reason));
      long opens[], closes[], ordinals[];
      if(ArrayResize(opens, horizon) != horizon || ArrayResize(closes, horizon) != horizon ||
         ArrayResize(ordinals, horizon) != horizon)
         return(Fail("study.history.time_capacity", reason));
      for(int h = 0; h < horizon; h++)
        {
         SDPCCClockBar bar;
         long open_time = 0, end = 0;
         if(!clock.IndexedTimelineBar(decision_bar + h, bar, open_time, end, reason) ||
            bar.ordinal != decision_bar + h || open_time != timeline_opens[h] || end != timeline_closes[h])
            return(Fail("study.history.time_join:" + reason, reason));
         opens[h] = bar.server_open;
         closes[h] = bar.server_close;
         ordinals[h] = bar.ordinal;
        }
      int raw_index = -1;
      if(!m_forecast.RawIndexForServerOpen(opens[0], true, raw_index, reason) ||
         !m_forecast.MatchesNativeOHLC(raw_index, native_ohlc, opens, reason))
         return(Fail("study.history.raw_horizon_join:" + reason, reason));
      if(!m_forecast.InferZToDevice(raw_index, GetPointer(m_z_latent), reason))
         return(Fail("study.history.encoder_inference:" + reason, reason));
      //--- The native simulator owns the continuous account and position age.
      float context[];
      SDPCCLayout layout, unused;
      uint tokens = 0;
      if(!DPCCCompositeLayouts(m_offline_config.shape, layout, unused, tokens) ||
         ArraySize(admitted_context) != (int)layout.offsets[10] ||
         ArrayCopy(context, admitted_context) != ArraySize(admitted_context))
         return(Fail("study.history.financial_context_shape", reason));
      if(context[(int)layout.offsets[6]] != 0 || context[(int)layout.offsets[6] + 20] != 8 ||
         context[(int)layout.offsets[6] + 3] != 50)
         return(Fail("BLOCKED:study.history.row_direct_lots_financial_profile_mismatch", reason));
      if(m_z_step == 0)
        {
         SDPCCSnapshotMeta meta;
         ZeroMemory(meta);
         meta.account_currency = m_z_account_currency;
         if(m_z_account_currency == "" ||
            !DPCCBuildHistoricalFlatSeed(1000, m_z_account_currency, m_z_account_currency_digits,
                                         meta, m_offline_config, m_offline_config.shape, context, native_ohlc,
                                            m_z_state, m_z_position, reason))
            return(Fail(reason, reason));
        }
      for(int i = 0; i < 24; i++)
         context[(int)layout.offsets[4] + i] = m_z_state[i];
      if(!DPCCBindHistoricalFxReference(m_offline_config.shape, context, m_z_state, reason))
         return(Fail(reason, reason));
      float step_values[];
      ENUM_SYMBOL_CALC_MODE calculation = SYMBOL_CALC_MODE_FOREX;
      if(!DPCCBuildHistoricalBarStepValues(m_offline_config.shape, context, native_ohlc, decision_bar,
                                           opens, closes, ordinals, timeline_opens[0], timeline_closes[0], step_values,
                                              calculation, reason))
         return(Fail(reason, reason));
      CNeuronScenarioRolloutOCL *native = dynamic_cast<CNeuronScenarioRolloutOCL *>(m_offline_factual.Layer(1));
      CBufferFloat prior;
      SDPCCHistoricalPreparedBar prepared;
      if(!native || !DPCCPrepareHistoricalBar(*native, step_values, decision_bar, (ulong)decision_bar + 1,
                                              opens[0], closes[0], timeline_opens[0], timeline_closes[0], calculation,
                                                 m_z_state, m_z_position,
                                              m_z_step, m_z_rows + horizon - 1, m_z_step == 0, prior, prepared, reason,
                                                 false, clock.TimeDomain()))
         return(Fail(reason, reason));
      if(m_z_step < m_z_resume_cursor)
        {
         float empty_action[], plan[], prepared_plan[];
         if(!DPCCForwardZPolicy(m_z_actor, m_offline_config.shape, GetPointer(m_z_latent), prepared.account13,
            empty_action, false, reason))
            return(Fail("study.history.replay_forward:" + reason, reason));
         m_z_actor.getResults(plan);
         if(ArraySize(plan) != horizon * 6 || !DPCCPrepareHistoricalPolicyActions(m_offline_config.shape, context, plan,
            prepared_plan, reason))
            return(Fail("study.history.replay_plan:" + reason, reason));
         float action[6];
         for(int i = 0; i < 6; i++)
            action[i] = prepared_plan[i];
         if(ArrayResize(out.account13, 13) != 13 || ArrayResize(out.pre_update_plan, horizon * 6) != horizon * 6 ||
            ArrayResize(out.executed_action, 6) != 6 || ArrayResize(out.teacher_plan, horizon * 6) != horizon * 6 ||
            ArrayResize(out.valid_horizons, horizon) != horizon || ArrayResize(out.state, 33) != 33)
            return(Fail("study.history.replay_result_capacity", reason));
         SDPCCHistoricalCommittedBar replay;
         if(!DPCCCommitHistoricalBar(*native, prepared, action, replay, reason))
            return(Fail("study.history.replay_commit:" + reason, reason));
         if(ArrayCopy(m_z_state, replay.state) != 33)
            return(Fail("study.history.replay_state_capacity", reason));
         m_z_position = replay.position;
         m_z_floor = replay.floor_reached;
         m_z_last_bar = decision_bar;
         m_z_step++;
         ArrayInitialize(out.teacher_plan, 0.0);
         ArrayInitialize(out.valid_horizons, 0.0);
         ArrayCopy(out.account13, prepared.account13);
         ArrayCopy(out.pre_update_plan, plan);
         ArrayCopy(out.executed_action, action);
         ArrayCopy(out.state, m_z_state);
         out.position = m_z_position;
         out.reward = replay.reward;
         out.next_row = m_z_step;
         out.decision_bar = decision_bar;
         out.committed = true;
         out.floor_reached = m_z_floor;
         reason = "";
         return(true);
        }
      //--- Preserve the causal Actor plan before hindsight targets or updates.
      float empty_action[], seed[], candidates[], teacher[], seed_selected[];
      if(!DPCCForwardZPolicy(m_z_actor, m_offline_config.shape, GetPointer(m_z_latent), prepared.account13,
                             empty_action, false, reason))
         return(Fail(reason, reason));
      m_z_actor.getResults(seed);
      int count = 0, teacher_source = -1, seed_source = -1;
      double teacher_score = 0, seed_score = 0;
      uchar teacher_mask[], seed_mask[];
      //--- Full plans use the raw seed; row-zero operation scoring initializes natively.
      CBufferFloat *teacher_continuation = GetPointer(prior);
      CBufferFloat *operation_continuation = (m_z_step == 0 ? NULL : GetPointer(prior));
      if(!DPCCGenerateOracleCandidatePlans(seed, horizon, m_z_deltas, candidates, count, reason))
         return(Fail(reason, reason));
      if(!DPCCSelectHistoricalOracleCandidateFromContinuation(m_offline_scoring, m_offline_config.shape,
            context, native_ohlc, opens[0], decision_bar, opens, closes, ordinals, candidates, count,
            m_offline_config, 0, teacher_continuation, m_z_step, m_z_rows + horizon - 1,
            teacher, teacher_score, teacher_source, teacher_mask, reason))
         return(Fail(reason, reason));
      if(!DPCCSelectHistoricalOracleCandidateFromContinuation(m_offline_scoring, m_offline_config.shape,
            context, native_ohlc, opens[0], decision_bar, opens, closes, ordinals, seed, 1,
            m_offline_config, 0, operation_continuation, m_z_step, m_z_rows + horizon - 1,
            seed_selected, seed_score, seed_source, seed_mask, reason, true))
         return(Fail(reason, reason));
      float action[6], mask[];
      if(ArrayResize(mask, horizon) != horizon)
         return(Fail("study.history.mask_capacity", reason));
      //--- Operation-only scoring returns the exact capped seed used for Critic and commit.
      for(int i = 0; i < 6; i++)
         action[i] = seed_selected[i];
      for(int h = 0; h < horizon; h++)
         mask[h] = (float)teacher_mask[h];
      //--- Reserve publication buffers before any model or financial update.
      if(ArrayResize(out.account13, 13) != 13 || ArrayResize(out.pre_update_plan, horizon * 6) != horizon * 6 ||
         ArrayResize(out.executed_action, 6) != 6 || ArrayResize(out.teacher_plan, horizon * 6) != horizon * 6 ||
         ArrayResize(out.valid_horizons, horizon) != horizon || ArrayResize(out.state, 33) != 33)
         return(Fail("study.history.result_capacity", reason));
      if(!DPCCPrepareDiscountedPlanGradient(m_z_actor, m_offline_config.shape, 3, teacher, mask,
                                            m_offline_config.gamma, reason))
         return(Fail(reason, reason));
      CBufferFloat detached_gradient;
      if(!detached_gradient.BufferInit(36288, 0) ||
         !detached_gradient.BufferCreate(m_forecast.EncoderContext()) ||
         !m_z_actor.backPropGradient(GetPointer(m_z_latent), GetPointer(detached_gradient), -1, true))
         return(Fail("study.history.actor_backward", reason));
      CNet *critics[] = {GetPointer(m_z_q1), GetPointer(m_z_q2)};
      //--- The open-preparation PnL precedes the current action; retain it in the ledger,
      //--- but exclude it from the action-conditioned Critic target.
      const double critic_target_candidate = seed_score - (double)prepared.preparation_reward;
      const float critic_target = (float)critic_target_candidate;
      if(!MathIsValidNumber(critic_target_candidate) || !MathIsValidNumber((double)critic_target))
         return(Fail("study.history.critic_target_nonfinite", reason));
      for(int i = 0; i < 2; i++)
        {
         if(!DPCCForwardZPolicy(*critics[i], m_offline_config.shape, GetPointer(m_z_latent), prepared.account13,
                                action, true, reason))
            return(Fail(reason, reason));
         if(!DPCCUpdateZCritic(*critics[i], m_offline_config.shape, GetPointer(m_z_latent), critic_target, 1, 1,
            reason))
            return(Fail(reason, reason));
        }
      SDPCCHistoricalCommittedBar committed;
      if(!DPCCCommitHistoricalBar(*native, prepared, action, committed, reason))
         return(Fail(reason, reason));
      if(ArrayCopy(m_z_state, committed.state) != 33)
         return(Fail("study.history.state_capacity", reason));
      m_z_position = committed.position;
      m_z_floor = committed.floor_reached;
      m_z_last_bar = decision_bar;
      m_z_step++;
      ArrayCopy(out.account13, prepared.account13);
      ArrayCopy(out.pre_update_plan, seed);
      ArrayCopy(out.executed_action, action);
      ArrayCopy(out.teacher_plan, teacher);
      ArrayCopy(out.valid_horizons, teacher_mask);
      ArrayCopy(out.state, m_z_state);
      out.position = m_z_position;
      out.teacher_score = teacher_score;
      out.teacher_source = teacher_source;
      out.reward = committed.reward;
      out.next_row = m_z_step;
      out.decision_bar = decision_bar;
      out.committed = true;
      out.floor_reached = m_z_floor;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Persist only latest Actor/Critic weights and Adam moments        |
   //+------------------------------------------------------------------+
   bool              SaveAction6TrainingStateOnly(const string base, const bool common_files,
                                     string &manifest_path, string &manifest_sha, string &reason)
     {
      manifest_path = "";
      manifest_sha = "";
      reason = "";
      string actor_path = "", q1_path = "", q2_path = "";
      if(!m_action6_history || !m_initialized ||
         CheckPointer(m_action6_actor) == POINTER_INVALID ||
         CheckPointer(m_action6_q1) == POINTER_INVALID ||
         CheckPointer(m_action6_q2) == POINTER_INVALID ||
         !Action6TrainingPaths(base, common_files, actor_path, q1_path, q2_path, manifest_path, reason))
        {
         if(reason == "")
            reason = "study.action6.training_state.boundary";
         return(false);
        }
      string hashes[3];
      if(!Action6SavePolicyState(m_action6_actor, actor_path, common_files, hashes[0], reason) ||
         !Action6SavePolicyState(m_action6_q1, q1_path, common_files, hashes[1], reason) ||
         !Action6SavePolicyState(m_action6_q2, q2_path, common_files, hashes[2], reason))
         return(false);
      const string payload = "DPCC_ACTION6_TRAINING_STATE_V1\n" +
                             hashes[0] + "\n" + hashes[1] + "\n" + hashes[2] + "\n" +
                             "END_DPCC_ACTION6_TRAINING_STATE_V1\n";
      if(!DPCCCheckpointWriteText(manifest_path, common_files, payload, reason, true))
         return(false);
      uchar bytes[];
      string readback = "", actual_sha = "";
      if(!DPCCReadArtifactBytes(manifest_path, common_files, 4096, bytes, reason) ||
         !DPCCStrictUtf8Decode(bytes, ArraySize(bytes), 4096, readback, reason) || readback != payload ||
         !DPCCCheckpointFileSHA(manifest_path, common_files, 4096, actual_sha, reason))
        {
         if(reason == "")
            reason = "study.action6.training_state.manifest_readback";
         return(false);
        }
      manifest_sha = actual_sha;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Restore only Actor/Critic weights and optimizer moments          |
   //+------------------------------------------------------------------+
   bool              LoadAction6TrainingStateOnly(const string base, const bool common_files,
                                     string &manifest_path, string &reason)
     {
      manifest_path = "";
      reason = "";
      string actor_path = "", q1_path = "", q2_path = "";
      if(!m_action6_history || !m_initialized ||
         CheckPointer(m_action6_actor) == POINTER_INVALID ||
         CheckPointer(m_action6_q1) == POINTER_INVALID ||
         CheckPointer(m_action6_q2) == POINTER_INVALID ||
         !Action6TrainingPaths(base, common_files, actor_path, q1_path, q2_path, manifest_path, reason))
        {
         if(reason == "")
            reason = "study.action6.training_state.boundary";
         return(false);
        }
      uchar bytes[];
      string source = "";
      if(!DPCCReadArtifactBytes(manifest_path, common_files, 4096, bytes, reason) ||
         !DPCCStrictUtf8Decode(bytes, ArraySize(bytes), 4096, source, reason))
         return(false);
      string expected[3], paths[3], actual = "";
      if(!Action6ParseTrainingManifest(source, expected[0], expected[1], expected[2], reason))
         return(false);
      paths[0] = actor_path;
      paths[1] = q1_path;
      paths[2] = q2_path;
      for(int i = 0; i < ArraySize(paths); i++)
         if(!DPCCCheckpointFileSHA(paths[i], common_files, 536870912, actual, reason) || actual != expected[i])
           {
            reason = "study.action6.training_state.model_sha_mismatch";
            return(false);
           }
      CNeuronDPCCOCL *action6_actor_top = dynamic_cast<CNeuronDPCCOCL*>(m_action6_actor.Layer(1));
      CNet *market = m_forecast.ReadyMarketNetwork();
      if(!Action6LoadPolicyState(m_action6_q1, q1_path, common_files, reason))
        {
         reason = "study.action6.training_state.q1:" + reason;
         return(false);
        }
      if(!Action6LoadPolicyState(m_action6_q2, q2_path, common_files, reason))
        {
         reason = "study.action6.training_state.q2:" + reason;
         return(false);
        }
      if(!Action6LoadPolicyState(m_action6_actor, actor_path, common_files, reason))
        {
         reason = "study.action6.training_state.actor:" + reason;
         return(false);
        }
      if(CheckPointer(action6_actor_top) == POINTER_INVALID ||
         !action6_actor_top.BindPolicyNetworks(market, m_action6_q1, m_action6_q2))
        {
         reason = "study.action6.training_state.actor_bind";
         return(false);
        }
      return(true);
     }
   //+--------------------------------------------------------------------+
   //| Publish the D01 native CNet Trading role with synchronized targets |
   //+--------------------------------------------------------------------+
   bool              SaveAction6HistoryModels(const ulong total_policy_updates, const ulong pass_index,
                                 string &manifest, string &sha, string &reason)
     {
      manifest = "";
      sha = "";
      string canonical_stem = "";
      if(total_policy_updates == 0 || !m_action6_history || !m_z_history || !m_initialized || m_failed ||
         !m_z_provenance_bound || m_z_step == 0 || m_z_last_bar < 0 ||
         m_z_first_server_bar <= 0 || m_z_next_server_bar <= 0 || m_action6_task_id == "" ||
         CheckPointer(m_action6_actor) == POINTER_INVALID || CheckPointer(m_action6_q1) == POINTER_INVALID ||
         CheckPointer(m_action6_q2) == POINTER_INVALID ||
         !DPCCCheckpointCanonicalPath(m_z_output_stem, canonical_stem, reason) || canonical_stem != m_z_output_stem)
         return(Fail("BLOCKED:study.action6.export_boundary:" + reason, reason));
      //--- The caller finalizes after the configured update limit or the floor boundary.
      //--- The resume cursor describes the latest pass; policy_updates is cumulative.
      CNeuronDPCCOCL *actor_top = dynamic_cast<CNeuronDPCCOCL*>(m_action6_actor.Layer(1));
      if(!actor_top || actor_top.Type() != defNeuronDPCCOCL || actor_top.ActorABI() != 3 ||
         (actor_top.LastStatus() != DPCC_OK &&
          actor_top.LastStatus() != DPCC_NO_FEASIBLE_CANDIDATE) || m_action6_market_max_bytes == 0)
         return(Fail("BLOCKED:study.action6.export_actor_contract", reason));
      string config_sha = "", deltas_sha = "", actual = "";
      if(!DPCCOracleHistoryConfigSHA(m_offline_config, config_sha, reason) || config_sha != m_z_config_sha ||
         !DPCCOracleHistoryDeltasSHA(m_z_deltas, deltas_sha, reason) || deltas_sha != m_z_deltas_sha ||
         !DPCCCheckpointFileSHA(m_action6_market_path, m_z_common_files, m_action6_market_max_bytes,
                                actual, reason) || actual != m_action6_market_sha ||
         !DPCCCheckpointTextSHA(m_action6_profile_text, actual, reason) || actual != m_action6_profile_sha)
         return(Fail("BLOCKED:study.action6.export.provenance_changed:" + reason, reason));
      for(int i = 0; i < ArraySize(m_z_source_labels) - 2; i++)
        {
         ulong limit = DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES;
         if(!DPCCCheckpointFileSHA(m_z_source_paths[i], m_z_common_files, limit, actual, reason) ||
            actual != m_z_source_hashes[i])
            return(Fail("BLOCKED:study.action6.export.source_changed." + m_z_source_labels[i] + ":" + reason, reason));
        }
      CNet *market = m_forecast.ReadyMarketNetwork();
      CNet *target_q1 = NULL, *target_q2 = NULL, *target_actor = NULL;
      CNeuronDPCCOCL *target_actor_top = NULL;
      bool saved = false;
      string output_path = "", output_sha = "";
      do
        {
         if(CheckPointer(market) == POINTER_INVALID || market.GetOpenCL() != m_action6_actor.GetOpenCL() ||
            market.WeightsUpdateEnabled() || !DPCCCreateAction6CriticNet(target_q1, market, reason) ||
            !DPCCCreateAction6CriticNet(target_q2, market, reason) ||
            !DPCCCreateAction6ActorNet(target_actor, m_action6_runtime, market, target_q1, target_q2,
                                       target_actor_top, reason) ||
            !DPCCSyncAction6TradingTargets(*market, *m_action6_actor, *m_action6_q1, *m_action6_q2,
                                           *target_actor, *target_q1, *target_q2, reason))
           {
            if(reason == "")
               reason = "study.action6.export.target_graph";
            break;
           }
         string actor_graph = "", q1_graph = "", q2_graph = "", target_actor_graph = "", target_q1_graph = "",
            target_q2_graph = "";
         if(!DPCCAPTradingGraph(*m_action6_actor, 2, actor_graph, reason) ||
            !DPCCAPTradingGraph(*m_action6_q1, 5, q1_graph, reason) ||
            !DPCCAPTradingGraph(*m_action6_q2, 5, q2_graph, reason) ||
            !DPCCAPTradingGraph(*target_actor, 2, target_actor_graph, reason) ||
            !DPCCAPTradingGraph(*target_q1, 5, target_q1_graph, reason) ||
            !DPCCAPTradingGraph(*target_q2, 5, target_q2_graph, reason))
            break;
         const string graph = "{\"Actor\":" + actor_graph + ",\"Q1\":" + q1_graph + ",\"Q2\":" + q2_graph +
                              ",\"TargetActor\":" + target_actor_graph + ",\"TargetQ1\":" + target_q1_graph +
                              ",\"TargetQ2\":" + target_q2_graph + "}";
         string source_abi = "";
         if(!DPCCCheckpointTextSHA(DPCC_AP_CONTRACT + "\n" + DPCC_TRADING_REVISION +
                                   "\nTRADING_NATIVE_CNET;SIX_ROLES;MARKET_DEPENDENCY_SHA_V1\n" +
                                   m_action6_market_sha + "\n" + graph, source_abi, reason))
            break;
         uchar financial_bytes[];
         string profile_text = m_action6_profile_text, model_text = m_z_model_text, financial_text = "";
         string profile_sha = "", model_sha = "", financial_sha = "";
         if(!DPCCCheckpointTextSHA(profile_text, profile_sha, reason) || profile_sha != m_action6_profile_sha ||
            !DPCCCheckpointTextSHA(model_text, model_sha, reason) || model_sha != m_z_model_sha ||
            !DPCCReadArtifactBytes(m_z_source_paths[0], m_z_common_files, 1048576, financial_bytes, reason) ||
            !DPCCSHA256Lower(financial_bytes, financial_sha, reason) || financial_sha != m_z_source_hashes[0] ||
            !DPCCStrictUtf8Decode(financial_bytes, ArraySize(financial_bytes), 1048576, financial_text, reason))
            break;
         CDPCCJsonDocument profile_document, model_document;
         if(!profile_document.Parse(profile_text, reason) || !model_document.Parse(model_text, reason))
            break;
         const string manifest_text = "{\"contract_id\":" + DPCCAPJSONString(DPCC_AP_CONTRACT) +
                                      ",\"revision\":" + DPCCAPJSONString(DPCC_TRADING_REVISION) +
                                      ",\"role\":\"Trading\",\"task_id\":" + DPCCAPJSONString(m_action6_task_id) +
                                      ",\"stage\":\"Study\",\"graph\":" + graph +
                                      ",\"source_archive_sha256\":\"2ed3f91b038394980f73d566a4c0c8c2fb53f651898d2d101b914811d28de3c8\"" +
                                      ",\"source_abi_sha256\":\"" + source_abi + "\",\"market_dependency_sha256\":\"" +
                                      m_action6_market_sha + "\",\"data_sha256\":\"" + m_action6_market_data_sha +
                                      "\",\"data_index_sha256\":null" +
                                      ",\"data_source\":{\"path\":" + DPCCAPJSONString(m_z_raw_path) +
                                      ",\"sha256\":null},\"study_run_sha256\":\"" + m_z_source_hashes[0] +
                                      "\",\"study_mode\":" + (string)m_offline_config.mode +
                                      ",\"model\":{\"sha256\":\"" + model_sha + "\",\"contents\":" + DPCCAPJSONString(
                                         model_text) + "}" +
                                      ",\"financial_profile\":{\"sha256\":\"" + financial_sha + "\",\"payload\":" +
                                      DPCCAPJSONString(financial_text) + "},\"profile\":{\"task_id\":" +
                                         DPCCAPJSONString(m_action6_task_id) +
                                      ",\"sha256\":\"" + m_action6_profile_sha + "\",\"contents\":" + profile_text +
                                      "},\"ready\":false,\"acceptance\":[{\"case_id\":\"STUDY_TRAINING\",\"status\":\"NOT_RUN\",\"evidence_sha256\":null}]}";
         string record_order_sha = "";
         if(!DPCCCheckpointTextSHA("CHRONOLOGICAL_TERMINAL_BARS_V1\n" +
                                   (string)m_z_first_server_bar + "\n" + (string)m_z_next_server_bar + "\n" +
                                   (string)m_z_rows + "\n" + (string)m_z_step, record_order_sha, reason))
            break;
         const string resume = "{\"stage\":\"Study\",\"epoch\":" + (string)pass_index +
                               ",\"next_record\":" + (string)m_z_step +
                               ",\"record_order_sha256\":\"" + record_order_sha + "\",\"completed_transitions\":" +
                               (string)m_z_step + ",\"policy_updates\":" + (string)total_policy_updates +
                               ",\"target_updates\":1,\"target_order_flag\":false,\"rng_state\":[],\"noise_seed\":0," +
                               "\"profile_sha256\":\"" + m_action6_profile_sha + "\",\"training_complete\":true," +
                               "\"row_count\":" + (string)m_z_rows + ",\"floor_reached\":" + (m_z_floor ? "true" :
                                  "false") +
                               ",\"study_run_sha256\":\"" + m_z_source_hashes[0] +
                                  "\",\"journal_path\":null,\"journal_sha256\":null," +
                               "\"replay_from_bar\":" + (string)m_z_first_server_bar + ",\"next_bar\":" +
                               (string)m_z_next_server_bar +
                               ",\"pending\":null}";
         CDPCCJsonDocument metadata;
         if(!metadata.Parse(manifest_text, reason) || !metadata.Parse(resume, reason))
            break;
         const string market_suffix = "/Market.current.dpc";
         const int slash = StringLen(m_action6_market_path) - StringLen(market_suffix);
         if(slash <= 0 || StringSubstr(m_action6_market_path, slash) != market_suffix)
           {
            reason = "study.action6.export.market_directory";
            break;
           }
         const string directory = StringSubstr(m_action6_market_path, 0, slash);
         saved = DPCCAPSaveTradingGeneration(directory, m_z_common_files, m_action6_market_max_bytes,
                                             source_abi, manifest_text, resume, *m_action6_actor, *m_action6_q1,
                                                *m_action6_q2,
                                             *target_actor, *target_q1, *target_q2, "", "", output_path, output_sha,
                                                reason);
        }
      while(false);
      if(CheckPointer(target_actor) != POINTER_INVALID)
         delete target_actor;
      if(CheckPointer(target_q2) != POINTER_INVALID)
         delete target_q2;
      if(CheckPointer(target_q1) != POINTER_INVALID)
         delete target_q1;
      if(!saved)
         return(Fail(reason == "" ? "study.action6.export" : reason, reason));
      manifest = output_path;
      sha = output_sha;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| SaveHistoryModels exports the legacy Z-route policy state        |
   //+------------------------------------------------------------------+
   bool              SaveHistoryModels(const string stem, string &manifest, string &sha, string &reason)
     {
      manifest = "";
      sha = "";
      string canonical = "";
      if(!m_z_history || !m_initialized || m_failed ||
         !m_z_provenance_bound ||
         m_z_step == 0 || m_z_last_bar < 0 ||
         !DPCCCheckpointCanonicalPath(stem, canonical, reason) || canonical != stem)
         return(Fail("study.history.export_boundary", reason));
      if(m_z_step < m_z_rows && !m_z_floor)
         return(Fail("study.history.export_before_complete", reason));
      if(m_z_resume_cursor > 0 && m_z_step <= m_z_resume_cursor)
        { manifest = m_z_resume_manifest; sha = m_z_resume_sha; reason = ""; return(true); }
      //--- Inputs were SHA-admitted and loaded before training. Export the
      //--- retained pins once after the complete pass.
      string config_sha = "", deltas_sha = "";
      if(!DPCCOracleHistoryConfigSHA(m_offline_config, config_sha, reason) || config_sha != m_z_config_sha ||
         !DPCCOracleHistoryDeltasSHA(m_z_deltas, deltas_sha, reason) || deltas_sha != m_z_deltas_sha)
         return(Fail("BLOCKED:study.history.export.config_or_deltas_changed", reason));
      const string prefix = stem + ".v7.latest";
      const string receipt = prefix + ".manifest";
      const string lock_path = stem + ".writer.lock";
      const int writer_lock = FileOpen(lock_path, FILE_READ | FILE_WRITE | FILE_BIN |
                                       (m_z_common_files ? FILE_COMMON : 0));
      if(writer_lock == INVALID_HANDLE)
         return(Fail("study.history.export_lock", reason));
      bool saved = false;
      string hashes[3];
      string paths[3];
      CNet *nets[] = {GetPointer(m_z_actor), GetPointer(m_z_q1), GetPointer(m_z_q2)};
      paths[0] = prefix + ".actor.dppt";
      paths[1] = prefix + ".q1.dppt";
      paths[2] = prefix + ".q2.dppt";
      do
        {
         bool models = true;
         for(int i = 0; i < 3 && models; i++)
           {
            if(!DPCCSaveCompactPolicyTrainingState(*nets[i], paths[i], m_z_common_files,
                                                   DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES, hashes[i], reason, true))
               models = false;
           }
         if(!models)
            break;
         const bool server_calendar = (m_z_time_domain == "SERVER_CALENDAR_SECONDS_V1");
         const string version = "V7";
         string wire = "DPCC_Z_ORACLE_MODELS_" + version + "\n";
         DPCCOfflineField(wire, "provenance=ADMISSION_TIME_SOURCE_SHA256_LOADED_IN_MEMORY");
         DPCCOfflineField(wire, "Z[21,9,12,16];contiguous_group=[K*V=189,H*D=192];no_copy");
         for(int i = 0; i < ArraySize(m_z_source_labels); i++)
           {
            DPCCOfflineField(wire, m_z_source_labels[i] + ".path=" + m_z_source_paths[i]);
            DPCCOfflineField(wire, m_z_source_labels[i] + ".sha256=" + m_z_source_hashes[i]);
           }
         DPCCOfflineField(wire, "execution_profile.sha256=" + m_z_execution_sha);
         DPCCOfflineField(wire, "config.sha256=" + m_z_config_sha);
         DPCCOfflineField(wire, "oracle_deltas.sha256=" + m_z_deltas_sha);
         DPCCOfflineField(wire, "cursor=" + (string)m_z_step);
         DPCCOfflineField(wire, "decision_bar=" + (string)m_z_last_bar);
         DPCCOfflineField(wire, "row_count=" + (string)m_z_rows);
         DPCCOfflineField(wire, "action_contract=" + DPCC_Z_ACTION_CONTRACT);
         if(server_calendar)
            DPCCOfflineField(wire, "time_domain=" + m_z_time_domain);
         for(int i = 0; i < 3; i++)
           {
            DPCCOfflineField(wire, paths[i]);
            DPCCOfflineField(wire, hashes[i]);
           }
         wire += "COMPACT_CNET_POLICY_TRAINING_STATE_V1\nREBUILD_TRANSIENT_STATE_ON_LOAD\n";
         wire += "FINANCIAL_STATE_AND_POSITION_NOT_SAVED\nMODELS_ONLY_NOT_RESUMABLE_LEDGER_CHECKPOINT\n";
         wire += "NOT_A_READINESS_AUTHORIZATION\nEND_DPCC_Z_ORACLE_MODELS_" + version + "\n";
         string expected = "", actual = "";
         if(!DPCCCheckpointTextSHA(wire, expected, reason) ||
            !DPCCCheckpointWriteText(receipt, m_z_common_files, wire, reason, true) ||
            !DPCCCheckpointFileSHA(receipt, m_z_common_files, DPCC_RESOLVER_MAX_JSON_BYTES, actual, reason) || actual !=
               expected)
            break;
         manifest = receipt;
         sha = actual;
         saved = true;
        }
      while(false);
      FileClose(writer_lock);
      return(saved || Fail(reason == "" ? "study.history.export" : reason, reason));
     }
  };
#endif
#endif
//+------------------------------------------------------------------+
//| Compare the caller's exact native graph, without running a model |
//+------------------------------------------------------------------+
bool DPCCAPNativeDescriptorEqual(CLayerDescription *actual, CLayerDescription *expected)
  {
   if(!actual || !expected || actual.type != expected.type || actual.count != expected.count ||
      actual.window != expected.window || actual.window_out != expected.window_out ||
      actual.step != expected.step || actual.layers != expected.layers || actual.batch != expected.batch ||
      actual.activation != expected.activation || actual.optimization != expected.optimization ||
      actual.probability != expected.probability || actual.variables != expected.variables ||
      ArraySize(actual.windows) != ArraySize(expected.windows) ||
      ArraySize(actual.units) != ArraySize(expected.units) ||
      ArraySize(actual.heads) != ArraySize(expected.heads) || actual.radius.Size() != expected.radius.Size())
      return(false);
   for(int i = 0; i < ArraySize(actual.windows); i++)
      if(actual.windows[i] != expected.windows[i])
         return(false);
   for(int i = 0; i < ArraySize(actual.units); i++)
      if(actual.units[i] != expected.units[i])
         return(false);
   for(int i = 0; i < ArraySize(actual.heads); i++)
      if(actual.heads[i] != expected.heads[i])
         return(false);
   for(ulong i = 0; i < actual.radius.Size(); i++)
      if(actual.radius[i] != expected.radius[i])
         return(false);
   return(true);
  }
//+------------------------------------------------------------------+
//| Decode one known native layer ABI; generic library layers use 0  |
//+------------------------------------------------------------------+
bool DPCCAPNativeLayerABI(CNeuronBaseOCL *layer, CLayerDescription *descriptor, uint &abi)
  {
   abi = 0;
   if(!layer || !descriptor)
      return(false);
   if(layer.Type() == defNeuronScenarioForecastPriceOCL)
     {
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(layer);
      if(!price)
         return(false);
      abi = price.ABI();
     }
   else
      if(layer.Type() == defNeuronScenarioDecoderOCL)
        {
         CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(layer);
         if(!decoder)
            return(false);
         abi = decoder.ABI();
        }
      else
         if(layer.Type() == defNeuronDPCCOCL)
           {
            CNeuronDPCCOCL *policy = dynamic_cast<CNeuronDPCCOCL*>(layer);
            if(!policy || (policy.ActorABI() == 2 && ArraySize(descriptor.windows) != 9) || (policy.ActorABI() == 3 && (
               ArraySize(descriptor.windows) != 0 || ArraySize(descriptor.units) != 8 || descriptor.units[7] != 3)) || (
               policy.ActorABI() != 2 && policy.ActorABI() != 3))
               return(false);
            abi = (policy.ActorABI() == 3 ? 3 : descriptor.windows[0]);
           }
   return(true);
  }
//+------------------------------------------------------------------+
//| Load a native role from its own finite file; retain the AP       |
//| handle Native Load closes its handle and exposes no consumed     |
//| cursor.                                                          |
//+------------------------------------------------------------------+
bool CDPCCAPRoleReader::LoadNative(const SDPCCAPNativeLoadContract &expected,
                                   CArrayObj &expected_graph, const uint &expected_abis[],
                                   COpenCLMy *shared_context, CNet *&model, string &reason)
  {
   return(LoadNativeCore(expected, expected_graph, expected_abis, shared_context, NULL, model, false, reason));
  }
//+------------------------------------------------------------------+
//| Function CDPCCAPRoleReader::LoadNativeInto                       |
//+------------------------------------------------------------------+
bool CDPCCAPRoleReader::LoadNativeInto(const SDPCCAPNativeLoadContract &expected, CNet &destination,
                                       COpenCLMy *shared_context, string &reason)
  {
   reason = "";
   const bool market_section = (expected.role == 1 && (expected.section_id == 100 || expected.section_id == 101));
   const bool trading_section = (expected.role == 2 && expected.section_id >= 110 && expected.section_id <= 115);
   if(!market_section && !trading_section)
     {
      reason = "dpccap.native.destination_role";
      return(false);
     }
   CArrayObj expected_graph;
   expected_graph.FreeMode(true);
   uint expected_abis[];
   for(int i = 0; i < 64; i++)
     {
      CNeuronBaseOCL *layer = destination.Layer(i);
      if(!layer)
         break;
      CLayerDescription *description = layer.GetLayerInfo();
      uint abi = 0;
      if(!description || !DPCCAPNativeLayerABI(layer, description, abi))
        {
         if(description)
            delete description;
         reason = "dpccap.native.destination_graph";
         return(false);
        }
      if(!expected_graph.Add(description))
        {
         delete description;
         reason = "dpccap.native.destination_graph_capacity";
         return(false);
        }
      const int count = ArraySize(expected_abis);
      if(ArrayResize(expected_abis, count + 1) != count + 1)
        {
         reason = "dpccap.native.destination_abi_capacity";
         return(false);
        }
      expected_abis[count] = abi;
     }
   if(expected_graph.Total() == 0 || expected_graph.Total() != ArraySize(expected_abis))
     {
      reason = "dpccap.native.destination_graph_empty";
      return(false);
     }
   CNet *unused = NULL;
   return(LoadNativeCore(expected, expected_graph, expected_abis, shared_context,
                         GetPointer(destination), unused, false, reason));
  }
//+------------------------------------------------------------------+
//| Load only a published, technically accepted Market section       |
//+------------------------------------------------------------------+
bool CDPCCAPRoleReader::LoadReadyMarketInto(const SDPCCAPNativeLoadContract &expected,
      CNet &destination, COpenCLMy *shared_context,
      string &reason, const bool allow_pending_training)
  {
   if(expected.role != 1 || expected.section_id != 100)
     {
      reason = "dpccap.ready_market.role_or_section";
      return(false);
     }
   CArrayObj expected_graph;
   expected_graph.FreeMode(true);
   uint expected_abis[];
   for(int i = 0; i < 64; i++)
     {
      CNeuronBaseOCL *layer = destination.Layer(i);
      if(!layer)
         break;
      CLayerDescription *description = layer.GetLayerInfo();
      uint abi = 0;
      if(!description || !DPCCAPNativeLayerABI(layer, description, abi))
        {
         if(description)
            delete description;
         reason = "dpccap.ready_market.destination_graph";
         return(false);
        }
      if(!expected_graph.Add(description))
        {
         delete description;
         reason = "dpccap.ready_market.destination_graph_capacity";
         return(false);
        }
      const int count = ArraySize(expected_abis);
      if(ArrayResize(expected_abis, count + 1) != count + 1)
        {
         reason = "dpccap.ready_market.destination_abi_capacity";
         return(false);
        }
      expected_abis[count] = abi;
     }
   if(expected_graph.Total() != 8 || expected_graph.Total() != ArraySize(expected_abis))
     {
      reason = "dpccap.ready_market.destination_graph_shape";
      return(false);
     }
   CNet *unused = NULL;
   return(LoadNativeCore(expected, expected_graph, expected_abis, shared_context,
                         GetPointer(destination), unused, !allow_pending_training, reason));
  }
//+------------------------------------------------------------------+
//| Function CDPCCAPRoleReader::ReadJSONSection                      |
//+------------------------------------------------------------------+
bool CDPCCAPRoleReader::ReadJSONSection(const uint section_id, const ulong maximum_bytes,
                                        string &text, string &reason)
  {
   text = "";
   reason = "";
   if(m_handle == INVALID_HANDLE || m_active != -1 || maximum_bytes == 0 || maximum_bytes > 1048576)
     {
      reason = "dpccap.reader.json_contract";
      return(false);
     }
   int section = -1;
   for(int i = 0; i < ArraySize(m_sections); i++)
      if(m_sections[i].id == section_id && m_sections[i].encoding == 1)
         section = i;
   if(section < 0 || m_sections[section].length == 0 || m_sections[section].length > maximum_bytes)
     {
      reason = "dpccap.reader.json_section_limit";
      return(false);
     }
   int handle = INVALID_HANDLE;
   if(!BeginSection(section_id, 1, handle, reason))
      return(false);
   uchar bytes[];
   const int length = (int)m_sections[section].length;
   if(ArrayResize(bytes, length) != length || FileReadArray(handle, bytes, 0, length) != (uint)length ||
      !EndSection(reason))
     {
      reason = "dpccap.reader.json_read";
      return(false);
     }
   CDPCCIncrementalSHA256 hash;
   uchar digest[];
   string observed = "";
   if(!hash.Init(reason) || !hash.Update(bytes, 0, length, reason) ||
      !hash.Final(digest, observed, reason) || observed != m_sections[section].sha256 ||
      !DPCCStrictUtf8Decode(bytes, length, (int)maximum_bytes, text, reason))
     {
      text = "";
      reason = "dpccap.reader.json_integrity:" + reason;
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function CDPCCAPRoleReader::VerifySectionIntegrity               |
//+------------------------------------------------------------------+
bool CDPCCAPRoleReader::VerifySectionIntegrity(const uint section_id, const uint encoding, string &reason)
  {
   reason = "";
   if(m_handle == INVALID_HANDLE || m_active != -1 || (encoding != 1 && encoding != 2))
     {
      reason = "dpccap.reader.section_integrity_contract";
      return(false);
     }
   int section = -1;
   for(int i = 0; i < ArraySize(m_sections); i++)
      if(m_sections[i].id == section_id && m_sections[i].encoding == encoding)
         section = i;
   if(section < 0 || m_sections[section].length == 0)
     {
      reason = "dpccap.reader.section_integrity_missing";
      return(false);
     }
   int handle = INVALID_HANDLE;
   if(!BeginSection(section_id, encoding, handle, reason))
      return(false);
   CDPCCIncrementalSHA256 hash;
   uchar bytes[];
   bool ok = (ArrayResize(bytes, DPCC_AP_HASH_CHUNK) == DPCC_AP_HASH_CHUNK && hash.Init(reason));
   ulong remaining = m_sections[section].length;
   while(ok && remaining > 0)
     {
      const uint count = (uint)MathMin((ulong)DPCC_AP_HASH_CHUNK, remaining);
      if(FileReadArray(handle, bytes, 0, count) != count || !hash.Update(bytes, 0, (int)count, reason))
         ok = false;
      else
         remaining -= count;
     }
   const bool ended = EndSection(reason);
   uchar digest[];
   string observed = "";
   if(!ok || !ended || remaining != 0 || !hash.Final(digest, observed, reason) ||
      observed != m_sections[section].sha256)
     {
      reason = "dpccap.reader.section_integrity_sha";
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Resolve only metadata admitted by the ready-Market reader gates  |
//+------------------------------------------------------------------+
bool CDPCCAPRoleReader::ReadReadyMarketContract(const string market_profile_sha256, const string task_id,
      const ulong max_native_bytes,
      SDPCCAPNativeLoadContract &expected, string &reason,
      const bool allow_pending_training)
  {
   ZeroMemory(expected);
   reason = "";
   if(m_handle == INVALID_HANDLE || m_active != -1 || m_role != 1 ||
      !DPCCResolverLowerSha256(m_source_abi) || !DPCCResolverLowerSha256(market_profile_sha256) ||
      !DPCCDataNonemptyText(task_id) || max_native_bytes == 0 || max_native_bytes > (ulong)LONG_MAX ||
      FileSize(m_handle) > max_native_bytes)
     {
      reason = "dpccap.ready_market.resolve_contract";
      return(false);
     }
   string manifest_text = "";
   if(!ReadJSONSection(1, 1048576, manifest_text, reason))
      return(false);
   CDPCCJsonDocument document;
   if(!document.Parse(manifest_text, reason))
      return(false);
   const int root = document.Root(), profile = document.FindMember(root, "profile");
   string contract = "", revision = "", role = "", abi = "", data = "", archive = "", task = "", stage = "";
   string auxiliary_target_policy = "";
   string profile_task = "", observed_profile_sha = "", observed_market_profile_sha = "";
   bool ready = false;
   if(document.Type(root) != DPCC_JSON_OBJECT || document.Type(profile) != DPCC_JSON_OBJECT ||
      !DPCCM05KnownMembers(document, profile, "|task_id|sha256|market_sha256|contents|",
                           "native.manifest.profile", reason) ||
      !DPCCResourceReadString(document, root, "contract_id", contract, reason, "native.manifest.contract") ||
      !DPCCResourceReadString(document, root, "revision", revision, reason, "native.manifest.revision") ||
      !DPCCResourceReadString(document, root, "role", role, reason, "native.manifest.role") ||
      !DPCCResourceReadString(document, root, "source_abi_sha256", abi, reason, "native.manifest.abi") ||
      !DPCCResourceReadString(document, root, "data_sha256", data, reason, "native.manifest.data") ||
      !DPCCResourceReadString(document, root, "source_archive_sha256", archive, reason, "native.manifest.archive") ||
      !DPCCResourceReadString(document, root, "task_id", task, reason, "native.manifest.task") ||
      !DPCCResourceReadString(document, root, "stage", stage, reason, "native.manifest.stage") ||
      !DPCCResourceReadString(document, root, "auxiliary_target_policy", auxiliary_target_policy, reason,
                              "native.manifest.auxiliary_target_policy") ||
      !DPCCResourceReadString(document, profile, "task_id", profile_task, reason, "native.manifest.profile_task") ||
      !DPCCResourceReadString(document, profile, "sha256", observed_profile_sha, reason, "native.manifest.profile") ||
      !DPCCResourceReadString(document, profile, "market_sha256", observed_market_profile_sha, reason,
                              "native.manifest.profile.market_sha") ||
      !DPCCResourceReadBool(document, root, "ready", ready, reason, "native.manifest.ready"))
      return(false);
   const bool supported_training_stage = (stage == "LATENT_PREPARE" || stage == "PRICE_JOINT" ||
                                          stage == "OMPB_CALIBRATE" || stage == "PRICE_ADAPT" || stage == "VERIFY");
   const int profile_contents = document.FindMember(profile, "contents");
   string embedded_profile_sha = "", embedded_market_profile_sha = "";
   CDPCCJsonDocument embedded_profile;
   if(document.Type(profile_contents) != DPCC_JSON_STRING ||
      !DPCCCheckpointTextSHA(document.Text(profile_contents), embedded_profile_sha, reason) ||
      embedded_profile_sha != observed_profile_sha ||
      !embedded_profile.Parse(document.Text(profile_contents), reason) ||
      !DPCCExecutionMarketProfileSHA(embedded_profile, embedded_profile.Root(),
                                     embedded_market_profile_sha, reason))
      return(false);
   StringToLower(archive);
   const int dependency = document.FindMember(root, "market_dependency_sha256");
   if(contract != DPCC_AP_CONTRACT || revision != DPCC_M05_MARKET_REVISION || role != "Market" ||
      auxiliary_target_policy != DPCC_M05_TARGET_POLICY ||
      task != task_id || profile_task != task_id || !DPCCResolverLowerSha256(observed_profile_sha) ||
      observed_market_profile_sha != market_profile_sha256 ||
      embedded_market_profile_sha != observed_market_profile_sha ||
      abi != m_source_abi || !DPCCResolverLowerSha256(data) || !DPCCResolverLowerSha256(archive) ||
      !DPCCDataNonemptyText(stage) || (allow_pending_training && !supported_training_stage) ||
      document.Type(dependency) != DPCC_JSON_NULL ||
      (!allow_pending_training && !ready))
     {
      reason = "dpccap.native.manifest_binding";
      return(false);
     }
   bool have_manifest = false, have_market = false, have_locator = false, have_resume = false;
   bool have_runtime_snapshot = false;
   for(int i = 0; i < ArraySize(m_sections); i++)
     {
      const uint id = m_sections[i].id;
      const uint encoding = m_sections[i].encoding;
      if(id == 1 && encoding == 1)
         have_manifest = true;
      else
         if(id == 100 && encoding == 2)
            have_market = true;
         else
            if(id == 102 && encoding == 1)
               have_locator = true;
            else
               if(id == 200 && encoding == 1)
                  have_resume = true;
               else
                  if(id == 210 && encoding == 3)
                     have_runtime_snapshot = true;
                  else
                    {
                     reason = "dpccap.ready_market.section_inventory";
                     return(false);
                    }
     }
   if(!have_manifest || !have_market || !have_locator || !have_resume ||
      ArraySize(m_sections) != (have_runtime_snapshot ? 5 : 4))
     {
      reason = "dpccap.ready_market.section_inventory";
      return(false);
     }
   bool calibration_completed = false, stage02_quality_pass = false;
   if(!DPCCResourceReadBool(document, root, "calibration_completed", calibration_completed, reason,
                            "native.manifest.calibration_completed") ||
      !DPCCResourceReadBool(document, root, "stage02_quality_pass", stage02_quality_pass, reason,
                            "native.manifest.stage02_quality_pass") ||
      (!allow_pending_training &&
       (!calibration_completed || (stage != "PRICE_ADAPT" && stage != "VERIFY"))))
     {
      reason = "dpccap.ready_market.training_or_calibration_not_complete";
      return(false);
     }
   const int acceptance = document.FindMember(root, "acceptance");
   if(document.Type(acceptance) != DPCC_JSON_ARRAY || document.ChildCount(acceptance) != 1)
     {
      reason = "dpccap.ready_market.acceptance_shape";
      return(false);
     }
   const int item = document.FirstChild(acceptance);
   string case_id = "", status = "";
   const int evidence_node = document.FindMember(item, "evidence_sha256");
   if(document.Type(item) != DPCC_JSON_OBJECT || document.ChildCount(item) != 3 ||
      !DPCCResourceReadString(document, item, "case_id", case_id, reason, "native.acceptance.case_id") ||
      !DPCCResourceReadString(document, item, "status", status, reason, "native.acceptance.status") ||
      case_id != "A01-A15" ||
      !((status == "NOT_RUN" && document.Type(evidence_node) == DPCC_JSON_NULL) ||
        (status == "PASS" && document.Type(evidence_node) == DPCC_JSON_STRING &&
         DPCCResolverLowerSha256(document.Text(evidence_node)))))
     {
      reason = "dpccap.ready_market.acceptance_receipt_invalid";
      return(false);
     }
   string locator_text = "";
   if(!ReadJSONSection(102, 1048576, locator_text, reason))
     {
      reason = "dpccap.ready_market.locator_read:" + reason;
      return(false);
     }
   CDPCCJsonDocument locator;
   string state_owner = "";
   const int locator_root = (locator.Parse(locator_text, reason) ? locator.Root() : -1);
   if(locator_root < 0 || locator.Type(locator_root) != DPCC_JSON_OBJECT || locator.ChildCount(locator_root) != 1 ||
      !DPCCResourceReadString(locator, locator_root, "state_owner", state_owner, reason,
         "native.locator.state_owner") ||
      state_owner != "section100.layer5")
     {
      reason = "dpccap.ready_market.locator_contract";
      return(false);
     }
   SDPCCAPNativeLoadContract candidate;
   candidate.role = 1;
   candidate.section_id = 100;
   candidate.encoding = 2;
   candidate.max_native_bytes = max_native_bytes;
   candidate.source_abi_sha256 = abi;
   candidate.profile_sha256 = observed_profile_sha;
   candidate.market_profile_sha256 = observed_market_profile_sha;
   candidate.data_sha256 = data;
   candidate.market_dependency_sha256 = "";
   candidate.source_archive_sha256 = archive;
   candidate.task_id = task;
   candidate.stage = stage;
   candidate.market_ready = ready;
   candidate.calibration_completed = calibration_completed;
   candidate.stage02_quality_pass = stage02_quality_pass;
   expected = candidate;
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Bind a ready Market path and native contract to the assigned     |
//| profile                                                          |
//+------------------------------------------------------------------+
bool DPCCResolveReadyMarketContract(const SDPCCExecutionControl &control, const bool common_files,
                                    string &market_path, SDPCCAPNativeLoadContract &expected, string &reason,
                                    const bool allow_pending_training = false)
  {
   market_path = "";
   ZeroMemory(expected);
   reason = "";
   string canonical = "", profile_sha = "";
   if(!DPCCResolverLowerSha256(control.profile_sha256) ||
      !DPCCResolverLowerSha256(control.market_profile_sha256) || !DPCCDataNonemptyText(control.task_id) ||
      control.profile_text == "" ||
      !DPCCCheckpointTextSHA(control.profile_text, profile_sha, reason) ||
      profile_sha != control.profile_sha256)
     {
      reason = "ready_market.profile.control_binding:" + reason;
      return(false);
     }
   CDPCCJsonDocument profile;
   if(!profile.Parse(control.profile_text, reason))
      return(false);
   const int root = profile.Root(), persistence = profile.FindMember(root, "persistence");
   string market_profile_sha = "";
   if(!DPCCExecutionMarketProfileSHA(profile, root, market_profile_sha, reason) ||
      market_profile_sha != control.market_profile_sha256)
     {
      reason = "ready_market.profile.market_scope_changed:" + reason;
      return(false);
     }
   string contract = "", revision = "", kind = "", task = "", symbol_source = "", directory = "";
   long maximum_signed = 0;
   if(profile.Type(root) != DPCC_JSON_OBJECT ||
      !DPCCExecutionProfileString(profile, root, "contract_id", contract, reason) ||
      !DPCCExecutionProfileString(profile, root, "revision", revision, reason) ||
      !DPCCExecutionProfileString(profile, root, "profile_kind", kind, reason) ||
      !DPCCExecutionProfileString(profile, root, "task_id", task, reason) ||
      !DPCCExecutionProfileString(profile, root, "symbol_source", symbol_source, reason) ||
      !DPCCResourceReadString(profile, persistence, "task_directory", directory, reason,
                              "profile.persistence.task_directory") ||
      !DPCCResourceReadLong(profile, persistence, "max_file_bytes", maximum_signed, reason,
                            "profile.persistence.max_file_bytes"))
      return(false);
   if(contract != DPCC_AP_CONTRACT || revision != "CNET_ACTION6_20261014" || kind != "USER_ASSIGNED" ||
      task != control.task_id || symbol_source != "CHART_SYMBOL" || maximum_signed <= 0 ||
      !DPCCCheckpointCanonicalPath(directory, canonical, reason) || directory != canonical)
     {
      reason = "ready_market.profile.assigned_persistence_required";
      return(false);
     }
//--- Header discovery selects an ABI to validate, never a readiness verdict.
   const string path = directory + "/Market.current.dpc";
   const ulong maximum = (ulong)maximum_signed;
   const int handle = FileOpen(path, FILE_READ | FILE_BIN | (common_files ? FILE_COMMON : 0));
   if(handle == INVALID_HANDLE)
     {
      reason = StringFormat("ready_market.header.open.%d", GetLastError());
      return(false);
     }
   uchar header[];
   const bool header_read = DPCCAPReadRecord(handle, 0, DPCC_AP_HEADER_BYTES, header, reason);
   FileClose(handle);
   if(!header_read)
      return(false);
   const string source_abi = DPCCAPReadSHA(header, 40);
   if(!DPCCResolverLowerSha256(source_abi))
     {
      reason = "ready_market.header.source_abi";
      return(false);
     }
//--- The reader locks the role and authenticates every section before metadata resolution.
   CDPCCAPRoleReader reader;
   if(!reader.Open(path, common_files, 1, source_abi, maximum, 64, reason))
      return(false);
   SDPCCAPNativeLoadContract candidate;
   const bool resolved = reader.ReadReadyMarketContract(control.market_profile_sha256, control.task_id,
                         maximum, candidate, reason, allow_pending_training);
   reader.Close();
   if(!resolved)
      return(false);
   market_path = path;
   expected = candidate;
   reason = "";
   return(true);
  }
//--- Read the profile-bound FIT normalization used by the 109-coordinate Actor condition.
bool DPCCResolveAction6ConditionProfile(const SDPCCExecutionControl &control,
                                        float &scale[], float &bias[], string &reason)
  {
   reason = "";
   string text = "", sha = "";
   if(control.profile_text == "" || !DPCCCheckpointTextSHA(control.profile_text, sha, reason) ||
      sha != control.profile_sha256)
     {
      reason = "ready_market.condition.profile_identity:" + reason;
      return(false);
     }
   CDPCCJsonDocument profile;
   if(!profile.Parse(control.profile_text, reason))
      return(false);
   const int root = profile.Root(), condition = profile.FindMember(root, "condition");
   string source = "";
   if(condition < 0 || !DPCCResourceReadString(profile, condition, "normalization_source", source,
         reason, "condition.normalization_source") ||
      source == "DIAGNOSTIC_IDENTITY_NOT_TRAINING" || source == "TEMPLATE_NOT_AUTHORIZED")
     {
      reason = "BLOCKED:ready_market.condition.fit_normalization_required";
      return(false);
     }
   const int scale_node = profile.FindMember(condition, "scale"), bias_node = profile.FindMember(condition, "bias");
   if(profile.ChildCount(scale_node) != 109 || profile.ChildCount(bias_node) != 109 ||
      ArrayResize(scale, 109) != 109 || ArrayResize(bias, 109) != 109)
     {
      reason = "BLOCKED:ready_market.condition.normalization_shape";
      return(false);
     }
   for(int i = 0; i < 109; i++)
     {
      double s = 0, b = 0;
      if(!profile.TryNumber(profile.ChildAt(scale_node, i), s) ||
         !profile.TryNumber(profile.ChildAt(bias_node, i), b) || !MathIsValidNumber(s) || s <= 0 ||
         !MathIsValidNumber(b) || MathAbs(s) > 3.402823466e38 || MathAbs(b) > 3.402823466e38)
        {
         reason = StringFormat("BLOCKED:ready_market.condition.normalization_value_%d", i);
         return(false);
        }
      scale[i] = (float)s;
      bias[i] = (float)b;
     }
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Owned Trading restore metadata shared by StudyOnline and Test    |
//+------------------------------------------------------------------+
struct SDPCCAction6TradingRestore
  {
   SDPCCRuntimeConfig runtime;
   SDPCCAPNativeLoadContract market_contract;
   float             limits[];
   string            market_path, market_sha256, trading_path, trading_sha256;
   string            raw_path, raw_sha256, model_sha256, study_run_sha256;
   string            source_stage;
   ulong             completed_transitions;
   ulong             diffusion_seed;
   bool              floor_reached;
  };
//+------------------------------------------------------------------+
//| Drop an unpublished bundle before releasing its borrowed Market  |
//+------------------------------------------------------------------+
void DPCCReleaseAction6Trading(CNet *&actor, CNet *&q1, CNet *&q2,
                               CNet *&target_actor, CNet *&target_q1, CNet *&target_q2)
  {
   if(CheckPointer(actor) != POINTER_INVALID)
      delete actor;
   if(CheckPointer(target_actor) != POINTER_INVALID)
      delete target_actor;
   if(CheckPointer(q1) != POINTER_INVALID)
      delete q1;
   if(CheckPointer(q2) != POINTER_INVALID)
      delete q2;
   if(CheckPointer(target_q1) != POINTER_INVALID)
      delete target_q1;
   if(CheckPointer(target_q2) != POINTER_INVALID)
      delete target_q2;
   actor = NULL;
   q1 = NULL;
   q2 = NULL;
   target_actor = NULL;
   target_q1 = NULL;
   target_q2 = NULL;
  }
//+------------------------------------------------------------------+
//| Admit profile-bound Study or Online roles before any CNet is     |
//| changed                                                          |
//+------------------------------------------------------------------+
bool DPCCResolveAction6TradingGeneration(CDPCCAPRoleReader &reader,
      const SDPCCExecutionControl &control,
      const SDPCCAPNativeLoadContract &market_contract,
      const string market_sha, CDPCCJsonDocument &assigned_profile,
      SDPCCAction6TradingRestore &resolved,
      SDPCCAPNativeLoadContract &native, string &reason)
  {
   string manifest_text = "", resume_text = "";
   if(!reader.ReadJSONSection(1, 1048576, manifest_text, reason) ||
      !reader.ReadJSONSection(200, 1048576, resume_text, reason))
      return(false);
   CDPCCJsonDocument manifest, resume;
   if(!manifest.Parse(manifest_text, reason) || !resume.Parse(resume_text, reason))
      return(false);
   const int root = manifest.Root(), profile = manifest.FindMember(root, "profile"),
             model = manifest.FindMember(root, "model"), financial = manifest.FindMember(root, "financial_profile"),
             source = manifest.FindMember(root, "data_source"), record = resume.Root();
   const int raw_sha_member = manifest.FindMember(source, "sha256");
   string contract = "", revision = "", role = "", task = "", stage = "", profile_sha = "", profile_task = "";
   string data_sha = "", dependency = "", archive = "", model_sha = "", model_text = "", financial_sha = "",
      financial_payload = "";
   string raw_path = "", raw_sha = "", study_run = "", resume_run = "", resume_profile = "", resume_stage = "", abi =
      "";
   long saved_mode = -1, rows = 0, completed = 0, next = 0, updates = 0;
   bool complete = false, floor = false, ready = false;
   const bool test_ablation = (control.stage == DPCC_STAGE_TEST);
   const bool allow_warm_start = (test_ablation || control.stage == DPCC_STAGE_STUDYONLINE);
   if(!DPCCResourceReadString(manifest, root, "contract_id", contract, reason, "trading.contract_id") ||
      !DPCCResourceReadString(manifest, root, "revision", revision, reason, "trading.revision") ||
      !DPCCResourceReadString(manifest, root, "role", role, reason, "trading.role") ||
      !DPCCResourceReadString(manifest, root, "task_id", task, reason, "trading.task_id") ||
      !DPCCResourceReadString(manifest, root, "stage", stage, reason, "trading.stage") ||
      !DPCCResourceReadString(manifest, root, "source_abi_sha256", abi, reason, "trading.source_abi_sha256") ||
      !DPCCResourceReadString(manifest, root, "data_sha256", data_sha, reason, "trading.data_sha256") ||
      !DPCCResourceReadString(manifest, root, "market_dependency_sha256", dependency, reason,
         "trading.market_dependency") ||
      !DPCCResourceReadString(manifest, root, "source_archive_sha256", archive, reason, "trading.archive") ||
      !DPCCResourceReadString(manifest, root, "study_run_sha256", study_run, reason, "trading.study_run_sha256") ||
      !DPCCResourceReadLong(manifest, root, "study_mode", saved_mode, reason, "trading.study_mode") ||
      !DPCCResourceReadBool(manifest, root, "ready", ready, reason, "trading.ready") ||
      !DPCCResourceReadString(manifest, profile, "sha256", profile_sha, reason, "trading.profile.sha256") ||
      !DPCCResourceReadString(manifest, profile, "task_id", profile_task, reason, "trading.profile.task_id") ||
      !DPCCResourceReadString(manifest, model, "sha256", model_sha, reason, "trading.model.sha256") ||
      !DPCCResourceReadString(manifest, model, "contents", model_text, reason, "trading.model.contents") ||
      !DPCCResourceReadString(manifest, financial, "sha256", financial_sha, reason,
         "trading.financial_profile.sha256") ||
      !DPCCResourceReadString(manifest, financial, "payload", financial_payload, reason,
         "trading.financial_profile.payload") ||
      !DPCCResourceReadString(manifest, source, "path", raw_path, reason, "trading.data_source.path") ||
      raw_sha_member < 0)
      return(false);
   if(manifest.Type(raw_sha_member) == DPCC_JSON_STRING)
     {
      if(!DPCCResourceReadString(manifest, source, "sha256", raw_sha, reason, "trading.data_source.sha256"))
         return(false);
     }
   else
      if(manifest.Type(raw_sha_member) == DPCC_JSON_NULL)
         raw_sha = "";
      else
        {
         reason = "BLOCKED:trading.data_source.sha256_type";
         return(false);
        }
   if(!DPCCResourceReadBool(resume, record, "training_complete", complete, reason,
                            "BLOCKED:trading.resume.training_complete_required") ||
      !DPCCResourceReadString(resume, record, "study_run_sha256", resume_run, reason,
         "trading.resume.study_run_sha256") ||
      !DPCCResourceReadString(resume, record, "profile_sha256", resume_profile, reason,
         "trading.resume.profile_sha256") ||
      !DPCCResourceReadString(resume, record, "stage", resume_stage, reason, "trading.resume.stage"))
      return(false);
   if(stage == "Study")
     {
      if(!DPCCResourceReadBool(resume, record, "floor_reached", floor, reason, "trading.resume.floor_reached") ||
         !DPCCResourceReadLong(resume, record, "row_count", rows, reason, "trading.resume.row_count") ||
         !DPCCResourceReadLong(resume, record, "completed_transitions", completed, reason,
                               "trading.resume.completed_transitions") ||
         !DPCCResourceReadLong(resume, record, "next_record", next, reason, "trading.resume.next_record") ||
         !DPCCResourceReadLong(resume, record, "policy_updates", updates, reason, "trading.resume.policy_updates") ||
         rows <= 0 || completed <= 0 || completed > rows || next != completed || updates < completed ||
         resume.Type(resume.FindMember(record, "pending")) != DPCC_JSON_NULL)
        {
         reason = "BLOCKED:trading.study_checkpoint_consistency:" + reason;
         return(false);
        }
     }
   else
      if(stage == "StudyOnline")
        {
         string restart = "", completion = "";
         if((control.stage == DPCC_STAGE_STUDYONLINE &&
             control.resume_mode != DPCC_RESUME_NEW_EPISODE_FROM_WEIGHTS) ||
            !DPCCM05KnownMembers(resume, record,
                                 "|stage|training_complete|profile_sha256|study_run_sha256|restart_policy|completion_reason|",
                                 "trading.online_metadata", reason) ||
            !DPCCResourceReadString(resume, record, "restart_policy", restart, reason,
               "trading.online.restart_policy") ||
            !DPCCResourceReadString(resume, record, "completion_reason", completion, reason,
                                    "trading.online.completion_reason") ||
            restart != "LATEST_MODELS_REPLAY_HISTORY_CURRENT_ACCOUNT" ||
            (completion != "TRAINING_END" && completion != "CONTROLLED_FLOOR"))
           {
            reason = "BLOCKED:trading.Online_requires_models_only_NEW_EPISODE_FROM_WEIGHTS:" + reason;
            return(false);
           }
         floor = (completion == "CONTROLLED_FLOOR");
        }
      else
        {
         reason = "BLOCKED:trading.completed_Study_or_StudyOnline_required";
         return(false);
        }
   string canonical = "", actual_model_sha = "", actual_financial_sha = "";
   StringToLower(archive);
   if(contract != DPCC_AP_CONTRACT || revision != DPCC_TRADING_REVISION || role != "Trading" ||
      task != control.task_id || profile_task != control.task_id || resume_stage != stage ||
      (!allow_warm_start && (profile_sha != control.profile_sha256 || resume_profile != control.profile_sha256 ||
                             dependency != market_sha || data_sha != market_contract.data_sha256 ||
                             archive != market_contract.source_archive_sha256)) ||
      (raw_sha != "" && raw_sha != data_sha) ||
      saved_mode < DPCC_P0 || saved_mode > DPCC_P2 ||
      !DPCCResolverLowerSha256(abi) || !DPCCResolverLowerSha256(model_sha) ||
      !DPCCResolverLowerSha256(financial_sha) || !DPCCResolverLowerSha256(study_run) || study_run != resume_run ||
      (!complete && control.stage != DPCC_STAGE_STUDYONLINE && control.stage != DPCC_STAGE_TEST) ||
      manifest.Type(manifest.FindMember(root, "data_index_sha256")) != DPCC_JSON_NULL ||
      !DPCCCheckpointCanonicalPath(raw_path, canonical, reason) || canonical != raw_path ||
      !DPCCCheckpointTextSHA(model_text, actual_model_sha, reason) || actual_model_sha != model_sha ||
      !DPCCCheckpointTextSHA(financial_payload, actual_financial_sha, reason) || actual_financial_sha !=
         financial_sha ||
      (!allow_warm_start && !DPCCBankJsonEqual(manifest, manifest.FindMember(profile, "contents"),
            assigned_profile, assigned_profile.Root(), 0)))
     {
      reason = "BLOCKED:trading.completed_profile_market_binding:" + reason;
      return(false);
     }
   if(control.stage == DPCC_STAGE_STUDYONLINE &&
      (profile_sha != control.profile_sha256 || resume_profile != control.profile_sha256 ||
       dependency != market_sha || data_sha != market_contract.data_sha256 ||
       archive != market_contract.source_archive_sha256))
      PrintFormat(
                  "DPCC_STUDYONLINE_TRANSFER source_stage=%s training_complete=%s " +
                  "profile_match=%s market_match=%s data_match=%s",
                  stage, complete ? "true" : "false",
                  (profile_sha == control.profile_sha256 && resume_profile == control.profile_sha256) ? "true" : "false",
                  (dependency == market_sha && archive == market_contract.source_archive_sha256) ? "true" : "false",
                  data_sha == market_contract.data_sha256 ? "true" : "false");
   if(test_ablation)
      PrintFormat(
                  "DPCC_TEST_ABLATION source_stage=%s training_complete=%s generation_ready=%s profile_match=%s market_match=%s data_match=%s",
                  stage, complete ? "true" : "false", ready ? "true" : "false",
                  (profile_sha == control.profile_sha256 && resume_profile == control.profile_sha256 &&
                   DPCCBankJsonEqual(manifest, manifest.FindMember(profile, "contents"),
                                     assigned_profile, assigned_profile.Root(), 0)) ? "true" : "false",
                  dependency == market_sha ? "true" : "false",
                  data_sha == market_contract.data_sha256 ? "true" : "false");
   const int diffusion = assigned_profile.FindMember(assigned_profile.Root(), "diffusion");
   const int seed = assigned_profile.FindMember(diffusion, "seed");
   if(assigned_profile.Type(seed) != DPCC_JSON_NUMBER ||
      !DPCCCheckpointReadUnsigned(assigned_profile.Text(seed), ULONG_MAX, resolved.diffusion_seed))
     {
      reason = "BLOCKED:trading.assigned_profile.diffusion.seed_exact_uint64_required";
      return(false);
     }
//--- Completed training is distinct from the acceptance verdict in this same manifest.
   if(!DPCCDecodeAction6ModelRuntime(model_text, resolved.runtime, resolved.limits, reason))
      return(false);
   resolved.runtime.financial.mode = (ENUM_DPCC_MODE)saved_mode;
   float scale[], bias[];
   if(!DPCCResolveAction6ConditionProfile(control, scale, bias, reason) ||
      ArrayCopy(resolved.runtime.condition_scale, scale) != 109 ||
      ArrayCopy(resolved.runtime.condition_bias, bias) != 109)
      return(false);
   native.role = 2;
   native.encoding = 2;
   native.section_id = 110;
   native.max_native_bytes = market_contract.max_native_bytes;
   native.source_abi_sha256 = abi;
   native.profile_sha256 = profile_sha;
   native.data_sha256 = data_sha;
   native.market_dependency_sha256 = dependency;
   native.source_archive_sha256 = archive;
   native.task_id = task;
   native.stage = stage;
   resolved.raw_path = raw_path;
   resolved.raw_sha256 = raw_sha;
   resolved.model_sha256 = model_sha;
   resolved.study_run_sha256 = study_run;
   resolved.source_stage = stage;
   resolved.completed_transitions = (ulong)completed;
   resolved.floor_reached = floor;
   return(true);
  }
#ifdef DPCC_TRAJECTORY_ENTRY_STUDY_FORECAST
//+------------------------------------------------------------------+
//| Restore one complete Trading bundle against an accepted Market   |
//+------------------------------------------------------------------+
bool DPCCLoadAction6Trading(const SDPCCExecutionControl &control, const bool common_files,
                            CDPCCStudyForecastCore &market_owner,
                            CNet *&actor, CNet *&q1, CNet *&q2, CNet *&target_actor,
                            CNet *&target_q1, CNet *&target_q2,
                            SDPCCAction6TradingRestore &restored, string &reason)
  {
   ZeroMemory(restored);
   reason = "";
   if(CheckPointer(actor) != POINTER_INVALID || CheckPointer(q1) != POINTER_INVALID ||
      CheckPointer(q2) != POINTER_INVALID || CheckPointer(target_actor) != POINTER_INVALID ||
      CheckPointer(target_q1) != POINTER_INVALID || CheckPointer(target_q2) != POINTER_INVALID ||
      market_owner.ReadyMarketNetwork() != NULL ||
      (control.stage != DPCC_STAGE_STUDYONLINE && control.stage != DPCC_STAGE_TEST))
     {
      reason = "trading.restore.destination_or_stage";
      return(false);
     }
   string market_path = "", market_sha = "";
   SDPCCAPNativeLoadContract market_contract;
   if(!DPCCResolveReadyMarketContract(control, common_files, market_path, market_contract, reason, true) ||
      !DPCCCheckpointFileSHA(market_path, common_files, market_contract.max_native_bytes, market_sha, reason))
      return(false);
   string assigned_text = control.profile_text, assigned_sha = "";
   if(assigned_text == "" || !DPCCCheckpointTextSHA(assigned_text, assigned_sha, reason) ||
      assigned_sha != control.profile_sha256)
      return(false);
   CDPCCJsonDocument assigned_profile;
   if(!assigned_profile.Parse(assigned_text, reason))
      return(false);
   const string suffix = "/Market.current.dpc";
   const int prefix = StringLen(market_path) - StringLen(suffix);
   if(prefix <= 0 || StringSubstr(market_path, prefix) != suffix)
     {
      reason = "trading.restore.market_directory";
      return(false);
     }
   const string directory = StringSubstr(market_path, 0, prefix);
   const string paths[] = {directory + "/Trading.current.dpc", directory + "/Trading.bak.dpc"};
   string last_reason = "trading.restore.no_generation";
   for(int attempt = 0; attempt < ArraySize(paths); attempt++)
     {
      const int handle = FileOpen(paths[attempt], FILE_READ | FILE_BIN | (common_files ? FILE_COMMON : 0));
      if(handle == INVALID_HANDLE)
        {
         if(last_reason == "trading.restore.no_generation")
            last_reason = StringFormat("trading.restore.header.open.%d", GetLastError());
         continue;
        }
      uchar header[];
      const bool header_ok = DPCCAPReadRecord(handle, 0, DPCC_AP_HEADER_BYTES, header, last_reason);
      FileClose(handle);
      if(!header_ok)
         continue;
      CDPCCAPRoleReader reader;
      if(!reader.Open(paths[attempt], common_files, 2, DPCCAPReadSHA(header, 40),
                      market_contract.max_native_bytes, 8, last_reason))
         continue;
      SDPCCAction6TradingRestore candidate;
      SDPCCAPNativeLoadContract native;
      if(!DPCCResolveAction6TradingGeneration(reader, control, market_contract, market_sha,
                                              assigned_profile, candidate, native, last_reason))
        {
         //--- Open already authenticated the whole frame under the shared reader lock.
         if(attempt == 0)
           {
            reason = "BLOCKED:trading.current_generation_not_admitted:" + last_reason;
            return(false);
           }
         continue;
        }
      //--- No fallback after a destructive Market load; reject the entire bundle on failure.
      if(!market_owner.RestoreReadyEncoder(market_path, common_files, candidate.raw_path,
                                           candidate.raw_sha256, control.timeframe, market_contract, reason,
                                           true, true))
         return(false);
      CNet *market = market_owner.ReadyMarketNetwork();
      CNet *roles[6];
      for(int i = 0; i < 6; i++)
         roles[i] = NULL;
      CNeuronDPCCOCL *online_top = NULL, *target_top = NULL;
      bool loaded = false;
      do
        {
         if(!DPCCCreateAction6CriticNet(roles[1], market, reason) ||
            !DPCCCreateAction6CriticNet(roles[2], market, reason) ||
            !DPCCCreateAction6CriticNet(roles[4], market, reason) ||
            !DPCCCreateAction6CriticNet(roles[5], market, reason) ||
            !DPCCCreateAction6ActorNet(roles[0], candidate.runtime, market, roles[1], roles[2], online_top, reason) ||
            !DPCCCreateAction6ActorNet(roles[3], candidate.runtime, market, roles[4], roles[5], target_top, reason))
            break;
         string graphs[6];
         bool graphs_ok = true;
         for(int i = 0; i < 6 && graphs_ok; i++)
            graphs_ok = DPCCAPTradingGraph(*roles[i], (i == 0 || i == 3 ? 2 : 5), graphs[i], reason);
         if(!graphs_ok)
            break;
         const string graph = "{\"Actor\":" + graphs[0] + ",\"Q1\":" + graphs[1] + ",\"Q2\":" + graphs[2] +
                              ",\"TargetActor\":" + graphs[3] + ",\"TargetQ1\":" + graphs[4] + ",\"TargetQ2\":" +
                                 graphs[5] + "}";
         string source_abi = "";
         if(!DPCCCheckpointTextSHA(DPCC_AP_CONTRACT + "\n" + DPCC_TRADING_REVISION +
                                   "\nTRADING_NATIVE_CNET;SIX_ROLES;MARKET_DEPENDENCY_SHA_V1\n" +
                                      native.market_dependency_sha256 + "\n" + graph,
                                   source_abi, reason) || source_abi != native.source_abi_sha256)
           {
            reason = "trading.restore.caller_graph_abi";
            break;
           }
         bool native_ok = true;
         for(int i = 0; i < 6 && native_ok; i++)
           {
            native.section_id = (uint)(110 + i);
            native_ok = reader.LoadNativeInto(native, *roles[i], market.GetOpenCL(), reason);
           }
         if(!native_ok)
            break;
         online_top = dynamic_cast<CNeuronDPCCOCL*>(roles[0].Layer(1));
         target_top = dynamic_cast<CNeuronDPCCOCL*>(roles[3].Layer(1));
         string binding_failure = "";
         if(CheckPointer(online_top) == POINTER_INVALID)
            binding_failure = "actor_layer_missing";
         else if(CheckPointer(target_top) == POINTER_INVALID)
            binding_failure = "target_actor_layer_missing";
         else if(!online_top.MatchesRuntimeConfig(candidate.runtime))
            binding_failure = "actor_runtime_mismatch";
         else if(!target_top.MatchesRuntimeConfig(candidate.runtime))
            binding_failure = "target_actor_runtime_mismatch";
         else if(!online_top.BindPolicyNetworks(market, roles[1], roles[2]))
            binding_failure = "actor_policy_bind";
         else if(!target_top.BindPolicyNetworks(market, roles[4], roles[5]))
            binding_failure = "target_policy_bind";
         if(binding_failure != "")
           {
            const int actor_status = (CheckPointer(online_top) == POINTER_INVALID ? -1 :
                                          (int)online_top.LastStatus());
            const int target_status = (CheckPointer(target_top) == POINTER_INVALID ? -1 :
                                       (int)target_top.LastStatus());
            PrintFormat("DPCC_TRADING_RESTORE_BIND_FAIL cause=%s actor_status=%d target_status=%d",
                        binding_failure, actor_status, target_status);
            reason = "trading.restore.loaded_runtime_or_policy_binding:" + binding_failure;
            break;
           }
         bool frozen = true;
         for(int i = 0; i < 6 && frozen; i++)
            frozen = roles[i].TrainMode(false) && roles[i].SetWeightsUpdate(false);
         if(!frozen || !online_top.SetProjectionMode(control.mode) || !target_top.SetProjectionMode(control.mode))
           {
            reason = "trading.restore.freeze_or_projection_mode";
            break;
           }
         string current_market_sha = "", trading_sha = "";
         if(!DPCCCheckpointFileSHA(market_path, common_files, market_contract.max_native_bytes,
                                   current_market_sha, reason) || current_market_sha != market_sha ||
            !reader.ArtifactSHA256(trading_sha, reason))
           {
            reason = "trading.restore.generation_changed:" + reason;
            break;
           }
         candidate.market_path = market_path;
         candidate.market_sha256 = market_sha;
         candidate.market_contract = market_contract;
         candidate.trading_path = paths[attempt];
         candidate.trading_sha256 = trading_sha;
         candidate.runtime.financial.mode = control.mode;
         restored = candidate;
         actor = roles[0];
         q1 = roles[1];
         q2 = roles[2];
         target_actor = roles[3];
         target_q1 = roles[4];
         target_q2 = roles[5];
         loaded = true;
        }
      while(false);
      if(!loaded)
         DPCCReleaseAction6Trading(roles[0], roles[1], roles[2], roles[3], roles[4], roles[5]);
      return(loaded);
     }
   reason = "BLOCKED:trading.restore.no_completed_generation:" + last_reason;
   return(false);
  }
//+------------------------------------------------------------------+
//| Save the last complete Online models once; account state is      |
//| local                                                            |
//+------------------------------------------------------------------+
bool DPCCSaveAction6OnlineTrading(const SDPCCExecutionControl &control, const bool common_files,
                                  CDPCCStudyForecastCore &market_owner,
                                  CNet &actor, CNet &q1, CNet &q2, CNet &target_actor,
                                  CNet &target_q1, CNet &target_q2,
                                  const SDPCCAction6TradingRestore &loaded,
                                  const bool controlled_floor_stop, bool &save_attempted,
                                  string &output_path, string &output_sha, string &reason)
  {
   output_path = "";
   output_sha = "";
   reason = "";
   if(save_attempted || control.stage != DPCC_STAGE_STUDYONLINE || loaded.trading_path == "" ||
      (loaded.source_stage != "Study" && loaded.source_stage != "StudyOnline"))
     {
      reason = "TRADING_SAVE.online.once_or_source_stage";
      return(false);
     }
   save_attempted = true;
   CNet *market = market_owner.ReadyMarketNetwork();
   CNeuronDPCCOCL *online_top = dynamic_cast<CNeuronDPCCOCL*>(actor.Layer(1));
   CNeuronDPCCOCL *target_top = dynamic_cast<CNeuronDPCCOCL*>(target_actor.Layer(1));
   if(CheckPointer(market) == POINTER_INVALID || market.WeightsUpdateEnabled() ||
      !online_top || !target_top || online_top.HasValidDecision() || target_top.HasValidDecision() ||
      online_top.LastStatus() != DPCC_OK || target_top.LastStatus() != DPCC_OK ||
      !online_top.MatchesRuntimeConfig(loaded.runtime) || !target_top.MatchesRuntimeConfig(loaded.runtime) ||
      actor.Layer(2) != NULL || target_actor.Layer(2) != NULL ||
      !NNQCriticGraph(GetPointer(q1)) || !NNQCriticGraph(GetPointer(q2)) ||
      !NNQCriticGraph(GetPointer(target_q1)) || !NNQCriticGraph(GetPointer(target_q2)))
     {
      reason = "TRADING_SAVE.online.idle_complete_native_graph_required";
      return(false);
     }
   CNet *roles[] = {GetPointer(actor), GetPointer(q1), GetPointer(q2), GetPointer(target_actor),
                    GetPointer(target_q1), GetPointer(target_q2)
                   };
   for(int role = 0; role < 6; role++)
     {
      if(roles[role].GetOpenCL() != market.GetOpenCL() || !roles[role].IsOpenCLTransferReady())
        {
         reason = "TRADING_SAVE.online.role_context";
         return(false);
        }
      for(int previous = 0; previous < role; previous++)
         if(roles[previous] == roles[role])
           {
            reason = "TRADING_SAVE.online.aliased_roles";
            return(false);
           }
     }
//--- Keep Market identity and provenance checks while accepting pending training quality.
   string market_path = "", market_sha = "";
   SDPCCAPNativeLoadContract market_contract;
   if(!DPCCResolveReadyMarketContract(control, common_files, market_path, market_contract, reason, true) ||
      market_path != loaded.market_path ||
      !DPCCCheckpointFileSHA(market_path, common_files, market_contract.max_native_bytes, market_sha, reason) ||
      market_sha != loaded.market_sha256)
     {
      reason = "TRADING_SAVE.online.Market_dependency_changed:" + reason;
      return(false);
     }
   string profile_text = control.profile_text, profile_sha = "";
   if(profile_text == "" || !DPCCCheckpointTextSHA(profile_text, profile_sha, reason) ||
      profile_sha != control.profile_sha256)
      return(false);
   CDPCCJsonDocument assigned_profile;
   if(!assigned_profile.Parse(profile_text, reason))
      return(false);
   const int handle = FileOpen(loaded.trading_path, FILE_READ | FILE_BIN | (common_files ? FILE_COMMON : 0));
   if(handle == INVALID_HANDLE)
     {
      reason = "TRADING_SAVE.online.source_open";
      return(false);
     }
   uchar header[];
   const bool header_ok = DPCCAPReadRecord(handle, 0, DPCC_AP_HEADER_BYTES, header, reason);
   FileClose(handle);
   if(!header_ok)
      return(false);
   CDPCCAPRoleReader reader;
   if(!reader.Open(loaded.trading_path, common_files, 2, DPCCAPReadSHA(header, 40),
                   market_contract.max_native_bytes, 8, reason))
      return(false);
   string source_sha = "", source_manifest = "";
   SDPCCAction6TradingRestore admitted;
   SDPCCAPNativeLoadContract native;
   if(!reader.ArtifactSHA256(source_sha, reason) || source_sha != loaded.trading_sha256 ||
      !DPCCResolveAction6TradingGeneration(reader, control, market_contract, market_sha,
                                           assigned_profile, admitted, native, reason) ||
      admitted.source_stage != loaded.source_stage || admitted.study_run_sha256 != loaded.study_run_sha256 ||
      admitted.model_sha256 != loaded.model_sha256 ||
      !reader.ReadJSONSection(1, 1048576, source_manifest, reason))
     {
      reason = "TRADING_SAVE.online.loaded_source_binding:" + reason;
      return(false);
     }
   CDPCCJsonDocument source;
   if(!source.Parse(source_manifest, reason))
      return(false);
   const int root = source.Root(), model = source.FindMember(root, "model"),
             financial = source.FindMember(root, "financial_profile");
   string model_text = "", financial_text = "", financial_sha = "";
   if(!DPCCResourceReadString(source, model, "contents", model_text, reason, "trading.model.contents") ||
      !DPCCResourceReadString(source, financial, "payload", financial_text, reason,
         "trading.financial_profile.payload") ||
      !DPCCResourceReadString(source, financial, "sha256", financial_sha, reason, "trading.financial_profile.sha256"))
      return(false);
   string graphs[6];
   for(int role = 0; role < 6; role++)
      if(!DPCCAPTradingGraph(*roles[role], (role == 0 || role == 3 ? 2 : 5), graphs[role], reason))
         return(false);
   const string graph = "{\"Actor\":" + graphs[0] + ",\"Q1\":" + graphs[1] + ",\"Q2\":" + graphs[2] +
                        ",\"TargetActor\":" + graphs[3] + ",\"TargetQ1\":" + graphs[4] + ",\"TargetQ2\":" + graphs[5] +
                           "}";
   CDPCCJsonDocument expected_graph;
   if(!expected_graph.Parse(graph, reason) ||
      !DPCCBankJsonEqual(source, source.FindMember(root, "graph"), expected_graph, expected_graph.Root(), 0))
     {
      reason = "TRADING_SAVE.online.loaded_graph_changed:" + reason;
      return(false);
     }
   string source_abi = "";
   if(!DPCCCheckpointTextSHA(DPCC_AP_CONTRACT + "\n" + DPCC_TRADING_REVISION +
                             "\nTRADING_NATIVE_CNET;SIX_ROLES;MARKET_DEPENDENCY_SHA_V1\n" + market_sha + "\n" + graph,
                             source_abi, reason) || source_abi != native.source_abi_sha256)
     {
      reason = "TRADING_SAVE.online.caller_graph_abi";
      return(false);
     }
   const string manifest_text = "{\"contract_id\":" + DPCCAPJSONString(DPCC_AP_CONTRACT) +
                                ",\"revision\":" + DPCCAPJSONString(DPCC_TRADING_REVISION) +
                                ",\"role\":\"Trading\",\"task_id\":" + DPCCAPJSONString(control.task_id) +
                                ",\"stage\":\"StudyOnline\",\"graph\":" + graph +
                                ",\"source_archive_sha256\":" + DPCCAPJSONString(native.source_archive_sha256) +
                                ",\"source_abi_sha256\":" + DPCCAPJSONString(source_abi) +
                                ",\"market_dependency_sha256\":" + DPCCAPJSONString(market_sha) +
                                ",\"data_sha256\":" + DPCCAPJSONString(market_contract.data_sha256) +
                                ",\"data_index_sha256\":null,\"data_source\":{\"path\":" + DPCCAPJSONString(
                                   admitted.raw_path) +
                                ",\"sha256\":" + DPCCAPJSONString(admitted.raw_sha256) + "},\"study_run_sha256\":" +
                                DPCCAPJSONString(admitted.study_run_sha256) + ",\"study_mode\":" + (
                                   string)control.mode +
                                ",\"model\":{\"sha256\":" + DPCCAPJSONString(admitted.model_sha256) +
                                ",\"contents\":" + DPCCAPJSONString(model_text) +
                                   "},\"financial_profile\":{\"sha256\":" +
                                DPCCAPJSONString(financial_sha) + ",\"payload\":" + DPCCAPJSONString(financial_text) +
                                   "},\"profile\":{\"task_id\":" +
                                DPCCAPJSONString(control.task_id) + ",\"sha256\":" + DPCCAPJSONString(
                                   control.profile_sha256) +
                                ",\"contents\":" + profile_text +
                                   "},\"ready\":false,\"acceptance\":[{\"case_id\":\"ONLINE_TRAINING\","
                                "\"status\":\"NOT_RUN\",\"evidence_sha256\":null}]}";
   const string resume = "{\"stage\":\"StudyOnline\",\"training_complete\":true,\"profile_sha256\":" +
                         DPCCAPJSONString(control.profile_sha256) + ",\"study_run_sha256\":" +
                         DPCCAPJSONString(admitted.study_run_sha256) +
                         ",\"restart_policy\":\"LATEST_MODELS_REPLAY_HISTORY_CURRENT_ACCOUNT\",\"completion_reason\":" +
                         DPCCAPJSONString(controlled_floor_stop ? "CONTROLLED_FLOOR" : "TRAINING_END") + "}";
   reader.Close();
   const string suffix = "/Market.current.dpc";
   const int prefix = StringLen(market_path) - StringLen(suffix);
   if(prefix <= 0 || StringSubstr(market_path, prefix) != suffix)
     {
      reason = "TRADING_SAVE.online.Market_directory";
      return(false);
     }
   const string directory = StringSubstr(market_path, 0, prefix);
   return(DPCCAPSaveTradingGeneration(directory, common_files, market_contract.max_native_bytes,
                                      source_abi, manifest_text, resume, actor, q1, q2, target_actor, target_q1,
                                         target_q2,
                                      loaded.trading_path, loaded.trading_sha256, output_path, output_sha, reason));
  }

#endif
//+------------------------------------------------------------------+
//| Function CDPCCAPRoleReader::LoadNativeCore                       |
//+------------------------------------------------------------------+
bool CDPCCAPRoleReader::LoadNativeCore(const SDPCCAPNativeLoadContract &expected,
                                       CArrayObj &expected_graph, const uint &expected_abis[],
                                       COpenCLMy *shared_context, CNet *destination,
                                       CNet *&model, const bool require_ready_market, string &reason)
  {
   reason = "";
   const bool market_section = (expected.role == 1 && (expected.section_id == 100 || expected.section_id == 101));
   const bool trading_section = (expected.role == 2 && expected.section_id >= 110 && expected.section_id <= 115);
   if(model || (destination && CheckPointer(destination) == POINTER_INVALID) ||
      (shared_context && CheckPointer(shared_context) == POINTER_INVALID) ||
      m_handle == INVALID_HANDLE || m_active != -1 || m_role != expected.role ||
      m_source_abi != expected.source_abi_sha256 || (!market_section && !trading_section) ||
      expected.encoding != 2 || expected.max_native_bytes == 0 || expected.max_native_bytes > (ulong)LONG_MAX ||
      expected_graph.Total() < 1 || expected_graph.Total() != ArraySize(expected_abis) ||
      !DPCCResolverLowerSha256(expected.source_abi_sha256) ||
      !DPCCResolverLowerSha256(expected.profile_sha256) ||
      (expected.role == 1 && !DPCCResolverLowerSha256(expected.market_profile_sha256)) ||
      !DPCCResolverLowerSha256(expected.data_sha256) || expected.task_id == "" || expected.stage == "" ||
      (expected.role == 1 && expected.market_dependency_sha256 != "") ||
      (require_ready_market && (expected.role != 1 || expected.section_id != 100)) ||
      (expected.role == 2 && (!DPCCResolverLowerSha256(expected.market_dependency_sha256) ||
                              !destination || !shared_context || destination.GetOpenCL() != shared_context ||
                              !destination.IsOpenCLTransferReady())))
     {
      reason = "dpccap.native.contract";
      return(false);
     }
   string expected_archive = expected.source_archive_sha256;
   StringToLower(expected_archive);
   if(!DPCCResolverLowerSha256(expected_archive))
     {
      reason = "dpccap.native.archive_contract";
      return(false);
     }
   int section = -1, manifest = -1;
   for(int i = 0; i < ArraySize(m_sections); i++)
     {
      if(m_sections[i].id == expected.section_id && m_sections[i].encoding == expected.encoding)
         section = i;
      if(m_sections[i].id == 1 && m_sections[i].encoding == 1)
         manifest = i;
     }
   if(section < 0 || manifest < 0 || m_sections[section].length == 0 ||
      m_sections[section].length > expected.max_native_bytes || m_sections[manifest].length == 0 ||
      m_sections[manifest].length > 1048576)
     {
      reason = "dpccap.native.section_limits";
      return(false);
     }
   int ap_handle = INVALID_HANDLE;
   uchar manifest_bytes[];
   string manifest_text = "", manifest_sha = "";
   if(!BeginSection(1, 1, ap_handle, reason))
      return(false);
   const int manifest_length = (int)m_sections[manifest].length;
   if(ArrayResize(manifest_bytes, manifest_length) != manifest_length ||
      FileReadArray(ap_handle, manifest_bytes, 0, manifest_length) != (uint)manifest_length || !EndSection(reason))
     {
      Close();
      reason = "dpccap.native.manifest_read";
      return(false);
     }
   CDPCCIncrementalSHA256 manifest_hash;
   uchar digest[];
   if(!manifest_hash.Init(reason) || !manifest_hash.Update(manifest_bytes, 0, manifest_length, reason) ||
      !manifest_hash.Final(digest, manifest_sha, reason) || manifest_sha != m_sections[manifest].sha256 ||
      !DPCCStrictUtf8Decode(manifest_bytes, manifest_length, 1048576, manifest_text, reason))
     {
      reason = "dpccap.native.manifest_integrity:" + reason;
      return(false);
     }
   CDPCCJsonDocument document;
   if(!document.Parse(manifest_text, reason))
      return(false);
   const int root = document.Root(), profile = document.FindMember(root, "profile");
   string contract = "", revision = "", role = "", abi_sha = "", profile_sha = "", data_sha = "";
   string task = "", stage = "", archive = "", profile_task = "", market_profile_sha = "";
   if(document.Type(root) != DPCC_JSON_OBJECT || document.Type(profile) != DPCC_JSON_OBJECT ||
      !DPCCResourceReadString(document, root, "contract_id", contract, reason, "native.manifest.contract") ||
      !DPCCResourceReadString(document, root, "revision", revision, reason, "native.manifest.revision") ||
      !DPCCResourceReadString(document, root, "role", role, reason, "native.manifest.role") ||
      !DPCCResourceReadString(document, root, "source_abi_sha256", abi_sha, reason, "native.manifest.abi") ||
      !DPCCResourceReadString(document, root, "data_sha256", data_sha, reason, "native.manifest.data") ||
      !DPCCResourceReadString(document, root, "task_id", task, reason, "native.manifest.task") ||
      !DPCCResourceReadString(document, root, "stage", stage, reason, "native.manifest.stage") ||
      !DPCCResourceReadString(document, root, "source_archive_sha256", archive, reason, "native.manifest.archive") ||
      !DPCCResourceReadString(document, profile, "sha256", profile_sha, reason, "native.manifest.profile") ||
      !DPCCResourceReadString(document, profile, "task_id", profile_task, reason, "native.manifest.profile_task"))
      return(false);
   if(expected.role == 1 &&
      !DPCCResourceReadString(document, profile, "market_sha256", market_profile_sha, reason,
                              "native.manifest.profile.market_sha"))
      return(false);
   string embedded_profile_sha = "", embedded_market_profile_sha = "";
   CDPCCJsonDocument embedded_profile;
   if(expected.role == 1)
     {
      const int profile_contents = document.FindMember(profile, "contents");
      if(!DPCCM05KnownMembers(document, profile, "|task_id|sha256|market_sha256|contents|",
                              "native.manifest.profile", reason) ||
         document.Type(profile_contents) != DPCC_JSON_STRING ||
         !DPCCCheckpointTextSHA(document.Text(profile_contents), embedded_profile_sha, reason) ||
         embedded_profile_sha != profile_sha ||
         !embedded_profile.Parse(document.Text(profile_contents), reason) ||
         !DPCCExecutionMarketProfileSHA(embedded_profile, embedded_profile.Root(),
                                        embedded_market_profile_sha, reason))
         return(false);
     }
   StringToLower(archive);
   const int dependency = document.FindMember(root, "market_dependency_sha256");
   const bool dependency_ok = (expected.role == 1 ? document.Type(dependency) == DPCC_JSON_NULL :
                               document.Type(dependency) == DPCC_JSON_STRING && document.Text(dependency) ==
                                  expected.market_dependency_sha256);
   const int ready_node = document.FindMember(root, "ready");
   const string expected_revision = (expected.role == 1 ? DPCC_M05_MARKET_REVISION : DPCC_TRADING_REVISION);
   if(contract != DPCC_AP_CONTRACT || revision != expected_revision ||
      role != (expected.role == 1 ? "Market" : "Trading") || abi_sha != expected.source_abi_sha256 ||
      profile_sha != expected.profile_sha256 || data_sha != expected.data_sha256 ||
      (expected.role == 1 && (market_profile_sha != expected.market_profile_sha256 ||
                              embedded_market_profile_sha != market_profile_sha)) ||
      task != expected.task_id || profile_task != expected.task_id || stage != expected.stage ||
      archive != expected_archive || !dependency_ok ||
      document.Type(ready_node) != DPCC_JSON_BOOLEAN ||
      (require_ready_market && document.Text(ready_node) != "true"))
     {
      reason = "dpccap.native.manifest_binding";
      return(false);
     }
   if(require_ready_market)
     {
      SDPCCAPNativeLoadContract ready_contract;
      if(!ReadReadyMarketContract(expected.market_profile_sha256, expected.task_id, expected.max_native_bytes,
                                  ready_contract, reason))
         return(false);
     }
//--- Bind the selected role to its manifest graph; expected graphs come from the caller.
   int manifest_graph = document.FindMember(root, "graph");
   if(trading_section)
     {
      const string role_keys[] = {"Actor", "Q1", "Q2", "TargetActor", "TargetQ1", "TargetQ2"};
      if(document.Type(manifest_graph) != DPCC_JSON_OBJECT ||
         document.ChildCount(manifest_graph) != ArraySize(role_keys))
        {
         reason = "dpccap.native.trading_graph_roles";
         return(false);
        }
      for(int i = 0; i < ArraySize(role_keys); i++)
        {
         const int role_graph = document.FindMember(manifest_graph, role_keys[i]);
         if(document.Type(role_graph) != DPCC_JSON_ARRAY || document.ChildCount(role_graph) < 1 ||
            document.ChildCount(role_graph) > 64)
           {
            reason = "dpccap.native.trading_graph_role_array." + role_keys[i];
            return(false);
           }
        }
      manifest_graph = document.FindMember(manifest_graph, role_keys[(int)expected.section_id - 110]);
     }
   if((expected.section_id == 100 || trading_section) &&
      (document.Type(manifest_graph) != DPCC_JSON_ARRAY || document.ChildCount(manifest_graph) != expected_graph.Total(
         )))
     {
      reason = "dpccap.native.manifest_graph";
      return(false);
     }
//--- Creating an owned directory is the exclusive claim. A failed create
//--- never authorizes opening or deleting any of that directory's contents.
   FolderCreate("Temp");
   static ulong sequence = 0;
   string scratch_directory = "";
   for(int attempt = 0; attempt < 16; attempt++)
     {
      sequence++;
      const string name = "Temp/DPCCAPNative_" + (string)ChartID() + "_" + (string)GetMicrosecondCount() + "_" +
                          (string)GetTickCount64() + "_" + (string)sequence;
      if(FolderCreate(name))
        {
         scratch_directory = name;
         break;
        }
     }
   if(scratch_directory == "")
     {
      reason = "dpccap.native.scratch_claim";
      return(false);
     }
   const string scratch_path = scratch_directory + "/role.nnw";
   int scratch = INVALID_HANDLE;
   CNet *candidate = NULL;
   CNet *loaded_model = destination;
   bool loaded = false, created_file = false;
   do
     {
      scratch = FileOpen(scratch_path, FILE_READ | FILE_WRITE | FILE_BIN);
      if(scratch == INVALID_HANDLE)
        {
         reason = "dpccap.native.scratch_open";
         break;
        }
      created_file = true;
      if(FileSize(scratch) != 0)
        {
         reason = "dpccap.native.scratch_not_empty";
         break;
        }
      if(!BeginSection(expected.section_id, expected.encoding, ap_handle, reason))
         break;
      CDPCCIncrementalSHA256 hash;
      uchar bytes[];
      if(ArrayResize(bytes, DPCC_AP_HASH_CHUNK) != DPCC_AP_HASH_CHUNK || !hash.Init(reason))
         break;
      ulong remaining = m_sections[section].length;
      bool copied = true;
      while(remaining > 0)
        {
         const uint count = (uint)MathMin((ulong)DPCC_AP_HASH_CHUNK, remaining);
         if(FileReadArray(ap_handle, bytes, 0, count) != count || FileWriteArray(scratch, bytes, 0, count) != count ||
            !hash.Update(bytes, 0, (int)count, reason))
           {
            copied = false;
            break;
           }
         remaining -= count;
        }
      FileFlush(scratch);
      string copied_sha = "";
      if(!copied || remaining != 0 || !hash.Final(digest, copied_sha, reason) ||
         copied_sha != m_sections[section].sha256 || FileSize(scratch) != m_sections[section].length)
        {reason = "dpccap.native.copy_integrity:" + reason; break;}
      if(!EndSection(reason))
         break;
      FileFlush(scratch);
      string scratch_sha = "";
      if(!DPCCAPHashRange(scratch, 0, m_sections[section].length, scratch_sha, reason) ||
         scratch_sha != m_sections[section].sha256 || !FileSeek(scratch, 0, SEEK_SET))
        {reason = "dpccap.native.scratch_integrity:" + reason; break;}
      if(!loaded_model)
        {
         candidate = new CNet();
         loaded_model = candidate;
        }
      if(!loaded_model)
        {
         reason = "dpccap.native.allocation";
         break;
        }
      const bool native_loaded = loaded_model.Load(scratch);
      //--- Load closes on its normal completion, but some early failures do not.
      //--- No new handle is opened between Load and this failure-only close.
      if(!native_loaded)
         FileClose(scratch);
      scratch = INVALID_HANDLE;
      if(!native_loaded)
        {
         reason = "dpccap.native.load";
         break;
        }
      int graph_node = document.FirstChild(manifest_graph);
      bool graph_ok = (loaded_model.Layer(expected_graph.Total()) == NULL);
      for(int i = 0; graph_ok && i < expected_graph.Total(); i++)
        {
         CNeuronBaseOCL *layer = loaded_model.Layer(i);
         CLayerDescription *required = dynamic_cast<CLayerDescription*>(expected_graph.At(i));
         CLayerDescription *actual = (layer ? layer.GetLayerInfo() : NULL);
         uint native_abi = 0;
         graph_ok = (layer && required && DPCCAPNativeDescriptorEqual(actual, required) &&
                     DPCCAPNativeLayerABI(layer, actual, native_abi) && native_abi == expected_abis[i]);
         if(graph_ok && expected.section_id == 100)
           {
            long index = -1, type = -1, abi = -1, neurons = -1;
            graph_ok = (document.Type(graph_node) == DPCC_JSON_OBJECT &&
                        DPCCResourceReadLong(document, graph_node, "index", index, reason, "native.graph.index") &&
                        DPCCResourceReadLong(document, graph_node, "type", type, reason, "native.graph.type") &&
                        DPCCResourceReadLong(document, graph_node, "abi", abi, reason, "native.graph.abi") &&
                        DPCCResourceReadLong(document, graph_node, "neurons", neurons, reason,
                           "native.graph.neurons") &&
                        index == i && type == (long)layer.Type() && abi == (long)native_abi && neurons == layer.Neurons(
                           ));
            graph_node = document.NextSibling(graph_node);
           }
         if(actual)
            delete actual;
        }
      if(!graph_ok)
        {
         reason = "dpccap.native.graph_descriptor:" + reason;
         break;
        }
      if(trading_section)
        {
         string loaded_graph_text = "";
         CDPCCJsonDocument loaded_graph;
         if(!DPCCAPTradingGraph(*loaded_model, expected_graph.Total(), loaded_graph_text, reason) ||
            !loaded_graph.Parse(loaded_graph_text, reason) ||
            !DPCCBankJsonEqual(document, manifest_graph, loaded_graph, loaded_graph.Root(), 0))
           {
            reason = "dpccap.native.trading_manifest_graph:" + reason;
            break;
           }
        }
      if(shared_context && ((loaded_model.GetOpenCL() != shared_context &&
                             !loaded_model.SetOpenCLChecked(shared_context)) ||
                            loaded_model.GetOpenCL() != shared_context || !loaded_model.IsOpenCLTransferReady()))
        {reason = "dpccap.native.shared_context"; break;}
      loaded = true;
     }
   while(false);
   if(scratch != INVALID_HANDLE)
      FileClose(scratch);
   if(m_active != -1)
      Close();
   const bool removed_file = (!created_file || FileDelete(scratch_path));
   const bool removed_directory = FolderDelete(scratch_directory);
   if(!removed_file || !removed_directory)
     {
      loaded = false;
      reason = "dpccap.native.scratch_cleanup:" + scratch_path;
     }
   if(!loaded)
     {
      if(candidate)
         delete candidate;
      if(reason == "")
         reason = "dpccap.native.failed";
      return(false);
     }
//--- This proves exact section bytes and the decoded native graph, not the
//--- unavailable native consumed-cursor or ready/acceptance/trading admission.
   if(candidate)
      model = candidate;
   return(true);
  }

#endif
//+------------------------------------------------------------------+
