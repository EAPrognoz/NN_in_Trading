      m_verify_target_fingerprint = saved.verify_target_fingerprint;
      m_ompb_decoder_updates = (uint)saved.ompb_decoder_step_baseline;
      m_price_adapt_decoder_updates = (uint)saved.price_adapt_decoder_step_baseline;
