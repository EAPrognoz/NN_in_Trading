//| Metadata.mqh: DPCC DatasetTimeIndex JSON adapter                 |
//+------------------------------------------------------------------+
#ifndef DPCC_METADATA_MQH
#define DPCC_METADATA_MQH
//+------------------------------------------------------------------+
//| DPCCClearDatasetTimeIndex clears a typed metadata value          |
//+------------------------------------------------------------------+
void DPCCClearDatasetTimeIndex(SDPCCDatasetTimeIndex &index)
  {
   index.schema_version = 0;
   index.example_only = false;
   index.time_index_id = "";
   index.dataset_id = "";
   index.data_source = "";
   index.timezone_mapping.path = "";
   index.timezone_mapping.sha256 = "";
   index.timezone_mapping.id = "";
   ArrayResize(index.bar_index, 0);
   ArrayResize(index.start_utc, 0);
   ArrayResize(index.end_utc, 0);
  }
//+------------------------------------------------------------------+
//| DPCCMetadataFail clears output and publishes one failure reason  |
//+------------------------------------------------------------------+
bool DPCCMetadataFail(SDPCCDatasetTimeIndex &index, string &reason, const string failure)
  {
   DPCCClearDatasetTimeIndex(index);
   reason = failure;
   return(false);
  }
//+------------------------------------------------------------------+
//| DPCCReadExactNonnegativeLong reads an exact decimal long         |
//+------------------------------------------------------------------+
bool DPCCReadExactNonnegativeLong(CDPCCJsonDocument &document, const int node, long &value)
  {
   value = 0;
   if(document.Type(node) != DPCC_JSON_NUMBER)
      return(false);
   const string lexeme = document.Text(node);
   const int    length = StringLen(lexeme);
   if(length <= 0)
      return(false);
   const bool negative_value = (StringGetCharacter(lexeme, 0) == '-');
   const int  mantissa_start = (negative_value ? 1 : 0);
   int exponent_pos = StringFind(lexeme, "e");
   if(exponent_pos < 0)
      exponent_pos = StringFind(lexeme, "E");
   const int mantissa_end = (exponent_pos < 0 ? length : exponent_pos);
   int       exponent     = 0;
   if(exponent_pos >= 0)
     {
      int  position = exponent_pos + 1;
      bool exponent_negative = false;
      if(StringGetCharacter(lexeme, position) == '+' || StringGetCharacter(lexeme, position) == '-')
        {
         exponent_negative = (StringGetCharacter(lexeme, position) == '-');
         position++;
        }
      for(; position < length; position++)
        {
         const int digit = (int)(StringGetCharacter(lexeme, position) - '0');
         if(exponent > DPCC_JSON_MAX_SOURCE_CHARS)
            exponent = DPCC_JSON_MAX_SOURCE_CHARS + 1;
         else
            exponent = exponent * 10 + digit;
        }
      if(exponent_negative)
         exponent = -exponent;
     }
   string    mantissa    = StringSubstr(lexeme, mantissa_start, mantissa_end - mantissa_start);
   const int decimal_pos = StringFind(mantissa, ".");
   const int fraction    = (decimal_pos < 0 ? 0 : StringLen(mantissa) - decimal_pos - 1);
   string    digits      = mantissa;
   if(decimal_pos >= 0)
      StringReplace(digits, ".", "");
   int first = 0;
   while(first < StringLen(digits) && StringGetCharacter(digits, first) == '0')
      first++;
   if(first >= StringLen(digits))
      return(true);
   if(negative_value)
      return(false);
   digits = StringSubstr(digits, first);
   int scale = exponent - fraction;
   if(scale < 0)
     {
      const int remove = -scale;
      if(remove > StringLen(digits))
         return(false);
      for(int i = StringLen(digits) - remove; i < StringLen(digits); i++)
         if(StringGetCharacter(digits, i) != '0')
            return(false);
      digits = StringSubstr(digits, 0, StringLen(digits) - remove);
      scale = 0;
      if(StringLen(digits) == 0)
         return(true);
     }
   if(StringLen(digits) + scale > 19)
      return(false);
   for(int i = 0; i < StringLen(digits) + scale; i++)
     {
      const int digit = (i < StringLen(digits) ? (int)(StringGetCharacter(digits, i) - '0') : 0);
      if(value > (LONG_MAX - digit) / 10)
         return(false);
      value = value * 10 + digit;
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| DPCCReadRequiredString reads one required string property        |
//+------------------------------------------------------------------+
bool DPCCReadRequiredString(CDPCCJsonDocument &document, const int object_node,
                            const string name, string &value, string &reason)
  {
   const int node = document.FindMember(object_node, name);
   if(node < 0)
     {
      reason = name;
      return(false);
     }
   if(document.Type(node) != DPCC_JSON_STRING)
     {
      reason = name + ".type";
      return(false);
     }
   value = document.Text(node);
   return(true);
  }
//+------------------------------------------------------------------+
//| DPCCReadRequiredLong reads one required exact integer property   |
//+------------------------------------------------------------------+
bool DPCCReadRequiredLong(CDPCCJsonDocument &document, const int object_node,
                          const string name, long &value, string &reason, const string path)
  {
   const int node = document.FindMember(object_node, name);
   if(node < 0)
     {
      reason = path;
      return(false);
     }
   if(!DPCCReadExactNonnegativeLong(document, node, value))
     {
      reason = path + ".integer";
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| DPCCDecodeDatasetTimeIndex decodes and validates META-09 JSON    |
//+------------------------------------------------------------------+
bool DPCCDecodeDatasetTimeIndex(CDPCCJsonDocument &document, const int root,
                                const string expected_dataset_id,
                                SDPCCDatasetTimeIndex &index, string &reason)
  {
   DPCCClearDatasetTimeIndex(index);
   reason = "";
   if(document.Type(root) != DPCC_JSON_OBJECT)
      return(DPCCMetadataFail(index, reason, "root.type"));
   if(document.ChildCount(root) != 7)
      return(DPCCMetadataFail(index, reason, "root.properties"));
   long schema_version = 0;
   if(!DPCCReadRequiredLong(document, root, "schema_version", schema_version, reason, "schema_version"))
      return(DPCCMetadataFail(index, reason, reason));
   index.schema_version = schema_version;
   const int example_node = document.FindMember(root, "example_only");
   if(example_node < 0)
      return(DPCCMetadataFail(index, reason, "example_only"));
   if(document.Type(example_node) != DPCC_JSON_BOOLEAN)
      return(DPCCMetadataFail(index, reason, "example_only.type"));
   index.example_only = (document.Text(example_node) == "true");
   if(!DPCCReadRequiredString(document, root, "time_index_id", index.time_index_id, reason))
      return(DPCCMetadataFail(index, reason, reason));
   if(!DPCCReadRequiredString(document, root, "dataset_id", index.dataset_id, reason))
      return(DPCCMetadataFail(index, reason, reason));
   if(!DPCCReadRequiredString(document, root, "data_source", index.data_source, reason))
      return(DPCCMetadataFail(index, reason, reason));
   const int timezone_node = document.FindMember(root, "timezone_mapping");
   if(timezone_node < 0)
      return(DPCCMetadataFail(index, reason, "timezone_mapping"));
   if(document.Type(timezone_node) != DPCC_JSON_OBJECT)
      return(DPCCMetadataFail(index, reason, "timezone_mapping.type"));
   if(document.ChildCount(timezone_node) != 3)
      return(DPCCMetadataFail(index, reason, "timezone_mapping.properties"));
   string field_reason = "";
   if(!DPCCReadRequiredString(document, timezone_node, "path", index.timezone_mapping.path, field_reason))
      return(DPCCMetadataFail(index, reason, "timezone_mapping." + field_reason));
   if(!DPCCReadRequiredString(document, timezone_node, "sha256", index.timezone_mapping.sha256, field_reason))
      return(DPCCMetadataFail(index, reason, "timezone_mapping." + field_reason));
   if(!DPCCReadRequiredString(document, timezone_node, "id", index.timezone_mapping.id, field_reason))
      return(DPCCMetadataFail(index, reason, "timezone_mapping." + field_reason));
   const int bars_node = document.FindMember(root, "bars");
   if(bars_node < 0)
      return(DPCCMetadataFail(index, reason, "bars"));
   if(document.Type(bars_node) != DPCC_JSON_ARRAY)
      return(DPCCMetadataFail(index, reason, "bars.type"));
   const int count = document.ChildCount(bars_node);
   if(count <= 0)
      return(DPCCMetadataFail(index, reason, "bars"));
   if(ArrayResize(index.bar_index, count) != count)
      return(DPCCMetadataFail(index, reason, "bars.bar_index.storage"));
   if(ArrayResize(index.start_utc, count) != count)
      return(DPCCMetadataFail(index, reason, "bars.start_utc.storage"));
   if(ArrayResize(index.end_utc, count) != count)
      return(DPCCMetadataFail(index, reason, "bars.end_utc.storage"));
   int bar_node = document.FirstChild(bars_node);
   for(int i = 0; i < count; i++)
     {
      const string base = StringFormat("bars[%d]", i);
      if(bar_node < 0 || document.Type(bar_node) != DPCC_JSON_OBJECT)
         return(DPCCMetadataFail(index, reason, base + ".type"));
      if(document.ChildCount(bar_node) != 3)
         return(DPCCMetadataFail(index, reason, base + ".properties"));
      if(!DPCCReadRequiredLong(document, bar_node, "bar_index", index.bar_index[i], reason, base + ".bar_index"))
         return(DPCCMetadataFail(index, reason, reason));
      if(!DPCCReadRequiredLong(document, bar_node, "start_utc", index.start_utc[i], reason, base + ".start_utc"))
         return(DPCCMetadataFail(index, reason, reason));
      if(!DPCCReadRequiredLong(document, bar_node, "end_utc", index.end_utc[i], reason, base + ".end_utc"))
         return(DPCCMetadataFail(index, reason, reason));
      bar_node = document.NextSibling(bar_node);
     }
   string validation_reason = "";
   if(!DPCCValidateDatasetTimeIndex(index, expected_dataset_id, validation_reason))
      return(DPCCMetadataFail(index, reason, validation_reason));
   reason = "";
   return(true);
  }

#endif
//+------------------------------------------------------------------+
//| DPCCClearArchitectureContract clears every nested contract field |
//+------------------------------------------------------------------+
void DPCCClearArchitectureContract(SDPCCArchitectureContract &contract)
  {
   contract.model_decoder.architecture = "";
   contract.model_decoder.embedding = 0;
   contract.model_decoder.activation = "";
   contract.model_decoder.backward_profile = "";
   contract.model_denoiser.architecture = "";
   contract.model_denoiser.embedding = 0;
   contract.model_denoiser.heads = 0;
   contract.model_denoiser.key_dimension = 0;
   contract.model_denoiser.depth = 0;
   contract.model_denoiser.padding_mask = false;
   contract.model_denoiser.graph_id = "";
   contract.model_denoiser.normalization = "";
   contract.model_denoiser.feedforward_activation = "";
   contract.model_denoiser.temporal_mask = false;
   contract.model_denoiser.attention_backward = "";
   contract.model_denoiser.graph_sha256 = "";
   contract.model_denoiser.backward_profile = "";
   contract.model_parallel.version = 0;
   contract.model_parallel.program = "";
   contract.model_parallel.training_plan_batch = 0;
   contract.model_parallel.deployment_plan_batch = 0;
   contract.model_parallel.proposal_slots = 0;
   contract.model_parallel.logical_heads = 0;
   contract.model_parallel.key_dimension = 0;
   contract.model_parallel.shared_projection_weights = false;
   contract.model_parallel.self_attention_fold = "";
   contract.model_parallel.cross_attention_fold = "";
   contract.model_parallel.activation_lifetime = "";
   contract.model_parallel.binary_layer_version = 0;
   contract.model_parallel.legacy_slice_use = "";
   contract.training_decoder.architecture = "";
   contract.training_decoder.embedding = 0;
   contract.training_decoder.activation = "";
   contract.training_decoder.backward_profile = "";
   contract.training_denoiser.architecture = "";
   contract.training_denoiser.embedding = 0;
   contract.training_denoiser.heads = 0;
   contract.training_denoiser.key_dimension = 0;
   contract.training_denoiser.depth = 0;
   contract.training_denoiser.padding_mask = false;
   contract.training_denoiser.graph_id = "";
   contract.training_denoiser.normalization = "";
   contract.training_denoiser.feedforward_activation = "";
   contract.training_denoiser.temporal_mask = false;
   contract.training_denoiser.attention_backward = "";
   contract.training_denoiser.graph_sha256 = "";
   contract.training_denoiser.backward_profile = "";
   contract.training_parallel.version = 0;
   contract.training_parallel.program = "";
   contract.training_parallel.training_plan_batch = 0;
   contract.training_parallel.deployment_plan_batch = 0;
   contract.training_parallel.proposal_slots = 0;
   contract.training_parallel.logical_heads = 0;
   contract.training_parallel.key_dimension = 0;
   contract.training_parallel.shared_projection_weights = false;
   contract.training_parallel.self_attention_fold = "";
   contract.training_parallel.cross_attention_fold = "";
   contract.training_parallel.activation_lifetime = "";
   contract.training_parallel.binary_layer_version = 0;
   contract.training_parallel.legacy_slice_use = "";
  }
//+------------------------------------------------------------------+
//| DPCCArchitectureMetadataFail clears output and sets stable       |
//| reason                                                           |
//+------------------------------------------------------------------+
void DPCCArchitectureMetadataFail(SDPCCArchitectureContract &contract, string &reason, const string failure)
  {
   DPCCClearArchitectureContract(contract);
   reason = failure;
  }
//+------------------------------------------------------------------+
//| Find one required object along a normative JSON path             |
//+------------------------------------------------------------------+
bool DPCCArchitectureObject(CDPCCJsonDocument &document, const int parent, const string name,
                            const string path, int &node, string &reason)
  {
   node = document.FindMember(parent, name);
   if(node < 0)
     {
      reason = path;
      return(false);
     }
   if(document.Type(node) != DPCC_JSON_OBJECT)
     {
      reason = path + ".type";
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Read required typed META-08 string                               |
//+------------------------------------------------------------------+
bool DPCCArchitectureString(CDPCCJsonDocument &document, const int object_node, const string name,
                            const string path, string &value, string &reason)
  {
   const int node = document.FindMember(object_node, name);
   if(node < 0)
     {
      reason = path;
      return(false);
     }
   if(document.Type(node) != DPCC_JSON_STRING)
     {
      reason = path + ".type";
      return(false);
     }
   value = document.Text(node);
   return(true);
  }
//+------------------------------------------------------------------+
//| Read mathematical integer exactly and range-check before uint    |
//+------------------------------------------------------------------+
bool DPCCArchitectureUInt(CDPCCJsonDocument &document, const int object_node, const string name,
                          const string path, uint &value, string &reason)
  {
   value = 0;
   const int node = document.FindMember(object_node, name);
   if(node < 0)
     {
      reason = path;
      return(false);
     }
   long exact = 0;
   if(!DPCCReadExactNonnegativeLong(document, node, exact))
     {
      reason = path + ".integer";
      return(false);
     }
   if(exact > 4294967295L)
     {
      reason = path + ".range";
      return(false);
     }
   value = (uint)exact;
   return(true);
  }
//+------------------------------------------------------------------+
//| Read required META-08 boolean                                    |
//+------------------------------------------------------------------+
bool DPCCArchitectureBool(CDPCCJsonDocument &document, const int object_node, const string name,
                          const string path, bool &value, string &reason)
  {
   const int node = document.FindMember(object_node, name);
   if(node < 0)
     {
      reason = path;
      return(false);
     }
   if(document.Type(node) != DPCC_JSON_BOOLEAN)
     {
      reason = path + ".type";
      return(false);
     }
   value = (document.Text(node) == "true");
   return(true);
  }
//+------------------------------------------------------------------+
//| Decode decoder architecture                                      |
//+------------------------------------------------------------------+
bool DPCCDecodeDecoderArchitecture(CDPCCJsonDocument &document, const int node,
                                   const string path, SDPCCDecoderArchitecture &value, string &reason)
  {
   return(DPCCArchitectureString(document, node, "architecture", path + ".architecture", value.architecture, reason) &&
          DPCCArchitectureUInt(document, node, "embedding", path + ".embedding", value.embedding, reason) &&
          DPCCArchitectureString(document, node, "activation", path + ".activation", value.activation, reason) &&
          DPCCArchitectureString(document, node, "backward_profile", path + ".backward_profile", value.backward_profile,
             reason));
  }
//+------------------------------------------------------------------+
//| Decode denoiser architecture                                     |
//+------------------------------------------------------------------+
bool DPCCDecodeDenoiserArchitecture(CDPCCJsonDocument &document, const int node,
                                    const string path, SDPCCDenoiserArchitecture &value, string &reason)
  {
   return(DPCCArchitectureString(document, node, "architecture", path + ".architecture", value.architecture, reason) &&
          DPCCArchitectureUInt(document, node, "embedding", path + ".embedding", value.embedding, reason) &&
          DPCCArchitectureUInt(document, node, "heads", path + ".heads", value.heads, reason) &&
          DPCCArchitectureUInt(document, node, "key_dimension", path + ".key_dimension", value.key_dimension, reason) &&
          DPCCArchitectureUInt(document, node, "depth", path + ".depth", value.depth, reason) &&
          DPCCArchitectureBool(document, node, "padding_mask", path + ".padding_mask", value.padding_mask, reason) &&
          DPCCArchitectureString(document, node, "graph_id", path + ".graph_id", value.graph_id, reason) &&
          DPCCArchitectureString(document, node, "normalization", path + ".normalization", value.normalization,
             reason) &&
          DPCCArchitectureString(document, node, "feedforward_activation", path + ".feedforward_activation",
             value.feedforward_activation, reason) &&
          DPCCArchitectureBool(document, node, "temporal_mask", path + ".temporal_mask", value.temporal_mask, reason) &&
          DPCCArchitectureString(document, node, "attention_backward", path + ".attention_backward",
             value.attention_backward, reason) &&
          DPCCArchitectureString(document, node, "graph_sha256", path + ".graph_sha256", value.graph_sha256, reason) &&
          DPCCArchitectureString(document, node, "backward_profile", path + ".backward_profile", value.backward_profile,
             reason));
  }
//+------------------------------------------------------------------+
//| Decode parallel execution contract                               |
//+------------------------------------------------------------------+
bool DPCCDecodeParallelExecution(CDPCCJsonDocument &document, const int node, const string path,
                                 SDPCCParallelExecution &value, string &reason)
  {
   return(DPCCArchitectureUInt(document, node, "version", path + ".version", value.version, reason) &&
          DPCCArchitectureString(document, node, "program", path + ".program", value.program, reason) &&
          DPCCArchitectureUInt(document, node, "training_plan_batch", path + ".training_plan_batch",
             value.training_plan_batch, reason) &&
          DPCCArchitectureUInt(document, node, "deployment_plan_batch", path + ".deployment_plan_batch",
             value.deployment_plan_batch, reason) &&
          DPCCArchitectureUInt(document, node, "proposal_slots", path + ".proposal_slots", value.proposal_slots,
             reason) &&
          DPCCArchitectureUInt(document, node, "logical_heads", path + ".logical_heads", value.logical_heads, reason) &&
          DPCCArchitectureUInt(document, node, "key_dimension", path + ".key_dimension", value.key_dimension, reason) &&
          DPCCArchitectureBool(document, node, "shared_projection_weights", path + ".shared_projection_weights",
             value.shared_projection_weights, reason) &&
          DPCCArchitectureString(document, node, "self_attention_fold", path + ".self_attention_fold",
             value.self_attention_fold, reason) &&
          DPCCArchitectureString(document, node, "cross_attention_fold", path + ".cross_attention_fold",
             value.cross_attention_fold, reason) &&
          DPCCArchitectureString(document, node, "activation_lifetime", path + ".activation_lifetime",
             value.activation_lifetime, reason) &&
          DPCCArchitectureUInt(document, node, "binary_layer_version", path + ".binary_layer_version",
             value.binary_layer_version, reason) &&
          DPCCArchitectureString(document, node, "legacy_slice_use", path + ".legacy_slice_use", value.legacy_slice_use,
             reason));
  }
//+------------------------------------------------------------------+
//| Extract schema-backed paths then apply the accepted META-08 gate |
//+------------------------------------------------------------------+
bool DPCCDecodeArchitectureContract(CDPCCJsonDocument &model_document, const int model_root,
                                    CDPCCJsonDocument &training_document, const int training_root,
                                    const string expected_graph_sha256,
                                    SDPCCArchitectureContract &contract, string &reason)
  {
   DPCCClearArchitectureContract(contract);
   reason = "";
   int composition = -1, model_decoder = -1, model_denoiser = -1, model_parallel = -1;
   int training_decoder = -1, training_denoiser = -1, training_parallel = -1;
   if(!DPCCArchitectureObject(model_document, model_root, "composition", "model.composition", composition, reason) ||
      !DPCCArchitectureObject(model_document, composition, "decoder", "model.composition.decoder", model_decoder,
         reason) ||
      !DPCCArchitectureObject(model_document, composition, "denoiser", "model.composition.denoiser", model_denoiser,
         reason) ||
      !DPCCArchitectureObject(model_document, model_root, "parallel_execution", "model.parallel_execution",
         model_parallel, reason) ||
      !DPCCArchitectureObject(training_document, training_root, "decoder", "training.decoder", training_decoder,
         reason) ||
      !DPCCArchitectureObject(training_document, training_decoder, "architecture", "training.decoder.architecture",
         training_decoder, reason) ||
      !DPCCArchitectureObject(training_document, training_root, "denoiser", "training.denoiser", training_denoiser,
         reason) ||
      !DPCCArchitectureObject(training_document, training_denoiser, "architecture", "training.denoiser.architecture",
         training_denoiser, reason) ||
      !DPCCArchitectureObject(training_document, training_root, "parallel_execution", "training.parallel_execution",
         training_parallel, reason))
     {
      DPCCArchitectureMetadataFail(contract, reason, reason);
      return(false);
     }
   if(!DPCCDecodeDecoderArchitecture(model_document, model_decoder, "model.composition.decoder", contract.model_decoder,
      reason) ||
      !DPCCDecodeDenoiserArchitecture(model_document, model_denoiser, "model.composition.denoiser",
         contract.model_denoiser, reason) ||
      !DPCCDecodeParallelExecution(model_document, model_parallel, "model.parallel_execution", contract.model_parallel,
         reason) ||
      !DPCCDecodeDecoderArchitecture(training_document, training_decoder, "training.decoder.architecture",
         contract.training_decoder, reason) ||
      !DPCCDecodeDenoiserArchitecture(training_document, training_denoiser, "training.denoiser.architecture",
         contract.training_denoiser, reason) ||
      !DPCCDecodeParallelExecution(training_document, training_parallel, "training.parallel_execution",
         contract.training_parallel, reason))
     {
      DPCCArchitectureMetadataFail(contract, reason, reason);
      return(false);
     }
   if(!DPCCValidateArchitectureContract(contract, expected_graph_sha256, reason))
     {
      DPCCArchitectureMetadataFail(contract, reason, reason);
      return(false);
     }
   reason = "";
   return(true);
  }

#endif
