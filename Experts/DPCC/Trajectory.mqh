      const uint reference_before = ompb.ReferenceCount(), current_before = ompb.CurrentCount();
      const uint layer_phase = (m_price_study_phase == defForecastPriceLatentPrepare ? defForecastPriceLatentPrepare :
                                (m_price_study_phase == defForecastPriceJoint ? defForecastPriceJoint :
                                 (m_price_study_phase == defForecastPriceOMPBCalibrate ? defForecastPriceOMPBCalibrate :
                                  (m_price_study_phase == defForecastPriceAdapt ? defForecastPriceAdapt :
                                     defForecastPriceVerify))));
      ENUM_OMPB_MODE warmup_mode = OMPB_BYPASS;
      if(m_price_study_phase == defForecastPriceAdapt || m_price_study_phase == defForecastPriceVerify)
         warmup_mode = OMPB_INFERENCE;
      else
         if(m_price_study_phase == defForecastPriceOMPBCalibrate)
           {
            if(saved.subphase == "EVALUATION_2" || saved.subphase == "EVALUATION_3" ||
               saved.subphase == "EVALUATION_4" || saved.subphase == "EVALUATION_5" ||
               saved.subphase == "CALIBRATION" || saved.subphase == "SOURCE_ANCHOR")
               warmup_mode = OMPB_INFERENCE;
            if(saved.subphase == "CALIBRATION" || saved.subphase == "SOURCE_ANCHOR")
               warmup_mode = OMPB_CALIBRATE;
           }
      if(!m_market.Layer(5) || !m_market.TrainMode(false) || !m_market.SetWeightsUpdate(false) ||
         !SetTeacherFrozenPolicy() ||
         !price.SetCodebookUpdate(false) || !price.SetGradientNormalization(warmup_mode != OMPB_CALIBRATE) ||
         !ompb.SetMode(warmup_mode) || !ompb.SetSourceAnchor(false) ||
         !price.SetPricePhase(layer_phase) || !decoder.SetPricePhase(layer_phase))
         return(Fail("M05_RESUME.warmup_phase", reason));
      for(int i = 0; i < 5; i++)
         if(!m_market.Layer(i) || !m_market.Layer(i).Clear())
            return(Fail("M05_RESUME.warmup_trunk_clear", reason));
      if(!price.Clear() || !decoder.Clear() || !ClearTeacherState())
         return(Fail("M05_RESUME.warmup_head_clear", reason));
      if(!price.ResetEpochDiagnostics())
         return(Fail("M05_RESUME.warmup_diagnostics_reset", reason));
      int replay_decision = -1, next_decision = -1, replay_count = 0;
      if(m_price_study_phase == defForecastPriceLatentPrepare)
        {
         replay_decision = (ArraySize(m_latent_fit) > 0 ? m_latent_fit[0] : -1);
         next_decision = (m_cursor < ArraySize(m_latent_fit) ? m_latent_fit[m_cursor] : -1);
         replay_count = (saved.epoch_started ? m_cursor : 0);
         if(!saved.epoch_started)
            replay_decision = next_decision;
        }
      else
         if(m_price_study_phase == defForecastPriceJoint)
           {
            replay_decision = (ArraySize(m_fit) > 0 ? m_fit[0] : -1);
            next_decision = (m_cursor < ArraySize(m_fit) ? m_fit[m_cursor] : -1);
            replay_count = (saved.epoch_started ? m_cursor : 0);
            if(!saved.epoch_started)
               replay_decision = next_decision;
           }
         else
            if(m_price_study_phase == defForecastPriceAdapt)
              {
               replay_decision = (ArraySize(m_fit) > 0 ? m_fit[0] : -1);
               next_decision = (m_cursor < ArraySize(m_fit) ? m_fit[m_cursor] : -1);
               replay_count = m_cursor;
              }
            else
               if(m_price_study_phase == defForecastPriceVerify)
                 {
                  replay_decision = (ArraySize(m_holdout) > 0 ? m_holdout[0] : -1);
                  next_decision = (m_cursor < ArraySize(m_holdout) ? m_holdout[m_cursor] : -1);
                  replay_count = (saved.verify_started ? m_cursor : 0);
                  if(!saved.verify_started)
                     replay_decision = next_decision;
                 }
               else
                  if(saved.subphase == "REFERENCE")
                    {
                     replay_decision = (ArraySize(m_ompb_reference) > 0 ? m_ompb_reference[0] : -1);
                     next_decision = (m_ompb_reference_cursor < ArraySize(m_ompb_reference) ?
                                      m_ompb_reference[m_ompb_reference_cursor] : -1);
                     replay_count = m_ompb_reference_cursor;
                    }
                  else
                     if(StringFind(saved.subphase, "EVALUATION_") == 0)
                       {
                        const bool source = (m_ompb_evaluation_stage % 2 == 0);
                        const int row_count = (source ? ArraySize(m_ompb_source_evaluation) : ArraySize(
                           m_ompb_target_evaluation));
                        replay_decision = (row_count > 0 ? (source ? m_ompb_source_evaluation[0] :
                           m_ompb_target_evaluation[0]) : -1);
                        next_decision = (m_ompb_evaluation_cursor < row_count ?
                                         (source ? m_ompb_source_evaluation[m_ompb_evaluation_cursor] :
                                          m_ompb_target_evaluation[m_ompb_evaluation_cursor]) : -1);
                        replay_count = m_ompb_evaluation_cursor;
                       }
                     else
                       {
                        replay_decision = (ArraySize(m_ompb_calibration) > 0 ? m_ompb_calibration[0] : -1);
                        next_decision = (m_cursor < ArraySize(m_ompb_calibration) ? m_ompb_calibration[m_cursor] : -1);
                        replay_count = (saved.ompb_epoch_started ? m_cursor : 0);
                        if(!saved.ompb_epoch_started)
                           replay_decision = next_decision;
                       }
      const long expected_replay = (replay_decision >= 0 && replay_decision < ArraySize(m_bars) ?
                                    m_bars[replay_decision].server_open : 0);
      const long expected_next = (next_decision >= 0 && next_decision < ArraySize(m_bars) ?
                                  m_bars[next_decision].server_open : 0);
      if(replay_count < 0 || (ulong)replay_count > saved.next_record || expected_replay != (
         long)saved.replay_from_bar ||
         expected_next != (long)saved.next_bar)
         return(Fail("M05_RESUME.server_time_replay_identity", reason));
      if(m_price_study_phase == defForecastPriceOMPBCalibrate &&
         saved.subphase != "REFERENCE" && StringFind(saved.subphase, "EVALUATION_") != 0 && saved.ompb_epoch_started)
        {
         uint replayed_sources = 0;
         const uint period = m_ompb_profile.source_anchor_period;
         for(int row = 0; row < replay_count; row++)
           {
            if(!WarmupM05Row(m_ompb_calibration[row], true, OMPB_CALIBRATE, false, reason))
               return(false);
            const bool due = (period > 0 && (uint)(row + 1) % period == 0 &&
                              ((row + 1) < replay_count || !m_ompb_source_pending));
            if(due)
              {
               if(ArraySize(m_ompb_reference) == 0)
                  return(Fail("M05_RESUME.warmup_source_reference_empty", reason));
               const uint source_index = replayed_sources % (uint)ArraySize(m_ompb_reference);
               if(!WarmupM05Row(m_ompb_reference[source_index], true, OMPB_CALIBRATE, true, reason))
                  return(Fail("M05_RESUME.warmup_source_anchor:" + reason, reason));
               replayed_sources++;
              }
           }
         if(replayed_sources != m_ompb_epoch_source_updates)
            return(Fail("M05_RESUME.warmup_source_anchor_count", reason));
        }
      else
         if(m_price_study_phase == defForecastPriceOMPBCalibrate && saved.subphase == "REFERENCE")
           {
            for(int row = 0; row < replay_count; row++)
               if(!WarmupM05Row(m_ompb_reference[row], false, OMPB_BYPASS, false, reason))
                  return(false);
           }
         else
            if(m_price_study_phase == defForecastPriceOMPBCalibrate && StringFind(saved.subphase, "EVALUATION_") == 0)
              {
               const bool source = (m_ompb_evaluation_stage % 2 == 0);
               for(int row = 0; row < replay_count; row++)
                 {
                  const int decision = (source ? m_ompb_source_evaluation[row] : m_ompb_target_evaluation[row]);
                  if(!WarmupM05Row(decision, true, warmup_mode, false, reason))
                     return(false);
                 }
              }
            else
               if(replay_count > 0)
                 {
                  if(m_price_study_phase == defForecastPriceLatentPrepare)
                    {
                     for(int row = 0; row < replay_count; row++)
                        if(!WarmupM05Row(m_latent_fit[row], true, warmup_mode, false, reason))
                           return(false);
                    }
                  else
                     if(m_price_study_phase == defForecastPriceVerify)
                       {
                        for(int row = 0; row < replay_count; row++)
                           if(!WarmupM05Row(m_holdout[row], true, warmup_mode, false, reason))
                              return(false);
                       }
                     else
                       {
                        for(int row = 0; row < replay_count; row++)
                           if(!WarmupM05Row(m_fit[row], true, warmup_mode, false, reason))
                              return(false);
                       }
                 }
      if(!price.ResetEpochDiagnostics())
         return(Fail("M05_RESUME.warmup_diagnostics_finish", reason));
      if(ompb.ReferenceCount() != reference_before || ompb.CurrentCount() != current_before)
         return(Fail("M05_RESUME.warmup_mutated_ompb_history", reason));
      ENUM_OMPB_MODE restore_mode = OMPB_BYPASS;
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
        {
         if(!m_ompb_reference_complete)
            restore_mode = OMPB_REFERENCE;
         else
            if(m_ompb_evaluation_stage < 4 || m_ompb_calibration_completed)
               restore_mode = (m_ompb_evaluation_stage < 2 ? OMPB_BYPASS : OMPB_INFERENCE);
            else
               restore_mode = OMPB_CALIBRATE;
        }
      if(!m_market.TrainMode(false) || !m_market.SetWeightsUpdate(false) ||
         !SetTeacherFrozenPolicy() ||
         !price.SetCodebookUpdate(false) || !price.SetGradientNormalization(restore_mode != OMPB_CALIBRATE) ||
         !price.SetPricePhase(layer_phase) || !decoder.SetPricePhase(layer_phase) ||
         !ompb.SetMode(restore_mode) || !ompb.SetSourceAnchor(false))
         return(Fail("M05_RESUME.restore_phase_policy", reason));
      ompb.TrainMode(restore_mode == OMPB_CALIBRATE);
      if(ompb.ReferenceCount() != saved.ompb_reference_count || ompb.CurrentCount() != saved.ompb_current_count)
         return(Fail("M05_RESUME.final_ompb_counts", reason));
      restored = true;
      reason = "";
      return(true);
     }
   string            PriceStudyStage(void) const
     {
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
         return("OMPB_CALIBRATE");
      if(m_price_study_phase == defForecastPriceAdapt)
         return("PRICE_ADAPT");
      if(m_price_study_phase == defForecastPriceVerify)
         return("VERIFY");
      return(m_price_study_phase == defForecastPriceLatentPrepare ? "LATENT_PREPARE" : "PRICE_JOINT");
     }
   int               PriceStudyPosition(void) const
     {
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
        {
         if(!m_ompb_reference_complete)
            return(m_ompb_reference_cursor);
         if(m_ompb_evaluation_stage < 4 || m_ompb_calibration_completed)
            return(m_ompb_evaluation_cursor);
        }
      return(m_cursor);
     }
   uint              PriceStudyEpochsCompleted(void) const
     {
      if(m_price_study_phase == defForecastPriceLatentPrepare)
         return(m_latent_epochs_completed);
      if(m_price_study_phase == defForecastPriceJoint)
         return(m_price_joint_epochs_completed);
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
         return(m_ompb_epoch);
      if(m_price_study_phase == defForecastPriceAdapt)
         return(m_price_adapt_epochs_completed);
      return(0);
     }
   int               PriceStudyTotal(void) const
     {
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
        {
         if(!m_ompb_reference_complete)
            return((int)m_ompb_reference_capacity);
         if(m_ompb_evaluation_stage < 4 || m_ompb_calibration_completed)
            return(m_ompb_evaluation_stage % 2 == 0 ? ArraySize(m_ompb_source_evaluation) :
                   ArraySize(m_ompb_target_evaluation));
         return(ArraySize(m_ompb_calibration));
        }
      return(m_price_study_phase == defForecastPriceVerify ? ArraySize(m_holdout) : m_fit_limit);
     }
   string            PriceStudyNextStage(void) const
     {
      if(m_price_study_phase == defForecastPriceLatentPrepare)
         return("PRICE_JOINT");
      if(m_price_study_phase == defForecastPriceAdapt || m_price_study_phase == defForecastPriceVerify)
         return("COMPLETE");
      return(m_price_study_phase == defForecastPriceOMPBCalibrate ? "PRICE_ADAPT" : "OMPB_CALIBRATE");
     }
   //+------------------------------------------------------------------+
   //| Accept the operator-selected latent boundary without new updates |
   //+------------------------------------------------------------------+
   bool              AcceptLatentPrepareComplete(string &reason)
     {
      reason = "";
      if(!m_m05 || !m_ready || m_failed || m_finished || !m_price_joint ||
         m_price_forward_only || m_restore_only || m_price_study_phase != defForecastPriceLatentPrepare ||
         m_latent_epochs_completed == 0 || m_cursor != 0 || m_epoch_started || ArraySize(m_fit) == 0)
        {
         reason = "M05_ACCEPT_LATENT.completed_epoch_boundary_required";
         return(false);
        }
      m_price_study_phase = defForecastPriceJoint;
      m_fit_limit = ArraySize(m_fit);
      m_cursor = 0;
      m_epoch_started = false;
      m_price_joint_epochs_completed = 0;
      m_price_phase_terminal_status = "";
      m_m05_manifest_bound = false;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Explicit PRICE_ADAPT selection accepts the current OMPB weights  |
   //+------------------------------------------------------------------+
   bool              AcceptPartialOMPBForPriceAdapt(string &reason)
     {
      reason = "";
      if(!m_m05 || !m_ready || m_failed || m_finished || !m_price_joint ||
         m_price_forward_only || m_restore_only || m_price_study_phase != defForecastPriceOMPBCalibrate ||
         !m_ompb_configured || !m_ompb_reference_complete || m_ompb_epoch == 0 ||
         m_ompb_target_updates == 0 || ArraySize(m_fit) == 0)
        {
         reason = "M05_ACCEPT_PARTIAL_OMPB.restored_trained_state_required";
         return(false);
        }
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!ompb || !forecast || !decoder || ompb.ReferenceCount() != m_ompb_reference_capacity ||
         ompb.CurrentCount() != m_ompb_current_capacity || !SetOMPBStudyPolicy(OMPB_INFERENCE, reason))
         return(Fail("study_forecast.ompb.operator_acceptance_state:" + reason, reason));
      ulong frozen = 0, posterior = 0;
      if(!OMPBFrozenFingerprint(frozen, reason) || frozen != m_ompb_frozen_fingerprint ||
         !ompb.AppendParameterFingerprint(posterior) || posterior == m_ompb_initial_fingerprint ||
         decoder.UpdateCount() != m_ompb_decoder_updates)
         return(Fail("study_forecast.ompb.operator_acceptance_frozen_boundary:" + reason, reason));
      CNeuronConvOCL *heads[3];
      heads[0] = forecast.GetGenerator();
      heads[1] = forecast.GetRouter();
      heads[2] = forecast.GetConfidenceHead();
      for(int h = 0; h < 3; h++)
         if(!heads[h] || heads[h].NativeOptimizerStep() != m_ompb_forecast_steps[h])
            return(Fail("study_forecast.ompb.operator_acceptance_forecast_optimizer", reason));
      //--- This is operator acceptance for experimentation, not a quality PASS or full-budget completion.
      m_ompb_calibration_completed = true;
      m_ompb_epoch_started = false;
      m_ompb_source_pending = false;
      m_m05_manifest_bound = false;
      return(BeginPriceAdapt(reason));
     }

   string            PricePhaseTerminalStatus(void) const
     {
      return(m_price_phase_terminal_status);
     }
   //+-------------------------------------------------------------------+
   //| Advance a whole PRICE_JOINT transaction, then freeze at phase end |
   //+-------------------------------------------------------------------+
   bool              AdvancePriceJoint(double &loss, double &rho_sum, uint &rho_nonzero, uint &generator_step,
                          uint &router_step, uint &confidence_step, string &reason)
     {
      loss = 0;
      rho_sum = 0;
      rho_nonzero = 0;
      generator_step = 0;
      router_step = 0;
      confidence_step = 0;
      reason = "";
      if(!m_ready || m_failed || m_finished || !m_price_joint || m_price_forward_only || m_restore_only)
         return(Fail("study_forecast.price_joint.lifecycle", reason));
      m_m05_manifest_bound = false;
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
         return(AdvanceOMPBCalibrate(reason));
      if(m_price_study_phase == defForecastPriceAdapt)
         return(AdvancePriceAdapt(loss, rho_sum, rho_nonzero, generator_step, router_step, confidence_step, reason));
      if(m_price_study_phase == defForecastPriceVerify)
         return(CompleteM05Training(reason));
      if(m_cursor >= m_fit_limit)
         return(Fail("study_forecast.price_joint.fit_limit", reason));
      if(!AdvancePriceJointFit(loss, rho_sum, rho_nonzero, generator_step, router_step, confidence_step, reason))
         return(false);
      if(m_price_study_phase == defForecastPriceJoint && m_m05)
        {
         const bool epoch_complete = (m_cursor == m_fit_limit);
         if(epoch_complete)
            m_price_joint_epochs_completed++;
         const bool update_cap_reached = (m_price_joint_updates >= m_price_joint_update_limit);
         if(update_cap_reached && m_price_joint_epochs_completed < m_price_joint_epoch_limit)
           {
            if(!FreezePriceJoint(reason))
               return(false);
            m_price_phase_terminal_status = "STOPPED_COMPLETE_UPDATE";
            m_finished = true;
            return(true);
           }
         if(epoch_complete && m_price_joint_epochs_completed < m_price_joint_epoch_limit)
           {
            m_cursor = 0;
            m_epoch_started = false;
            return(true);
           }
        }
      if(m_cursor == m_fit_limit)
        {
         if(!FreezePriceJoint(reason))
            return(false);
         if(m_price_study_phase == defForecastPriceLatentPrepare)
           {
            CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
            ulong decoder_after = 0;
            if(!decoder || !decoder.AppendParameterFingerprint(decoder_after) ||
               decoder_after != m_price_latent_decoder_fingerprint)
               return(Fail("study_forecast.M05.latent_decoder_changed", reason));
            m_latent_epochs_completed++;
            if(m_latent_epochs_completed < m_ompb_profile.latent_epochs)
              {
               //--- The next fit step clears recurrent tapes, retaining weights and Adam state.
               m_cursor = 0;
               m_epoch_started = false;
               return(true);
              }
            //--- Restart chronological runtime tapes for fit; every learned parameter stays in this graph.
            m_price_study_phase = defForecastPriceJoint;
            m_fit_limit = ArraySize(m_fit);
            m_cursor = 0;
            m_epoch_started = false;
            m_price_joint_epochs_completed = 0;
            m_price_phase_terminal_status = "";
           }
         else
            if(m_m05 && m_full_run)
               return(BeginOMPBCalibrate(reason));
            else
               m_finished = true;
        }
      return(true);
     }
   double            PriceJointMeanLoss(void) const
     {
      return(m_price_joint_updates > 0 ? m_price_loss_sum / (double)m_price_joint_updates : 0);
     }
   //+------------------------------------------------------------------+
   //| Publish one historical normalized and native OHLC generation     |
   //+------------------------------------------------------------------+
   bool              AdvancePriceForward(float &normalized[], float &native[],
                            SDPCCHistoricalPriceSnapshot &snapshot, string &reason)
     {
      ArrayResize(normalized, 0);
      ArrayResize(native, 0);
      ZeroMemory(snapshot);
      if(m_ready_encoder_restored || !m_price_forward_only || !m_ready || m_failed || m_cursor >= ArraySize(m_fit))
         return(Fail("study_forecast.price_forward.lifecycle", reason));
      const int decision = m_fit[m_cursor];
      float state[];
      SDPCCHistoricalPriceSnapshot observed;
      if(!DPCCPackStudyForecastInput(m_bars, decision, state) ||
         !ForwardHistoricalPriceState(decision, state, observed, reason))
         return(Fail("study_forecast.price_forward.causal_input:" + reason, reason));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      CNeuronScenarioForecastPriceOCL *forecast = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      ulong decision_id = 0;
      double anchor = 0, scale = 0;
      float norm_values[], native_values[];
      if(!decoder || !forecast || !decoder.GetPriceAnchor(anchor, scale, decision_id) ||
         decision_id != observed.decision_id || anchor != observed.anchor || scale != observed.scale ||
         decoder.getOutput().GetData(norm_values) != 21 * 12 * 4 ||
         !decoder.BuildNativeScenarios(GetPointer(m_price_native), 12, observed.tick_size) ||
         m_price_native.GetData(native_values) != 21 * 12 * 4)
         return(Fail("study_forecast.price_forward.outputs_or_native_precision", reason));
      //--- Admit the complete generation before publishing any scenario.
      for(int k = 0; k < 21; k++)
         for(int h = 0; h < 12; h++)
           {
            const int base = (k * 12 + h) * 4;
            for(int c = 0; c < 4; c++)
               if(!MathIsValidNumber(norm_values[base + c]) || !MathIsValidNumber(native_values[base + c]) ||
                  native_values[base + c] <= 0)
                  return(Fail("study_forecast.price_forward.nonfinite_or_nonpositive", reason));
            if(norm_values[base + 1] < MathMax(norm_values[base], norm_values[base + 3]) ||
               norm_values[base + 2] > MathMin(norm_values[base], norm_values[base + 3]) ||
               native_values[base + 1] < MathMax(native_values[base], native_values[base + 3]) ||
               native_values[base + 2] > MathMin(native_values[base], native_values[base + 3]) ||
               (h == 0 && (norm_values[base] != 0 ||
                           MathAbs((double)native_values[base] - anchor) > 0.5 * observed.tick_size)))
               return(Fail("study_forecast.price_forward.OHLC_or_first_open", reason));
           }
      if(!decoder.Clear() || !forecast.CancelTrainingFrame() ||
         ArrayCopy(normalized, norm_values) != 21 * 12 * 4 || ArrayCopy(native, native_values) != 21 * 12 * 4)
        {
         ArrayResize(normalized, 0);
         ArrayResize(native, 0);
         return(Fail("study_forecast.price_forward.release_or_publish:" + reason, reason));
        }
      if(m_cursor + 1 == ArraySize(m_fit) && !VerifyFrozenProducerFingerprints(reason))
        {
         ArrayResize(normalized, 0);
         ArrayResize(native, 0);
         return(false);
        }
      snapshot = observed;
      m_cursor++;
      reason = "";
      return(true);
     }

   bool              Initialize(const string raw_path, const string raw_sha, const string root, const uint max_updates,
      string &reason)
     {
      reason = "";
      if(m_ready || m_failed || !DPCCReadStudyForecastRaw(raw_path, raw_sha, m_bars, m_raw_sha, reason) ||
         !DPCCBuildStudyForecastSplits(m_bars, m_fit, m_holdout, reason))
         return(Fail("study_forecast.raw_or_split:" + reason, reason));
      if(max_updates > 0 && max_updates > (uint)ArraySize(m_fit))
         return(Fail("study_forecast.max_updates_exceeds_fit", reason));
      m_max_updates = max_updates;
      m_full_run = (max_updates == 0);
      m_fit_limit = (m_full_run ? ArraySize(m_fit) : (int)max_updates);
      if(!DPCCCheckpointCanonicalPath(root, m_root, reason) ||
         FileIsExist(m_root + "/Market.initial.nnw") || FileIsExist(m_root + "/Target.initial.nnw") || FileIsExist(
            m_root + "/Encoder.initial.nnw") ||
         FileIsExist(m_root + "/Teacher.initial.nnw") || FileIsExist(m_root + "/EncoderTeacher.study.txt") ||
         FileIsExist(m_root + "/ForecastDecoder.study.txt") || !CreateGraphs(reason) || !m_target.ParameterFingerprint(
            m_teacher_initial_fingerprint))
         return(Fail("study_forecast.initialize:" + reason, reason));
      FolderCreate(m_root);
      const datetime now = TimeCurrent();
      if(!m_market.Save(m_root + "/Encoder.initial.nnw", 0, 0, 0, now, false) ||
         !m_target.Save(m_root + "/Teacher.initial.nnw", 0, 0, 0, now, false))
         return(Fail("study_forecast.initial_save", reason));
      m_ready = true;
      return(true);
     }

   bool              Advance(double &rho_sum, uint &rho_nonzero, uint &generator_step, uint &router_step,
                uint &confidence_step, bool &holdout_step, string &reason)
     {
      rho_sum = 0;
      rho_nonzero = 0;
      generator_step = 0;
      router_step = 0;
      confidence_step = 0;
      holdout_step = false;
      reason = "";
      if(!m_ready || m_failed || m_finished || m_restore_only || m_price_forward_only || m_price_joint)
         return(Fail("study_forecast.advance.lifecycle_or_price_mode", reason));
      if(m_cursor < m_fit_limit)
         return(AdvanceFit(rho_sum, rho_nonzero, generator_step, router_step, confidence_step, reason));
      if(!m_full_run)
         return(Fail("study_forecast.partial_holdout_refused", reason));
      holdout_step = true;
      return(AdvanceHoldout(reason));
     }

   bool              Finished(void) const { return(m_finished && !m_failed); }
   bool              PartialFitComplete(void) const { return(!m_full_run && m_cursor >= m_fit_limit && !m_failed); }
   ulong             Updates(void) const { return(m_updates); }
   int               FitCount(void) const { return(ArraySize(m_fit)); }
   int               HoldoutCount(void) const { return(ArraySize(m_holdout)); }
   int               HoldoutCompleted(void) const { return(m_holdout_cursor); }
   double            HoldoutLatentError(void) const { return(m_holdout_latent); }
   double            HoldoutValidExamples(void) const { return(m_holdout_valid); }
   double            HoldoutInvalidExamples(void) const { return(m_holdout_invalid); }
   string            RawSHA(void) const { return(m_raw_sha); }
   string            OMPBProfileSHA256(void) const { return(m_ompb_profile.profile_sha256); }
   //+------------------------------------------------------------------+
   //| CopyPinnedHistory returns the authenticated history and split    |
   //+------------------------------------------------------------------+
   bool              CopyPinnedHistory(SDPCCStudyForecastBar &bars[], int &fit[], int &holdout[],
                          string &raw_sha, string &reason) const
     {
      reason = "";
      raw_sha = "";
      bool outputs_cleared = true;
      if(ArrayResize(bars, 0) != 0)
         outputs_cleared = false;
      if(ArrayResize(fit, 0) != 0)
         outputs_cleared = false;
      if(ArrayResize(holdout, 0) != 0)
         outputs_cleared = false;
      if(!outputs_cleared)
        {
         reason = "study_forecast.copy_pinned_history.clear_outputs";
         return(false);
        }
      //--- Validate the authenticated source and its split indices.
      const int bar_count = ArraySize(m_bars);
      const int fit_count = ArraySize(m_fit);
      const int holdout_count = ArraySize(m_holdout);
      if(!m_ready || m_failed || !m_restore_only || bar_count <= 0 || fit_count <= 0 || holdout_count <= 0 ||
         !DPCCArchitectureSHA256Encoding(m_raw_sha))
        {
         reason = "study_forecast.copy_pinned_history.lifecycle_or_shape";
         return(false);
        }
      for(int i = 0; i < fit_count; i++)
        {
         if(m_fit[i] < 0 || m_fit[i] >= bar_count || (i > 0 && m_fit[i] <= m_fit[i - 1]))
           {
            reason = "study_forecast.copy_pinned_history.fit_indices";
            return(false);
           }
        }
      for(int i = 0; i < holdout_count; i++)
        {
         if(m_holdout[i] < 0 || m_holdout[i] >= bar_count || (i > 0 && m_holdout[i] <= m_holdout[i - 1]))
           {
            reason = "study_forecast.copy_pinned_history.holdout_indices";
            return(false);
           }
        }
      //--- Stage each array before publishing any output.
      SDPCCStudyForecastBar staged_bars[];
      int staged_fit[], staged_holdout[];
      if(ArrayResize(staged_bars, bar_count) != bar_count)
        {
         reason = "study_forecast.copy_pinned_history.stage_bars_resize";
         return(false);
        }
      if(ArrayResize(staged_fit, fit_count) != fit_count)
        {
         reason = "study_forecast.copy_pinned_history.stage_fit_resize";
         return(false);
        }
      if(ArrayResize(staged_holdout, holdout_count) != holdout_count)
        {
         reason = "study_forecast.copy_pinned_history.stage_holdout_resize";
         return(false);
        }
      if(ArrayCopy(staged_bars, m_bars) != bar_count)
        {
         reason = "study_forecast.copy_pinned_history.stage_bars_copy";
         return(false);
        }
      if(ArrayCopy(staged_fit, m_fit) != fit_count)
        {
         reason = "study_forecast.copy_pinned_history.stage_fit_copy";
         return(false);
        }
      if(ArrayCopy(staged_holdout, m_holdout) != holdout_count)
        {
         reason = "study_forecast.copy_pinned_history.stage_holdout_copy";
         return(false);
        }
      //--- Publish the staged arrays; clear every output if any copy fails.
      if(ArrayResize(bars, bar_count) != bar_count)
        {
         reason = "study_forecast.copy_pinned_history.publish_bars_resize";
         return(false);
        }
      if(ArrayResize(fit, fit_count) != fit_count)
        {
         if(ArrayResize(bars, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_bars";
         if(ArrayResize(fit, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_fit";
         if(ArrayResize(holdout, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_holdout";
         if(reason == "")
            reason = "study_forecast.copy_pinned_history.publish_fit_resize";
         return(false);
        }
      if(ArrayResize(holdout, holdout_count) != holdout_count)
        {
         if(ArrayResize(bars, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_bars";
         if(ArrayResize(fit, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_fit";
         if(ArrayResize(holdout, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_holdout";
         if(reason == "")
            reason = "study_forecast.copy_pinned_history.publish_holdout_resize";
         return(false);
        }
      if(ArrayCopy(bars, staged_bars) != bar_count)
        {
         if(ArrayResize(bars, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_bars";
         if(ArrayResize(fit, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_fit";
         if(ArrayResize(holdout, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_holdout";
         if(reason == "")
            reason = "study_forecast.copy_pinned_history.publish_bars_copy";
         return(false);
        }
      if(ArrayCopy(fit, staged_fit) != fit_count)
        {
         if(ArrayResize(bars, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_bars";
         if(ArrayResize(fit, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_fit";
         if(ArrayResize(holdout, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_holdout";
         if(reason == "")
            reason = "study_forecast.copy_pinned_history.publish_fit_copy";
         return(false);
        }
      if(ArrayCopy(holdout, staged_holdout) != holdout_count)
        {
         if(ArrayResize(bars, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_bars";
         if(ArrayResize(fit, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_fit";
         if(ArrayResize(holdout, 0) != 0)
            reason = "study_forecast.copy_pinned_history.clear_holdout";
         if(reason == "")
            reason = "study_forecast.copy_pinned_history.publish_holdout_copy";
         return(false);
        }
      //--- Finalize the output identity after all arrays have been copied.
      raw_sha = m_raw_sha;
      return(true);
     }
   bool              RawIndexForServerOpen(const long server_open, const bool require_fit, int &index,
      string &reason) const
     {
      if(!m_ready || m_failed || !DPCCStudyForecastUniqueServerOpen(m_bars, server_open, index, reason))
         return(false);
      const int fit_position = ArrayBsearch(m_fit, index);
      if(require_fit && (fit_position < 0 || fit_position >= ArraySize(m_fit) || m_fit[fit_position] != index))
        {index = -1; reason = "study_forecast.time_join.not_fit"; return(false);}
      reason = "";
      return(true);
     }
   bool              MatchesNativeOHLC(const int decision, const float &target_native_ohlc[],
                          const long &server_opens[], string &reason) const
     {
      return(m_ready && !m_failed &&
             DPCCStudyForecastMatchNativeHorizon(m_bars, decision, target_native_ohlc, server_opens, reason));
     }
   //+------------------------------------------------------------------+
   //| Restore authenticated native models without training permission  |
   //+------------------------------------------------------------------+
   bool              RestoreEncoderCompleted(const string raw_path, const string expected_raw_sha, const string root,
                                const string trusted_receipt_sha, string &reason,
                                const bool common_files = false)
     {
      if(m_ready || m_failed || !m_encoder_only || !DPCCArchitectureSHA256Encoding(expected_raw_sha))
         return(Fail("study_encoder.restore.lifecycle_or_raw_pin", reason));
      if(!DPCCCheckpointCanonicalPath(root, m_root, reason) || m_root != root ||
         !DPCCReadStudyForecastRaw(raw_path, expected_raw_sha, m_bars, m_raw_sha, m_raw_successor, reason,
            common_files) ||
         !DPCCBuildStudyForecastSplits(m_bars, m_fit, m_holdout, reason))
         return(Fail("study_encoder.restore.raw_or_split:" + reason, reason));
      SDPCCStudyEncoderReceipt receipt;
      if(!DPCCReadStudyEncoderReceipt(m_root, trusted_receipt_sha, m_raw_sha, (uint)ArraySize(m_fit),
                                      (uint)ArraySize(m_holdout), receipt, reason, common_files))
         return(Fail("study_encoder.restore.receipt:" + reason, reason));
      const string encoder_path = m_root + "/Encoder.trained.nnw";
      string actual = "";
      if(!DPCCCheckpointFileSHA(encoder_path, common_files, DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES, actual, reason) ||
         actual != receipt.encoder_sha256)
         return(Fail("study_encoder.restore.artifact_sha", reason));
      Print("DPCC_STUDY_GRAPH_INIT_BEGIN mode=restore_encoder");
      if(!CreateGraphs(reason, false))
         return(false);
      Print("DPCC_STUDY_GRAPH_INIT_COMPLETE mode=restore_encoder");
      float error = 0, undefined = 0, forecast_error = 0;
      datetime time = 0;
      if(!m_market.Load(encoder_path, error, undefined, forecast_error, time, common_files) ||
         !m_market.TrainMode(false) || !m_market.SetWeightsUpdate(false))
         return(Fail("study_encoder.restore.native_load_or_freeze", reason));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      const int types[] = {defNeuronBaseOCL, defNeuronBatchNormOCL, defNeuronDropoutOCL,
                           defNeuronCogDriverData, defNeuronCogDriverRankTCM, defNeuronOMPBOCL,
                              defNeuronScenarioForecast
                          };
      for(int i = 0; i < 7; i++)
         if(!m_market.Layer(i) || m_market.Layer(i).Type() != types[i])
            return(Fail("study_encoder.restore.encoder_graph", reason));
      if(!forecast || !ompb || m_market.Layer(7) != NULL || m_target.Layer(0) != NULL ||
         m_market.Layer(0).Neurons() != 45 || forecast.Scenarios() != 21 || forecast.Variables() != 9 ||
         forecast.GetTopK() != 5 || forecast.Horizon() != 12 || forecast.Dimension() != 16 ||
         forecast.RecoveryAge() != 256 ||
         !ompb.SetMode(OMPB_BYPASS) || !ompb.SetSourceAnchor(false) || !forecast.SetCodebookUpdate(false) ||
         !m_market.ParameterFingerprint(m_decoder_market_fingerprint))
         return(Fail("study_encoder.restore.geometry_or_frozen_policy", reason));
      if(!DPCCCheckpointFileSHA(encoder_path, common_files, DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES, actual, reason) ||
         actual != receipt.encoder_sha256)
         return(Fail("study_encoder.restore.changed_artifact", reason));
      if(!DPCCReadStudyEncoderReceipt(m_root, trusted_receipt_sha, m_raw_sha, (uint)ArraySize(m_fit),
                                      (uint)ArraySize(m_holdout), receipt, reason, common_files))
         return(Fail("study_encoder.restore.changed_receipt:" + reason, reason));
      m_decoder_target_fingerprint = 0;
      m_teacher_initial_fingerprint = 0;
      m_updates = receipt.fit_updates;
      m_restore_only = true;
      m_live_next_open = m_raw_successor;
      m_ready = true;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| AdvanceInference advances only admitted causal Encoder origins   |
   //+------------------------------------------------------------------+
   bool              AdvanceInference(const int decision, string &reason)
     {
      if(!m_encoder_only || !m_ready || m_failed || !m_restore_only)
         return(Fail("study_encoder.inference.lifecycle", reason));
      int selected = -1, position = -1;
      for(int split = 0; split < 2 && selected < 0; split++)
        {
         const int count = (split == 0 ? ArraySize(m_fit) : ArraySize(m_holdout));
         if(count == 0)
            continue;
         const int i = (split == 0 ? ArrayBsearch(m_fit, decision) : ArrayBsearch(m_holdout, decision));
         if(i >= 0 && i < count && (split == 0 ? m_fit[i] : m_holdout[i]) == decision)
           {
            selected = split;
            position = i;
           }
        }
      if(selected < 0)
         return(Fail("study_encoder.inference.unadmitted_decision", reason));
      m_live_prepared = false;
      //--- RankTCM retains causal history. Forward requests continue one chronological pass.
      //--- A split change or repeated/backward request replays from that split's first eligible origin.
      if(selected != m_inference_split || position <= m_inference_cursor)
        {
         if(!m_market.Clear())
            return(Fail("study_encoder.inference.split_clear", reason));
         m_inference_split = selected;
         m_inference_cursor = -1;
        }
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(!forecast || forecast.CodebookUpdate())
         return(Fail("study_encoder.inference.forecast_policy", reason));
      for(int i = m_inference_cursor + 1; i <= position; i++)
        {
         const int row = (selected == 0 ? m_fit[i] : m_holdout[i]);
         float state_values[];
         if(!DPCCPackStudyForecastInput(m_bars, row, state_values) || ArraySize(state_values) != 45)
            return(Fail("study_encoder.inference.input", reason));
         if(!ForwardHistoricalState(row, state_values, reason))
            return(false);
         m_inference_cursor = i;
        }
      reason = "";
      return(true);
     }

   bool              InferZ(const int decision, float &z[], string &reason)
     {
      ArrayResize(z, 0);
      if(!AdvanceInference(decision, reason))
         return(false);
      return(PublishZ(z, reason));
     }

   bool              InferZToDevice(const int decision, CBufferFloat *destination, string &reason)
     {
      m_z_available = false;
      if(!destination || destination.GetOpenCL() != m_market.GetOpenCL() ||
         destination.GetIndex() < 0 || destination.Total() != 36288)
         return(Fail("study_encoder.inference.device_destination", reason));
      if(!AdvanceInference(decision, reason))
         return(false);
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(!forecast || forecast.CodebookUpdate() || m_market.WeightsUpdateEnabled())
         return(Fail("study_encoder.inference.device_frozen", reason));
      if(!m_gradient_ops.CopyFinite(forecast.GetZ(), destination, 36288))
         return(Fail("study_encoder.inference.device_finite_copy", reason));
      m_z_available = true;
      reason = "";
      return(true);
     }
   //+-------------------------------------------------------------------+
   //| InferTesterZ advances frozen Encoder on actual closed Tester bars |
   //+-------------------------------------------------------------------+
   bool              InferTesterZ(const SDPCCStudyForecastBar &closed[], const long decision_open,
                     float &z[], string &reason)
     {
      ArrayResize(z, 0);
      if(!DPCCTesterOnly(reason))
         return(false);
      const bool cold = (m_inference_split != 2);
      const int expected_rows = (cold ? DPCC_ENCODER_WARMUP_HISTORY : DPCC_ENCODER_INPUT_WINDOW);
      if(!m_encoder_only || !m_ready || m_failed || !m_restore_only ||
         ArraySize(closed) != expected_rows || decision_open <= 0 || decision_open > INT_MAX ||
         (m_inference_split != -1 && m_inference_split != 2) ||
         (m_inference_split == 2 && decision_open <= m_inference_cursor))
         return(Fail("study_encoder.tester.lifecycle_or_chronology_or_warmup_rows", reason));
      for(int i = 0; i < expected_rows; i++)
         if(closed[i].server_open <= 0 || closed[i].server_open >= decision_open ||
            (i > 0 && closed[i].server_open <= closed[i - 1].server_open))
            return(Fail("study_encoder.tester.closed_input_order", reason));
      if(cold)
        {
         if(!m_market.Clear())
            return(Fail("study_encoder.tester.initial_clear", reason));
         //--- CogDriverData consumes the frozen input window. Replay enough overlapping
         //--- states to fill the frozen recurrent stack; only the final state is published.
         SDPCCStudyForecastBar window[];
         if(ArrayResize(window, DPCC_ENCODER_INPUT_WINDOW) != DPCC_ENCODER_INPUT_WINDOW)
            return(Fail("study_encoder.tester.warmup_window_allocate", reason));
         for(int end = DPCC_ENCODER_INPUT_WINDOW - 1; end < expected_rows; end++)
           {
            for(int j = 0; j < DPCC_ENCODER_INPUT_WINDOW; j++)
               window[j] = closed[end - (DPCC_ENCODER_INPUT_WINDOW - 1) + j];
            float state[];
            if(!DPCCPackStudyForecastInput(window, DPCC_ENCODER_INPUT_WINDOW, state) || !ForwardInferenceState(state,
               reason))
               return(Fail("study_encoder.tester.causal_warmup:" +
                           (string)(end - DPCC_ENCODER_INPUT_WINDOW + 2) + ":" + reason, reason));
           }
        }
      else
        {
         float state[];
         if(!DPCCPackStudyForecastInput(closed, DPCC_ENCODER_INPUT_WINDOW, state) || !ForwardInferenceState(state,
            reason))
            return(Fail("study_encoder.tester.incremental_state:" + reason, reason));
        }
      if(!PublishZ(z, reason))
         return(false);
      m_inference_split = 2;
      m_inference_cursor = (int)decision_open;
      return(true);
     }
   bool              TesterWarmupRequired(void) const
                     {return(m_inference_split != 2);}
   //+-------------------------------------------------------------------+
   //| PrepareZSnapshot allocates an owned buffer in the Encoder context |
   //+-------------------------------------------------------------------+
   bool              PrepareZSnapshot(CBufferFloat *destination, string &reason)
     {
      reason = "";
      COpenCLMy *context = m_market.GetOpenCL();
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(!m_encoder_only || !m_ready || m_failed || !m_restore_only ||
         CheckPointer(context) == POINTER_INVALID || CheckPointer(destination) == POINTER_INVALID ||
         !forecast || m_market.WeightsUpdateEnabled() || forecast.CodebookUpdate() ||
         destination == forecast.GetZ() || destination.GetOpenCL() != NULL ||
         destination.GetIndex() >= 0 || destination.Total() != 0)
        {
         reason = "study_encoder.snapshot.prepare_owner_context_or_shape";
         return(false);
        }
      const uint count = 21 * 9 * 12 * 16;
      if(!destination.BufferInit(count, 0.0f))
        {
         reason = "study_encoder.snapshot.prepare_init";
         return(false);
        }
      if(!destination.BufferCreate(context))
        {
         reason = "study_encoder.snapshot.prepare_create";
         return(false);
        }
      return(true);
     }
   //+------------------------------------------------------------------+
   //| CopyZ snapshots the last admitted Z in the Encoder context       |
   //+------------------------------------------------------------------+
   bool              CopyZ(CBufferFloat *destination, string &reason)
     {
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(!m_encoder_only || !m_ready || m_failed || !m_restore_only || !m_z_available ||
         !forecast || !destination || destination.GetOpenCL() != m_market.GetOpenCL() ||
         destination.GetIndex() < 0 || destination.Total() != 21 * 9 * 12 * 16 ||
         destination == forecast.GetZ() || m_market.WeightsUpdateEnabled() || forecast.CodebookUpdate())
        {
         reason = "study_encoder.snapshot.owner_context_or_shape";
         return(false);
        }
      if(!m_gradient_ops.Copy(forecast.GetZ(), destination, 21 * 9 * 12 * 16))
         return(Fail("study_encoder.snapshot.copy", reason));
      reason = "";
      return(true);
     }

   COpenCLMy         *EncoderContext(void)
     {
      if(!m_encoder_only || !m_ready || m_failed || !m_restore_only)
         return(NULL);
      return(m_market.GetOpenCL());
     }
   //+------------------------------------------------------------------+
   //| InferLiveZ commits one linked closed observation after Z publish |
   //+------------------------------------------------------------------+
   bool              InferLiveZ(const SDPCCClosedHistoryRow &captured, float &z[], string &reason)
     {
      //--- Refuse external input before changing the committed stream or native recurrent state.
      ArrayResize(z, 0);
      reason = "";
      if(!m_encoder_only || !m_ready || m_failed || !m_restore_only)
        {
         reason = "study_encoder.live.lifecycle";
         return(false);
        }
      const long ordinal = (long)ArraySize(m_bars) + m_live_count;
      if(ordinal >= INT_MAX)
        {
         reason = "study_encoder.live.capacity";
         return(false);
        }
      SDPCCClosedHistoryRow row;
      if(!DPCCRebaseStudyLiveRow(captured, m_live_next_open, ordinal, row, reason))
         return(false);
      SDPCCStudyForecastBar prior[];
      float state_values[], normalization[];
      if(!LivePredecessors(m_live_count, prior, reason))
         return(false);
      if(!DPCCPrepareStudyLiveInput(prior, row, m_live_next_open, ordinal, state_values, normalization, reason))
         return(false);
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(m_market.WeightsUpdateEnabled() || !forecast || forecast.CodebookUpdate())
         return(Fail("study_encoder.live.freeze_policy", reason));
      //--- Reserve the next committed row before any stateful device operation.
      if(ArrayResize(m_live_bars, m_live_count + 1) != m_live_count + 1)
        {
         reason = "study_encoder.live.row_capacity";
         return(false);
        }
      if(!PrepareLiveState(reason) || !ForwardInferenceState(state_values, reason) ||
         !PublishZ(z, reason))
        {
         ArrayResize(z, 0);
         ArrayResize(m_live_bars, m_live_count);
         return(false);
        }
      //--- Publish only after exact output shape, finiteness, and frozen-parameter checks.
      m_live_bars[m_live_count] = row.bar;
      m_live_count++;
      m_live_next_open = row.successor_open_server;
      m_inference_split = -1;
      m_inference_cursor = -1;
      return(true);
     }

   long              LiveNextOrdinal(void) const { return((long)ArraySize(m_bars) + m_live_count); }
   long              LiveNextServerOpen(void) const { return(m_live_next_open); }
   int               LiveCount(void) const { return(m_live_count); }

   bool              SaveCompleted(string &reason)
     {
      return(SaveEncoderCompleted(reason));
     }

  };
//+------------------------------------------------------------------+
//| Rebase the restored Market on pre-start Tester chart history     |
//+------------------------------------------------------------------+
bool DPCCPrepareReadyMarketLiveStart(CDPCCStudyForecastCore &market,
                                     const string symbol, const int &handles[],
                                     const long first_closed_open, string &reason)
  {
   reason = "";
//--- Validate the first live bar.
   if(symbol == "" || first_closed_open <= 0 || ArraySize(handles) != 4)
     {
      reason = "ready_market.live.start.arguments";
      return(false);
     }
   const int count = DPCC_ENCODER_WARMUP_HISTORY;
   const long current_open = (long)iTime(symbol, PERIOD_H1, 0);
   if(current_open <= first_closed_open ||
      (long)iTime(symbol, PERIOD_H1, 1) != first_closed_open)
     {
      reason = "ready_market.live.start.bar_binding";
      return(false);
     }
   SDPCCClosedHistoryRow history[];
   if(ArrayResize(history, count) != count)
     {
      reason = "ready_market.live.start.capacity";
      return(false);
     }
//--- Capture the available pre-start bars in chronological order.
   for(int i = 0; i < count; i++)
     {
      const int shift = count + 1 - i;
      if(!DPCCCaptureTesterClosedRow(symbol, handles, shift, history[i], reason))
         return(false);
      const long expected_successor = (i + 1 < count ?
                                       (long)iTime(symbol, PERIOD_H1, shift - 1) : first_closed_open);
      if(history[i].successor_open_server != expected_successor ||
         history[i].bar.server_open >= first_closed_open ||
         (i > 0 && (history[i - 1].bar.server_open >= history[i].bar.server_open ||
                    history[i - 1].successor_open_server != history[i].bar.server_open)))
        {
         reason = StringFormat("ready_market.live.start.history_link.%d", i);
         return(false);
        }
     }
//--- Rebase the restored Market at the first live decision.
   return(market.RebaseReadyMarketLiveHistory(history, first_closed_open, reason));
  }
#endif
#endif
#undef DPCC_TRAJECTORY_INCLUDE_STUDY_FORECAST_CORE
//+------------------------------------------------------------------+
//| Shared central model decoding for Study and Trading restoration  |
//+------------------------------------------------------------------+
struct SDPCCTrainingModelBinding
  {
   uint              price_basis;
   float             action_bias[6], action_scale[6], probability_tolerance;
   double            volume_scale, price_scale, money_scale, schedule_s, beta_cap;
   double            beta[], alpha_bar[], sigma[];
  };
//+------------------------------------------------------------------+
//| Function DPCCRecordNonzeroMantissa                               |
//+------------------------------------------------------------------+
bool DPCCRecordNonzeroMantissa(const string lexeme)
  {
   for(int i = 0; i < StringLen(lexeme); i++)
     {
      const ushort ch = StringGetCharacter(lexeme, i);
      if(ch == 'e' || ch == 'E')
         break;
      if(ch >= '1' && ch <= '9')
         return(true);
     }
   return(false);
  }
//+------------------------------------------------------------------+
//| Function DPCCRecordFloatArray                                    |
//+------------------------------------------------------------------+
bool DPCCRecordFloatArray(CDPCCJsonDocument &document, const int node, const uint count,
                          float &values[], const string path, string &reason,
                          const int domain = 0, const double tolerance = 0)
  {
   ArrayResize(values, 0);
   if(document.Type(node) != DPCC_JSON_ARRAY || document.ChildCount(node) != (int)count ||
      ArrayResize(values, (int)count) != (int)count)
     {reason = path + ".length"; return(false);}
   double original_sum = 0, converted_sum = 0;
   for(uint i = 0; i < count; i++)
     {
      double number = 0;
      if(!document.TryNumber(document.ChildAt(node, (int)i), number) ||
         !MathIsValidNumber((float)number))
        {reason = StringFormat("%s[%u].float32", path, i); return(false);}
      if(number == 0 && DPCCRecordNonzeroMantissa(document.Text(document.ChildAt(node, (int)i))))
        {reason = StringFormat("%s[%u].double_underflow", path, i); return(false);}
      const float converted = (float)number;
      if((domain == 1 && (number <= 0 || converted <= 0)) ||
         (domain == 2 && (number < 0 || converted < 0)))
        {reason = StringFormat("%s[%u].domain", path, i); return(false);}
      values[i] = converted;
      original_sum += number;
      converted_sum += (double)converted;
     }
   if(domain == 2 && (!MathIsValidNumber(original_sum) || !MathIsValidNumber(converted_sum) ||
                      MathAbs(original_sum - 1) > tolerance || MathAbs(converted_sum - 1) > tolerance))
     {reason = path + ".simplex"; return(false);}
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCDecodePreparedActorConfig                           |
//+------------------------------------------------------------------+
bool DPCCDecodePreparedActorConfig(const string source, const SDPCCConfig &training,
                                   SDPCCConfig &actor, float &limits[], string &reason)
  {
   reason = "";
   CDPCCJsonDocument d;
   if(!d.Parse(source, reason))
      return(false);
   actor = training;
   actor.shape.PlanBatch = actor.shape.M;
   actor.shape.Depth = 0;
   actor.mode = DPCC_P0;
   const int root = d.Root(), projection = d.FindMember(root, "projection"), risk = d.FindMember(root, "risk"),
             price = d.FindMember(root, "price_contract"), execution = d.FindMember(root, "execution_contract"),
             diffusion = d.FindMember(root, "diffusion"), bound = d.FindMember(risk, "limits");
   long iterations = 0, evaluations = 0, lookback = 0;
   string name = "", quote = "", event = "", randomness = "";
   double parameter = 0, mean = 0, gamma = 0;
   if(!DPCCResourceReadLong(d, projection, "max_iterations", iterations, reason, "actor.iterations") ||
      !DPCCResourceReadLong(d, projection, "max_evaluations", evaluations, reason, "actor.evaluations") ||
      !DPCCResourceReadLong(d, projection, "lookback_steps", lookback, reason, "actor.lookback") ||
      iterations < 1 || iterations > UINT_MAX || evaluations < 1 || evaluations > UINT_MAX || lookback < 1 || lookback >
         actor.shape.H ||
      !DPCCResourceReadDouble(d, projection, "improvement_atol", actor.projection_improvement_atol, reason,
         "actor.improvement") ||
      !DPCCResourceReadDouble(d, projection, "distance_tie_atol", actor.projection_distance_tie_atol, reason,
         "actor.tie") ||
      !DPCCResourceReadString(d, risk, "type", name, reason, "actor.risk") ||
      !DPCCResourceReadDouble(d, risk, "parameter", parameter, reason, "actor.parameter") ||
      !DPCCResourceReadDouble(d, risk, "mean_weight", mean, reason, "actor.mean") ||
      !DPCCResourceReadDouble(d, risk, "gamma", gamma, reason, "actor.gamma") ||
      !DPCCResourceReadString(d, price, "quote_adapter", quote, reason, "actor.quote") ||
      !DPCCResourceReadString(d, execution, "event_model", event, reason, "actor.event") || event !=
         "LOCAL_TWO_PATH_V1" ||
      !DPCCResourceReadString(d, diffusion, "randomness_version", randomness, reason, "actor.randomness") ||
         randomness != "INDEXED_NORMAL_V1" ||
      !DPCCResourceReadDouble(d, price, "max_quote_age_seconds", actor.max_quote_age_seconds, reason,
         "actor.quote_age") ||
      !DPCCResourceReadDouble(d, price, "max_last_age_seconds", actor.max_last_age_seconds, reason, "actor.last_age"))
     {if(StringLen(reason) == 0)reason = "actor.model_operational_profile"; return(false);}
   if(quote == "BID_IDENTITY_V1" && actor.price_basis == DPCC_PRICE_BID)
      actor.quote_adapter = DPCC_QUOTE_BID_IDENTITY_V1;
   else
      if(quote == "LAST_FROZEN_OFFSET_V1" && actor.price_basis == DPCC_PRICE_LAST)
         actor.quote_adapter = DPCC_QUOTE_LAST_FROZEN_OFFSET_V1;
      else
        {
         reason = "actor.model_quote_profile";
         return(false);
        }
   actor.projection_max_iterations = (uint)iterations;
   actor.projection_max_evaluations = (uint)evaluations;
   actor.projection_lookback_steps = (uint)lookback;
   if(name == "MEAN")
      actor.risk_type = defSRM_MEAN;
   else
      if(name == "CVAR")
         actor.risk_type = defSRM_CVAR;
      else
         if(name == "MEAN_CVAR")
            actor.risk_type = defSRM_MEAN_CVAR;
         else
            if(name == "EXPONENTIAL")
               actor.risk_type = defSRM_EXPONENTIAL;
            else
               if(name == "DUAL_POWER")
                  actor.risk_type = defSRM_DUAL_POWER;
               else
                 {
                  reason = "actor.model_risk_type";
                  return(false);
                 }
   actor.risk_parameter = (float)parameter;
   actor.mean_weight = (float)mean;
   actor.gamma = (float)gamma;
   actor.event_model = DPCC_EVENT_LOCAL_TWO_PATH_V1;
   actor.randomness_version = DPCC_RANDOM_INDEXED_NORMAL_V1;
//--- Missing extension denotes exactly the old pinned financial profile.
//--- Partial explicit metadata cannot upgrade or silently downgrade a Model.
   const int margin_model = d.FindMember(execution, "margin_fx_model"), calc_version = d.FindMember(execution,
      "calc_contract_version"),
             money_digits = d.FindMember(execution, "account_currency_digits"), round_model = d.FindMember(execution,
                "margin_rounding_model");
   actor.margin_fx_profile = DPCC_MARGIN_EXTERNAL_V2;
   actor.account_currency_digits = 0;
   if(margin_model >= 0 || calc_version >= 0 || money_digits >= 0 || round_model >= 0)
     {
      string margin_name = "", round_name = "";
      long version = 0, digits = 0;
      if(!DPCCResourceReadString(d, execution, "margin_fx_model", margin_name, reason, "actor.margin_model") ||
         !DPCCResourceReadLong(d, execution, "calc_contract_version", version, reason, "actor.calc_version") ||
         !DPCCResourceReadLong(d, execution, "account_currency_digits", digits, reason, "actor.currency_digits") ||
         !DPCCResourceReadString(d, execution, "margin_rounding_model", round_name, reason, "actor.margin_rounding"))
         return(false);
      if(margin_name == "EXTERNAL_CURRENCY_V2" && version == 2 && digits == 0 && round_name == "LEGACY_UNROUNDED_V2")
         actor.margin_fx_profile = DPCC_MARGIN_EXTERNAL_V2;
      else
         if(margin_name == "FOREX_BASE_MARGIN_ACCOUNT_PROFIT_SPOT_V1" && version == 3 && digits >= 0 && digits <= 8 &&
            round_name == "ACCOUNT_CURRENCY_NEAREST_BOUNDED_FP32_V1")
           {actor.margin_fx_profile = DPCC_MARGIN_FOREX_SPOT_V1; actor.account_currency_digits = (uint)digits;}
         else
            if(margin_name == "HISTORICAL_CLOSE_FX_V1" && version == 4 && digits >= 0 && digits <= 8 &&
               round_name == "ACCOUNT_CURRENCY_NEAREST_BOUNDED_FP32_V1")
              {actor.margin_fx_profile = DPCC_MARGIN_HISTORICAL_CLOSE_V1; actor.account_currency_digits = (uint)digits;}
            else
              {
               reason = "actor.model_financial_profile";
               return(false);
              }
     }
//--- Reuse exactly the native DPCC/FQF admission, including risk-specific domains.
   if((actor.risk_type == defSRM_DUAL_POWER && parameter < 1) || !DPCCValidateFixedConfig(actor.shape, actor))
     {
      reason = "actor.model_native_config";
      return(false);
     }
   const string names[] = {"max_abs_lots", "min_free_margin", "max_margin_fraction", "min_equity",
      "max_loss_from_snapshot",
                           "max_drawdown_cash", "max_daily_loss", "min_sl_points", "max_sl_points", "min_tp_points",
                              "max_tp_points",
                           "free_margin_reserve", "loss_reserve", "extra_slippage_points", "volume_atol", "price_atol",
                              "money_atol",
                           "money_rtol", "probability_atol", "max_price_jump_diagnostic", "active_mask",
                              "risk_scale_cash", "limit_version", "reserved_zero"
                          };
   if(ArrayResize(limits, 24) != 24)
     {
      reason = "actor.limits_capacity";
      return(false);
     }
   for(int i = 0; i < 24; i++)
     {
      double value = 0;
      if(!DPCCResourceReadDouble(d, bound, names[i], value, reason, "actor.limit"))
         return(false);
      limits[i] = (float)value;
      if(!MathIsValidNumber(limits[i]))
        {
         reason = "actor.limit_float";
         return(false);
        }
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCRunModelValues                                      |
//+------------------------------------------------------------------+
bool DPCCRunModelValues(CDPCCJsonDocument &d, const SDPCCResourceShape &shape,
                        SDPCCTrainingModelBinding &binding, string &reason)
  {
   const int root = d.Root(), norm = d.FindMember(root, "normalization"), risk = d.FindMember(root, "risk"),
             scales = d.FindMember(risk, "technical_scales"), limits = d.FindMember(risk, "limits"), diff =
                d.FindMember(root, "diffusion");
   string basis;
   const int price = d.FindMember(root, "price_contract");
   if(!DPCCResourceReadString(d, price, "chart_price_basis", basis, reason, "model.chart_price_basis"))
      return(false);
   if(basis == "BID")
      binding.price_basis = DPCC_PRICE_BID;
   else
      if(basis == "LAST")
         binding.price_basis = DPCC_PRICE_LAST;
      else
        {
         reason = "training.model_price_basis";
         return(false);
        }
   float bias[], scale[], gain[], nbias[];
   if(!DPCCRecordFloatArray(d, d.FindMember(norm, "action_bias"), 6, bias, "model.action_bias", reason) ||
      !DPCCRecordFloatArray(d, d.FindMember(norm, "action_scale"), 6, scale, "model.action_scale", reason, 1) ||
      !DPCCRecordFloatArray(d, d.FindMember(norm, "gain"), 4, gain, "model.gain", reason) ||
      !DPCCRecordFloatArray(d, d.FindMember(norm, "bias"), 4, nbias, "model.bias", reason))
      return(false);
   for(int i = 0; i < 4; i++)
      if(gain[i] != 1 || nbias[i] != 0)
        {
         reason = "training.revin_gain1";
         return(false);
        }
   for(int i = 0; i < 6; i++)
     {
      binding.action_bias[i] = bias[i];
      binding.action_scale[i] = scale[i];
     }
   double tolerance;
   if(!DPCCResourceReadDouble(d, scales, "volume_scale", binding.volume_scale, reason, "model.volume_scale") ||
      !DPCCResourceReadDouble(d, scales, "price_scale", binding.price_scale, reason, "model.price_scale") ||
      !DPCCResourceReadDouble(d, scales, "money_scale", binding.money_scale, reason, "model.money_scale") ||
      !DPCCResourceReadDouble(d, limits, "probability_atol", tolerance, reason, "model.probability_atol") ||
      !DPCCResourceReadDouble(d, diff, "s", binding.schedule_s, reason, "model.diffusion.s") ||
      !DPCCResourceReadDouble(d, diff, "beta_cap", binding.beta_cap, reason, "model.diffusion.beta_cap"))
      return(false);
   binding.probability_tolerance = (float)tolerance;
   const int count = (int)shape.J + 1;
   if(shape.J < 1 || shape.J > 64 || ArrayResize(binding.beta, count) != count || ArrayResize(binding.alpha_bar,
      count) != count ||
      ArrayResize(binding.sigma, count) != count)
     {
      reason = "training.model_schedule_capacity";
      return(false);
     }
   int bn = d.FindMember(diff, "beta"), an = d.FindMember(diff, "alpha_bar"), sn = d.FindMember(diff, "sigma");
   if(d.ChildCount(bn) != count || d.ChildCount(an) != count || d.ChildCount(sn) != count)
     {
      reason = "training.model_schedule_length";
      return(false);
     }
   for(int i = 0; i < count; i++)
      if(!d.TryNumber(d.ChildAt(bn, i), binding.beta[i]) || !d.TryNumber(d.ChildAt(an, i), binding.alpha_bar[i]) ||
         !d.TryNumber(d.ChildAt(sn, i), binding.sigma[i]))
        {
         reason = "training.model_schedule_numeric";
         return(false);
        }
   return(true);
  }
//+------------------------------------------------------------------+
//| Decode the same central Action6 model for training and           |
//| restoration                                                      |
//+------------------------------------------------------------------+
string DPCCAction6RuntimeDoubleArray(const double &values[])
  {
   string json = "[";
   for(int i = 0; i < ArraySize(values); i++)
     {
      if(!MathIsValidNumber(values[i]))
         return("");
      json += (i == 0 ? "" : ",") + StringFormat("%.17g", values[i]);
     }
   return(json + "]");
  }
//+------------------------------------------------------------------+
//| Function DPCCAction6RuntimeFloatArray                            |
//+------------------------------------------------------------------+
string DPCCAction6RuntimeFloatArray(const float &values[])
  {
   string json = "[";
   for(int i = 0; i < ArraySize(values); i++)
     {
      if(!MathIsValidNumber((double)values[i]))
         return("");
      json += (i == 0 ? "" : ",") + StringFormat("%.9g", (double)values[i]);
     }
   return(json + "]");
  }
//+------------------------------------------------------------------+
//| Function DPCCAction6RuntimeReadArray                             |
//+------------------------------------------------------------------+
bool DPCCAction6RuntimeReadArray(CDPCCJsonDocument &document, const int root, const string key,
                                 const int expected, double &values[], string &reason)
  {
   const int node = document.FindMember(root, key);
   if(node < 0 || document.Type(node) != DPCC_JSON_ARRAY || document.ChildCount(node) != expected ||
      ArrayResize(values, expected) != expected)
     {reason = "action6.runtime." + key + ".shape"; return(false);}
   for(int i = 0; i < expected; i++)
      if(!document.TryNumber(document.ChildAt(node, i), values[i]) || !MathIsValidNumber(values[i]))
        {reason = StringFormat("action6.runtime.%s[%d].number", key, i); return(false);}
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCEncodeAction6ModelRuntime                           |
//+------------------------------------------------------------------+
bool DPCCEncodeAction6ModelRuntime(const SDPCCRuntimeConfig &runtime, const float &limits[],
                                   string &source, string &reason)
  {
   source = "";
   reason = "";
   const SDPCCConfig c = runtime.financial;
   if(ArraySize(limits) != 24 || !DPCCValidateFixedConfig(c.shape, c) ||
      ArraySize(runtime.beta) != (int)c.shape.J + 1 || ArraySize(runtime.alpha_bar) != (int)c.shape.J + 1 ||
      ArraySize(runtime.sigma) != (int)c.shape.J + 1)
     {reason = "action6.runtime.encode.shape"; return(false);}
   const long integers[] = {c.shape.K, c.shape.V, c.shape.H, c.shape.D, c.shape.M, c.shape.J, c.shape.E,
                            c.shape.PlanBatch, c.shape.NActions, c.shape.StateSize, c.shape.Embedding, c.shape.Heads,
                            c.shape.KeyDimension, c.shape.Depth, c.contract_version, c.binary_layer_version, (
                               long)c.mode,
                            c.projection_max_iterations, c.projection_max_evaluations, c.projection_lookback_steps,
                            c.price_basis, c.quote_adapter, c.event_model, c.risk_type, c.normalization_mode,
                               c.loss_coordinates,
                            c.randomness_version, c.margin_fx_profile, c.account_currency_digits
                           };
   const double reals[] = {c.projection_improvement_atol, c.projection_distance_tie_atol, c.volume_scale,
                           c.price_scale, c.money_scale, c.max_quote_age_seconds, c.max_last_age_seconds
                          };
   const double scalars[] = {(double)c.risk_parameter, (double)c.mean_weight, (double)c.gamma, (
      double)c.probability_tolerance};
   string integer_json = "[", real_json = "[", scalar_json = "[";
   for(int i = 0; i < ArraySize(integers); i++)
      integer_json += (i == 0 ? "" : ",") + (string)integers[i];
   for(int i = 0; i < ArraySize(reals); i++)
     {
      if(!MathIsValidNumber(reals[i]))
        {
         reason = "action6.runtime.encode.real";
         return(false);
        }
      real_json += (i == 0 ? "" : ",") + StringFormat("%.17g", reals[i]);
     }
   for(int i = 0; i < ArraySize(scalars); i++)
     {
      if(!MathIsValidNumber(scalars[i]))
        {
         reason = "action6.runtime.encode.scalar";
         return(false);
        }
      scalar_json += (i == 0 ? "" : ",") + StringFormat("%.9g", scalars[i]);
     }
   integer_json += "]";
   real_json += "]";
   scalar_json += "]";
   string bias_json = "[", scale_json = "[";
   for(int i = 0; i < 6; i++)
     {
      if(!MathIsValidNumber((double)c.action_bias[i]) || !MathIsValidNumber((double)c.action_scale[i]))
        {reason = "action6.runtime.encode.action"; return(false);}
      bias_json += (i == 0 ? "" : ",") + StringFormat("%.9g", (double)c.action_bias[i]);
      scale_json += (i == 0 ? "" : ",") + StringFormat("%.9g", (double)c.action_scale[i]);
     }
   bias_json += "]";
   scale_json += "]";
   const string beta_json = DPCCAction6RuntimeDoubleArray(runtime.beta);
   const string alpha_json = DPCCAction6RuntimeDoubleArray(runtime.alpha_bar);
   const string sigma_json = DPCCAction6RuntimeDoubleArray(runtime.sigma);
   const string limits_json = DPCCAction6RuntimeFloatArray(limits);
   if(beta_json == "" || alpha_json == "" || sigma_json == "" || limits_json == "")
     {reason = "action6.runtime.encode.nonfinite"; return(false);}
   source = "{\"format\":\"DPCC_ACTION6_RUNTIME_V1\",\"integers\":" + integer_json +
            ",\"reals\":" + real_json + ",\"scalars\":" + scalar_json +
            ",\"action_bias\":" + bias_json + ",\"action_scale\":" + scale_json +
            ",\"beta\":" + beta_json + ",\"alpha_bar\":" + alpha_json +
            ",\"sigma\":" + sigma_json + ",\"limits\":" + limits_json + "}";
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCDecodeAction6RuntimeEnvelope                        |
//+------------------------------------------------------------------+
bool DPCCDecodeAction6RuntimeEnvelope(CDPCCJsonDocument &document, const int root,
                                      SDPCCRuntimeConfig &runtime, float &limits[], string &reason)
  {
   double integers[], reals[], scalars[], bias[], scale[], beta[], alpha[], sigma[], limit_values[];
   if(!DPCCAction6RuntimeReadArray(document, root, "integers", 29, integers, reason) ||
      !DPCCAction6RuntimeReadArray(document, root, "reals", 7, reals, reason) ||
      !DPCCAction6RuntimeReadArray(document, root, "scalars", 4, scalars, reason) ||
      !DPCCAction6RuntimeReadArray(document, root, "action_bias", 6, bias, reason) ||
      !DPCCAction6RuntimeReadArray(document, root, "action_scale", 6, scale, reason) ||
      !DPCCAction6RuntimeReadArray(document, root, "limits", 24, limit_values, reason))
      return(false);
   for(int i = 0; i < 29; i++)
      if(!MathIsValidNumber(integers[i]) || integers[i] < 0 || MathFloor(integers[i]) != integers[i] ||
         integers[i] > UINT_MAX)
        {reason = StringFormat("action6.runtime.integer_%d", i); return(false);}
   if(integers[16] > DPCC_P2 || integers[23] > INT_MAX)
     {reason = "action6.runtime.integer_domain"; return(false);}
   SDPCCConfig c;
   ZeroMemory(c);
   c.shape.K = (uint)integers[0];
   c.shape.V = (uint)integers[1];
   c.shape.H = (uint)integers[2];
   c.shape.D = (uint)integers[3];
   c.shape.M = (uint)integers[4];
   c.shape.J = (uint)integers[5];
   c.shape.E = (uint)integers[6];
   c.shape.PlanBatch = (uint)integers[7];
   c.shape.NActions = (uint)integers[8];
   c.shape.StateSize = (uint)integers[9];
   c.shape.Embedding = (uint)integers[10];
   c.shape.Heads = (uint)integers[11];
   c.shape.KeyDimension = (uint)integers[12];
   c.shape.Depth = (uint)integers[13];
   c.contract_version = (uint)integers[14];
   c.binary_layer_version = (uint)integers[15];
   c.mode = (ENUM_DPCC_MODE)(int)integers[16];
   c.projection_max_iterations = (uint)integers[17];
   c.projection_max_evaluations = (uint)integers[18];
   c.projection_lookback_steps = (uint)integers[19];
   c.price_basis = (uint)integers[20];
   c.quote_adapter = (uint)integers[21];
   c.event_model = (uint)integers[22];
   c.risk_type = (int)integers[23];
   c.normalization_mode = (uint)integers[24];
   c.loss_coordinates = (uint)integers[25];
   c.randomness_version = (uint)integers[26];
   c.margin_fx_profile = (uint)integers[27];
   c.account_currency_digits = (uint)integers[28];
   for(int i = 0; i < 7; i++)
      if(!MathIsValidNumber(reals[i]))
        {
         reason = StringFormat("action6.runtime.real_%d", i);
         return(false);
        }
   for(int i = 0; i < 4; i++)
      if(!MathIsValidNumber(scalars[i]) || !MathIsValidNumber((float)scalars[i]))
        {reason = StringFormat("action6.runtime.scalar_%d", i); return(false);}
   c.projection_improvement_atol = reals[0];
   c.projection_distance_tie_atol = reals[1];
   c.volume_scale = reals[2];
   c.price_scale = reals[3];
   c.money_scale = reals[4];
   c.max_quote_age_seconds = reals[5];
   c.max_last_age_seconds = reals[6];
   c.risk_parameter = (float)scalars[0];
   c.mean_weight = (float)scalars[1];
   c.gamma = (float)scalars[2];
   c.probability_tolerance = (float)scalars[3];
   for(int i = 0; i < 6; i++)
     {
      c.action_bias[i] = (float)bias[i];
      c.action_scale[i] = (float)scale[i];
      if(!MathIsValidNumber((double)c.action_bias[i]) || !MathIsValidNumber((double)c.action_scale[i]))
        {reason = "action6.runtime.action_float32"; return(false);}
     }
   if(!DPCCValidateFixedConfig(c.shape, c) || ArrayResize(limits, 24) != 24)
     {reason = "action6.runtime.config_or_limits"; return(false);}
   for(int i = 0; i < 24; i++)
     {
      if(!MathIsValidNumber(limit_values[i]) || !MathIsValidNumber((float)limit_values[i]))
        {reason = StringFormat("action6.runtime.limit_%d", i); return(false);}
      limits[i] = (float)limit_values[i];
     }
   if(!DPCCAction6RuntimeReadArray(document, root, "beta", (int)c.shape.J + 1, beta, reason) ||
      !DPCCAction6RuntimeReadArray(document, root, "alpha_bar", (int)c.shape.J + 1, alpha, reason) ||
      !DPCCAction6RuntimeReadArray(document, root, "sigma", (int)c.shape.J + 1, sigma, reason))
      return(false);
   if(ArrayResize(runtime.beta, ArraySize(beta)) != ArraySize(beta) ||
      ArrayResize(runtime.alpha_bar, ArraySize(alpha)) != ArraySize(alpha) ||
      ArrayResize(runtime.sigma, ArraySize(sigma)) != ArraySize(sigma))
     {reason = "action6.runtime.schedule_capacity"; return(false);}
   for(int i = 0; i < ArraySize(beta); i++)
     {
      if(beta[i] < 0 || beta[i] >= 1 || alpha[i] <= 0 || alpha[i] > 1 || sigma[i] < 0)
        {reason = StringFormat("action6.runtime.schedule_%d", i); return(false);}
      runtime.beta[i] = beta[i];
      runtime.alpha_bar[i] = alpha[i];
      runtime.sigma[i] = sigma[i];
     }
   runtime.financial = c;
   ArrayInitialize(runtime.condition_scale, 1.0f);
   ArrayInitialize(runtime.condition_bias, 0.0f);
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCDecodeAction6ModelRuntime                           |
//+------------------------------------------------------------------+
bool DPCCDecodeAction6ModelRuntime(const string model_source, SDPCCRuntimeConfig &runtime,
                                   float &limits[], string &reason)
  {
   ZeroMemory(runtime);
   ArrayResize(limits, 0);
   CDPCCJsonDocument model_document;
   string parse_reason = "";
   if(model_document.Parse(model_source, parse_reason))
     {
      const int format = model_document.FindMember(model_document.Root(), "format");
      if(format >= 0 && model_document.Type(format) == DPCC_JSON_STRING &&
         model_document.Text(format) == "DPCC_ACTION6_RUNTIME_V1")
         return(DPCCDecodeAction6RuntimeEnvelope(model_document, model_document.Root(), runtime, limits, reason));
     }
   reason = "";
   SDPCCCentralModel model;
   SDPCCTrainingModelBinding binding;
   if(!model_document.Parse(model_source, reason) || !DPCCDecodeCentralModel(model_document, model, reason) ||
      model.example_only || model.shapes.K != 21 || model.shapes.V != 9 || model.shapes.H != 12 || model.shapes.D !=
         16 ||
      model.shapes.M < 1 || model.shapes.M > 64 || model.shapes.J < 1 || model.shapes.J > 64 ||
      model.shapes.E < 1 || model.shapes.E > UINT_MAX ||
      !DPCCRunModelValues(model_document, model.shapes, binding, reason))
     {reason = "action6.central_model_profile:" + reason; return(false);}
   SDPCCConfig training;
   ZeroMemory(training);
   training.shape.K = 21;
   training.shape.V = 9;
   training.shape.H = 12;
   training.shape.D = 4;
   training.shape.M = (uint)model.shapes.M;
   training.shape.J = (uint)model.shapes.J;
   training.shape.E = (uint)model.shapes.E;
   training.shape.PlanBatch = 1;
   training.shape.NActions = 6;
   training.shape.StateSize = 13;
   training.shape.Embedding = 16;
   training.shape.Heads = 1;
   training.shape.KeyDimension = 16;
   training.shape.Depth = 0;
   training.contract_version = 2;
   training.binary_layer_version = 3;
   training.normalization_mode = DPCC_NORMALIZATION_CAUSAL_AFFINE_V2;
   training.loss_coordinates = DPCC_LOSS_NORMALIZED;
   training.price_basis = binding.price_basis;
   training.volume_scale = binding.volume_scale;
   training.price_scale = binding.price_scale;
   training.money_scale = binding.money_scale;
   training.probability_tolerance = binding.probability_tolerance;
   for(int i = 0; i < 6; i++)
     {
      training.action_bias[i] = binding.action_bias[i];
      training.action_scale[i] = binding.action_scale[i];
     }
   if(!DPCCDecodePreparedActorConfig(model_source, training, runtime.financial, limits, reason) ||
      !DPCCBuildCosineDiffusionSchedule(training.shape.J, binding.schedule_s, binding.beta_cap,
                                        runtime.beta, runtime.alpha_bar, runtime.sigma, reason))
      return(false);
   for(int i = 0; i < ArraySize(runtime.beta); i++)
      if(runtime.beta[i] != binding.beta[i] || runtime.alpha_bar[i] != binding.alpha_bar[i] || runtime.sigma[i] !=
         binding.sigma[i])
        {reason = "action6.central_model_schedule_mismatch"; return(false);}
   ArrayInitialize(runtime.condition_scale, 1.0f);
   ArrayInitialize(runtime.condition_bias, 0.0f);
   return(true);
  }
//+------------------------------------------------------------------+
//| Build the existing Action6 runtime from EA inputs and terminal   |
//+------------------------------------------------------------------+
bool DPCCBuildAction6RuntimeFromInputs(const ENUM_DPCC_MODE mode, const ulong noise_seed,
                                       const double schedule_s, const double beta_cap,
                                       const int risk_type, const double risk_parameter,
                                       const double mean_weight, const double gamma,
                                       const uint projection_iterations, const uint projection_evaluations,
                                       const uint projection_lookback, const double improvement_atol,
                                       const double distance_tie_atol, const double min_equity,
                                       const double max_sl_points, const double max_tp_points,
                                       SDPCCRuntimeConfig &runtime, float &limits[], string &reason)
  {
   ZeroMemory(runtime);
   ArrayResize(limits, 0);
   reason = "";
   const double input_numbers[] = {schedule_s, beta_cap, risk_parameter, mean_weight, gamma,
                                   improvement_atol, distance_tie_atol, min_equity, max_sl_points, max_tp_points
                                  };
   for(int i = 0; i < ArraySize(input_numbers); i++)
      if(!MathIsValidNumber(input_numbers[i]) || !MathIsValidNumber((float)input_numbers[i]))
        {
         reason = "action6.inputs.nonfinite";
         return(false);
        }
   if(min_equity < 0 || max_sl_points <= 0 || max_tp_points <= 0 ||
      (risk_type == defSRM_DUAL_POWER && risk_parameter < 1))
     {
      reason = "action6.inputs.risk_or_action_scale";
      return(false);
     }
   SDPCCConfig config;
   ZeroMemory(config);
//--- These dimensions are the existing Action6 architecture, not a data restriction.
   config.shape.K = 21;
   config.shape.V = 9;
   config.shape.H = 12;
   config.shape.D = 4;
   config.shape.M = 16;
   config.shape.J = 32;
   config.shape.E = DPCC_HISTORY_CALENDAR_MIN_EVENTS;
   config.shape.PlanBatch = config.shape.M;
   config.shape.NActions = 6;
   config.shape.StateSize = 13;
   config.shape.Embedding = 16;
   config.shape.Heads = 1;
   config.shape.KeyDimension = 16;
   config.shape.Depth = 0;
   config.contract_version = DPCC_CONTRACT_VERSION;
   config.binary_layer_version = DPCC_BINARY_LAYER_VERSION;
   config.mode = mode;
   config.projection_max_iterations = projection_iterations;
   config.projection_max_evaluations = projection_evaluations;
   config.projection_lookback_steps = projection_lookback;
   config.projection_improvement_atol = improvement_atol;
   config.projection_distance_tie_atol = distance_tie_atol;
   config.volume_scale = 1.0;
   config.price_scale = 1.0;
   config.money_scale = 1000.0;
   config.risk_type = risk_type;
   config.risk_parameter = (float)risk_parameter;
   config.mean_weight = (float)mean_weight;
   config.gamma = (float)gamma;
   config.probability_tolerance = 0.00001f;
   config.event_model = DPCC_EVENT_LOCAL_TWO_PATH_V1;
   config.normalization_mode = DPCC_NORMALIZATION_CAUSAL_AFFINE_V2;
   config.loss_coordinates = DPCC_LOSS_NORMALIZED;
   config.randomness_version = DPCC_RANDOM_INDEXED_NORMAL_V1;
   for(int i = 0; i < 6; i++)
      config.action_scale[i] = 1.0f;
   long chart_mode = 0, calculation_mode = 0;
   if(!SymbolInfoInteger(_Symbol, SYMBOL_CHART_MODE, chart_mode) ||
      !SymbolInfoInteger(_Symbol, SYMBOL_TRADE_CALC_MODE, calculation_mode))
     {
      reason = "action6.inputs.symbol_properties";
      return(false);
     }
   config.price_basis = (chart_mode == SYMBOL_CHART_MODE_LAST ? DPCC_PRICE_LAST : DPCC_PRICE_BID);
   config.quote_adapter = config.price_basis;
   config.max_quote_age_seconds = 3600.0;
   config.max_last_age_seconds = 3600.0;
   const bool forex = (calculation_mode == SYMBOL_CALC_MODE_FOREX ||
                       calculation_mode == SYMBOL_CALC_MODE_FOREX_NO_LEVERAGE);
   config.margin_fx_profile = (forex && config.price_basis == DPCC_PRICE_BID ?
                               DPCC_MARGIN_FOREX_SPOT_V1 : DPCC_MARGIN_EXTERNAL_V2);
   config.account_currency_digits = (config.margin_fx_profile == DPCC_MARGIN_EXTERNAL_V2 ? 0 :
                                     (uint)AccountInfoInteger(ACCOUNT_CURRENCY_DIGITS));
   if(!DPCCValidateFixedConfig(config.shape, config) ||
      !DPCCBuildCosineDiffusionSchedule(config.shape.J, schedule_s, beta_cap,
                                        runtime.beta, runtime.alpha_bar, runtime.sigma, reason))
     {
      if(reason == "")
         reason = "action6.inputs.native_runtime";
      return(false);
     }
//--- Preserve the former 24-slot direct-lot profile and its numeric tolerances.
   const float values[] = {0, 0, 0, (float)min_equity, 0, 0, 0, 0, (float)max_sl_points,
                           0, (float)max_tp_points, 0, 0, 0, 0.000001f, 0.00001f, 0.01f, 0.00001f, 0.00001f,
                           0, 8, 1000, 2, 0
                          };
   if(ArrayCopy(limits, values) != 24)
     {
      reason = "action6.inputs.limits_capacity";
      return(false);
     }
   runtime.financial = config;
//--- The caller replaces these neutral coordinates with the loaded FIT normalization.
   ArrayInitialize(runtime.condition_scale, 1.0f);
   ArrayInitialize(runtime.condition_bias, 0.0f);
   return(true);
  }

#ifdef DPCC_TRAJECTORY_ENTRY_STUDY
#ifndef DPCC_STUDY_STAGE_LOADER_MQH
#define DPCC_STUDY_STAGE_LOADER_MQH
#ifndef DPCC_STUDY_STAGE_INPUT_MQH
#define DPCC_STUDY_STAGE_INPUT_MQH
#ifndef DPCC_EPOCH_OWNER_MQH
#define DPCC_EPOCH_OWNER_MQH
#ifndef DPCC_RUN_PLAN_MQH
#define DPCC_RUN_PLAN_MQH
#ifndef DPCC_TRAINING_MQH
#define DPCC_TRAINING_MQH
//--- Canonical destination uses Model.mqh and BankStaging.mqh in this directory.
#ifndef DPCC_MODEL_MQH
#define DPCC_MODEL_MQH
//--- Bounded deployment preparation, never a readiness gate.

#endif
#ifndef DPCC_BANK_STAGING_CANDIDATE_MQH
#define DPCC_BANK_STAGING_CANDIDATE_MQH
//--- WORK CANDIDATE. Includes resolve from the canonical consumer directory.
#ifndef DPCC_BANK_READER_MQH
#define DPCC_BANK_READER_MQH

#define DPCC_BANK_PREFIX_BYTES 20
#define DPCC_BANK_FOOTER_BYTES 48
#define DPCC_BANK_RECORD_FRAME_BYTES 36
#define DPCC_BANK_DIGEST_BYTES DPCC_SHA256_DIGEST_BYTES
#define DPCC_BANK_MAX_JSON_BYTES 4194304
#define DPCC_BANK_STREAM_CHUNK_BYTES 65536

struct SDPCCBankIntegrityResult
  {
   uchar             header_bytes[];
   int               header_length;
   string            header_sha256;
   string            prefix_sha256;
   string            bank_sha256;
   ulong             file_bytes;
   ulong             record_count;
  };
//+------------------------------------------------------------------+
//| Function DPCCBankIntegrityClear                                  |
//+------------------------------------------------------------------+
void DPCCBankIntegrityClear(SDPCCBankIntegrityResult &result)
  {
   ArrayResize(result.header_bytes, 0);
   result.header_length = 0;
   result.header_sha256 = "";
   result.prefix_sha256 = "";
   result.bank_sha256 = "";
   result.file_bytes = 0;
   result.record_count = 0;
  }
//+------------------------------------------------------------------+
//| Function DPCCBankIntegrityFail                                   |
//+------------------------------------------------------------------+
bool DPCCBankIntegrityFail(SDPCCBankIntegrityResult &result, string &reason,
                           const string code, const int handle = INVALID_HANDLE)
  {
   if(handle != INVALID_HANDLE)
      FileClose(handle);
   DPCCBankIntegrityClear(result);
   reason = code;
   return(false);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankExpectedSHAValid                                |
//+------------------------------------------------------------------+
bool DPCCBankExpectedSHAValid(const string digest)
  {
   if(StringLen(digest) != 64)
      return(false);
   for(int i = 0; i < 64; i++)
     {
      const ushort ch = StringGetCharacter(digest, i);
      if(!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')))
         return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankReadUnsignedLE                                  |
//+------------------------------------------------------------------+
ulong DPCCBankReadUnsignedLE(const uchar &bytes[], const int offset, const int width)
  {
   ulong value = 0;
   for(int i = 0; i < width; i++)
      value |= ((ulong)bytes[offset + i] << (i * 8));
   return(value);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankRawDigestHex                                    |
//+------------------------------------------------------------------+
string DPCCBankRawDigestHex(const uchar &bytes[], const int offset, const int length)
  {
   const string alphabet = "0123456789abcdef";
   string hex = "";
   for(int i = 0; i < length; i++)
     {
      hex += StringSubstr(alphabet, (int)(bytes[offset + i] >> 4), 1);
      hex += StringSubstr(alphabet, (int)(bytes[offset + i] & 0x0F), 1);
     }
   return(hex);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankUpdate                                          |
//+------------------------------------------------------------------+
bool DPCCBankUpdate(CDPCCIncrementalSHA256 &hash, const uchar &bytes[], const int count,
                    string &reason)
  {
   return(hash.Update(bytes, 0, count, reason));
  }
//+------------------------------------------------------------------+
//| Function DPCCBankReadPrefixRegion                                |
//+------------------------------------------------------------------+
bool DPCCBankReadPrefixRegion(const int handle, uchar &scratch[], const ulong length,
                              CDPCCIncrementalSHA256 &whole_hash,
                              CDPCCIncrementalSHA256 &prefix_hash, ulong &position,
                              string &reason)
  {
   ulong remaining = length;
   while(remaining > 0)
     {
      const int requested = (int)MathMin((double)ArraySize(scratch), (double)remaining);
      ResetLastError();
      const uint read = FileReadArray(handle, scratch, 0, requested);
      if(read != (uint)requested)
        {
         reason = StringFormat("bank.read.short.%u.%d", read, GetLastError());
         return(false);
        }
      if(!DPCCBankUpdate(whole_hash, scratch, requested, reason) ||
         !DPCCBankUpdate(prefix_hash, scratch, requested, reason))
         return(false);
      position += (ulong)requested;
      remaining -= (ulong)requested;
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankReadHeader                                      |
//+------------------------------------------------------------------+
bool DPCCBankReadHeader(const int handle, uchar &scratch[], uchar &header[],
                        const int length, CDPCCIncrementalSHA256 &whole_hash,
                        CDPCCIncrementalSHA256 &prefix_hash,
                        CDPCCIncrementalSHA256 &header_hash, ulong &position,
                        string &reason)
  {
   if(ArrayResize(header, length) != length)
     { reason = "bank.header.capacity"; return(false); }
   int copied = 0;
   while(copied < length)
     {
      const int requested = MathMin(ArraySize(scratch), length - copied);
      ResetLastError();
      const uint read = FileReadArray(handle, scratch, 0, requested);
      if(read != (uint)requested)
        {
         reason = StringFormat("bank.header.short.%u.%d", read, GetLastError());
         return(false);
        }
      if(!DPCCBankUpdate(whole_hash, scratch, requested, reason) ||
         !DPCCBankUpdate(prefix_hash, scratch, requested, reason) ||
         !DPCCBankUpdate(header_hash, scratch, requested, reason))
         return(false);
      if(ArrayCopy(header, scratch, copied, 0, requested) != requested)
        { reason = "bank.header.copy"; return(false); }
      copied += requested;
      position += (ulong)requested;
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankReadRecordPayload                               |
//+------------------------------------------------------------------+
bool DPCCBankReadRecordPayload(const int handle, uchar &scratch[], const ulong length,
                               CDPCCIncrementalSHA256 &whole_hash,
                               CDPCCIncrementalSHA256 &prefix_hash,
                               CDPCCIncrementalSHA256 &record_hash, ulong &position,
                               uchar &captured_payload[], const bool capture_payload,
                               string &reason)
  {
   if(capture_payload && ArrayResize(captured_payload, (int)length) != (int)length)
     { reason = "bank.record.capture.capacity"; return(false); }
   ulong copied = 0;
   ulong remaining = length;
   while(remaining > 0)
     {
      const int requested = (int)MathMin((double)ArraySize(scratch), (double)remaining);
      ResetLastError();
      const uint read = FileReadArray(handle, scratch, 0, requested);
      if(read != (uint)requested)
        {
         reason = StringFormat("bank.record.short.%u.%d", read, GetLastError());
         return(false);
        }
      if(!DPCCBankUpdate(whole_hash, scratch, requested, reason) ||
         !DPCCBankUpdate(prefix_hash, scratch, requested, reason) ||
         !DPCCBankUpdate(record_hash, scratch, requested, reason))
         return(false);
      if(capture_payload && ArrayCopy(captured_payload, scratch, (int)copied, 0, requested) != requested)
        { reason = "bank.record.capture.copy"; return(false); }
      copied += (ulong)requested;
      position += (ulong)requested;
      remaining -= (ulong)requested;
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankVerifyFooterAtEOF                               |
//+------------------------------------------------------------------+
bool DPCCBankVerifyFooterAtEOF(const int handle, const ulong footer_start,
                               const uchar &expected_footer[], string &reason)
  {
   if(!FileSeek(handle, (long)footer_start, SEEK_SET))
     { reason = "bank.footer.eof_seek"; return(false); }
   uchar actual_footer[];
   if(!DPCCBankReadExact(handle, actual_footer, DPCC_BANK_FOOTER_BYTES, reason))
     { reason = "bank.footer.eof_read"; return(false); }
   if(ArraySize(actual_footer) != ArraySize(expected_footer))
     { reason = "bank.footer.eof_size"; return(false); }
   for(int i = 0; i < DPCC_BANK_FOOTER_BYTES; i++)
      if(actual_footer[i] != expected_footer[i])
        { reason = "bank.footer.changed"; return(false); }
   if(FileTell(handle) != (long)(footer_start + DPCC_BANK_FOOTER_BYTES))
     { reason = "bank.file.not_eof"; return(false); }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankReadExact                                       |
//+------------------------------------------------------------------+
bool DPCCBankReadExact(const int handle, uchar &bytes[], const int count, string &reason)
  {
   if(ArrayResize(bytes, count) != count)
     { reason = "bank.buffer.capacity"; return(false); }
   ResetLastError();
   const uint read = FileReadArray(handle, bytes, 0, count);
   if(read != (uint)count)
     {
      reason = StringFormat("bank.read.fixed_short.%u.%d", read, GetLastError());
      return(false);
     }
   return(true);
  }
//--- Validation-only contract: implementations may update provisional in-memory state.
//--- They must not write externally, submit trades, or make training decisions.
class CDPCCBankRecordValidationObserver
  {
public:
   virtual bool      BeginRecord(const ulong record_index, const ulong payload_bytes, string &reason) = 0;
   virtual bool      ConsumeChunk(const ulong record_index, const uchar &chunk[], const int count, string &reason) = 0;
   virtual bool      EndRecord(const ulong record_index, string &reason) = 0;
   virtual bool      Complete(string &reason) = 0;
   virtual void      Abort(void) = 0;
  };
//+------------------------------------------------------------------+
//| Function DPCCBankObserverPointerValid                            |
//+------------------------------------------------------------------+
bool DPCCBankObserverPointerValid(CDPCCBankRecordValidationObserver *observer)
  {
   const ENUM_POINTER_TYPE pointer_type = CheckPointer(observer);
   return(pointer_type == POINTER_AUTOMATIC || pointer_type == POINTER_DYNAMIC);
  }
//+------------------------------------------------------------------+
//| Function DPCCBankScanHandle                                      |
//+------------------------------------------------------------------+
bool DPCCBankScanHandle(const int handle,
                        const string expected_bank_sha256,
                        SDPCCBankIntegrityResult &result,
                        string &reason,
                        CDPCCBankRecordValidationObserver *observer,
                        bool &callback_active, bool &callback_mutation,
                        ulong &session_generation, const ulong scan_generation)
  {
   DPCCBankIntegrityClear(result);
   reason = "";
   ResetLastError();
   const ulong file_bytes = FileSize(handle);
   if(GetLastError() != 0)
      return(DPCCBankIntegrityFail(result, reason, "bank.file.size"));
   if(file_bytes > (ulong)LONG_MAX)
      return(DPCCBankIntegrityFail(result, reason, "bank.file.seek_range"));
   if(file_bytes < (ulong)(DPCC_BANK_PREFIX_BYTES + 1 + DPCC_BANK_FOOTER_BYTES))
      return(DPCCBankIntegrityFail(result, reason, "bank.file.too_short"));
   const ulong footer_start = file_bytes - DPCC_BANK_FOOTER_BYTES;
   if(!FileSeek(handle, (long)footer_start, SEEK_SET))
      return(DPCCBankIntegrityFail(result, reason, "bank.footer.seek"));
   uchar footer[];
   if(!DPCCBankReadExact(handle, footer, DPCC_BANK_FOOTER_BYTES, reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.footer.short_read"));
   if(footer[0] != 'D' || footer[1] != 'P' || footer[2] != 'C' || footer[3] != 'C' ||
      footer[4] != 'E' || footer[5] != 'N' || footer[6] != 'D' || footer[7] != '2')
      return(DPCCBankIntegrityFail(result, reason, "bank.footer.magic"));
   const ulong declared_records = DPCCBankReadUnsignedLE(footer, 8, 8);
   if(!FileSeek(handle, 0, SEEK_SET))
      return(DPCCBankIntegrityFail(result, reason, "bank.file.seek_start"));
   uchar scratch[];
   if(ArrayResize(scratch, DPCC_BANK_STREAM_CHUNK_BYTES) != DPCC_BANK_STREAM_CHUNK_BYTES)
      return(DPCCBankIntegrityFail(result, reason, "bank.scratch.capacity"));
   uchar fixed_prefix[];
   if(!DPCCBankReadExact(handle, fixed_prefix, DPCC_BANK_PREFIX_BYTES, reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.prefix.short_read"));
   if(fixed_prefix[0] != 'D' || fixed_prefix[1] != 'P' || fixed_prefix[2] != 'C' ||
      fixed_prefix[3] != 'C' || fixed_prefix[4] != 'B' || fixed_prefix[5] != 'K' ||
      fixed_prefix[6] != '0' || fixed_prefix[7] != '2')
      return(DPCCBankIntegrityFail(result, reason, "bank.magic"));
   if(DPCCBankReadUnsignedLE(fixed_prefix, 8, 2) != 2 ||
      DPCCBankReadUnsignedLE(fixed_prefix, 10, 2) != 0)
      return(DPCCBankIntegrityFail(result, reason, "bank.version"));
   if(DPCCBankReadUnsignedLE(fixed_prefix, 12, 4) != 0x01020304)
      return(DPCCBankIntegrityFail(result, reason, "bank.endian"));
   const ulong header_length = DPCCBankReadUnsignedLE(fixed_prefix, 16, 4);
   if(header_length == 0)
      return(DPCCBankIntegrityFail(result, reason, "bank.header.length.zero"));
   if(header_length > DPCC_BANK_MAX_JSON_BYTES)
      return(DPCCBankIntegrityFail(result, reason, "bank.header.length.limit"));
   if((ulong)DPCC_BANK_PREFIX_BYTES + header_length > footer_start)
      return(DPCCBankIntegrityFail(result, reason, "bank.header.length.file_bounds"));
   CDPCCIncrementalSHA256 whole_hash, prefix_hash, header_hash;
   if(!whole_hash.Init(reason) || !prefix_hash.Init(reason) || !header_hash.Init(reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.hash.init"));
   ulong position = 0;
   if(!DPCCBankUpdate(whole_hash, fixed_prefix, DPCC_BANK_PREFIX_BYTES, reason) ||
      !DPCCBankUpdate(prefix_hash, fixed_prefix, DPCC_BANK_PREFIX_BYTES, reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.hash.prefix"));
   position = DPCC_BANK_PREFIX_BYTES;
   uchar header_bytes[];
   if(!DPCCBankReadHeader(handle, scratch, header_bytes, (int)header_length,
                          whole_hash, prefix_hash, header_hash, position, reason))
      return(DPCCBankIntegrityFail(result, reason, reason));
   if(position > footer_start || footer_start - position < DPCC_BANK_RECORD_FRAME_BYTES + 1)
     {
      if(declared_records != 0 || position != footer_start)
         return(DPCCBankIntegrityFail(result, reason, "bank.footer.count.impossible"));
     }
   if(declared_records > (footer_start - position) / (DPCC_BANK_RECORD_FRAME_BYTES + 1))
      return(DPCCBankIntegrityFail(result, reason, "bank.footer.count.impossible"));
   ulong actual_records = 0;
   uchar captured_payload[];
   while(position < footer_start)
     {
      if(footer_start - position < DPCC_BANK_RECORD_FRAME_BYTES + 1)
         return(DPCCBankIntegrityFail(result, reason, "bank.record.frame.truncated"));
      uchar length_bytes[];
      if(!DPCCBankReadExact(handle, length_bytes, 4, reason))
         return(DPCCBankIntegrityFail(result, reason, "bank.record.length.short"));
      if(!DPCCBankUpdate(whole_hash, length_bytes, 4, reason) ||
         !DPCCBankUpdate(prefix_hash, length_bytes, 4, reason))
         return(DPCCBankIntegrityFail(result, reason, "bank.hash.record_length"));
      position += 4;
      const ulong payload_length = DPCCBankReadUnsignedLE(length_bytes, 0, 4);
      if(payload_length == 0)
         return(DPCCBankIntegrityFail(result, reason, "bank.record.length.zero"));
      if(payload_length > DPCC_BANK_MAX_JSON_BYTES)
         return(DPCCBankIntegrityFail(result, reason, "bank.record.length.limit"));
      if(payload_length > footer_start - position - DPCC_BANK_DIGEST_BYTES)
         return(DPCCBankIntegrityFail(result, reason, "bank.record.frame.truncated"));
      uchar record_digest[];
      if(!DPCCBankReadExact(handle, record_digest, DPCC_BANK_DIGEST_BYTES, reason))
         return(DPCCBankIntegrityFail(result, reason, "bank.record.digest.short"));
      if(!DPCCBankUpdate(whole_hash, record_digest, DPCC_BANK_DIGEST_BYTES, reason) ||
         !DPCCBankUpdate(prefix_hash, record_digest, DPCC_BANK_DIGEST_BYTES, reason))
         return(DPCCBankIntegrityFail(result, reason, "bank.hash.record_digest"));
      position += DPCC_BANK_DIGEST_BYTES;
      CDPCCIncrementalSHA256 record_hash;
      if(!record_hash.Init(reason))
         return(DPCCBankIntegrityFail(result, reason, "bank.record.hash.init"));
      if(!DPCCBankReadRecordPayload(handle, scratch, payload_length, whole_hash,
                                    prefix_hash, record_hash, position, captured_payload,
                                    observer != NULL, reason))
         return(DPCCBankIntegrityFail(result, reason, reason));
      uchar record_hash_bytes[];
      string record_hash_hex = "";
      if(!record_hash.Final(record_hash_bytes, record_hash_hex, reason))
         return(DPCCBankIntegrityFail(result, reason, "bank.record.hash.final"));
      if(record_hash_hex != DPCCBankRawDigestHex(record_digest, 0, DPCC_BANK_DIGEST_BYTES))
         return(DPCCBankIntegrityFail(result, reason, "bank.record.digest"));
      if(observer != NULL)
        {
         if(!DPCCBankObserverPointerValid(observer))
            return(DPCCBankIntegrityFail(result, reason, "bank.record.observer.invalid_pointer"));
         callback_active = true;
         const bool begin_ok = observer.BeginRecord(actual_records, payload_length, reason);
         callback_active = false;
         if(callback_mutation || session_generation != scan_generation)
            return(DPCCBankIntegrityFail(result, reason, "bank.session.callback_mutation"));
         if(!begin_ok)
            return(DPCCBankIntegrityFail(result, reason, "bank.record.observer.begin"));
         ulong delivered = 0;
         while(delivered < payload_length)
           {
            const int delivery_count = (int)MathMin((double)ArraySize(scratch),
                                                    (double)(payload_length - delivered));
            if(ArrayCopy(scratch, captured_payload, 0, (int)delivered, delivery_count) != delivery_count)
               return(DPCCBankIntegrityFail(result, reason, "bank.record.observer.copy"));
            if(!DPCCBankObserverPointerValid(observer))
               return(DPCCBankIntegrityFail(result, reason, "bank.record.observer.invalid_pointer"));
            callback_active = true;
            const bool chunk_ok = observer.ConsumeChunk(actual_records, scratch, delivery_count, reason);
            callback_active = false;
            if(callback_mutation || session_generation != scan_generation)
               return(DPCCBankIntegrityFail(result, reason, "bank.session.callback_mutation"));
            if(!chunk_ok)
               return(DPCCBankIntegrityFail(result, reason, "bank.record.observer.chunk"));
            delivered += (ulong)delivery_count;
           }
         if(!DPCCBankObserverPointerValid(observer))
            return(DPCCBankIntegrityFail(result, reason, "bank.record.observer.invalid_pointer"));
         callback_active = true;
         const bool end_ok = observer.EndRecord(actual_records, reason);
         callback_active = false;
         if(callback_mutation || session_generation != scan_generation)
            return(DPCCBankIntegrityFail(result, reason, "bank.session.callback_mutation"));
         if(!end_ok)
            return(DPCCBankIntegrityFail(result, reason, "bank.record.observer.end"));
         ArrayResize(captured_payload, 0);
        }
      actual_records++;
     }
   if(position != footer_start)
      return(DPCCBankIntegrityFail(result, reason, "bank.frame.trailing_or_truncated"));
   if(actual_records != declared_records)
      return(DPCCBankIntegrityFail(result, reason, "bank.footer.count.mismatch"));
   uchar prefix_digest[];
   string prefix_hex = "";
   if(!prefix_hash.Final(prefix_digest, prefix_hex, reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.prefix.hash.final"));
   if(prefix_hex != DPCCBankRawDigestHex(footer, 16, 32))
      return(DPCCBankIntegrityFail(result, reason, "bank.footer.prefix_sha256"));
   if(!DPCCBankVerifyFooterAtEOF(handle, footer_start, footer, reason))
      return(DPCCBankIntegrityFail(result, reason, reason));
   if(!whole_hash.Update(footer, 0, DPCC_BANK_FOOTER_BYTES, reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.full.hash.footer"));
   uchar whole_digest[];
   string whole_hex = "";
   if(!whole_hash.Final(whole_digest, whole_hex, reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.full.hash.final"));
   if(whole_hex != expected_bank_sha256)
      return(DPCCBankIntegrityFail(result, reason, "bank.file.sha256"));
   uchar header_digest[];
   string header_hex = "";
   if(!header_hash.Final(header_digest, header_hex, reason))
      return(DPCCBankIntegrityFail(result, reason, "bank.header.hash.final"));
   if(ArrayResize(result.header_bytes, ArraySize(header_bytes)) != ArraySize(header_bytes))
      return(DPCCBankIntegrityFail(result, reason, "bank.result.header.capacity"));
   if(ArrayCopy(result.header_bytes, header_bytes, 0, 0, ArraySize(header_bytes)) != ArraySize(header_bytes))
      return(DPCCBankIntegrityFail(result, reason, "bank.result.header.copy"));
   result.header_length = (int)header_length;
   result.header_sha256 = header_hex;
   result.prefix_sha256 = prefix_hex;
   result.bank_sha256 = whole_hex;
   result.file_bytes = file_bytes;
   result.record_count = actual_records;
   reason = "";
   return(true);
  }
//+------------------------------------------------------------------+
//| Declaration CDPCCBankIntegritySession                            |
//+------------------------------------------------------------------+
class CDPCCBankIntegritySession
  {
private:
   int                       m_handle;
   string                    m_expected_sha256;
   ulong                     m_file_bytes;
   SDPCCBankIntegrityResult  m_pass_a;
   bool                      m_pass_a_valid;
   bool                      m_record_pass_verified;
   CDPCCBankRecordValidationObserver *m_observer;
   ulong                     m_generation;
   bool                      m_callback_active;
   bool                      m_callback_mutation;

   void              BumpGeneration(void)
     {
      m_generation++;
      if(m_generation == 0)
         m_generation = 1;
     }

   bool              RejectMutationDuringCallback(string &reason)
     {
      if(!m_callback_active)
         return(false);
      m_callback_mutation = true;
      reason = "bank.session.callback_mutation";
      return(true);
     }

   void              AbortBorrowedObserver(CDPCCBankRecordValidationObserver *observer)
     {
      const bool previously_active = m_callback_active;
      m_callback_active = true;
      if(DPCCBankObserverPointerValid(observer))
         observer.Abort();
      m_callback_active = previously_active;
     }

   void              AbortObserver(void)
     {
      CDPCCBankRecordValidationObserver *observer = m_observer;
      m_observer = NULL;
      AbortBorrowedObserver(observer);
     }

   bool              Fail(string &reason, const string code)
     {
      AbortObserver();
      Close();
      DPCCBankIntegrityClear(m_pass_a);
      m_pass_a_valid = false;
      m_record_pass_verified = false;
      reason = code;
      return(false);
     }

   bool              CopyPassResult(SDPCCBankIntegrityResult &result, string &reason)
     {
      if(ArrayResize(result.header_bytes, ArraySize(m_pass_a.header_bytes)) != ArraySize(m_pass_a.header_bytes) ||
         ArrayCopy(result.header_bytes, m_pass_a.header_bytes, 0, 0, ArraySize(m_pass_a.header_bytes)) != ArraySize(
            m_pass_a.header_bytes))
        { reason = "bank.result.header.copy"; return(false); }
      result.header_length = m_pass_a.header_length;
      result.header_sha256 = m_pass_a.header_sha256;
      result.prefix_sha256 = m_pass_a.prefix_sha256;
      result.bank_sha256 = m_pass_a.bank_sha256;
      result.file_bytes = m_pass_a.file_bytes;
      result.record_count = m_pass_a.record_count;
      return(true);
     }

public:
   void              CDPCCBankIntegritySession(void)
     {
      m_handle = INVALID_HANDLE;
      m_expected_sha256 = "";
      m_file_bytes = 0;
      m_pass_a_valid = false;
      m_record_pass_verified = false;
      m_observer = NULL;
      m_generation = 0;
      m_callback_active = false;
      m_callback_mutation = false;
      DPCCBankIntegrityClear(m_pass_a);
     }

                    ~CDPCCBankIntegritySession(void)
     {
      Close();
     }

   void              Close(void)
     {
      if(m_callback_active)
        { m_callback_mutation = true; return; }
      BumpGeneration();
      AbortObserver();
      if(m_handle != INVALID_HANDLE)
        { FileClose(m_handle); m_handle = INVALID_HANDLE; }
      m_expected_sha256 = "";
      m_file_bytes = 0;
      m_pass_a_valid = false;
      m_record_pass_verified = false;
      m_observer = NULL;
      m_callback_active = false;
      m_callback_mutation = false;
      DPCCBankIntegrityClear(m_pass_a);
     }

   bool              IsOpen(void) const { return(m_handle != INVALID_HANDLE); }

   bool              CopyVerifiedPassA(SDPCCBankIntegrityResult &result, string &reason)
     {
      DPCCBankIntegrityClear(result);
      reason = "";
      if(RejectMutationDuringCallback(reason))
         return(false);
      if(m_handle == INVALID_HANDLE || !m_pass_a_valid)
        {
         reason = "bank.session.pass_a_required";
         return(false);
        }
      if(!CopyPassResult(result, reason))
        {
         DPCCBankIntegrityClear(result);
         if(reason == "")
            reason = "bank.result.copy";
         return(false);
        }
      return(true);
     }

   bool              OpenAndVerify(const string resolved_sandbox_path, const bool common_files,
                      const string expected_bank_sha256, string &reason)
     {
      if(RejectMutationDuringCallback(reason))
         return(false);
      BumpGeneration();
      Close();
      reason = "";
      if(!DPCCBankExpectedSHAValid(expected_bank_sha256))
         return(Fail(reason, "bank.expected_sha256"));
      string lowered_path = resolved_sandbox_path;
      StringToLower(lowered_path);
      const int path_length = StringLen(lowered_path);
      if(path_length >= 5 && StringSubstr(lowered_path, path_length - 5) == ".part")
         return(Fail(reason, "bank.path.part"));
      if(resolved_sandbox_path == "")
         return(Fail(reason, "bank.path.empty"));
      int flags = FILE_READ | FILE_BIN | FILE_SHARE_READ;
      if(common_files)
         flags |= FILE_COMMON;
      ResetLastError();
      m_handle = FileOpen(resolved_sandbox_path, flags);
      if(m_handle == INVALID_HANDLE)
         return(Fail(reason, StringFormat("bank.file.open.%d", GetLastError())));
      m_expected_sha256 = expected_bank_sha256;
      ResetLastError();
      m_file_bytes = FileSize(m_handle);
      if(GetLastError() != 0)
         return(Fail(reason, "bank.file.size"));
      if(!DPCCBankScanHandle(m_handle, m_expected_sha256, m_pass_a, reason, NULL,
                             m_callback_active, m_callback_mutation, m_generation, m_generation))
         return(Fail(reason, reason));
      if(FileTell(m_handle) != (long)m_file_bytes)
         return(Fail(reason, "bank.file.not_eof"));
      m_pass_a_valid = true;
      reason = "";
      return(true);
     }
   //--- Pass-B bytes are provisional inputs for internal semantic validation.
   //--- This session has no API that exposes records to training. The borrowed observer must
   //--- outlive the session until FinishRecordPass or Close; every deferred dereference is guarded.
   bool              BeginRecordPass(CDPCCBankRecordValidationObserver *observer, string &reason)
     {
      if(RejectMutationDuringCallback(reason))
         return(false);
      BumpGeneration();
      m_callback_mutation = false;
      reason = "";
      if(m_handle == INVALID_HANDLE || !m_pass_a_valid)
         return(Fail(reason, "bank.session.pass_a_required"));
      if(m_record_pass_verified)
         return(Fail(reason, "bank.session.record_pass_repeated"));
      const ENUM_POINTER_TYPE observer_type = CheckPointer(observer);
      if(observer_type != POINTER_AUTOMATIC && observer_type != POINTER_DYNAMIC)
         return(Fail(reason, "bank.record.observer.invalid_pointer"));
      m_observer = observer;
      SDPCCBankIntegrityResult pass_b;
      DPCCBankIntegrityClear(pass_b);
      const ulong pass_generation = m_generation;
      if(!DPCCBankScanHandle(m_handle, m_expected_sha256, pass_b, reason, m_observer,
                             m_callback_active, m_callback_mutation, m_generation, pass_generation))
         return(Fail(reason, reason));
      if(m_generation != pass_generation || m_callback_mutation)
         return(Fail(reason, "bank.session.callback_mutation"));
      if(FileTell(m_handle) != (long)m_file_bytes ||
         pass_b.file_bytes != m_pass_a.file_bytes ||
         pass_b.record_count != m_pass_a.record_count ||
         pass_b.bank_sha256 != m_pass_a.bank_sha256 ||
         pass_b.prefix_sha256 != m_pass_a.prefix_sha256 ||
         pass_b.header_sha256 != m_pass_a.header_sha256)
        {
         DPCCBankIntegrityClear(pass_b);
         return(Fail(reason, "bank.record_pass.changed"));
        }
      DPCCBankIntegrityClear(pass_b);
      m_record_pass_verified = true;
      return(true);
     }

   bool              BeginRecordPass(CDPCCBankRecordValidationObserver &observer, string &reason)
     {
      return(BeginRecordPass(GetPointer(observer), reason));
     }

   bool              FinishRecordPass(SDPCCBankIntegrityResult &result, string &reason)
     {
      DPCCBankIntegrityClear(result);
      if(RejectMutationDuringCallback(reason))
         return(false);
      BumpGeneration();
      reason = "";
      if(m_handle == INVALID_HANDLE || !m_pass_a_valid || !m_record_pass_verified)
         return(Fail(reason, "bank.session.record_pass_incomplete"));
      if(!CopyPassResult(result, reason))
        { DPCCBankIntegrityClear(result); return(Fail(reason, reason)); }
      CDPCCBankRecordValidationObserver *observer = m_observer;
      m_observer = NULL;
      if(!DPCCBankObserverPointerValid(observer))
        { DPCCBankIntegrityClear(result); return(Fail(reason, "bank.record.observer.invalid_pointer")); }
      const ulong complete_generation = m_generation;
      m_callback_mutation = false;
      m_callback_active = true;
      const bool complete_ok = observer.Complete(reason);
      m_callback_active = false;
      if(m_generation != complete_generation || m_callback_mutation)
        {
         AbortBorrowedObserver(observer);
         Close();
         DPCCBankIntegrityClear(result);
         reason = "bank.session.reentered";
         return(false);
        }
      if(!complete_ok)
        {
         AbortBorrowedObserver(observer);
         DPCCBankIntegrityClear(result);
         return(Fail(reason, "bank.record.observer.complete"));
        }
      if(!m_pass_a_valid || !m_record_pass_verified || m_handle == INVALID_HANDLE)
        {
         AbortBorrowedObserver(observer);
         Close();
         DPCCBankIntegrityClear(result);
         reason = "bank.session.reentered";
         return(false);
        }
      reason = "";
      Close();
      return(true);
     }

   bool              FinishScanOnly(SDPCCBankIntegrityResult &result, string &reason)
     {
      DPCCBankIntegrityClear(result);
      if(RejectMutationDuringCallback(reason))
         return(false);
      BumpGeneration();
      reason = "";
      if(m_handle == INVALID_HANDLE || !m_pass_a_valid)
         return(Fail(reason, "bank.session.pass_a_required"));
      if(!CopyPassResult(result, reason))
        { DPCCBankIntegrityClear(result); return(Fail(reason, reason)); }
      reason = "";
      Close();
      return(true);
     }
  };
//+------------------------------------------------------------------+
//| Function DPCCScanPublishedBankIntegrity                          |
//+------------------------------------------------------------------+
bool DPCCScanPublishedBankIntegrity(const string resolved_sandbox_path,
                                    const bool common_files,
                                    const string expected_bank_sha256,
                                    SDPCCBankIntegrityResult &result,
                                    string &reason)
  {
   DPCCBankIntegrityClear(result);
   reason = "";
   CDPCCBankIntegritySession session;
   if(!session.OpenAndVerify(resolved_sandbox_path, common_files, expected_bank_sha256, reason))
      return(false);
   return(session.FinishScanOnly(result, reason));
  }

#endif
//+------------------------------------------------------------------+
//| TrajectoryRecord.mqh: VALID-record identity and time admission   |
//+------------------------------------------------------------------+
#ifndef DPCC_TRAJECTORY_RECORD_MQH
#define DPCC_TRAJECTORY_RECORD_MQH

struct SDPCCRecordAdmission
  {
   bool              admitted;
   string            split;
   long              decision_bar_index;
   long              decision_time;
   long              horizon;
  };
//+------------------------------------------------------------------+
//| Function DPCCClearRecordAdmission                                |
//+------------------------------------------------------------------+
void DPCCClearRecordAdmission(SDPCCRecordAdmission &result)
  {
   result.admitted = false;
   result.split = "";
   result.decision_bar_index = 0;
   result.decision_time = 0;
   result.horizon = 0;
  }
//+------------------------------------------------------------------+
//| Function DPCCRecordFail                                          |
//+------------------------------------------------------------------+
bool DPCCRecordFail(SDPCCRecordAdmission &result, string &reason, const string code)
  {
   DPCCClearRecordAdmission(result);
   reason = code;
   return(false);
  }
//--- Exact JSON decimal-to-signed-long conversion. Integral decimal/exponent
//--- spellings are accepted; fractional values and signed overflow fail closed.
bool DPCCRecordReadSignedLong(CDPCCJsonDocument &document, const int node, long &value)
  {
   value = 0;
   if(node < 0 || document.Type(node) != DPCC_JSON_NUMBER)
      return(false);
   const string lexeme = document.Text(node);
   const int length = StringLen(lexeme);
   if(length <= 0)
      return(false);
   int position = 0;
   bool negative = false;
   if(StringGetCharacter(lexeme, position) == '-')
     {
      negative = true;
      position++;
     }
   string digits = "";
   int fraction = 0;
   bool decimal = false;
   bool any_digit = false;
   for(; position < length; position++)
     {
      const ushort ch = StringGetCharacter(lexeme, position);
      if(ch >= '0' && ch <= '9')
        {
         digits += ShortToString(ch);
         if(decimal)
            fraction++;
         any_digit = true;
         continue;
        }
      if(ch == '.' && !decimal)
        {
         decimal = true;
         continue;
        }
      break;
     }
   if(!any_digit)
      return(false);
   int exponent = 0;
   if(position < length && (StringGetCharacter(lexeme, position) == 'e' ||
                            StringGetCharacter(lexeme, position) == 'E'))
     {
      position++;
      bool exponent_negative = false;
      if(position < length && (StringGetCharacter(lexeme, position) == '+' ||
                               StringGetCharacter(lexeme, position) == '-'))
        {
         exponent_negative = (StringGetCharacter(lexeme, position) == '-');
         position++;
        }
      if(position >= length)
         return(false);
      for(; position < length; position++)
        {
         const ushort ch = StringGetCharacter(lexeme, position);
         if(ch < '0' || ch > '9')
            return(false);
         const int digit = (int)(ch - '0');
         if(exponent > DPCC_JSON_MAX_SOURCE_CHARS)
            exponent = DPCC_JSON_MAX_SOURCE_CHARS + 1;
         else
            exponent = exponent * 10 + digit;
        }
      if(exponent_negative)
         exponent = -exponent;
     }
   else
      if(position != length)
         return(false);
   int first = 0;
   while(first < StringLen(digits) && StringGetCharacter(digits, first) == '0')
      first++;
   if(first == StringLen(digits))
      return(true);
   digits = StringSubstr(digits, first);
   int scale = exponent - fraction;
   if(scale < 0)
     {
      const int remove = -scale;
      if(remove > StringLen(digits))
         return(false);
      for(int i = StringLen(digits) - remove; i < StringLen(digits); i++)
         if(StringGetCharacter(digits, i) != '0')
            return(false);
      digits = StringSubstr(digits, 0, StringLen(digits) - remove);
      scale = 0;
      if(StringLen(digits) == 0)
         return(true);
     }
   if(scale > 19 || StringLen(digits) + scale > 19)
      return(false);
   const ulong positive_limit = (ulong)LONG_MAX;
   const ulong negative_limit = positive_limit + 1;
   const ulong limit = (negative ? negative_limit : positive_limit);
   ulong magnitude = 0;
   const int total = StringLen(digits) + scale;
   for(int i = 0; i < total; i++)
     {
      const int digit = (i < StringLen(digits) ?
                         (int)(StringGetCharacter(digits, i) - '0') : 0);
      if(magnitude > (limit - (ulong)digit) / 10)
         return(false);
      magnitude = magnitude * 10 + (ulong)digit;
     }
   if(negative)
     {
      if(magnitude == negative_limit)
         value = LONG_MIN;
      else
         value = -(long)magnitude;
     }
   else
      value = (long)magnitude;
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCRecordReadLongField                                 |
//+------------------------------------------------------------------+
bool DPCCRecordReadLongField(CDPCCJsonDocument &document, const int object_node,
                             const string field, long &value, const string path,
                             string &reason)
  {
   const int node = document.FindMember(object_node, field);
   if(!DPCCRecordReadSignedLong(document, node, value))
     {
      reason = path + ".integer";
      return(false);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCRecordReadStringField                               |
//+------------------------------------------------------------------+
bool DPCCRecordReadStringField(CDPCCJsonDocument &document, const int object_node,
                               const string field, string &value, const string path,
                               string &reason)
  {
   const int node = document.FindMember(object_node, field);
   if(node < 0 || document.Type(node) != DPCC_JSON_STRING)
     {
      reason = path;
      return(false);
     }
   value = document.Text(node);
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCRecordSplit                                         |
//+------------------------------------------------------------------+
bool DPCCRecordSplit(const SDPCCDatasetManifest &dataset, const string split,
                     SDPCCDatasetInterval &interval, string &reason)
  {
   if(split == "fit")
      interval = dataset.fit;
   else
      if(split == "validation")
         interval = dataset.validation;
      else
         if(split == "test")
            interval = dataset.test;
         else
           {
            reason = "record.split";
            return(false);
           }
   if(interval.start_utc < 0 || interval.end_utc <= interval.start_utc ||
      interval.bar_start < 0 || interval.bar_end <= interval.bar_start)
     {
      reason = "dataset.splits." + split;
      return(false);
     }
   return(true);
  }
//--- Admission boundary: input Dataset/links/Profile/Bank/Header/TimeIndex values
//--- must already have passed their respective linked metadata gates. The typed
//--- TimeIndex arrays are structurally revalidated here, but the DTO carries no
//--- content digest, so this function cannot authenticate caller-mutated arrays.
//--- INVALID records are rejected for training admission; bank-level policy must
//--- skip them without rejecting an otherwise complete published bank.
bool DPCCAdmitValidTrajectoryRecord(const string record_source,
                                    const string record_schema,
                                    const string accepted_header_source,
                                    const string bank_header_schema,
                                    const SDPCCDatasetManifest &accepted_dataset,
                                    const SDPCCDatasetLinkResult &accepted_links,
                                    const SDPCCDataProfile &accepted_profile,
                                    const SDPCCBankMetadataResult &accepted_bank,
                                    const SDPCCDatasetTimeIndex &time_index,
                                    SDPCCRecordAdmission &result, string &reason)
  {
   DPCCClearRecordAdmission(result);
   reason = "";
   if(accepted_dataset.dataset_id == "" || accepted_dataset.normalization_id == "" ||
      accepted_dataset.time_index.id == "" || accepted_dataset.time_index.sha256 == "" ||
      accepted_links.dataset_id != accepted_dataset.dataset_id ||
      accepted_links.time_index_id != accepted_dataset.time_index.id ||
      accepted_links.time_index_sha256 != accepted_dataset.time_index.sha256 ||
      accepted_profile.dataset_manifest.id != accepted_links.dataset_id ||
      accepted_profile.dataset_manifest.sha256 != accepted_links.dataset_sha256 ||
      accepted_profile.forecast_id == "" || accepted_bank.bank_id == "" ||
      accepted_bank.dataset_id != accepted_dataset.dataset_id ||
      accepted_bank.time_index_id != accepted_links.time_index_id)
      return(DPCCRecordFail(result, reason, "record.accepted_contract"));
   CDPCCJsonDocument header_document;
   if(!DPCCCentralSchemaValidate(header_document, accepted_header_source, bank_header_schema,
                                 reason, "record.header"))
      return(DPCCRecordFail(result, reason, reason));
   const int header_root = header_document.Root();
   string header_bank_id = "", header_dataset_id = "", header_forecast_id = "", header_normalization_id = "";
   if(!DPCCRecordReadStringField(header_document, header_root, "bank_id", header_bank_id,
                                 "record.header.bank_id", reason) ||
      !DPCCRecordReadStringField(header_document, header_root, "dataset_id", header_dataset_id,
                                 "record.header.dataset_id", reason) ||
      !DPCCRecordReadStringField(header_document, header_root, "forecast_id", header_forecast_id,
                                 "record.header.forecast_id", reason) ||
      !DPCCRecordReadStringField(header_document, header_root, "normalization_id", header_normalization_id,
                                 "record.header.normalization_id", reason))
      return(DPCCRecordFail(result, reason, reason));
   if(header_bank_id != accepted_bank.bank_id || header_dataset_id != accepted_dataset.dataset_id ||
      header_forecast_id != accepted_profile.forecast_id ||
      header_normalization_id != accepted_dataset.normalization_id)
      return(DPCCRecordFail(result, reason, "record.header.accepted_contract"));
   const int header_shapes = header_document.FindMember(header_root, "shapes");
   long header_horizon = 0;
   if(!DPCCRecordReadLongField(header_document, header_shapes, "H", header_horizon,
                               "record.header.shapes.H", reason) ||
      header_horizon <= 0 || (ulong)header_horizon != (ulong)accepted_dataset.shapes.H)
      return(DPCCRecordFail(result, reason, "record.header.shapes.H"));
   string time_reason = "";
   if(!DPCCValidateDatasetTimeIndex(time_index, accepted_dataset.dataset_id, time_reason))
      return(DPCCRecordFail(result, reason, "record.time_index." + time_reason));
   if(time_index.time_index_id != accepted_links.time_index_id ||
      time_index.dataset_id != accepted_links.dataset_id)
      return(DPCCRecordFail(result, reason, "record.time_index.identity"));
   CDPCCJsonDocument record_document;
   if(!DPCCCentralSchemaValidate(record_document, record_source, record_schema, reason, "record"))
      return(DPCCRecordFail(result, reason, reason));
   const int root = record_document.Root();
   string state = "", record_dataset_id = "", record_forecast_id = "", record_normalization_id = "";
   if(!DPCCRecordReadStringField(record_document, root, "record_state", state, "record.record_state", reason) ||
      !DPCCRecordReadStringField(record_document, root, "dataset_id", record_dataset_id, "record.dataset_id", reason) ||
      !DPCCRecordReadStringField(record_document, root, "forecast_id", record_forecast_id, "record.forecast_id",
         reason) ||
      !DPCCRecordReadStringField(record_document, root, "normalization_id", record_normalization_id,
                                 "record.normalization_id", reason))
      return(DPCCRecordFail(result, reason, reason));
   if(state != "VALID")
      return(DPCCRecordFail(result, reason, "record.state.not_valid"));
   if(record_dataset_id != accepted_links.dataset_id)
      return(DPCCRecordFail(result, reason, "record.identity.dataset_id"));
   if(record_forecast_id != accepted_profile.forecast_id)
      return(DPCCRecordFail(result, reason, "record.identity.forecast_id"));
   if(record_normalization_id != accepted_dataset.normalization_id)
      return(DPCCRecordFail(result, reason, "record.identity.normalization_id"));
   long decision_bar = 0, decision_time = 0, forecast_asof = 0, normalization_asof = 0;
   if(!DPCCRecordReadLongField(record_document, root, "decision_bar_index", decision_bar,
                               "record.decision_bar_index", reason) ||
      !DPCCRecordReadLongField(record_document, root, "decision_time", decision_time,
                               "record.decision_time", reason) ||
      !DPCCRecordReadLongField(record_document, root, "forecast_asof", forecast_asof,
                               "record.forecast_asof", reason) ||
      !DPCCRecordReadLongField(record_document, root, "normalization_asof", normalization_asof,
                               "record.normalization_asof", reason))
      return(DPCCRecordFail(result, reason, reason));
   if(decision_bar < 0)
      return(DPCCRecordFail(result, reason, "record.decision_bar_index.negative"));
   if(forecast_asof > decision_time)
      return(DPCCRecordFail(result, reason, "record.forecast_asof.future"));
   if(normalization_asof > decision_time)
      return(DPCCRecordFail(result, reason, "record.normalization_asof.future"));
   string split = "";
   if(!DPCCRecordReadStringField(record_document, root, "split", split, "record.split", reason))
      return(DPCCRecordFail(result, reason, reason));
   SDPCCDatasetInterval interval;
   if(!DPCCRecordSplit(accepted_dataset, split, interval, reason))
      return(DPCCRecordFail(result, reason, reason));
   const int count = ArraySize(time_index.bar_index);
   if(decision_bar > (long)count)
      return(DPCCRecordFail(result, reason, "record.decision_bar_index.range"));
   const ulong available = (ulong)(count - (int)decision_bar);
   const ulong horizon = (ulong)accepted_dataset.shapes.H;
   if(horizon == 0)
      return(DPCCRecordFail(result, reason, "dataset.shapes.H"));
   if(horizon > available)
      return(DPCCRecordFail(result, reason, "record.horizon.range"));
   if(decision_bar < interval.bar_start || decision_bar >= interval.bar_end ||
      interval.bar_end > count)
      return(DPCCRecordFail(result, reason, "record.split.bar_bounds"));
   const int bar_times = record_document.FindMember(root, "bar_times");
   const int action_times = record_document.FindMember(root, "source_action_times");
   if(bar_times < 0 || record_document.Type(bar_times) != DPCC_JSON_ARRAY ||
      record_document.ChildCount(bar_times) != (int)horizon)
      return(DPCCRecordFail(result, reason, "record.bar_times.length"));
   if(action_times < 0 || record_document.Type(action_times) != DPCC_JSON_ARRAY ||
      record_document.ChildCount(action_times) != (int)horizon)
      return(DPCCRecordFail(result, reason, "record.source_action_times.length"));
   if(decision_time != time_index.start_utc[(int)decision_bar])
      return(DPCCRecordFail(result, reason, "record.decision_time.index"));
   for(int h = 0; h < (int)horizon; h++)
     {
      const long ordinal = decision_bar + h;
      const int bar_node = record_document.ChildAt(bar_times, h);
      long open_utc = 0, close_utc = 0, bar_ordinal = 0, action_time = 0;
      if(!DPCCRecordReadLongField(record_document, bar_node, "open_utc", open_utc,
                                  StringFormat("record.bar_times[%d].open_utc", h), reason) ||
         !DPCCRecordReadLongField(record_document, bar_node, "close_utc", close_utc,
                                  StringFormat("record.bar_times[%d].close_utc", h), reason) ||
         !DPCCRecordReadLongField(record_document, bar_node, "bar_index", bar_ordinal,
                                  StringFormat("record.bar_times[%d].bar_index", h), reason) ||
         !DPCCRecordReadSignedLong(record_document, record_document.ChildAt(action_times, h), action_time))
        {
         if(reason == "")
            reason = StringFormat("record.source_action_times[%d].integer", h);
         return(DPCCRecordFail(result, reason, reason));
        }
      if(bar_ordinal < 0)
         return(DPCCRecordFail(result, reason, StringFormat("record.bar_times[%d].bar_index.negative", h)));
      if(bar_ordinal != ordinal || time_index.bar_index[(int)ordinal] != ordinal)
         return(DPCCRecordFail(result, reason, StringFormat("record.bar_times[%d].bar_index", h)));
      if(open_utc != time_index.start_utc[(int)ordinal])
         return(DPCCRecordFail(result, reason, StringFormat("record.bar_times[%d].open_utc", h)));
      if(close_utc != time_index.end_utc[(int)ordinal])
         return(DPCCRecordFail(result, reason, StringFormat("record.bar_times[%d].close_utc", h)));
      if(ordinal < interval.bar_start || ordinal >= interval.bar_end ||
         open_utc < interval.start_utc || close_utc > interval.end_utc)
         return(DPCCRecordFail(result, reason, StringFormat("record.split.bounds[%d]", h)));
      if(action_time > open_utc)
         return(DPCCRecordFail(result, reason, StringFormat("record.source_action_times[%d].future", h)));
     }
   result.admitted = true;
   result.split = split;
   result.decision_bar_index = decision_bar;
   result.decision_time = decision_time;
   result.horizon = (long)horizon;
   reason = "";
   return(true);
  }
//--- Provisional CPU materialization only. Whole-bank observer authorization is
//--- deliberately not represented by this per-record value.
struct SDPCCMaterializedRecord
  {
   SDPCCRecordAdmission admission;
   string            window_id, dataset_id, forecast_id, normalization_id, source_id, noise_seed, execution_label;
   long              episode_id, forecast_asof, normalization_asof;
   ulong             noise_seed_u64;
   float             account_features[], context_without_noise[], target_native_ohlc[], rho[], actions[],
      executed_actions[], rewards[];
   uint              terminal_flags[];
   long              bar_open_times[], bar_close_times[], bar_indices[], source_action_times[];
  };
//+------------------------------------------------------------------+
//| Function DPCCClearMaterializedRecord                             |
//+------------------------------------------------------------------+
void DPCCClearMaterializedRecord(SDPCCMaterializedRecord &record)
  {
   DPCCClearRecordAdmission(record.admission);
   record.window_id = "";
   record.dataset_id = "";
   record.forecast_id = "";
   record.normalization_id = "";
   record.source_id = "";
   record.noise_seed = "";
   record.execution_label = "";
   record.episode_id = 0;
   record.forecast_asof = 0;
   record.normalization_asof = 0;
   record.noise_seed_u64 = 0;
   ArrayResize(record.account_features, 0);
   ArrayResize(record.context_without_noise, 0);
   ArrayResize(record.target_native_ohlc, 0);
   ArrayResize(record.rho, 0);
   ArrayResize(record.actions, 0);
   ArrayResize(record.executed_actions, 0);
   ArrayResize(record.rewards, 0);
   ArrayResize(record.terminal_flags, 0);
   ArrayResize(record.bar_open_times, 0);
   ArrayResize(record.bar_close_times, 0);
   ArrayResize(record.bar_indices, 0);
   ArrayResize(record.source_action_times, 0);
  }
//--- A record-array decoder, not a second general JSON validator. Both double
//--- and final float32 probability sums are checked without renormalization.
//--- The JSON parser already guarantees numeric syntax. Inspect only the mantissa:
//--- StringToDouble can silently turn a nonzero tiny decimal into double zero.
//+------------------------------------------------------------------+
//| Function DPCCMaterializeValidTrajectoryRecord                    |
//+------------------------------------------------------------------+
bool DPCCMaterializeValidTrajectoryRecord(const string record_source, const string record_schema,
      const string accepted_header_source, const string bank_header_schema,
      const SDPCCDatasetManifest &accepted_dataset, const SDPCCDatasetLinkResult &accepted_links,
      const SDPCCDataProfile &accepted_profile, const SDPCCBankMetadataResult &accepted_bank,
      const SDPCCDatasetTimeIndex &time_index, const SDPCCConfig &frozen_config,
      SDPCCMaterializedRecord &result, string &reason)
  {
   DPCCClearMaterializedRecord(result);
   reason = "";
   SDPCCMaterializedRecord candidate;
   DPCCClearMaterializedRecord(candidate);
   if(!DPCCAdmitValidTrajectoryRecord(record_source, record_schema, accepted_header_source, bank_header_schema,
                                      accepted_dataset, accepted_links, accepted_profile, accepted_bank, time_index,
                                         candidate.admission, reason))
      return(false);
   const SDPCCShape shape = frozen_config.shape;
   const SDPCCResourceShape expected = accepted_dataset.shapes;
   if(shape.K != (ulong)expected.K || shape.V != (ulong)expected.V || shape.H != (ulong)expected.H ||
      shape.D != (ulong)expected.D || shape.M != (ulong)expected.M || shape.J != (ulong)expected.J ||
      shape.E != (ulong)expected.E || shape.NActions != 6 || shape.StateSize != 13 ||
      expected.A != 6 || expected.B != 1 || expected.account_features != 13 ||
      frozen_config.normalization_mode != DPCC_NORMALIZATION_CAUSAL_AFFINE_V2 ||
      !MathIsValidNumber(frozen_config.probability_tolerance) || frozen_config.probability_tolerance < 0 ||
      frozen_config.probability_tolerance >= 1)
     {reason = "record.materialization.frozen_config"; return(false);}
   SDPCCLayout layout, rollout;
   uint tokens;
   if(!DPCCCompositeLayouts(shape, layout, rollout, tokens) || layout.offsets[10] > (ulong)INT_MAX)
     {reason = "record.materialization.layout"; return(false);}
   CDPCCJsonDocument document;
   if(!document.Parse(record_source, reason))
     {
      reason = "record.materialization.parse";
      return(false);
     }
   const int root = document.Root(), context = document.FindMember(root, "context");
   const string identities[] = {"window_id", "dataset_id", "forecast_id", "normalization_id", "source_id", "noise_seed",
      "execution_label"};
   string texts[];
   ArrayResize(texts, 7);
   for(uint i = 0; i < 7; i++)
      if(!DPCCRecordReadStringField(document, root, identities[i], texts[i], "record." + identities[i], reason))
         return(false);
   candidate.window_id = texts[0];
   candidate.dataset_id = texts[1];
   candidate.forecast_id = texts[2];
   candidate.normalization_id = texts[3];
   candidate.source_id = texts[4];
   candidate.noise_seed = texts[5];
   candidate.execution_label = texts[6];
   if(!DPCCRecordReadLongField(document, root, "episode_id", candidate.episode_id, "record.episode_id", reason) ||
      !DPCCRecordReadLongField(document, root, "forecast_asof", candidate.forecast_asof, "record.forecast_asof",
         reason) ||
      !DPCCRecordReadLongField(document, root, "normalization_asof", candidate.normalization_asof,
         "record.normalization_asof", reason))
      return(false);
   for(int i = 0; i < 16; i++)
     {
      const int ch = (int)StringGetCharacter(candidate.noise_seed, i);
      const uint digit = (uint)(ch >= '0' && ch <= '9' ? ch - '0' : ch - 'a' + 10);
      candidate.noise_seed_u64 = (candidate.noise_seed_u64 << 4) | (ulong)digit;
     }
   const string hash_source = candidate.dataset_id + "\n" + candidate.source_id + "\n" + (string)candidate.episode_id +
                              "\n" + (string)candidate.admission.decision_time + "\n" + candidate.noise_seed;
   uchar bytes[];
   const int encoded = StringToCharArray(hash_source, bytes, 0, WHOLE_ARRAY, CP_UTF8);
   string digest = "";
   if(encoded <= 0 || ArrayResize(bytes, encoded - 1) != encoded - 1 || !DPCCSHA256Lower(bytes, digest, reason) ||
      digest != candidate.window_id)
     {reason = "record.window_id.derivation"; return(false);}
   if(!DPCCRecordFloatArray(document, document.FindMember(root, "account_features"), 13, candidate.account_features,
                            "record.account_features", reason) || ArrayResize(candidate.context_without_noise, (
                               int)layout.offsets[10]) != (int)layout.offsets[10])
     {if(reason == "")reason = "record.context.capacity"; return(false);}
   const string names[] = {"Z", "U", "Pi", "PriceNorm", "Account", "Instrument", "Limits", "Execution", "CalendarCount",
      "Calendar"};
   float values[];
   for(uint section = 0; section < 10; section++)
     {
      const int node = document.FindMember(context, names[section]);
      const int domain = (section == 1 ? 1 : (section == 2 ? 2 : 0));
      if(!DPCCRecordFloatArray(document, node, (uint)layout.lengths[section], values,
                               "record.context." + names[section], reason, domain, (
                                  double)frozen_config.probability_tolerance))
         return(false);
      for(uint i = 0; i < (uint)layout.lengths[section]; i++)
         candidate.context_without_noise[(int)layout.offsets[section] + (int)i] = values[i];
      if(section == 8)
         for(uint i = 0; i < shape.H; i++)
           {
            long count = 0;
            if(!DPCCRecordReadSignedLong(document, document.ChildAt(node, (int)i), count) || count < 0 ||
               count > (long)shape.E || (double)(float)count != (double)count)
              {reason = StringFormat("record.context.CalendarCount[%u].integer", i); return(false);}
           }
      if(section == 7)
         for(uint row = 0; row < shape.K * shape.H; row++)
           {
            long count = 0;
            if(!DPCCRecordReadSignedLong(document, document.ChildAt(node, (int)(row * 24 + 21)), count) ||
               count < 0 || count > (long)shape.E || (double)(float)count != (double)count)
              {reason = StringFormat("record.context.Execution[%u].event_count", row); return(false);}
           }
     }
   for(uint channel = 0; channel < 4; channel++)
     {
      const int p = (int)layout.offsets[3] + (int)channel * 4;
      long exact_gain = 0;
      double raw_bias = 0;
      const int price_node = document.FindMember(context, "PriceNorm");
      if(candidate.context_without_noise[p + 1] <= 0 || candidate.context_without_noise[p + 2] != 1 ||
         candidate.context_without_noise[p + 3] != 0 ||
         !DPCCRecordReadSignedLong(document, document.ChildAt(price_node, (int)channel * 4 + 2), exact_gain) ||
         !document.TryNumber(document.ChildAt(price_node, (int)channel * 4 + 3), raw_bias) || exact_gain != 1 ||
            raw_bias != 0)
        {reason = "record.context.PriceNorm.profile"; return(false);}
     }
   if(!DPCCRecordFloatArray(document, document.FindMember(root, "target_native_ohlc"), shape.H * 4,
                            candidate.target_native_ohlc, "record.target_native_ohlc", reason) ||
      !DPCCRecordFloatArray(document, document.FindMember(root, "rho"), shape.K, candidate.rho, "record.rho", reason,
                            2, (double)frozen_config.probability_tolerance) ||
      !DPCCRecordFloatArray(document, document.FindMember(root, "actions"), shape.H * 6, candidate.actions,
         "record.actions", reason) ||
      !DPCCRecordFloatArray(document, document.FindMember(root, "executed_actions"), shape.H * 6,
         candidate.executed_actions, "record.executed_actions", reason) ||
      !DPCCRecordFloatArray(document, document.FindMember(root, "rewards"), shape.H, candidate.rewards,
         "record.rewards", reason))
      return(false);
   if(ArrayResize(candidate.terminal_flags, (int)shape.H) != (int)shape.H ||
      ArrayResize(candidate.bar_open_times, (int)shape.H) != (int)shape.H ||
      ArrayResize(candidate.bar_close_times, (int)shape.H) != (int)shape.H ||
      ArrayResize(candidate.bar_indices, (int)shape.H) != (int)shape.H ||
      ArrayResize(candidate.source_action_times, (int)shape.H) != (int)shape.H)
     {reason = "record.targets.capacity"; return(false);}
   const int flags = document.FindMember(root, "terminal_flags"), bars = document.FindMember(root, "bar_times"),
             action_times = document.FindMember(root, "source_action_times");
   if(document.ChildCount(flags) != (int)shape.H)
     {
      reason = "record.terminal_flags.length";
      return(false);
     }
   bool terminal = false;
   for(uint h = 0; h < shape.H; h++)
     {
      long flag = 0;
      const int bar = document.ChildAt(bars, (int)h);
      if(!DPCCRecordReadSignedLong(document, document.ChildAt(flags, (int)h), flag) || (flag != 0 && flag != 1) ||
         !DPCCRecordReadLongField(document, bar, "open_utc", candidate.bar_open_times[h], "record.bar_times.open_utc",
            reason) ||
         !DPCCRecordReadLongField(document, bar, "close_utc", candidate.bar_close_times[h],
            "record.bar_times.close_utc", reason) ||
         !DPCCRecordReadLongField(document, bar, "bar_index", candidate.bar_indices[h], "record.bar_times.bar_index",
            reason) ||
         !DPCCRecordReadSignedLong(document, document.ChildAt(action_times, (int)h), candidate.source_action_times[h]))
        {if(reason == "")reason = "record.targets.integer"; return(false);}
      if(terminal)
        {
         double raw_value = 0;
         if(flag != 1 || candidate.rewards[h] != 0 ||
            !document.TryNumber(document.ChildAt(document.FindMember(root, "rewards"), (int)h), raw_value) ||
               raw_value != 0)
           {reason = "record.terminal.absorbing"; return(false);}
         for(uint a = 0; a < 6; a++)
           {
            if(candidate.actions[h * 6 + a] != 0 || candidate.executed_actions[h * 6 + a] != 0 ||
               !document.TryNumber(document.ChildAt(document.FindMember(root, "actions"), (int)(h * 6 + a)),
                  raw_value) || raw_value != 0 ||
               !document.TryNumber(document.ChildAt(document.FindMember(root, "executed_actions"), (int)(h * 6 + a)),
                  raw_value) || raw_value != 0)
              {reason = "record.terminal.absorbing"; return(false);}
           }
        }
      candidate.terminal_flags[h] = (uint)flag;
      if(flag == 1)
         terminal = true;
     }
   result = candidate;
   reason = "";
   return(true);
  }

#endif
//--- Materialized records stay private through every callback. Complete means
//--- semantic staging finished, not DATA readiness or permission to train.
class CDPCCBankMaterializationObserver : public CDPCCBankRecordValidationObserver
  {
private:
   string            m_record_schema, m_header, m_header_schema;
   SDPCCDatasetManifest m_dataset;
   SDPCCDatasetLinkResult m_links;
   SDPCCDataProfile  m_profile;
   SDPCCBankMetadataResult m_bank;
   SDPCCDatasetTimeIndex m_time_index;
   SDPCCConfig       m_config;
   SDPCCMaterializedRecord m_records[];
   string            m_window_ids[];
   ulong             m_invalid;
   uchar             m_payload[];
   ulong             m_next, m_expected;
   uint              m_limit;
   bool              m_active, m_complete, m_configured;

   bool              Fail(string &reason, const string code)
     {
      Abort();
      reason = code;
      return(false);
     }

public:
                     CDPCCBankMaterializationObserver(void)
     {m_configured = false; m_limit = 0; Abort();}

   bool              Configure(const string record_schema, const string header, const string header_schema,
                  const SDPCCDatasetManifest &dataset, const SDPCCDatasetLinkResult &links,
                  const SDPCCDataProfile &profile, const SDPCCBankMetadataResult &bank,
                  const SDPCCDatasetTimeIndex &time_index, const SDPCCConfig &config,
                  const uint maximum_records, string &reason)
     {
      Abort();
      m_configured = false;
      reason = "";
      if(maximum_records == 0 || maximum_records > (uint)INT_MAX)
         return(Fail(reason, "staging.capacity.profile"));
      if(dataset.dataset_id == "" || dataset.normalization_id == "" ||
         dataset.time_index.id == "" || dataset.time_index.sha256 == "" ||
         links.dataset_id != dataset.dataset_id || links.time_index_id != dataset.time_index.id ||
         links.time_index_sha256 != dataset.time_index.sha256 ||
         profile.dataset_manifest.id != links.dataset_id ||
         profile.dataset_manifest.sha256 != links.dataset_sha256 || profile.forecast_id == "" ||
         bank.bank_id == "" || bank.dataset_id != dataset.dataset_id ||
         bank.time_index_id != links.time_index_id || bank.record_count < 0 ||
         !DPCCBankExpectedSHAValid(bank.bank_sha256) || !DPCCBankExpectedSHAValid(bank.header_sha256))
         return(Fail(reason, "staging.accepted_contract"));
      if(!DPCCValidateDatasetTimeIndex(time_index, dataset.dataset_id, reason) ||
         time_index.time_index_id != links.time_index_id || time_index.dataset_id != links.dataset_id)
         return(Fail(reason, "staging.time_index.identity"));
      CDPCCJsonDocument header_document;
      if(!DPCCCentralSchemaValidate(header_document, header, header_schema, reason, "staging.header"))
        {Abort(); return(false);}
      const int header_root = header_document.Root();
      string bank_id = "", dataset_id = "", forecast_id = "", normalization_id = "";
      if(!DPCCRecordReadStringField(header_document, header_root, "bank_id", bank_id, "staging.header.bank_id",
         reason) ||
         !DPCCRecordReadStringField(header_document, header_root, "dataset_id", dataset_id, "staging.header.dataset_id",
            reason) ||
         !DPCCRecordReadStringField(header_document, header_root, "forecast_id", forecast_id,
            "staging.header.forecast_id", reason) ||
         !DPCCRecordReadStringField(header_document, header_root, "normalization_id", normalization_id,
            "staging.header.normalization_id", reason))
        {Abort(); return(false);}
      if(bank_id != bank.bank_id || dataset_id != dataset.dataset_id ||
         forecast_id != profile.forecast_id || normalization_id != dataset.normalization_id)
         return(Fail(reason, "staging.header.accepted_contract"));
      if(!DPCCBankCheckShape(header_document, header_root, dataset.shapes, reason))
        {Abort(); return(false);}
      uchar header_bytes[];
      string header_digest = "";
      const int encoded = StringToCharArray(header, header_bytes, 0, WHOLE_ARRAY, CP_UTF8);
      if(encoded <= 0 || ArrayResize(header_bytes, encoded - 1) != encoded - 1 ||
         !DPCCSHA256Lower(header_bytes, header_digest, reason) || header_digest != bank.header_sha256)
         return(Fail(reason, "staging.header.sha256"));
      m_record_schema = record_schema;
      m_header = header;
      m_header_schema = header_schema;
      m_dataset = dataset;
      m_links = links;
      m_profile = profile;
      m_bank = bank;
      m_time_index = time_index;
      m_config = config;
      m_limit = maximum_records;
      m_configured = true;
      return(true);
     }

   virtual bool      BeginRecord(const ulong record_index, const ulong payload_bytes, string &reason)
     {
      reason = "";
      if(!m_configured || m_active || m_complete || record_index != m_next ||
         m_next >= m_limit || payload_bytes == 0 || payload_bytes > DPCC_BANK_MAX_JSON_BYTES)
         return(Fail(reason, "staging.record.begin"));
      m_expected = payload_bytes;
      if(ArrayResize(m_payload, 0) != 0)
         return(Fail(reason, "staging.payload.reset"));
      m_active = true;
      return(true);
     }

   virtual bool      ConsumeChunk(const ulong record_index, const uchar &chunk[], const int count, string &reason)
     {
      reason = "";
      const int old = ArraySize(m_payload);
      if(!m_active || record_index != m_next || count <= 0 || count > ArraySize(chunk) ||
         (ulong)old + (ulong)count > m_expected)
         return(Fail(reason, "staging.payload.chunk"));
      if(ArrayResize(m_payload, old + count) != old + count || ArrayCopy(m_payload, chunk, old, 0, count) != count)
         return(Fail(reason, "staging.payload.capacity"));
      return(true);
     }

   virtual bool      EndRecord(const ulong record_index, string &reason)
     {
      reason = "";
      if(!m_active || record_index != m_next || (ulong)ArraySize(m_payload) != m_expected)
         return(Fail(reason, "staging.record.end"));
      const string source = CharArrayToString(m_payload, 0, ArraySize(m_payload), CP_UTF8);
      //--- Byte-exact UTF8 roundtrip rejects replacement characters / embedded NUL.
      uchar encoded[];
      const int size = StringToCharArray(source, encoded, 0, WHOLE_ARRAY, CP_UTF8);
      if(size != ArraySize(m_payload) + 1)
         return(Fail(reason, "staging.payload.utf8"));
      for(int i = 0; i < ArraySize(m_payload); i++)
         if(encoded[i] != m_payload[i])
            return(Fail(reason, "staging.payload.utf8"));
      //--- Envelope admission applies to ALL records. INVALID records have no
      //--- fabricated tensor values; their identity still participates in uniqueness.
      CDPCCJsonDocument document;
      if(!DPCCCentralSchemaValidate(document, source, m_record_schema, reason, "staging.record"))
        {Abort(); return(false);}
      const int root = document.Root();
      string state = "", window = "", dataset = "", forecast = "", normalization = "", source_id = "", seed = "";
      if(!DPCCRecordReadStringField(document, root, "record_state", state, "record.record_state", reason) ||
         !DPCCRecordReadStringField(document, root, "window_id", window, "record.window_id", reason) ||
         !DPCCRecordReadStringField(document, root, "dataset_id", dataset, "record.dataset_id", reason) ||
         !DPCCRecordReadStringField(document, root, "forecast_id", forecast, "record.forecast_id", reason) ||
         !DPCCRecordReadStringField(document, root, "normalization_id", normalization, "record.normalization_id",
            reason) ||
         !DPCCRecordReadStringField(document, root, "source_id", source_id, "record.source_id", reason) ||
         !DPCCRecordReadStringField(document, root, "noise_seed", seed, "record.noise_seed", reason))
        {Abort(); return(false);}
      if(dataset != m_dataset.dataset_id || dataset != m_links.dataset_id ||
         forecast != m_profile.forecast_id || normalization != m_dataset.normalization_id)
         return(Fail(reason, "staging.record.identity"));
      long episode = 0, time = 0, forecast_asof = 0, normalization_asof = 0;
      if(!DPCCRecordReadLongField(document, root, "episode_id", episode, "record.episode_id", reason) ||
         !DPCCRecordReadLongField(document, root, "decision_time", time, "record.decision_time", reason) ||
         !DPCCRecordReadLongField(document, root, "forecast_asof", forecast_asof, "record.forecast_asof", reason) ||
         !DPCCRecordReadLongField(document, root, "normalization_asof", normalization_asof, "record.normalization_asof",
            reason))
        {Abort(); return(false);}
      if(forecast_asof > time || normalization_asof > time)
         return(Fail(reason, "staging.record.future_statistics"));
      const string hash_source = dataset + "\n" + source_id + "\n" + (string)episode + "\n" + (string)time + "\n" +
         seed;
      uchar hash_bytes[];
      string digest = "";
      const int hash_size = StringToCharArray(hash_source, hash_bytes, 0, WHOLE_ARRAY, CP_UTF8);
      if(hash_size <= 0 || ArrayResize(hash_bytes, hash_size - 1) != hash_size - 1 ||
         !DPCCSHA256Lower(hash_bytes, digest, reason) || digest != window)
         return(Fail(reason, "staging.window_id.derivation"));
      for(int i = 0; i < ArraySize(m_window_ids); i++)
         if(m_window_ids[i] == window)
            return(Fail(reason, "staging.window_id.duplicate"));
      const int identity_count = ArraySize(m_window_ids);
      if(ArrayResize(m_window_ids, identity_count + 1) != identity_count + 1)
         return(Fail(reason, "staging.identities.capacity"));
      m_window_ids[identity_count] = window;
      if(state == "INVALID")
        {
         string invalid_reason = "";
         if(!DPCCRecordReadStringField(document, root, "invalid_reason", invalid_reason, "record.invalid_reason",
            reason))
           {Abort(); return(false);}
         if(StringLen(invalid_reason) == 0)
            return(Fail(reason, "staging.invalid.reason_empty"));
         m_invalid++;
         m_next++;
         m_expected = 0;
         m_active = false;
         ArrayResize(m_payload, 0);
         return(true);
        }
      if(state != "VALID")
         return(Fail(reason, "staging.record.state"));
      SDPCCMaterializedRecord candidate;
      if(!DPCCMaterializeValidTrajectoryRecord(source, m_record_schema, m_header, m_header_schema,
            m_dataset, m_links, m_profile, m_bank, m_time_index, m_config, candidate, reason))
        {Abort(); return(false);}
      const int next = ArraySize(m_records);
      if(ArrayResize(m_records, next + 1) != next + 1)
         return(Fail(reason, "staging.records.capacity"));
      m_records[next] = candidate;
      m_next++;
      m_expected = 0;
      m_active = false;
      ArrayResize(m_payload, 0);
      return(true);
     }

   virtual bool      Complete(string &reason)
     {
      reason = "";
      if(!m_configured || m_active || m_complete || m_next == 0)
         return(Fail(reason, "staging.complete.state"));
      m_complete = true;
      return(true);
     }

   virtual void      Abort(void)
     {
      for(int i = 0; i < ArraySize(m_records); i++)
         DPCCClearMaterializedRecord(m_records[i]);
      ArrayResize(m_records, 0);
      ArrayResize(m_payload, 0);
      ArrayResize(m_window_ids, 0);
      m_next = 0;
      m_invalid = 0;
      m_expected = 0;
      m_active = false;
      m_complete = false;
     }
   //--- Caller uses this only AFTER FinishRecordPass returned true. Copies protect
   //--- stored rho from consumer writes; no mutable record/array pointer escapes.
   bool              CopyFinishedRecords(SDPCCMaterializedRecord &result[], string &reason)
     {
      ArrayResize(result, 0);
      reason = "";
      if(!m_complete)
         return(Fail(reason, "staging.not_complete"));
      const int count = ArraySize(m_records);
      if(ArrayResize(result, count) != count)
        {
         reason = "staging.output.capacity";
         return(false);
        }
      for(int i = 0; i < count; i++)
         result[i] = m_records[i];
      return(true);
     }
   ulong             InvalidCount(void) const {return(m_complete ? m_invalid : 0);}
   ulong             TotalCount(void) const {return(m_complete ? m_next : 0);}
   bool              BindExpectedSHA(const string expected_sha, string &reason)
     {
      if(!m_configured || expected_sha != m_bank.bank_sha256)
         return(Fail(reason, "staging.bank.expected_sha256"));
      reason = "";
      return(true);
     }
   bool              BindFinishedIntegrity(const SDPCCBankIntegrityResult &integrity, string &reason)
     {
      if(!m_complete || integrity.bank_sha256 != m_bank.bank_sha256 ||
         integrity.header_sha256 != m_bank.header_sha256 ||
         integrity.record_count != (ulong)m_bank.record_count || integrity.record_count != m_next)
         return(Fail(reason, "staging.bank.finished_binding"));
      //--- Hash binding plus exact raw-byte comparison against the configured header.
      uchar expected[];
      const int encoded = StringToCharArray(m_header, expected, 0, WHOLE_ARRAY, CP_UTF8);
      if(encoded != integrity.header_length + 1 || ArraySize(integrity.header_bytes) != integrity.header_length)
         return(Fail(reason, "staging.header.finished_bytes"));
      for(int i = 0; i < integrity.header_length; i++)
         if(expected[i] != integrity.header_bytes[i])
            return(Fail(reason, "staging.header.finished_bytes"));
      reason = "";
      return(true);
     }
  };
//--- This outer transaction is the only consumer entry: nothing is published if
//--- either pass, any callback, footer/hash comparison or FinishRecordPass fails.
bool DPCCStageMaterializedBank(CDPCCBankMaterializationObserver &observer,
                               const string path, const bool common_files, const string expected_sha,
                               SDPCCMaterializedRecord &records[], SDPCCBankIntegrityResult &integrity,
                               ulong &invalid_records, string &reason)
  {
   invalid_records = 0;
   ArrayResize(records, 0);
   DPCCBankIntegrityClear(integrity);
   CDPCCBankIntegritySession session;
   if(!observer.BindExpectedSHA(expected_sha, reason) ||
      !session.OpenAndVerify(path, common_files, expected_sha, reason) ||
      !session.BeginRecordPass(observer, reason) || !session.FinishRecordPass(integrity, reason) ||
      !observer.BindFinishedIntegrity(integrity, reason) ||
      !observer.CopyFinishedRecords(records, reason))
     {
      observer.Abort();
      session.Close();
      ArrayResize(records, 0);
      DPCCBankIntegrityClear(integrity);
      return(false);
     }
   if(observer.TotalCount() != integrity.record_count ||
      (ulong)ArraySize(records) + observer.InvalidCount() != integrity.record_count)
     {
      observer.Abort();
      ArrayResize(records, 0);
      DPCCBankIntegrityClear(integrity);
      reason = "staging.record_count.reconciliation";
      return(false);
     }
   invalid_records = observer.InvalidCount();
   observer.Abort();
   return(true);
  }

#endif

enum ENUM_DPCC_TRAIN_OPERATION { DPCC_TRAIN_UPDATE = 0, DPCC_TRAIN_FROZEN = 1, DPCC_TRAIN_VALIDATE = 2 };
struct SDPCCTrainingBankSource
  {
   string            record_schema, header, header_schema, path;
   bool              common_files;
   uint              maximum_records;
   ulong             maximum_staged_tensor_bytes;
   SDPCCDatasetManifest dataset;
   SDPCCDatasetLinkResult links;
   SDPCCDataProfile  profile;
   SDPCCBankMetadataResult bank;
   SDPCCDatasetTimeIndex time_index;
  };
struct SDPCCTrainingExampleKeys
  {
   uint              j, repeat;
   ulong             seed, decision_identity, context_identity, owner_identity;
   long              decision_time;
  };
struct SDPCCTrainingFrozenRecordKeys
  {
   string            window_id;
   long              decision_time;
   ulong             decision_identity, context_identity, owner_identity;
   uint              validation_j;
  };
struct SDPCCTrainingExampleResult
  {
   bool              completed, update_attempted;
   string            stage, reason, window_id, source_id, split, bank_sha256, header_sha256;
   long              decision_time;
   uint              j, repeat, updates_before, updates_after;
   ulong             seed;
   double            loss;
  };

struct SDPCCDecoderValidationObservation
  {
   int               record_index;
   string            window_id, selected_manifest_sha;
   double            normalized_loss;
   float             normalized[], native_ohlc[], causal_price_norm[];
  };
struct SDPCCDecoderInferenceObservation
  {
   int               record_index;
   string            window_id, selected_manifest_sha;
   long              decision_time;
   float             normalized[];
  };
//--- Owns the factories and their frozen bindings; does not adopt arbitrary CNet.
#ifndef DPCC_RUN_IDENTITY_MQH
#define DPCC_RUN_IDENTITY_MQH
struct SDPCCTrainingRecordIdentity
  {
   int               record_index;
   string            window_id, source_id, split, bank_sha256, header_sha256;
   long              decision_time, decision_bar_index;
   SDPCCTrainingFrozenRecordKeys keys;
  };

#endif
//--- Staging is semantic/integrity admission, never DATA/RESOURCES/RESEARCH READY.
class CDPCCTrainingExamples
  {
private:
   //--- Reverse destruction order keeps borrowed denoiser context alive.
   CNet              m_decoder_net, m_denoiser_net;
   CNeuronScenarioDecoderOCL *m_decoder;
   CNeuronPlanDenoiserOCL *m_denoiser;
   SDPCCConfig       m_config;
   string            m_epoch_time_index_id;
   SDPCCMaterializedRecord m_records[];
   SDPCCTrainingFrozenRecordKeys m_record_keys[];
   SDPCCBankIntegrityResult m_integrity;
   double            m_alpha[];
   ulong             m_training_seed, m_validation_seed;
   uint              m_validation_repeat;
   ulong             m_decoder_contract, m_denoiser_contract;
   bool              m_initialized, m_poisoned, m_decoder_initial_saved, m_denoiser_initial_saved;
   int               m_loaded;
   SDPCCLayout       m_c, m_r;
   uint              m_tokens, m_decoder_stream_native_loads;
   CBufferFloat      m_z, m_norm, m_target, m_rho, m_context, m_account, m_actions, m_epsilon, m_noisy, m_condition;

   CNet              *m_checkpoint_decoder_net;
   CNet              *m_checkpoint_denoiser_net;
   CNet              *m_inference_decoder_net;
   CBufferFloat      *m_inference_input;
   SDPCCCheckpointArtifact m_inference_artifact;
   SDPCCDecoderComposition m_checkpoint_decoder_composition;
   SDPCCDenoiserComposition m_checkpoint_denoiser_composition;
   SDPCCCheckpointBinding m_checkpoint_binding;
   string            m_checkpoint_dataset_id;
   string            m_checkpoint_normalization_id;
   string            m_checkpoint_bank_id;
   string            m_checkpoint_dataset_sha;
   string            m_checkpoint_timeindex_sha;
   string            m_checkpoint_timeindex_table_sha;
   string            m_checkpoint_binding_sha;
   SDPCCCheckpointArtifact m_checkpoint_initial;
   bool              m_checkpoint_metadata_bound;
   bool              m_checkpoint_restored;
   ulong             m_checkpoint_max_file_bytes;

   CNet              *DecoderNet(void)
     {
      return(m_checkpoint_decoder_net ? m_checkpoint_decoder_net : GetPointer(m_decoder_net));
     }
   void              CloseDecoderInference(void)
     {
      delete m_inference_input;
      m_inference_input = NULL;
      delete m_inference_decoder_net;
      m_inference_decoder_net = NULL;
      ZeroMemory(m_inference_artifact);
     }
   bool              DecoderInferenceFailure(const string cause, string &reason)
     {
      CloseDecoderInference();
      reason = cause;
      return(false);
     }
   bool              DecoderInferenceArtifact(const SDPCCCheckpointArtifact &artifact, string &reason)
     {
      string sha = "";
      if(!DPCCCheckpointFileSHA(artifact.manifest_path, artifact.common_files, 65536, sha, reason) ||
         sha != artifact.manifest_sha256)
        {
         reason = "decoder.infer.manifest_artifact";
         return(false);
        }
      if(!DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
         reason) ||
         sha != artifact.decoder_sha256)
        {
         reason = "decoder.infer.decoder_artifact";
         return(false);
        }
      return(true);
     }
   CNet              *DenoiserNet(void)
     {
      return(m_checkpoint_denoiser_net ? m_checkpoint_denoiser_net : GetPointer(m_denoiser_net));
     }
   //+------------------------------------------------------------------+
   //| Computes a complete immutable owner/profile/table SHA            |
   //+------------------------------------------------------------------+
   bool              CheckpointBindingSHA(const SDPCCCheckpointBinding &binding, string &sha, string &reason)
     {
      const string receipts[] = {binding.training_config_sha256, binding.model_manifest_sha256,
         binding.bank_manifest_sha256,
                                 binding.dataset_manifest_sha256, binding.time_index_sha256,
                                 binding.normalization_section_sha256, binding.decoder_plan_sha256,
                                 binding.denoiser_plan_sha256
                                };
      string text = "DPCC_CHECKPOINT_BINDING_V1\n";
      for(uint i = 0; i < (uint)ArraySize(receipts); i++)
        {
         if(!DPCCResolverLowerSha256(receipts[i]))
           {
            reason = "checkpoint.binding.sha256";
            return(false);
           }
         text += receipts[i] + "\n";
        }
      text += m_integrity.bank_sha256 + "\n" + m_integrity.header_sha256 + "\n";
      text += (string)StringLen(m_checkpoint_dataset_id) + ":" + m_checkpoint_dataset_id + "\n";
      text += (string)StringLen(m_checkpoint_bank_id) + ":" + m_checkpoint_bank_id + "\n";
      text += (string)StringLen(m_checkpoint_normalization_id) + ":" + m_checkpoint_normalization_id + "\n";
      text += m_checkpoint_timeindex_table_sha + "\n";
      text += (string)m_decoder_contract + "\n" + (string)m_denoiser_contract + "\n";
      text += (string)m_training_seed + "\n" + (string)m_validation_seed + "\n" + (string)m_validation_repeat + "\n";
      const SDPCCShape s = m_config.shape;
      const uint words[] = {s.K, s.V, s.H, s.D, s.M, s.J, s.E, s.PlanBatch, s.NActions, s.StateSize, s.Embedding,
                            s.Heads, s.KeyDimension, s.Depth, m_config.contract_version, m_config.binary_layer_version,
                            (uint)m_config.mode, m_config.projection_max_iterations,
                               m_config.projection_max_evaluations,
                            m_config.projection_lookback_steps, m_config.price_basis, m_config.quote_adapter,
                            m_config.event_model, (uint)m_config.risk_type, m_config.normalization_mode,
                            m_config.loss_coordinates, m_config.randomness_version
                           };
      for(uint i = 0; i < (uint)ArraySize(words); i++)
         text += (string)words[i] + "\n";
      const double scalars[] = {m_config.projection_improvement_atol, m_config.projection_distance_tie_atol,
                                m_config.volume_scale, m_config.price_scale, m_config.money_scale,
                                m_config.max_quote_age_seconds, m_config.max_last_age_seconds, (
                                   double)m_config.risk_parameter,
                                (double)m_config.mean_weight, (double)m_config.gamma, (
                                   double)m_config.probability_tolerance
                               };
      for(uint i = 0; i < (uint)ArraySize(scalars); i++)
        {
         if(!MathIsValidNumber(scalars[i]))
           {
            reason = "checkpoint.binding.numeric";
            return(false);
           }
         text += StringFormat("%.17g", scalars[i]) + "\n";
        }
      for(uint i = 0; i < 6; i++)
         text += StringFormat("%.17g\n%.17g\n", (double)m_config.action_bias[i], (double)m_config.action_scale[i]);
      for(int i = 0; i < ArraySize(m_alpha); i++)
         text += StringFormat("%.17g\n", m_alpha[i]);
      for(int i = 0; i < ArraySize(m_record_keys); i++)
        {
         const SDPCCTrainingFrozenRecordKeys k = m_record_keys[i];
         text += (string)StringLen(k.window_id) + ":" + k.window_id + "\n";
         text += (string)k.decision_time + "\n" + (string)k.decision_identity + "\n";
         text += (string)k.context_identity + "\n" + (string)k.owner_identity + "\n" + (string)k.validation_j + "\n";
         text += (string)StringLen(m_records[i].source_id) + ":" + m_records[i].source_id + "\n";
         text += m_records[i].admission.split + "\n";
        }
      return(DPCCCheckpointTextSHA(text, sha, reason));
     }

   bool              CheckpointPath(const string path, string &canonical, string &reason)
     {
      string prepared = "";
      if(!DPCCResolverPreparePath(path, prepared, reason, "checkpoint.path"))
         return(false);
      string segments[];
      if(!DPCCResolverAppendSegments(prepared, segments, 0, reason, "checkpoint.path"))
         return(false);
      canonical = DPCCResolverJoinSegments(segments);
      if(StringLen(canonical) == 0 || canonical != prepared)
        {
         reason = "checkpoint.path.canonical";
         return(false);
        }
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Writes one fresh full native artifact and keeps failed bytes     |
   //+------------------------------------------------------------------+
   bool              CheckpointSaveNative(CNet *net, const string path, const bool common_files, string &sha,
      string &reason)
     {
      if(FileIsExist(path, common_files ? FILE_COMMON : 0))
        {
         reason = "checkpoint.destination_exists";
         return(false);
        }
      const int writer = FileOpen(path, FILE_WRITE | FILE_BIN | (common_files ? FILE_COMMON : 0));
      if(writer == INVALID_HANDLE)
        {
         reason = "checkpoint.native.open";
         return(false);
        }
      ResetLastError();
      bool saved = net.Save(writer);
      FileFlush(writer);
      saved = (saved && GetLastError() == 0);
      FileClose(writer);
      if(!saved)
        {
         reason = "checkpoint.native.save_or_flush";
         return(false);
        }
      return(DPCCCheckpointFileSHA(path, common_files, m_checkpoint_max_file_bytes, sha, reason));
     }
   //+------------------------------------------------------------------+
   //| Creates a native candidate borrowing the permanent decoder owner |
   //+------------------------------------------------------------------+
   bool              CheckpointCandidate(const bool decoder_role, const string path, const bool common_files,
                            const uint expected_updates, const ulong expected_state, CNet *&candidate, string &reason)
     {
      candidate = new CNet;
      if(!candidate)
        {
         reason = "checkpoint.candidate.capacity";
         return(false);
        }
      bool created = false;
      if(decoder_role)
        {
         SDPCCConfig config = m_config;
         config.shape.Depth = 0;
         CNeuronScenarioDecoderOCL *layer = NULL;
         created = DPCCCreateDecoderNet(candidate, config, m_checkpoint_decoder_composition, 1,
                                        m_decoder_net.GetOpenCL(), layer, reason);
        }
      else
        {
         CNeuronPlanDenoiserOCL *layer = NULL;
         created = DPCCCreateDenoiserNet(candidate, m_config, m_checkpoint_denoiser_composition,
                                         m_checkpoint_denoiser_composition, 1, m_decoder_net.GetOpenCL(), layer,
                                            reason);
        }
      if(!created)
        {
         delete candidate;
         candidate = NULL;
         return(false);
        }
      float error = 0, undefined = 0, forecast = 0;
      datetime time = 0;
      //--- Native filename overload owns the open/close lifecycle, including failure.
      if(!candidate.Load(path, error, undefined, forecast, time, common_files))
        {
         delete candidate;
         candidate = NULL;
         reason = "checkpoint.candidate.native_load";
         return(false);
        }
      bool admitted = false;
      if(decoder_role)
        {
         CNeuronScenarioDecoderOCL *layer = dynamic_cast<CNeuronScenarioDecoderOCL *>(candidate.Layer(1));
         admitted = (layer && layer.Type() == defNeuronScenarioDecoderOCL && candidate.Layer(2) == NULL &&
                     layer.ContractSignature() == m_decoder_contract && layer.UpdateCount() == expected_updates &&
                     layer.GenerationPhase() == 0 && layer.TrainableStateFingerprint() == expected_state);
        }
      else
        {
         CNeuronPlanDenoiserOCL *layer = dynamic_cast<CNeuronPlanDenoiserOCL *>(candidate.Layer(1));
         admitted = (layer && layer.Type() == defNeuronPlanDenoiserOCL && candidate.Layer(2) == NULL &&
                     layer.ContractSignature() == m_denoiser_contract && layer.UpdateCount() == expected_updates &&
                     layer.GenerationPhase() == 0 && layer.TrainableStateFingerprint() == expected_state);
        }
      if(!admitted || expected_state == 0 || candidate.GetOpenCL() != m_decoder_net.GetOpenCL())
        {
         delete candidate;
         candidate = NULL;
         reason = "checkpoint.candidate.contract_or_full_state";
         return(false);
        }
      CLayerDescription *input_info = candidate.Layer(0).GetLayerInfo();
      CLayerDescription *role = candidate.Layer(1).GetLayerInfo();
      const uint input_count = (decoder_role ? m_config.shape.K * m_config.shape.V * m_config.shape.H*m_config.shape.D :
                                m_config.shape.H * 6);
      const bool descriptor_ok = (input_info && role && input_info.type == defNeuronBaseOCL &&
                                  input_info.count == input_count && input_info.batch == 1 &&
                                  input_info.optimization == ADAM && role.batch == 1 &&
                                  role.optimization == ADAM && role.layers == (decoder_role ? 0 : 1) &&
                                  ArraySize(role.windows) == 9 && role.windows[8] == 1);
      delete role;
      delete input_info;
      if(!descriptor_ok)
        {
         delete candidate;
         candidate = NULL;
         reason = "checkpoint.candidate.optimizer_or_input_descriptor";
         return(false);
        }
      if(!decoder_role)
        {
         CNeuronPlanDenoiserOCL *layer = dynamic_cast<CNeuronPlanDenoiserOCL *>(candidate.Layer(1));
         const ulong state_before = layer.TrainableStateFingerprint();
         const uint updates_before = layer.UpdateCount();
         //--- Native bytes carry graph/affine/Adam state; the bound owner supplies condition scales.
         const bool configured = layer.Configure(m_config, m_checkpoint_denoiser_composition,
                                                 m_checkpoint_denoiser_composition);
         const int configuration_status = (int)layer.LastStatus();
         const ulong state_after = layer.TrainableStateFingerprint();
         const uint updates_after = layer.UpdateCount();
         const bool unchanged = (state_before == expected_state && state_after == state_before &&
                                 updates_before == expected_updates && updates_after == updates_before &&
                                 layer.ContractSignature() == m_denoiser_contract && layer.GenerationPhase() == 0 &&
                                 candidate.GetOpenCL() == m_decoder_net.GetOpenCL());
         if(!configured || configuration_status != (int)DPCC_OK || !unchanged)
           {
            reason = StringFormat("checkpoint.candidate.denoiser_configuration:status=%d:unchanged=%d",
                                  configuration_status, (int)unchanged);
            delete candidate;
            candidate = NULL;
            return(false);
           }
         PrintFormat("DPCC_CHECKPOINT_NATIVE_CONFIG_BOUND role=denoiser updates_before=%u updates_after=%u "
                     "state_before=%s state_after=%s status=%d",
                     updates_before, updates_after, (string)state_before, (string)state_after, configuration_status);
        }
      return(true);
     }
   //+-------------------------------------------------------------------+
   //| Loss-only native probe reuses owned staged tensors and fixed keys |
   //+-------------------------------------------------------------------+
   bool              CheckpointProbeFailure(const string stage, CNeuronScenarioDecoderOCL *decoder,
                               CNeuronPlanDenoiserOCL *denoiser, const bool candidate, string &reason)
     {
      const int terminal_error = GetLastError();
      reason = stage + StringFormat(":decoder_status=%d:denoiser_status=%d:terminal_error=%d",
                                    (int)decoder.LastStatus(), (int)denoiser.LastStatus(), terminal_error);
      PrintFormat("DPCC_CHECKPOINT_PROBE_FAILURE candidate=%d stage=%s decoder_status=%d denoiser_status=%d "
                  "decoder_phase=%u denoiser_phase=%u terminal_error=%d",
                  (int)candidate, stage, (int)decoder.LastStatus(), (int)denoiser.LastStatus(),
                  decoder.GenerationPhase(), denoiser.GenerationPhase(), terminal_error);
      return(false);
     }

   bool              CheckpointProbe(CNet *decoder_net, CNet *denoiser_net, const int index,
                        float &decoder_output[], float &denoiser_output[], double &decoder_loss,
                        double &denoiser_loss, string &reason)
     {
      SDPCCTrainingExampleResult admission;
      if(!Begin(index, DPCC_TRAIN_VALIDATE, admission))
        {
         reason = admission.reason;
         return(false);
        }
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL *>(decoder_net.Layer(1));
      CNeuronPlanDenoiserOCL *denoiser = dynamic_cast<CNeuronPlanDenoiserOCL *>(denoiser_net.Layer(1));
      if(!decoder || !denoiser || !decoder_net.TrainMode(false) || !denoiser_net.TrainMode(false))
        {
         reason = "checkpoint.probe.model_or_mode";
         return(false);
        }
      decoder_net.SetWeightsUpdate(false);
      denoiser_net.SetWeightsUpdate(false);
      const bool candidate = (denoiser_net != DenoiserNet());
      ResetLastError();
      if(!decoder_net.feedForward(GetPointer(m_z), 1, false, (CBufferFloat*)NULL))
         return(CheckpointProbeFailure("checkpoint.probe.decoder.forward", decoder, denoiser, candidate, reason));
      if(!decoder.BuildNativeBankRhoLoss(GetPointer(m_target), GetPointer(m_norm), GetPointer(m_rho),
                                         m_config.probability_tolerance, false, decoder_loss))
         return(CheckpointProbeFailure("checkpoint.probe.decoder.loss", decoder, denoiser, candidate, reason));
      if(decoder.getOutputVal(decoder_output) != (int)(m_config.shape.K * m_config.shape.H * 4))
         return(CheckpointProbeFailure("checkpoint.probe.decoder.output", decoder, denoiser, candidate, reason));
      const SDPCCTrainingFrozenRecordKeys k = m_record_keys[index];
      float indexed[], epsilon[];
      if(!DPCCBuildIndexedNoiseV1(m_validation_seed, k.decision_time, m_validation_repeat, 1,
                                  m_config.shape.J, m_config.shape.H, indexed) ||
         ArrayResize(epsilon, m_config.shape.H * 6) != (int)(m_config.shape.H * 6))
        {
         reason = "checkpoint.probe.noise";
         return(false);
        }
      for(uint i = 0; i < m_config.shape.H * 6; i++)
         epsilon[i] = indexed[k.validation_j * m_config.shape.H * 6 + i];
      if(!Upload(m_epsilon, epsilon))
         return(CheckpointProbeFailure("checkpoint.probe.denoiser.upload", decoder, denoiser, candidate, reason));
      if(!denoiser.PrepareTrainingExample(GetPointer(m_actions), GetPointer(m_epsilon), GetPointer(m_context),
                                          GetPointer(m_account), k.validation_j, m_alpha[k.validation_j],
                                          GetPointer(m_noisy), GetPointer(m_condition)))
         return(CheckpointProbeFailure("checkpoint.probe.denoiser.prepare", decoder, denoiser, candidate, reason));
      if(!denoiser.SetContextIdentity(k.decision_identity, k.context_identity, k.owner_identity))
         return(CheckpointProbeFailure("checkpoint.probe.denoiser.identity", decoder, denoiser, candidate, reason));
      if(!denoiser_net.feedForward(GetPointer(m_noisy), 1, false, GetPointer(m_condition)))
         return(CheckpointProbeFailure("checkpoint.probe.denoiser.forward", decoder, denoiser, candidate, reason));
      if(!denoiser.BuildEpsilonMSELoss(GetPointer(m_epsilon), false, denoiser_loss))
         return(CheckpointProbeFailure("checkpoint.probe.denoiser.loss", decoder, denoiser, candidate, reason));
      if(denoiser.getOutputVal(denoiser_output) != (int)(m_config.shape.H * 6))
         return(CheckpointProbeFailure("checkpoint.probe.denoiser.output", decoder, denoiser, candidate, reason));
      if(!MathIsValidNumber(decoder_loss) || !MathIsValidNumber(denoiser_loss))
         return(CheckpointProbeFailure("checkpoint.probe.loss_nonfinite", decoder, denoiser, candidate, reason));
      return(true);
     }

   bool              CheckpointSameOutputs(const float &first[], const float &second[])
     {
      if(ArraySize(first) != ArraySize(second))
         return(false);
      for(int i = 0; i < ArraySize(first); i++)
         if(!MathIsValidNumber(first[i]) || !MathIsValidNumber(second[i]) || first[i] != second[i])
            return(false);
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Resolves retained typed initial manifest and both native bytes   |
   //+------------------------------------------------------------------+
   bool              CheckpointInitialArtifacts(const string path, const string expected_sha, const bool common_files,
                                   SDPCCCheckpointArtifact &initial, string &reason)
     {
      ZeroMemory(initial);
      if(!DPCCReadCheckpointArtifact(path, common_files, expected_sha, initial, reason) ||
         initial.binding_sha256 != m_checkpoint_binding_sha || initial.cursor.stage != 0 ||
         initial.cursor.decoder_updates != 0 || initial.cursor.denoiser_updates != 0)
        {
         reason = "checkpoint.initial.manifest_binding";
         return(false);
        }
      string observed = "";
      if(!DPCCCheckpointFileSHA(initial.decoder_path, common_files, m_checkpoint_max_file_bytes, observed, reason) ||
         observed != initial.decoder_sha256)
        {
         reason = "checkpoint.initial.decoder_artifact";
         return(false);
        }
      if(!DPCCCheckpointFileSHA(initial.denoiser_path, common_files, m_checkpoint_max_file_bytes, observed, reason) ||
         observed != initial.denoiser_sha256)
        {
         reason = "checkpoint.initial.denoiser_artifact";
         return(false);
        }
      return(true);
     }

   bool              CheckpointFirstUpdateGate(string &reason)
     {
      SDPCCCheckpointArtifact initial;
      return(CheckpointInitialArtifacts(m_checkpoint_initial.manifest_path, m_checkpoint_initial.manifest_sha256,
                                        m_checkpoint_initial.common_files, initial, reason));
     }

   bool              Allocate(CBufferFloat &buffer, const uint count)
                     {return(buffer.BufferInit(count, 0) && buffer.BufferCreate(DecoderNet().GetOpenCL()));}
   bool              Upload(CBufferFloat &buffer, const float &values[])
     {
      if(buffer.Total() != ArraySize(values))
         return(false);
      for(int i = 0; i < ArraySize(values); i++)
         if(!buffer.Update(i, values[i]))
            return(false);
      return(buffer.BufferWrite());
     }
   bool              Fail(SDPCCTrainingExampleResult &result, const string stage, const string reason)
     {result.completed = false; result.stage = stage; result.reason = reason; return(false);}
   bool              Begin(const int record_index, const ENUM_DPCC_TRAIN_OPERATION operation,
              SDPCCTrainingExampleResult &result)
     {
      ZeroMemory(result);
      result.stage = "admission";
      result.bank_sha256 = m_integrity.bank_sha256;
      result.header_sha256 = m_integrity.header_sha256;
      if(!m_initialized || m_poisoned || record_index < 0 || record_index >= ArraySize(m_records))
         return(Fail(result, "admission", "training.instance_or_record"));
      result.window_id = m_records[record_index].window_id;
      result.source_id = m_records[record_index].source_id;
      result.split = m_records[record_index].admission.split;
      result.decision_time = m_records[record_index].admission.decision_time;
      if(operation != DPCC_TRAIN_UPDATE && operation != DPCC_TRAIN_FROZEN && operation != DPCC_TRAIN_VALIDATE)
         return(Fail(result, "admission", "training.operation"));
      const string required = operation == DPCC_TRAIN_VALIDATE ? "validation" : "fit";
      if(result.split != required)
         return(Fail(result, "admission", "training.split"));
      if(m_decoder.ContractSignature() != m_decoder_contract || m_denoiser.ContractSignature() != m_denoiser_contract)
         return(Fail(result, "admission", "training.factory_binding"));
      if(m_loaded == record_index)
         return(true);
      const SDPCCMaterializedRecord record = m_records[record_index];
      float z[], norm[];
      string packing_reason = "";
      if(!DPCCPackDecoderInput(m_config.shape, record.context_without_noise, z, packing_reason))
         return(Fail(result, "upload", packing_reason));
      if(ArrayResize(norm, 16) != 16)
         return(Fail(result, "upload", "training.host_slice_capacity"));
      for(uint i = 0; i < 16; i++)
         norm[i] = record.context_without_noise[(uint)m_c.offsets[3] + i];
      if(!Upload(m_z, z) || !Upload(m_norm, norm) || !Upload(m_target, record.target_native_ohlc) || !Upload(m_rho,
         record.rho) ||
         !Upload(m_context, record.context_without_noise) || !Upload(m_account, record.account_features) || !Upload(
            m_actions, record.actions))
        {m_loaded = -1; return(Fail(result, "upload", "training.original_tensor_upload"));}
      m_loaded = record_index;
      return(true);
     }

   bool              ObserveDecoderCandidate(CNet *decoder, CNet *denoiser, const SDPCCCheckpointArtifact &artifact,
      const int index,
                                SDPCCDecoderValidationObservation &out, string &reason)
     {
      if(CheckPointer(decoder) == POINTER_INVALID || CheckPointer(denoiser) == POINTER_INVALID ||
         index < 0 || index >= ArraySize(m_records) || m_records[index].admission.split != "validation")
        {reason = "decoder.observe.candidate_or_record"; return(false);}
      float normalized[], discard[];
      double loss = 0, unused = 0;
      bool ok = CheckpointProbe(decoder, denoiser, index, normalized, discard, loss, unused, reason);
      CNeuronScenarioDecoderOCL *layer = dynamic_cast<CNeuronScenarioDecoderOCL*>(decoder.Layer(1));
      CNeuronPlanDenoiserOCL *noise = dynamic_cast<CNeuronPlanDenoiserOCL*>(denoiser.Layer(1));
      SDPCCDecoderValidationObservation candidate;
      candidate.record_index = index;
      candidate.window_id = m_records[index].window_id;
      candidate.selected_manifest_sha = artifact.manifest_sha256;
      candidate.normalized_loss = loss;
        {
         const uint count = m_config.shape.K * m_config.shape.H * 4;
         CNeuronBatchNormOCL holder;
         CNeuronRevINDenormOCL restoration;
         ok = ok && layer != NULL && noise != NULL && ArraySize(normalized) == (int)count &&
              ArrayResize(candidate.causal_price_norm, 16) == 16 &&
              holder.Init(0, 2, decoder.GetOpenCL(), uint(4), uint(2), ADAM) && restoration.InitOwned(1,
                 decoder.GetOpenCL(), count);
         if(ok)
           {
            holder.TrainMode(false);
            restoration.TrainMode(false);
            for(int i = 0; i < 16; i++)
               candidate.causal_price_norm[i] = m_records[index].context_without_noise[(int)m_c.offsets[3] + i];
            CBufferFloat *ho = holder.getBatchOptions(), *ro = restoration.getBatchOptions();
            ok = ho != NULL && ro != NULL && ho.Total() == 36 && ro.Total() == (int)(count * 9);
            for(uint row = 0; ok && row < count; row++)
              {
               const int channel = (int)(row % 4) * 4;
               const float mean = candidate.causal_price_norm[channel], std = candidate.causal_price_norm[channel + 1];
               const float variance = (float)((double)std * std);
               ok = MathIsValidNumber(mean) && MathIsValidNumber(std) && std > 0 && MathIsValidNumber(variance) &&
                  variance > 0 &&
                    candidate.causal_price_norm[channel + 2] == 1 && candidate.causal_price_norm[channel + 3] == 0 &&
                    MathIsValidNumber(normalized[(int)row]);
               //--- Finite preflight only: observable restoration comes exclusively from native RevIN.
               const float product = (float)((double)(float)MathSqrt(variance) * normalized[(int)row]);
               ok = ok && MathIsValidNumber(product) && MathIsValidNumber((float)((double)mean + product));
               for(int j = 0; ok && j < 9; j++)
                  ok = ro.Update((int)row * 9 + j, 0);
               ok = ok && ro.Update((int)row * 9, mean) && ro.Update((int)row * 9 + 1, variance) && ro.Update((
                  int)row * 9 + 3, 1);
               if(row < 4)
                 {
                  for(int j = 0; ok && j < 9; j++)
                     ok = ho.Update((int)row * 9 + j, 0);
                  ok = ok && ho.Update((int)row * 9, mean) && ho.Update((int)row * 9 + 1, variance) && ho.Update((
                     int)row * 9 + 3, 1);
                 }
              }
            ok = ok && ho.BufferWrite() && holder.SetBatchCount(1) && ro.BufferWrite() && restoration.FeedForward(
               layer.AsObject()) &&
                 restoration.getOutput() != NULL && restoration.getOutput().BufferRead() && ArrayResize(
                    candidate.native_ohlc, (int)count) == (int)count;
            for(uint i = 0; ok && i < count; i++)
              {candidate.native_ohlc[(int)i] = restoration.getOutput().At((int)i); ok = MathIsValidNumber(
                 candidate.native_ohlc[(int)i]);}
            if(ok)
               ok = ArrayCopy(candidate.normalized, normalized) == (int)count;
           }
        //--- Owning normalization dies while native candidate context still exists.
        }
      ok = ok && layer != NULL && noise != NULL && layer.TrainableStateFingerprint() == artifact.decoder_state &&
           noise.TrainableStateFingerprint() == artifact.denoiser_state && layer.UpdateCount() ==
              artifact.cursor.decoder_updates &&
           noise.UpdateCount() == artifact.cursor.denoiser_updates;
      if(!ok)
        {
         if(StringLen(reason) == 0)
            reason = "decoder.observe.native_restoration_or_state";
         return(false);
        }
      out = candidate;
      return(true);
     }
   bool              WriteDecoderObservation(const int handle, const string value, const ulong budget, ulong &written,
      string &reason)
     {
      if((ulong)StringLen(value) > budget - written) {reason = "decoder.stream.budget"; return(false);
        }
      uchar bytes[];
      const int count = StringToCharArray(value, bytes, 0, WHOLE_ARRAY, CP_UTF8);
      if(count <= 0 || (ulong)(count - 1) > budget - written || ArrayResize(bytes, count - 1) != count - 1 ||
         FileWriteArray(handle, bytes, 0, count - 1) != (uint)(count - 1))
        {reason = "decoder.stream.write_or_budget"; return(false);}
      written += (ulong)(count - 1);
      return(true);
     }
public:
                     CDPCCTrainingExamples(void)
     {
      m_decoder = NULL;
      m_denoiser = NULL;
      m_initialized = false;
      m_poisoned = false;
      m_decoder_initial_saved = false;
      m_denoiser_initial_saved = false;
      m_loaded = -1;
      m_tokens = 0;
      m_decoder_stream_native_loads = 0;
      m_checkpoint_decoder_net = NULL;
      m_checkpoint_denoiser_net = NULL;
      m_inference_decoder_net = NULL;
      m_inference_input = NULL;
      ZeroMemory(m_inference_artifact);
      m_checkpoint_metadata_bound = false;
      m_checkpoint_restored = false;
      m_checkpoint_max_file_bytes = 0;
      ZeroMemory(m_checkpoint_initial);
     }
                    ~CDPCCTrainingExamples(void)
     {
      CloseDecoderInference();
      delete m_checkpoint_denoiser_net;
      delete m_checkpoint_decoder_net;
     }

   bool              Initialize(const SDPCCTrainingBankSource &source, const SDPCCConfig &config,
                   const SDPCCDecoderComposition &decoder_composition,
                   const SDPCCDenoiserComposition &model_composition,
                      const SDPCCDenoiserComposition &training_composition,
                   const double schedule_s, const double beta_cap, const double &frozen_alpha[],
                   const SDPCCTrainingFrozenRecordKeys &frozen_keys[],
                   const ulong training_seed, const ulong validation_seed,
                   const uint validation_repeat, string &reason)
     {
      reason = "";
      if(m_initialized || m_poisoned || DecoderNet().Layer(0) != NULL || DenoiserNet().Layer(0) != NULL)
        {reason = "training.destination_not_empty"; return(false);}
      if(config.shape.PlanBatch != 1 || config.shape.J == 0 || config.shape.J > 64 ||
         ArraySize(frozen_alpha) != (int)config.shape.J + 1 || frozen_alpha[0] != 1 ||
         !DPCCCompositeLayouts(config.shape, m_c, m_r, m_tokens))
        {reason = "training.frozen_shape_or_schedule"; return(false);}
      double canonical_beta[], canonical_alpha[], canonical_sigma[];
      if(schedule_s != 0.008 || beta_cap != 0.999 ||
         !DPCCBuildCosineDiffusionSchedule(config.shape.J, schedule_s, beta_cap,
                                           canonical_beta, canonical_alpha, canonical_sigma, reason))
        {reason = "training.canonical_cosine_parameters"; return(false);}
      for(uint j = 0; j <= config.shape.J; j++)
         if(frozen_alpha[j] != canonical_alpha[j])
           {reason = "training.frozen_cosine_schedule_mismatch"; return(false);}
      for(uint j = 1; j <= config.shape.J; j++)
         if(!MathIsValidNumber(frozen_alpha[j]) || frozen_alpha[j] <= 0 || frozen_alpha[j] >= frozen_alpha[j - 1] ||
            (float)frozen_alpha[j] <= 0 || (float)frozen_alpha[j] >= 1)
           {reason = "training.alpha_numeric_or_order"; return(false);}
      //--- Bound two simultaneous materialization copies plus fixed-width arrays.
      //--- This is a tensor payload budget, not a measured total process RAM gate.
      const ulong H = config.shape.H, K = config.shape.K;
      const ulong floats = (ulong)m_c.offsets[10] + 13 + H * 4 + K + H * 12 + H;
      const ulong per_record = floats * sizeof(float) + H * sizeof(uint) + H * 4 * sizeof(long);
      if(source.maximum_records == 0 || source.maximum_staged_tensor_bytes == 0 ||
         per_record > source.maximum_staged_tensor_bytes / 2 / source.maximum_records)
        {reason = "training.staged_tensor_budget"; return(false);}
      CDPCCBankMaterializationObserver observer;
      if(!observer.Configure(source.record_schema, source.header, source.header_schema, source.dataset, source.links,
                             source.profile, source.bank, source.time_index, config, source.maximum_records, reason))
         return(false);
      ulong invalid = 0;
      if(!DPCCStageMaterializedBank(observer, source.path, source.common_files, source.bank.bank_sha256,
                                    m_records, m_integrity, invalid, reason))
         return(false);
      //--- Invalid records remain in bank integrity count and are not fabricated as examples.
      if(ArraySize(m_records) == 0)
        {
         reason = "training.no_valid_examples";
         return(false);
        }
      if(ArraySize(frozen_keys) != ArraySize(m_records) || ArrayResize(m_record_keys, ArraySize(m_records)) !=
         ArraySize(m_records))
        {reason = "training.frozen_record_keys_capacity"; return(false);}
      for(int i = 0; i < ArraySize(m_records); i++)
        {
         const SDPCCTrainingFrozenRecordKeys key = frozen_keys[i];
         if(key.window_id != m_records[i].window_id || key.decision_time != m_records[i].admission.decision_time ||
            key.decision_identity == 0 || key.context_identity == 0 || key.owner_identity == 0 ||
            (m_records[i].admission.split == "validation" ? (key.validation_j == 0 || key.validation_j >
               config.shape.J) : key.validation_j != 0))
           {reason = "training.frozen_record_keys_binding"; return(false);}
         for(int k = 0; k < i; k++)
            if(frozen_keys[k].decision_identity == key.decision_identity)
              {reason = "training.frozen_decision_identity_duplicate"; return(false);}
         m_record_keys[i] = key;
        }
      m_config = config;
      m_training_seed = training_seed;
      m_validation_seed = validation_seed;
      m_validation_repeat = validation_repeat;
      if(ArrayCopy(m_alpha, frozen_alpha) != ArraySize(frozen_alpha))
        {
         reason = "training.alpha_copy";
         return(false);
        }
      //--- Decoder has no UShape depth; retain the denoiser role geometry unchanged.
      SDPCCConfig decoder_config = config;
      decoder_config.shape.Depth = 0;
      if(!DPCCCreateDecoderNet(m_decoder_net, decoder_config, decoder_composition, 1, NULL, m_decoder, reason) ||
         !DPCCCreateDenoiserNet(m_denoiser_net, config, model_composition, training_composition, 1,
                                DecoderNet().GetOpenCL(), m_denoiser, reason))
        {m_poisoned = true; return(false);}
      m_decoder_contract = m_decoder.ContractSignature();
      m_denoiser_contract = m_denoiser.ContractSignature();
      if(m_decoder_contract == 0 || m_denoiser_contract == 0 || !Allocate(m_z, (uint)m_c.lengths[0]) || !Allocate(
         m_norm, 16) ||
         !Allocate(m_target, config.shape.H * 4) || !Allocate(m_rho, config.shape.K) ||
         !Allocate(m_context, (uint)m_c.offsets[10]) || !Allocate(m_account, 13) || !Allocate(m_actions,
            config.shape.H * 6) ||
         !Allocate(m_epsilon, config.shape.H * 6) || !Allocate(m_noisy, config.shape.H * 6) || !Allocate(m_condition,
            m_tokens + 61))
        {m_poisoned = true; reason = "training.device_allocation"; return(false);}
      m_checkpoint_decoder_composition = decoder_composition;
      m_checkpoint_denoiser_composition = model_composition;
      m_checkpoint_dataset_id = source.dataset.dataset_id;
      m_epoch_time_index_id = source.links.time_index_id;
      m_checkpoint_normalization_id = source.dataset.normalization_id;
      m_checkpoint_bank_id = source.bank.bank_id;
      m_checkpoint_dataset_sha = source.links.dataset_sha256;
      m_checkpoint_timeindex_sha = source.links.time_index_sha256;
      string index_text = "DPCC_TIME_INDEX_TYPED_V1\n";
      for(int i = 0; i < ArraySize(source.time_index.bar_index); i++)
         index_text += (string)source.time_index.bar_index[i] + ":" + (string)source.time_index.start_utc[i] + ":" +
                       (string)source.time_index.end_utc[i] + "\n";
      if(!DPCCCheckpointTextSHA(index_text, m_checkpoint_timeindex_table_sha, reason))
         return(false);
      m_initialized = true;
      return(true);
     }
   int               RecordCount(void) const {return(m_initialized ? ArraySize(m_records) : 0);}
   //--- Read-only access to one admitted row; the full bank remains private.
   bool              AdmittedRecordCount(int &count, string &reason) const
     {
      count = 0;
      reason = "";
      if(!m_initialized)
        {reason = "training.records_not_admitted"; return(false);}
      if(m_poisoned)
        {reason = "training.records_poisoned"; return(false);}
      count = ArraySize(m_records);
      if(count <= 0)
        {count = 0; reason = "training.records_empty"; return(false);}
      return(true);
     }
   bool              CopyAdmittedRecord(const int index, SDPCCMaterializedRecord &record, string &reason) const
     {
      DPCCClearMaterializedRecord(record);
      reason = "";
      if(!m_initialized)
        {reason = "training.records_not_admitted"; return(false);}
      if(m_poisoned)
        {reason = "training.records_poisoned"; return(false);}
      if(index < 0 || index >= ArraySize(m_records))
        {reason = "training.record_index"; return(false);}
      record = m_records[index];
      return(true);
     }
   //--- Read-only validation of EVERY admitted original record before the owner can UPDATE.
   //--- Exact float bits use the native holder's effective std, never a tolerance.
   bool              CheckFixedPriceNorm(const float &profile[], const long cutoff, string &reason)
     {
      if(!m_initialized || m_poisoned || ArraySize(profile) != 16 || cutoff < 0 || ArraySize(m_records) == 0)
        {reason = "BLOCKED.training.fixed_profile_admission_required"; return(false);}
      for(int record = 0; record < ArraySize(m_records); record++)
        {
         if(m_records[record].normalization_asof < cutoff ||
            m_records[record].normalization_asof > m_records[record].admission.decision_time)
           {reason = "BLOCKED.training.fixed_normalization_cutoff.record_" + (string)record; return(false);}
         for(int field = 0; field < 16; field++)
           {
            URAGFloatBits expected, actual;
            expected.value = profile[field];
            actual.value = m_records[record].context_without_noise[(int)m_c.offsets[3] + field];
            if(expected.bits != actual.bits)
              {reason = "BLOCKED.training.fixed_PriceNorm.record_" + (string)record + ".field_" + (string)field; return(
                 false);}
           }
        }
      reason = "";
      return(true);
     }
   //--- Contract-only copy: FIT_FIXED never obtains statistics from a bank record.
   bool              PreparedActorContract(SDPCCConfig &config, SDPCCDecoderComposition &decoder,
                              SDPCCDenoiserComposition &denoiser, string &reason)
     {
      if(!m_initialized || m_poisoned)
        {reason = "actor.examples_contract_not_admitted"; return(false);}
      config = m_config;
      decoder = m_checkpoint_decoder_composition;
      denoiser = m_checkpoint_denoiser_composition;
      reason = "";
      return(true);
     }
   bool              PreparedActorProfile(const int index, SDPCCConfig &config, SDPCCDecoderComposition &decoder,
                             SDPCCDenoiserComposition &denoiser, float &norm[], string &reason)
     {
      if(!m_initialized || m_poisoned || index < 0 || index >= ArraySize(m_records) ||
         ArrayResize(norm, 16) != 16)
        {
         reason = "actor.owner_causal_record";
         return(false);
        }
      config = m_config;
      decoder = m_checkpoint_decoder_composition;
      denoiser = m_checkpoint_denoiser_composition;
      for(int i = 0; i < 16; i++)
         norm[i] = m_records[index].context_without_noise[(int)m_c.offsets[3] + i];
      return(true);
     }
   bool              RecordIdentity(const int index, SDPCCTrainingRecordIdentity &result)
     {
      ZeroMemory(result);
      if(!m_initialized || m_poisoned || index < 0 || index >= ArraySize(m_records))
         return(false);
      result.record_index = index;
      result.window_id = m_records[index].window_id;
      result.source_id = m_records[index].source_id;
      result.split = m_records[index].admission.split;
      result.decision_time = m_records[index].admission.decision_time;
      result.decision_bar_index = m_records[index].admission.decision_bar_index;
      result.bank_sha256 = m_integrity.bank_sha256;
      result.header_sha256 = m_integrity.header_sha256;
      result.keys = m_record_keys[index];
      return(true);
     }
   bool              RunBinding(const string dataset_id, const string bank_id, const string normalization_id,
                   const string dataset_sha256, const SDPCCBankMetadataResult &bank,
                      const SDPCCTrainingModelBinding &model,
                   const string time_index_sha256, const SDPCCDatasetTimeIndex &time_index,
                      const SDPCCArchitectureContract &a, const string training_seed, const string validation_seed,
                   const uint validation_repeat, const uint J, const bool denoiser_keys, string &reason)
     {
      if(!m_initialized || m_poisoned || dataset_id != m_checkpoint_dataset_id || bank_id != m_checkpoint_bank_id ||
         normalization_id != m_checkpoint_normalization_id || dataset_sha256 != m_checkpoint_dataset_sha || J !=
            m_config.shape.J ||
         (denoiser_keys && (training_seed != StringFormat("%016I64x", m_training_seed) ||
                            validation_seed != StringFormat("%016I64x", m_validation_seed) || validation_repeat !=
                               m_validation_repeat)))
        {reason = "training.owner_run_binding"; return(false);}
      if(bank.bank_id != m_checkpoint_bank_id || bank.dataset_id != m_checkpoint_dataset_id || bank.time_index_id !=
         m_epoch_time_index_id ||
         bank.bank_sha256 != m_integrity.bank_sha256 || bank.header_sha256 != m_integrity.header_sha256 ||
         bank.record_count < 0 || (ulong)bank.record_count != m_integrity.record_count)
        {reason = "training.owner_bank_receipt"; return(false);}
      if(time_index_sha256 != m_checkpoint_timeindex_sha || time_index.time_index_id != m_epoch_time_index_id ||
         !DPCCValidateDatasetTimeIndex(time_index, m_checkpoint_dataset_id, reason))
         return(false);
      for(int r = 0; r < ArraySize(m_records); r++)
        {
         long decision = m_records[r].admission.decision_bar_index;
         if(decision < 0 || decision >= ArraySize(time_index.bar_index) ||
            m_records[r].admission.decision_time != time_index.start_utc[(int)decision])
           {reason = "training.owner_decision_time_index"; return(false);}
         for(int t = 0; t < ArraySize(m_records[r].bar_indices); t++)
           {
            long bar = m_records[r].bar_indices[t];
            if(bar < 0 || bar >= ArraySize(time_index.bar_index) ||
               time_index.bar_index[(int)bar] != bar || time_index.start_utc[(int)bar] !=
                  m_records[r].bar_open_times[t] ||
               time_index.end_utc[(int)bar] != m_records[r].bar_close_times[t])
              {reason = "training.owner_target_time_index"; return(false);}
           }
        }
      if(model.price_basis != m_config.price_basis || model.volume_scale != m_config.volume_scale ||
         model.price_scale != m_config.price_scale || model.money_scale != m_config.money_scale ||
         model.probability_tolerance != m_config.probability_tolerance || model.schedule_s != 0.008 || model.beta_cap !=
            0.999)
        {reason = "training.owner_model_scales"; return(false);}
      for(int i = 0; i < 6; i++)
         if(model.action_bias[i] != m_config.action_bias[i] || model.action_scale[i] != m_config.action_scale[i])
           {reason = "training.owner_action_affine"; return(false);}
      double beta[], alpha[], sigma[];
      if(!DPCCBuildCosineDiffusionSchedule(J, model.schedule_s, model.beta_cap, beta, alpha, sigma, reason) ||
         ArraySize(model.beta) != (int)J + 1 || ArraySize(model.alpha_bar) != (int)J + 1 || ArraySize(model.sigma) != (
            int)J + 1)
        {reason = "training.owner_schedule_shape"; return(false);}
      for(uint i = 0; i <= J; i++)
         if(model.beta[i] != beta[i] || model.alpha_bar[i] != m_alpha[i] || model.sigma[i] != sigma[i])
           {reason = "training.owner_schedule_values"; return(false);}
      SDPCCDecoderArchitecture d;
      d.architecture = m_checkpoint_decoder_composition.architecture;
      d.embedding = m_checkpoint_decoder_composition.embedding;
      d.activation = m_checkpoint_decoder_composition.activation_profile;
      d.backward_profile = m_checkpoint_decoder_composition.backward_profile;
      return(DPCCCompareDecoderArchitecture(d, a.training_decoder, "training.owner_decoder", reason) &&
             DPCCCompareDenoiserArchitecture(m_checkpoint_denoiser_composition.graph, a.training_denoiser,
                "training.owner_denoiser", reason) &&
             DPCCCompareParallelExecution(m_checkpoint_denoiser_composition.parallel, a.training_parallel,
                "training.owner_parallel", reason));
     }

   bool              SaveDecoderCheckpoint(const int writer, string &reason)
     {
      reason = "";
      if(!m_initialized || m_poisoned || writer == INVALID_HANDLE || m_decoder.GenerationPhase() != 0 || !DecoderNet(
         ).Save(writer))
        {reason = "training.decoder_checkpoint"; return(false);}
      ResetLastError();
      FileFlush(writer);
      if(GetLastError() != 0)
        {
         reason = "training.decoder_checkpoint_flush";
         return(false);
        }
      //--- Legacy writer success does not authorize the first Adam update.
      return(true);
     }
   bool              SaveDenoiserCheckpoint(const int writer, string &reason)
     {
      reason = "";
      if(!m_initialized || m_poisoned || writer == INVALID_HANDLE || m_denoiser.GenerationPhase() != 0 || !DenoiserNet(
         ).Save(writer))
        {reason = "training.denoiser_checkpoint"; return(false);}
      ResetLastError();
      FileFlush(writer);
      if(GetLastError() != 0)
        {
         reason = "training.denoiser_checkpoint_flush";
         return(false);
        }
      //--- Legacy writer success does not authorize the first Adam update.
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Binds external admitted metadata without granting READY          |
   //+------------------------------------------------------------------+
   bool              BindCheckpointMetadata(const SDPCCCheckpointBinding &binding, const ulong maximum_file_bytes,
      string &reason)
     {
      reason = "";
      if(!m_initialized || m_poisoned || m_checkpoint_metadata_bound || maximum_file_bytes == 0 ||
         m_decoder.UpdateCount() != 0 || m_denoiser.UpdateCount() != 0 ||
         binding.dataset_manifest_sha256 != m_checkpoint_dataset_sha || binding.time_index_sha256 !=
            m_checkpoint_timeindex_sha)
        {
         reason = "checkpoint.binding.owner_state";
         return(false);
        }
      string digest = "";
      if(!CheckpointBindingSHA(binding, digest, reason))
         return(false);
      m_checkpoint_binding = binding;
      m_checkpoint_binding_sha = digest;
      m_checkpoint_max_file_bytes = maximum_file_bytes;
      m_checkpoint_metadata_bound = true;
      return(true);
     }

   bool              NativeState(uint &decoder_updates, uint &denoiser_updates, ulong &decoder_state,
      ulong &denoiser_state)
     {
      decoder_updates = 0;
      denoiser_updates = 0;
      decoder_state = 0;
      denoiser_state = 0;
      if(!m_initialized || m_poisoned || m_decoder.GenerationPhase() != 0 || m_denoiser.GenerationPhase() != 0)
         return(false);
      decoder_updates = m_decoder.UpdateCount();
      denoiser_updates = m_denoiser.UpdateCount();
      decoder_state = m_decoder.TrainableStateFingerprint();
      denoiser_state = m_denoiser.TrainableStateFingerprint();
      return(decoder_state != 0 && denoiser_state != 0);
     }
   //+-------------------------------------------------------------------+
   //| Saves both native roles; publishes manifest and initial gate last |
   //+-------------------------------------------------------------------+
   bool              SaveVerifiedCheckpointArtifact(const string stem, const bool common_files,
                                       const SDPCCCheckpointCursor &cursor,
                                       SDPCCCheckpointArtifact &artifact, string &reason)
     {
      ZeroMemory(artifact);
      reason = "";
      if(!m_initialized || m_poisoned || !m_checkpoint_metadata_bound ||
         cursor.stage > 2 || cursor.next_record != 0 || cursor.completed_epoch == UINT_MAX ||
         cursor.next_epoch != cursor.completed_epoch + 1 ||
         (cursor.stage == 0 && (cursor.completed_epoch != 0 || cursor.decoder_updates != 0 || cursor.denoiser_updates !=
            0)))
        {
         reason = "checkpoint.save.owner_or_epoch_boundary";
         return(false);
        }
      uint decoder_updates = 0, denoiser_updates = 0;
      ulong decoder_state = 0, denoiser_state = 0;
      if(!NativeState(decoder_updates, denoiser_updates, decoder_state, denoiser_state) ||
         decoder_updates != cursor.decoder_updates || denoiser_updates != cursor.denoiser_updates)
        {
         reason = "checkpoint.save.counter_binding";
         return(false);
        }
      const bool initial = (cursor.stage == 0);
      if(initial ? StringLen(m_checkpoint_initial.manifest_sha256) > 0 : StringLen(
         m_checkpoint_initial.manifest_sha256) == 0)
        {
         reason = "checkpoint.save.initial_artifact_required_or_already_preserved";
         PrintFormat("DPCC_CHECKPOINT_INITIAL_GATE initial=%d retained_sha_len=%d eq_empty=%d eq_null=%d",
                     (int)initial, StringLen(m_checkpoint_initial.manifest_sha256),
                     (int)(m_checkpoint_initial.manifest_sha256 == ""),
                     (int)(m_checkpoint_initial.manifest_sha256 == NULL));
         return(false);
        }
      if(!initial && common_files != m_checkpoint_initial.common_files)
        {
         reason = "checkpoint.save.storage_namespace";
         return(false);
        }
      if(!initial)
        {
         SDPCCCheckpointArtifact retained_initial;
         if(!CheckpointInitialArtifacts(m_checkpoint_initial.manifest_path, m_checkpoint_initial.manifest_sha256,
                                        common_files, retained_initial, reason))
            return(false);
        }
      string canonical = "";
      if(!CheckpointPath(stem, canonical, reason))
         return(false);
      artifact.manifest_path = canonical + ".dpccstate";
      artifact.decoder_path = canonical + ".decoder.bin";
      artifact.denoiser_path = canonical + ".denoiser.bin";
      artifact.common_files = common_files;
      artifact.cursor = cursor;
      artifact.binding_sha256 = m_checkpoint_binding_sha;
      artifact.decoder_state = decoder_state;
      artifact.denoiser_state = denoiser_state;
      if(!initial)
        {
         artifact.initial_manifest_path = m_checkpoint_initial.manifest_path;
         artifact.initial_manifest_sha256 = m_checkpoint_initial.manifest_sha256;
        }
      if(FileIsExist(artifact.manifest_path, common_files ? FILE_COMMON : 0) ||
         FileIsExist(artifact.decoder_path, common_files ? FILE_COMMON : 0) ||
         FileIsExist(artifact.denoiser_path, common_files ? FILE_COMMON : 0))
        {
         reason = "checkpoint.destination_exists";
         return(false);
        }
      int validation_index = -1;
      for(int i = 0; i < ArraySize(m_records); i++)
         if(m_records[i].admission.split == "validation")
           {
            validation_index = i;
            break;
           }
      float reference_decoder[], reference_denoiser[];
      if(validation_index < 0 || !CheckpointProbe(DecoderNet(), DenoiserNet(), validation_index,
            reference_decoder, reference_denoiser,
            artifact.decoder_probe_loss, artifact.denoiser_probe_loss, reason))
        {
         m_poisoned = true;
         if(StringLen(reason) == 0)
            reason = "checkpoint.probe.validation_missing";
         return(false);
        }
      if(!DPCCCheckpointOutputSHA(reference_decoder, artifact.decoder_probe_sha256, reason) ||
         !DPCCCheckpointOutputSHA(reference_denoiser, artifact.denoiser_probe_sha256, reason))
         return(false);
      if(!CheckpointSaveNative(DecoderNet(), artifact.decoder_path, common_files, artifact.decoder_sha256, reason))
         return(false);
      if(!CheckpointSaveNative(DenoiserNet(), artifact.denoiser_path, common_files, artifact.denoiser_sha256, reason))
         return(false);
      CNet *decoder_candidate = NULL;
      CNet *denoiser_candidate = NULL;
      if(!CheckpointCandidate(true, artifact.decoder_path, common_files, decoder_updates, decoder_state,
                              decoder_candidate, reason))
         return(false);
      if(!CheckpointCandidate(false, artifact.denoiser_path, common_files, denoiser_updates, denoiser_state,
                              denoiser_candidate, reason))
        {
         delete decoder_candidate;
         return(false);
        }
      float candidate_decoder[], candidate_denoiser[];
      double decoder_loss = 0, denoiser_loss = 0;
      bool verified = CheckpointProbe(decoder_candidate, denoiser_candidate, validation_index,
                                      candidate_decoder, candidate_denoiser, decoder_loss, denoiser_loss, reason);
      if(verified)
         verified = (decoder_loss == artifact.decoder_probe_loss && denoiser_loss == artifact.denoiser_probe_loss &&
                     CheckpointSameOutputs(reference_decoder, candidate_decoder) &&
                     CheckpointSameOutputs(reference_denoiser, candidate_denoiser));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL *>(decoder_candidate.Layer(1));
      CNeuronPlanDenoiserOCL *denoiser = dynamic_cast<CNeuronPlanDenoiserOCL *>(denoiser_candidate.Layer(1));
      if(verified)
         verified = (decoder.TrainableStateFingerprint() == decoder_state && denoiser.TrainableStateFingerprint() ==
            denoiser_state &&
                     m_decoder.TrainableStateFingerprint() == decoder_state && m_denoiser.TrainableStateFingerprint() ==
                        denoiser_state);
      delete denoiser_candidate;
      delete decoder_candidate;
      if(!verified)
        {
         if(StringLen(reason) == 0)
            reason = "checkpoint.readback.native_state_or_output";
         return(false);
        }
      string actual = "";
      if(!DPCCCheckpointFileSHA(artifact.decoder_path, common_files, m_checkpoint_max_file_bytes, actual, reason) ||
         actual != artifact.decoder_sha256)
        {
         reason = "checkpoint.readback.decoder_changed";
         return(false);
        }
      if(!DPCCCheckpointFileSHA(artifact.denoiser_path, common_files, m_checkpoint_max_file_bytes, actual, reason) ||
         actual != artifact.denoiser_sha256)
        {
         reason = "checkpoint.readback.denoiser_changed";
         return(false);
        }
      const string text = DPCCCheckpointManifest(artifact);
      if(!DPCCCheckpointWriteText(artifact.manifest_path, common_files, text, reason))
         return(false);
      string expected = "";
      if(!DPCCCheckpointTextSHA(text, expected, reason) ||
         !DPCCCheckpointFileSHA(artifact.manifest_path, common_files, 65536, actual, reason) || actual != expected)
        {
         reason = "checkpoint.manifest.readback";
         return(false);
        }
      artifact.manifest_sha256 = actual;
      if(initial)
        {
         m_checkpoint_initial = artifact;
         m_decoder_initial_saved = true;
         m_denoiser_initial_saved = true;
        }
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Admits every artifact before loading any candidate native state  |
   //+------------------------------------------------------------------+
   bool              RestoreTrainingCheckpoint(const SDPCCCheckpointArtifact &artifact,
                                  SDPCCCheckpointCursor &cursor, string &reason)
     {
      ZeroMemory(cursor);
      reason = "";
      if(!m_initialized || m_poisoned || !m_checkpoint_metadata_bound || m_checkpoint_restored ||
         m_decoder.UpdateCount() != 0 || m_denoiser.UpdateCount() != 0 ||
         artifact.binding_sha256 != m_checkpoint_binding_sha || artifact.cursor.stage > 2 ||
         artifact.cursor.next_record != 0 || artifact.cursor.completed_epoch == UINT_MAX ||
         artifact.cursor.next_epoch != artifact.cursor.completed_epoch + 1 ||
         !DPCCResolverLowerSha256(artifact.manifest_sha256) || !DPCCResolverLowerSha256(artifact.decoder_sha256) ||
         !DPCCResolverLowerSha256(artifact.denoiser_sha256) ||
         !DPCCResolverLowerSha256(artifact.decoder_probe_sha256) || !DPCCResolverLowerSha256(
            artifact.denoiser_probe_sha256))
        {
         reason = "checkpoint.restore.binding_or_destination";
         return(false);
        }
      string canonical = "";
      if(!CheckpointPath(artifact.manifest_path, canonical, reason) ||
         !CheckpointPath(artifact.decoder_path, canonical, reason) ||
         !CheckpointPath(artifact.denoiser_path, canonical, reason) ||
         artifact.decoder_path == artifact.denoiser_path || artifact.decoder_path == artifact.manifest_path ||
         artifact.denoiser_path == artifact.manifest_path)
         return(false);
      string expected = "", actual = "";
      if(!DPCCCheckpointTextSHA(DPCCCheckpointManifest(artifact), expected, reason) ||
         expected != artifact.manifest_sha256 ||
         !DPCCCheckpointFileSHA(artifact.manifest_path, artifact.common_files, 65536, actual, reason) || actual !=
            expected)
        {
         reason = "checkpoint.restore.manifest";
         return(false);
        }
      if(artifact.cursor.stage == 0)
        {
         if(artifact.cursor.completed_epoch != 0 || artifact.cursor.decoder_updates != 0 ||
            artifact.cursor.denoiser_updates != 0 || StringLen(artifact.initial_manifest_path) != 0 ||
            StringLen(artifact.initial_manifest_sha256) != 0)
           {
            reason = "checkpoint.restore.initial_state";
            return(false);
           }
        }
      SDPCCCheckpointArtifact retained_initial;
      if(artifact.cursor.stage == 0)
        {
         if(!CheckpointInitialArtifacts(artifact.manifest_path, artifact.manifest_sha256, artifact.common_files,
                                        retained_initial, reason))
            return(false);
        }
      else
        {
         if(!CheckpointInitialArtifacts(artifact.initial_manifest_path, artifact.initial_manifest_sha256,
                                        artifact.common_files, retained_initial, reason))
            return(false);
        }
      if(!DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, actual,
         reason) ||
         actual != artifact.decoder_sha256)
        {
         reason = "checkpoint.restore.decoder_artifact";
         return(false);
        }
      if(!DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes, actual,
         reason) ||
         actual != artifact.denoiser_sha256)
        {
         reason = "checkpoint.restore.denoiser_artifact";
         return(false);
        }
      CNet *decoder_candidate = NULL;
      CNet *denoiser_candidate = NULL;
      if(!CheckpointCandidate(true, artifact.decoder_path, artifact.common_files, artifact.cursor.decoder_updates,
                              artifact.decoder_state, decoder_candidate, reason))
        {
         m_poisoned = true;
         return(false);
        }
      if(!CheckpointCandidate(false, artifact.denoiser_path, artifact.common_files, artifact.cursor.denoiser_updates,
                              artifact.denoiser_state, denoiser_candidate, reason))
        {
         delete decoder_candidate;
         m_poisoned = true;
         return(false);
        }
      int validation_index = -1;
      for(int i = 0; i < ArraySize(m_records); i++)
         if(m_records[i].admission.split == "validation")
           {
            validation_index = i;
            break;
           }
      float decoder_output[], denoiser_output[];
      double decoder_loss = 0, denoiser_loss = 0;
      string decoder_sha = "", denoiser_sha = "";
      bool verified = (validation_index >= 0 && CheckpointProbe(decoder_candidate, denoiser_candidate, validation_index,
                       decoder_output, denoiser_output, decoder_loss, denoiser_loss, reason));
      if(verified)
         verified = (DPCCCheckpointOutputSHA(decoder_output, decoder_sha, reason) &&
                     DPCCCheckpointOutputSHA(denoiser_output, denoiser_sha, reason) &&
                     decoder_sha == artifact.decoder_probe_sha256 && denoiser_sha == artifact.denoiser_probe_sha256 &&
                     decoder_loss == artifact.decoder_probe_loss && denoiser_loss == artifact.denoiser_probe_loss);
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL *>(decoder_candidate.Layer(1));
      CNeuronPlanDenoiserOCL *denoiser = dynamic_cast<CNeuronPlanDenoiserOCL *>(denoiser_candidate.Layer(1));
      if(verified)
         verified = (decoder.TrainableStateFingerprint() == artifact.decoder_state &&
                     denoiser.TrainableStateFingerprint() == artifact.denoiser_state);
      if(verified)
         verified = (DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes,
            actual, reason) &&
                     actual == artifact.decoder_sha256);
      if(verified)
         verified = (DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes,
            actual, reason) &&
                     actual == artifact.denoiser_sha256);
      if(verified)
         verified = (DPCCCheckpointFileSHA(artifact.manifest_path, artifact.common_files, 65536, actual, reason) &&
                     actual == artifact.manifest_sha256);
      if(verified)
        {
         SDPCCCheckpointArtifact final_initial;
         verified = CheckpointInitialArtifacts(retained_initial.manifest_path, retained_initial.manifest_sha256,
                                               artifact.common_files, final_initial, reason);
        }
      if(!verified)
        {
         delete denoiser_candidate;
         delete decoder_candidate;
         m_poisoned = true;
         if(StringLen(reason) == 0)
            reason = "checkpoint.restore.native_readback";
         return(false);
        }
      //--- Permanent original decoder retains the shared context for every borrowed tensor/net.
      m_checkpoint_decoder_net = decoder_candidate;
      m_checkpoint_denoiser_net = denoiser_candidate;
      m_decoder = decoder;
      m_denoiser = denoiser;
      m_decoder_initial_saved = true;
      m_denoiser_initial_saved = true;
      m_checkpoint_restored = true;
      m_loaded = -1;
      m_checkpoint_initial = retained_initial;
      cursor = artifact.cursor;
      return(true);
     }
   //--- C2 read-only candidate verification; never adopts either native model.
   bool              VerifyRunnerArtifact(const SDPCCCheckpointArtifact &artifact, double &decoder_loss,
      double &denoiser_loss, string &reason)
     {
      decoder_loss = 0;
      denoiser_loss = 0;
      if(!m_initialized || m_poisoned || !m_checkpoint_metadata_bound ||
         artifact.binding_sha256 != m_checkpoint_binding_sha)
        {reason = "epoch.artifact.binding"; return(false);}
      string actual = "";
      if(!DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, actual,
         reason) || actual != artifact.decoder_sha256 ||
         !DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes, actual,
            reason) || actual != artifact.denoiser_sha256)
        {reason = "epoch.artifact.native_sha"; return(false);}
      CNet *decoder = NULL, *denoiser = NULL;
      if(!CheckpointCandidate(true, artifact.decoder_path, artifact.common_files, artifact.cursor.decoder_updates,
         artifact.decoder_state, decoder, reason))
         return(false);
      if(!CheckpointCandidate(false, artifact.denoiser_path, artifact.common_files, artifact.cursor.denoiser_updates,
         artifact.denoiser_state, denoiser, reason))
        {delete decoder; return(false);}
      bool ok = true;
      uint count = 0;
      for(int i = 0; ok && i < ArraySize(m_records); i++)
         if(m_records[i].admission.split == "validation")
           {
            float dout[], nout[];
            double dl = 0, nl = 0;
            ok = CheckpointProbe(decoder, denoiser, i, dout, nout, dl, nl, reason);
            if(ok)
              {
               decoder_loss += dl;
               denoiser_loss += nl;
               count++;
              }
           }
      CNeuronScenarioDecoderOCL *d = dynamic_cast<CNeuronScenarioDecoderOCL*>(decoder.Layer(1));
      CNeuronPlanDenoiserOCL *n = dynamic_cast<CNeuronPlanDenoiserOCL*>(denoiser.Layer(1));
      ok = ok && count > 0 && MathIsValidNumber(decoder_loss) && MathIsValidNumber(denoiser_loss) &&
           d.TrainableStateFingerprint() == artifact.decoder_state && n.TrainableStateFingerprint() ==
              artifact.denoiser_state &&
           d.UpdateCount() == artifact.cursor.decoder_updates && n.UpdateCount() == artifact.cursor.denoiser_updates;
      delete denoiser;
      delete decoder;
      if(!ok)
        {
         if(StringLen(reason) == 0)
            reason = "epoch.artifact.validation";
         return(false);
        }
      if(!DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, actual,
         reason) || actual != artifact.decoder_sha256 ||
         !DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes, actual,
            reason) || actual != artifact.denoiser_sha256 ||
         !DPCCCheckpointFileSHA(artifact.manifest_path, artifact.common_files, 65536, actual, reason) || actual !=
            artifact.manifest_sha256)
        {reason = "epoch.artifact.changed_after_probe"; return(false);}
      decoder_loss /= count;
      denoiser_loss /= count;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Opens one frozen selected decoder for admitted causal rows       |
   //+------------------------------------------------------------------+
   bool              BeginSelectedDecoderInference(const SDPCCCheckpointArtifact &artifact, string &reason)
     {
      reason = "";
      if(!m_initialized || m_poisoned || !m_checkpoint_metadata_bound ||
         artifact.binding_sha256 != m_checkpoint_binding_sha || artifact.cursor.stage != 1)
         return(DecoderInferenceFailure("decoder.infer.admission", reason));
      if(m_inference_decoder_net != NULL || m_inference_input != NULL)
         return(DecoderInferenceFailure("decoder.infer.session_already_open", reason));
      if(!DecoderInferenceArtifact(artifact, reason))
        {
         CloseDecoderInference();
         return(false);
        }
      SDPCCCheckpointArtifact actual;
      if(!DPCCReadCheckpointArtifact(artifact.manifest_path, artifact.common_files,
                                     artifact.manifest_sha256, actual, reason) ||
         DPCCCheckpointManifest(actual) != DPCCCheckpointManifest(artifact))
         return(DecoderInferenceFailure("decoder.infer.manifest_binding", reason));
      if(!CheckpointCandidate(true, artifact.decoder_path, artifact.common_files, artifact.cursor.decoder_updates,
                              artifact.decoder_state, m_inference_decoder_net, reason))
        {
         CloseDecoderInference();
         return(false);
        }
      if(!m_inference_decoder_net.TrainMode(false))
         return(DecoderInferenceFailure("decoder.infer.frozen_mode", reason));
      if(!m_inference_decoder_net.SetWeightsUpdate(false))
         return(DecoderInferenceFailure("decoder.infer.freeze_weights", reason));
      m_inference_input = new CBufferFloat;
      if(m_inference_input == NULL)
         return(DecoderInferenceFailure("decoder.infer.input_capacity", reason));
      if(!Allocate(m_inference_input, (uint)m_c.lengths[0]))
         return(DecoderInferenceFailure("decoder.infer.input_allocate", reason));
      m_inference_artifact = artifact;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Copies one frozen decoder output without targets or denoiser     |
   //+------------------------------------------------------------------+
   bool              InferSelectedDecoderRow(const int index, SDPCCDecoderInferenceObservation &out, string &reason)
     {
      out.record_index = -1;
      out.window_id = "";
      out.selected_manifest_sha = "";
      out.decision_time = 0;
      ArrayResize(out.normalized, 0);
      reason = "";
      if(!m_initialized || m_poisoned || m_inference_decoder_net == NULL || m_inference_input == NULL ||
         index < 0 || index >= ArraySize(m_records))
         return(DecoderInferenceFailure("decoder.infer.row_admission", reason));
      if(m_records[index].admission.split != "fit")
         return(DecoderInferenceFailure("decoder.infer.fit_row_required", reason));
      CNeuronScenarioDecoderOCL *layer =
         dynamic_cast<CNeuronScenarioDecoderOCL*>(m_inference_decoder_net.Layer(1));
      if(layer == NULL || layer.ContractSignature() != m_decoder_contract ||
         layer.TrainableStateFingerprint() != m_inference_artifact.decoder_state ||
         layer.UpdateCount() != m_inference_artifact.cursor.decoder_updates || layer.GenerationPhase() != 0)
         return(DecoderInferenceFailure("decoder.infer.state_before", reason));
      //--- Upload only the causal section into the persistent session buffer.
      float causal_values[];
      if(!DPCCPackDecoderInput(m_config.shape, m_records[index].context_without_noise, causal_values, reason))
        {
         CloseDecoderInference();
         return(false);
        }
      if(!Upload(m_inference_input, causal_values))
         return(DecoderInferenceFailure("decoder.infer.input_upload", reason));
      if(!m_inference_decoder_net.feedForward(m_inference_input, 1, false, (CBufferFloat*)NULL))
         return(DecoderInferenceFailure("decoder.infer.forward", reason));
      SDPCCDecoderInferenceObservation observed;
      const int count = (int)(m_config.shape.K * m_config.shape.H * 4);
      if(layer.getOutputVal(observed.normalized) != count)
         return(DecoderInferenceFailure("decoder.infer.output", reason));
      for(int i = 0; i < ArraySize(observed.normalized); i++)
         if(!MathIsValidNumber((double)observed.normalized[i]))
            return(DecoderInferenceFailure("decoder.infer.output_nonfinite", reason));
      if(layer.ContractSignature() != m_decoder_contract ||
         layer.TrainableStateFingerprint() != m_inference_artifact.decoder_state ||
         layer.UpdateCount() != m_inference_artifact.cursor.decoder_updates || layer.GenerationPhase() != 0)
         return(DecoderInferenceFailure("decoder.infer.state_after", reason));
      //--- Return an owned copy before the next row replaces the native output.
      observed.record_index = index;
      observed.window_id = m_records[index].window_id;
      observed.selected_manifest_sha = m_inference_artifact.manifest_sha256;
      observed.decision_time = m_records[index].admission.decision_time;
      out = observed;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Verifies artifacts and releases the frozen inference session     |
   //+------------------------------------------------------------------+
   bool              EndSelectedDecoderInference(string &reason)
     {
      reason = "";
      if(m_inference_decoder_net == NULL || m_inference_input == NULL)
         return(DecoderInferenceFailure("decoder.infer.session_not_open", reason));
      const bool ok = DecoderInferenceArtifact(m_inference_artifact, reason);
      CloseDecoderInference();
      return(ok);
     }
   bool              ObserveSelectedDecoder(const SDPCCCheckpointArtifact &artifact, const int index,
                               SDPCCDecoderValidationObservation &out, string &reason)
     {
      out.record_index = -1;
      out.window_id = "";
      out.selected_manifest_sha = "";
      out.normalized_loss = 0;
      ArrayResize(out.normalized, 0);
      ArrayResize(out.native_ohlc, 0);
      ArrayResize(out.causal_price_norm, 0);
      if(!m_initialized || m_poisoned || !m_checkpoint_metadata_bound || artifact.binding_sha256 !=
         m_checkpoint_binding_sha ||
         artifact.cursor.stage != 1 || index < 0 || index >= ArraySize(m_records) || m_records[index].admission.split !=
            "validation")
        {reason = "decoder.observe.admission"; return(false);}
      string sha = "";
      if(!DPCCCheckpointFileSHA(artifact.manifest_path, artifact.common_files, 65536, sha, reason) || sha !=
         artifact.manifest_sha256 ||
         !DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.decoder_sha256 ||
         !DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.denoiser_sha256)
         return(false);
      CNet *decoder = NULL, *denoiser = NULL;
      if(!CheckpointCandidate(true, artifact.decoder_path, artifact.common_files, artifact.cursor.decoder_updates,
         artifact.decoder_state, decoder, reason))
         return(false);
      if(!CheckpointCandidate(false, artifact.denoiser_path, artifact.common_files, artifact.cursor.denoiser_updates,
         artifact.denoiser_state, denoiser, reason))
        {delete decoder; return(false);}
      SDPCCDecoderValidationObservation observed;
      const bool ok = ObserveDecoderCandidate(decoder, denoiser, artifact, index, observed, reason);
      delete denoiser;
      delete decoder;
      if(!ok)
         return(false);
      if(!DPCCCheckpointFileSHA(artifact.manifest_path, artifact.common_files, 65536, sha, reason) || sha !=
         artifact.manifest_sha256 ||
         !DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.decoder_sha256 ||
         !DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.denoiser_sha256)
        {reason = "decoder.observe.artifact_changed"; return(false);}
      out = observed;
      return(true);
     }
   bool              StreamSelectedDecoder(const SDPCCCheckpointArtifact &artifact, const int &indices[],
      const string path,
                              const ulong output_budget, double &mean, uint &records, ulong &written,
                                 string &output_sha, string &reason)
     {
      mean = 0;
      records = 0;
      written = 0;
      output_sha = "";
      reason = "";
      m_decoder_stream_native_loads = 0;
      if(!m_initialized || m_poisoned || !m_checkpoint_metadata_bound || artifact.binding_sha256 !=
         m_checkpoint_binding_sha ||
         artifact.cursor.stage != 1 || output_budget == 0)
        {
         reason = "decoder.stream.admission";
         return(false);
        }
      int expected = 0;
      for(int i = 0; i < ArraySize(m_records); i++)
         if(m_records[i].admission.split == "validation")
            expected++;
      if(expected <= 0 || ArraySize(indices) != expected)
        {
         reason = "decoder.stream.complete_validation_required";
         return(false);
        }
      bool seen[];
      if(ArrayResize(seen, ArraySize(m_records)) != ArraySize(m_records))
        {
         reason = "decoder.stream.seen_capacity";
         return(false);
        }
      ArrayInitialize(seen, false);
      for(int i = 0; i < expected; i++)
        {
         if(indices[i] < 0 || indices[i] >= ArraySize(m_records) || m_records[indices[i]].admission.split !=
            "validation")
           {reason = "decoder.stream.record"; return(false);}
         if(seen[indices[i]])
           {
            reason = "decoder.stream.duplicate";
            return(false);
           }
         seen[indices[i]] = true;
        }
      string canonical = "", sha = "";
      SDPCCCheckpointArtifact actual;
      if(!DPCCCheckpointCanonicalPath(path, canonical, reason) || FileIsExist(canonical, artifact.common_files ?
         FILE_COMMON : 0) ||
         !DPCCReadCheckpointArtifact(artifact.manifest_path, artifact.common_files, artifact.manifest_sha256, actual,
            reason) ||
         DPCCCheckpointManifest(actual) != DPCCCheckpointManifest(artifact) ||
         !DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.decoder_sha256 ||
         !DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.denoiser_sha256)
         return(false);
      CNet *decoder = NULL, *denoiser = NULL;
      if(!CheckpointCandidate(true, artifact.decoder_path, artifact.common_files, artifact.cursor.decoder_updates,
         artifact.decoder_state, decoder, reason))
         return(false);
      m_decoder_stream_native_loads++;
      if(!CheckpointCandidate(false, artifact.denoiser_path, artifact.common_files, artifact.cursor.denoiser_updates,
         artifact.denoiser_state, denoiser, reason))
        {delete decoder; return(false);}
      m_decoder_stream_native_loads++;
      const int handle = FileOpen(canonical, FILE_WRITE | FILE_BIN | (artifact.common_files ? FILE_COMMON : 0));
      if(handle == INVALID_HANDLE)
        {
         delete denoiser;
         delete decoder;
         reason = "decoder.stream.open";
         return(false);
        }
      bool ok = WriteDecoderObservation(handle, "DPCC_DECODER_NATIVE_OBSERVATIONS_V1\n" + artifact.manifest_path +
         "\n" +
                                        artifact.manifest_sha256 + "\n" + (string)expected +
                                           "\nUNPUBLISHED_UNTIL_STAGE_RESULT_SHA\n", output_budget, written, reason);
      double sum = 0;
      for(int ordinal = 0; ok && ordinal < expected; ordinal++)
        {
         if(IsStopped())
           {
            reason = "decoder.stream.cancelled";
            ok = false;
            break;
           }
         SDPCCDecoderValidationObservation observation;
         ok = ObserveDecoderCandidate(decoder, denoiser, artifact, indices[ordinal], observation, reason);
         if(!ok)
            break;
         sum += observation.normalized_loss;
         ok = MathIsValidNumber(sum) && WriteDecoderObservation(handle, (string)observation.record_index + "\n" +
            observation.window_id + "\n" +
               StringFormat("%.17g\n", observation.normalized_loss) + (string)ArraySize(observation.normalized) + "\n",
               output_budget, written, reason);
         for(int i = 0; ok && i < ArraySize(observation.normalized); i++)
            ok = WriteDecoderObservation(handle, StringFormat("%.9g\n", observation.normalized[i]), output_budget,
               written, reason);
         for(int i = 0; ok && i < ArraySize(observation.native_ohlc); i++)
            ok = WriteDecoderObservation(handle, StringFormat("%.9g\n", observation.native_ohlc[i]), output_budget,
               written, reason);
         for(int i = 0; ok && i < ArraySize(observation.causal_price_norm); i++)
            ok = WriteDecoderObservation(handle, StringFormat("%.9g\n", observation.causal_price_norm[i]),
               output_budget, written, reason);
         if(ok)
            records++;
        }
      if(ok)
         ok = WriteDecoderObservation(handle, "END_DPCC_DECODER_NATIVE_OBSERVATIONS_V1\n", output_budget, written,
            reason);
      ResetLastError();
      FileFlush(handle);
      const int flush_error = GetLastError();
      FileClose(handle);
      delete denoiser;
      delete decoder;
      if(!ok || flush_error != 0)
        {
         if(StringLen(reason) == 0)
            reason = "decoder.stream.native_or_flush";
         return(false);
        }
      if(!DPCCCheckpointFileSHA(artifact.manifest_path, artifact.common_files, 65536, sha, reason) || sha !=
         artifact.manifest_sha256 ||
         !DPCCCheckpointFileSHA(artifact.decoder_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.decoder_sha256 ||
         !DPCCCheckpointFileSHA(artifact.denoiser_path, artifact.common_files, m_checkpoint_max_file_bytes, sha,
            reason) || sha != artifact.denoiser_sha256 ||
         !DPCCCheckpointFileSHA(canonical, artifact.common_files, output_budget, output_sha, reason))
        {reason = "decoder.stream.changed_or_output_hash"; return(false);}
      mean = sum / (double)expected;
      return(MathIsValidNumber(mean) && records == (uint)expected);
     }
   uint              DecoderValidationNativeLoads(void)const {return(m_decoder_stream_native_loads);}
   bool              RestoreTrainingCheckpointFile(const string path, const bool common_files,
      const string expected_sha,
                                      SDPCCCheckpointCursor &cursor, string &reason)
     {
      SDPCCCheckpointArtifact artifact;
      if(!DPCCReadCheckpointArtifact(path, common_files, expected_sha, artifact, reason))
        {
         ZeroMemory(cursor);
         return(false);
        }
      return(RestoreTrainingCheckpoint(artifact, cursor, reason));
     }

   bool              DecoderExample(const int record_index, const ENUM_DPCC_TRAIN_OPERATION operation,
                       SDPCCTrainingExampleResult &result)
     {
      if(!Begin(record_index, operation, result))
         return(false);
      const bool gradients = operation != DPCC_TRAIN_VALIDATE, update = operation == DPCC_TRAIN_UPDATE;
      if(update && !m_decoder_initial_saved)
         return(Fail(result, "checkpoint", "training.initial_decoder_checkpoint_required"));
      if(update && m_decoder.UpdateCount() == 0)
        {
         string checkpoint_reason = "";
         if(!CheckpointFirstUpdateGate(checkpoint_reason))
            return(Fail(result, "checkpoint", checkpoint_reason));
        }
      result.updates_before = m_decoder.UpdateCount();
      result.updates_after = result.updates_before;
      if(!DecoderNet().TrainMode(gradients))
         return(Fail(result, "mode", "training.decoder_mode"));
      DecoderNet().SetWeightsUpdate(update);
      if(!DecoderNet().feedForward(GetPointer(m_z), 1, false, (CBufferFloat*)NULL))
         return(Fail(result, "forward", "training.decoder_forward"));
      if(!m_decoder.BuildNativeBankRhoLoss(GetPointer(m_target), GetPointer(m_norm), GetPointer(m_rho),
                                           m_config.probability_tolerance, gradients, result.loss))
        {
         if(gradients && !m_decoder.CancelGeneration())
            m_poisoned = true;
         return(Fail(result, "loss", "training.decoder_native_rho_loss"));
        }
      if(gradients)
        {
         result.update_attempted = update;
         if(!DecoderNet().backPropGradient((CBufferFloat*)NULL, (CBufferFloat*)NULL, 1, false))
           {m_poisoned = true; result.updates_after = m_decoder.UpdateCount(); return(Fail(result, "backward",
              "training.decoder_backward_or_update"));}
        }
      result.updates_after = m_decoder.UpdateCount();
      result.completed = true;
      result.stage = "complete";
      return(true);
     }

   bool              DenoiserExample(const int record_index, const ENUM_DPCC_TRAIN_OPERATION operation,
                        const SDPCCTrainingExampleKeys &keys, SDPCCTrainingExampleResult &result)
     {
      ZeroMemory(result);
      if(!m_initialized || m_poisoned || record_index < 0 || record_index >= ArraySize(m_records))
         return(Fail(result, "admission", "training.instance_or_record"));
      result.window_id = m_records[record_index].window_id;
      result.source_id = m_records[record_index].source_id;
      result.split = m_records[record_index].admission.split;
      result.decision_time = m_records[record_index].admission.decision_time;
      result.bank_sha256 = m_integrity.bank_sha256;
      result.header_sha256 = m_integrity.header_sha256;
      result.j = keys.j;
      result.repeat = keys.repeat;
      result.seed = keys.seed;
      const SDPCCTrainingFrozenRecordKeys fixed = m_record_keys[record_index];
      if(keys.decision_identity != fixed.decision_identity || keys.context_identity != fixed.context_identity ||
         keys.owner_identity != fixed.owner_identity ||
         (operation == DPCC_TRAIN_VALIDATE && keys.j != fixed.validation_j))
         return(Fail(result, "keys", "training.frozen_record_keys"));
      if(keys.decision_time != result.decision_time || keys.j == 0 || keys.j > m_config.shape.J ||
         keys.decision_identity == 0 || keys.context_identity == 0 || keys.owner_identity == 0 ||
         keys.seed != (operation == DPCC_TRAIN_VALIDATE ? m_validation_seed : m_training_seed) ||
         (operation == DPCC_TRAIN_VALIDATE && keys.repeat != m_validation_repeat))
         return(Fail(result, "keys", "training.explicit_keys"));
      if(!Begin(record_index, operation, result))
         return(false);
      result.j = keys.j;
      result.repeat = keys.repeat;
      result.seed = keys.seed;
      float indexed[], epsilon[];
      if(!DPCCBuildIndexedNoiseV1(keys.seed, keys.decision_time, keys.repeat, 1, m_config.shape.J, m_config.shape.H,
         indexed) ||
         ArrayResize(epsilon, m_config.shape.H * 6) != (int)(m_config.shape.H * 6))
         return(Fail(result, "noise", "training.indexed_noise"));
      //--- Raw slice only; the canonical helper defines all noise arithmetic.
      for(uint i = 0; i < m_config.shape.H * 6; i++)
         epsilon[i] = indexed[keys.j * m_config.shape.H * 6 + i];
      if(!Upload(m_epsilon, epsilon))
         return(Fail(result, "noise", "training.noise_upload"));
      const bool gradients = operation != DPCC_TRAIN_VALIDATE, update = operation == DPCC_TRAIN_UPDATE;
      if(update && !m_denoiser_initial_saved)
         return(Fail(result, "checkpoint", "training.initial_denoiser_checkpoint_required"));
      if(update && m_denoiser.UpdateCount() == 0)
        {
         string checkpoint_reason = "";
         if(!CheckpointFirstUpdateGate(checkpoint_reason))
            return(Fail(result, "checkpoint", checkpoint_reason));
        }
      result.updates_before = m_denoiser.UpdateCount();
      result.updates_after = result.updates_before;
      if(!DenoiserNet().TrainMode(gradients))
         return(Fail(result, "mode", "training.denoiser_mode"));
      DenoiserNet().SetWeightsUpdate(update);
      if(!m_denoiser.PrepareTrainingExample(GetPointer(m_actions), GetPointer(m_epsilon), GetPointer(m_context),
         GetPointer(m_account),
                                            keys.j, m_alpha[keys.j], GetPointer(m_noisy), GetPointer(m_condition)))
         return(Fail(result, "prepare", "training.native_example_prepare"));
      if(!m_denoiser.SetContextIdentity(keys.decision_identity, keys.context_identity, keys.owner_identity) ||
         !DenoiserNet().feedForward(GetPointer(m_noisy), 1, false, GetPointer(m_condition)))
         return(Fail(result, "forward", "training.denoiser_forward"));
      if(!m_denoiser.BuildEpsilonMSELoss(GetPointer(m_epsilon), gradients, result.loss))
        {
         if(gradients && !m_denoiser.CancelGeneration())
            m_poisoned = true;
         return(Fail(result, "loss", "training.epsilon_mse"));
        }
      if(gradients)
        {
         result.update_attempted = update;
         if(!DenoiserNet().backPropGradient(GetPointer(m_condition), (CBufferFloat*)NULL, 1, false))
           {m_poisoned = true; result.updates_after = m_denoiser.UpdateCount(); return(Fail(result, "backward",
              "training.denoiser_backward_or_update"));}
        }
      result.updates_after = m_denoiser.UpdateCount();
      result.completed = true;
      result.stage = "complete";
      return(true);
     }
  };
#endif

struct SDPCCTrainingRoleConfig
  {
   long              max_epochs, validation_every_epochs, patience;
   double            min_delta;
   string            training_seed, validation_seed, loss;
  };
struct SDPCCTrainingConfigAdmission
  {
   bool              example_only;
   string            training_id, dataset_id, bank_id, normalization_id, source_sha256, dataset_sha256, model_sha256,
      bank_manifest_sha256, time_index_sha256, normalization_section_sha256;
   SDPCCDatasetTimeIndex time_index;
   SDPCCBankMetadataResult bank_receipt;
   SDPCCTrainingModelBinding model_binding;
   SDPCCArchitectureContract architecture;
   SDPCCTrainingRoleConfig decoder, denoiser;
  };
struct SDPCCTrainingPlanEntry
  {
   uint              epoch, ordinal, j, repeat;
   int               record_index;
   string            window_id;
  };
//--- Exact native optimizer admission independently of caller JSON schema.
bool DPCCRunOptimizer(CDPCCJsonDocument &d, const int role, string &reason)
  {
   const int o = d.FindMember(role, "optimizer");
   string names[] = {"name", "profile", "bias_correction", "gradient_convention", "clip_location",
      "zero_variance_update"};
   string expected[] = {"ADAM", "NN_NATIVE_CONV_ADAM_C6A8_V1", "HOST_LT_FROM_T", "NEGATIVE_DERIVATIVE",
      "PER_WEIGHT_AFTER_TOKEN_SUM", "ZERO_DELTA"};
   for(int i = 0; i < ArraySize(names); i++)
     {string v; if(!DPCCResourceReadString(d, o, names[i], v, reason, "training.optimizer") || v !=
        expected[i]) {reason = "training.optimizer." + names[i]; return(false);}}
   string numeric[] = {"learning_rate", "beta1", "beta2", "epsilon", "weight_decay", "gradient_clip"};
   double values[] = {0.0003, 0.9, 0.999, 0, 0, 0.01};
   for(int i = 0; i < ArraySize(numeric); i++)
     {double v; if(!DPCCResourceReadDouble(d, o, numeric[i], v, reason, "training.optimizer") || v !=
        values[i]) {reason = "training.optimizer." + numeric[i]; return(false);}}
   long step;
   if(!DPCCResourceReadLong(d, o, "initial_step", step, reason, "training.optimizer.initial_step") || step != 1)
      return(false);
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCRunRole                                             |
//+------------------------------------------------------------------+
bool DPCCRunRole(CDPCCJsonDocument &d, const int root, const string role, const string loss,
                 SDPCCTrainingRoleConfig &c, string &reason)
  {
   int n = d.FindMember(root, role);
   long batch;
   if(!DPCCRunOptimizer(d, n, reason) ||
      !DPCCResourceReadLong(d, n, "max_epochs", c.max_epochs, reason, role) ||
      !DPCCResourceReadLong(d, n, "validation_every_epochs", c.validation_every_epochs, reason, role) ||
      !DPCCResourceReadLong(d, n, "patience", c.patience, reason, role) ||
      !DPCCResourceReadLong(d, n, "batch_examples", batch, reason, role) ||
      !DPCCResourceReadDouble(d, n, "min_delta", c.min_delta, reason, role) ||
      !DPCCResourceReadString(d, n, "training_seed", c.training_seed, reason, role) ||
      !DPCCResourceReadString(d, n, "validation_seed", c.validation_seed, reason, role) ||
      !DPCCResourceReadString(d, n, "loss", c.loss, reason, role))
      return(false);
   if(batch != 1 || c.max_epochs < 1 || c.validation_every_epochs < 1 || c.patience < 1 ||
      c.validation_every_epochs > c.max_epochs || c.min_delta < 0 || !MathIsValidNumber(c.min_delta) || c.loss != loss)
     {reason = "training.role_config"; return(false);}
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCRunNormalizationSection                             |
//+------------------------------------------------------------------+
bool DPCCRunNormalizationSection(CDPCCJsonDocument &d, const SDPCCTrainingModelBinding &binding,
                                 const SDPCCDatasetManifest &dataset, string &digest, string &reason)
  {
   int n = d.FindMember(d.Root(), "normalization");
   string wire = "DPCC_MODEL_NORMALIZATION_V1\n";
   string names[] = {"id", "mode", "statistics_source", "inverse_implementation", "loss_coordinates",
      "account_feature_contract", "account_builder_sha256"};
   for(int i = 0; i < ArraySize(names); i++)
     {
      string v;
      if(!DPCCResourceReadString(d, n, names[i], v, reason, "normalization"))
         return(false);
      if(i == 0 && v != dataset.normalization_id)
        {
         reason = "training.model_normalization_id";
         return(false);
        }
      wire += (string)StringLen(v) + ":" + v + "\n";
     }
   string channels[] = {"Open", "High", "Low", "Close"};
   int a = d.FindMember(n, "channels");
   if(d.ChildCount(a) != 4)
     {
      reason = "training.normalization_channels";
      return(false);
     }
   for(int i = 0; i < 4; i++)
      if(d.Type(d.ChildAt(a, i)) != DPCC_JSON_STRING || d.Text(d.ChildAt(a, i)) != channels[i])
        {reason = "training.normalization_channels"; return(false);}
   wire += "OHLC_GAIN1_BIAS0\n";
   SDPCCDatasetInterval fit;
   if(!DPCCDatasetDecodeInterval(d, d.FindMember(n, "fit_interval"), fit, reason, "model.normalization.fit_interval"))
      return(false);
   if(fit.start_utc != dataset.normalization_fit.start_utc || fit.end_utc != dataset.normalization_fit.end_utc ||
      fit.bar_start != dataset.normalization_fit.bar_start || fit.bar_end != dataset.normalization_fit.bar_end)
     {reason = "training.normalization_fit_interval"; return(false);}
   wire += (string)fit.start_utc + ":" + (string)fit.end_utc + ":" + (string)fit.bar_start + ":" + (string)fit.bar_end +
      "\n";
   for(int i = 0; i < 6; i++)
      wire += StringFormat("%.17g:%.17g\n", (double)binding.action_bias[i], (double)binding.action_scale[i]);
   return(DPCCBankSourceHash(wire, digest, reason, "normalization.section"));
  }
//+------------------------------------------------------------------+
//| Function DPCCRunSameInterval                                     |
//+------------------------------------------------------------------+
bool DPCCRunSameInterval(const SDPCCDatasetInterval &left, const SDPCCDatasetInterval &right)
  {
   return(left.start_utc == right.start_utc && left.end_utc == right.end_utc &&
          left.bar_start == right.bar_start && left.bar_end == right.bar_end);
  }
//--- The staged source is already the owner’s exact data contract. IDs and hashes
//--- authenticate artifacts; this check also refuses a semantically different
//--- decoded DatasetManifest that reuses those identities.
bool DPCCRunSameDatasetContract(const SDPCCDatasetManifest &actual, const SDPCCDatasetManifest &source, string &reason)
  {
   if(actual.dataset_id != source.dataset_id || actual.normalization_id != source.normalization_id ||
      actual.embargo_bars != source.embargo_bars || actual.time_index.id != source.time_index.id ||
      actual.time_index.sha256 != source.time_index.sha256 ||
      !DPCCRunSameInterval(actual.fit, source.fit) || !DPCCRunSameInterval(actual.validation, source.validation) ||
      !DPCCRunSameInterval(actual.test, source.test) || !DPCCRunSameInterval(actual.normalization_fit,
         source.normalization_fit))
     {reason = "training.actual_dataset_contract"; return(false);}
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCRunContainingArtifact                               |
//+------------------------------------------------------------------+
bool DPCCRunContainingArtifact(const string package_root, const string canonical_path, string &relative, string &reason)
  {
   string prepared;
   string segments[];
   if(!DPCCResolverPreparePath(package_root, prepared, reason, "run.package_root") ||
      !DPCCResolverAppendSegments(prepared, segments, 0, reason, "run.package_root"))
      return(false);
   const string prefix = DPCCResolverJoinSegments(segments) + "/";
   if(StringFind(canonical_path, prefix) != 0)
     {
      reason = "run.artifact_outside_package";
      return(false);
     }
   relative = StringSubstr(canonical_path, StringLen(prefix));
   return(relative != "");
  }
//--- Whole JSON schema admission plus source hash; component copies compare actual JSON objects.
//--- linked_model must already be resolved/admitted by the factory's model metadata path.
bool DPCCDecodeTrainingConfigDocuments(CDPCCJsonDocument &d, CDPCCJsonDocument &m, const string source,
                                       const SDPCCTrainingBankSource &bank, SDPCCTrainingConfigAdmission &result,
                                          string &reason)
  {
   ZeroMemory(result);
   const int root = d.Root(), mr = m.Root();
   SDPCCTrainingConfigAdmission c;
   if(!DPCCResourceReadBool(d, root, "example_only", c.example_only, reason, "training") ||
      !DPCCResourceReadString(d, root, "training_id", c.training_id, reason, "training") ||
      !DPCCResourceReadString(d, root, "dataset_id", c.dataset_id, reason, "training") ||
      !DPCCResourceReadString(d, root, "bank_id", c.bank_id, reason, "training") ||
      !DPCCResourceReadString(d, root, "normalization_id", c.normalization_id, reason, "training") ||
      !DPCCRunRole(d, root, "decoder", "RHO_WEIGHTED_NORMALIZED_MSE", c.decoder, reason) ||
      !DPCCRunRole(d, root, "denoiser", "EPSILON_MSE", c.denoiser, reason))
      return(false);
   if(c.dataset_id != bank.dataset.dataset_id || c.normalization_id != bank.dataset.normalization_id || c.bank_id !=
      bank.bank.bank_id)
     {reason = "training.dataset_binding"; return(false);}
   int graph = m.FindMember(m.FindMember(mr, "composition"), "denoiser");
   string graph_sha;
   if(!DPCCResourceReadString(m, graph, "graph_sha256", graph_sha, reason, "training.graph") ||
      !DPCCDecodeArchitectureContract(m, mr, d, root, graph_sha, c.architecture, reason))
      return(false);
   if(!DPCCBankSourceHash(source, c.source_sha256, reason, "training"))
      return(false);
   c.dataset_sha256 = bank.links.dataset_sha256;
   result = c;
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCDecodeTrainingConfigFields                          |
//+------------------------------------------------------------------+
bool DPCCDecodeTrainingConfigFields(const string source, const string schema, const string linked_model,
                                    const SDPCCTrainingBankSource &bank, SDPCCTrainingConfigAdmission &result,
                                       string &reason)
  {
   string digest;
   CDPCCJsonDocument d, m;
   if(!DPCCBankSourceHash(schema, digest, reason, "training.schema") ||
      digest != "7c630093d92684a80dede93bd51c0fa339521d8586660b019e4107703a338a2a")
     {reason = "training.schema_sha256"; return(false);}
   if(!DPCCCentralSchemaValidate(d, source, schema, reason, "training") || !m.Parse(linked_model, reason))
      return(false);
   return(DPCCDecodeTrainingConfigDocuments(d, m, source, bank, result, reason));
  }
enum ENUM_DPCC_TRAIN_ROLE { DPCC_ROLE_DECODER = 0, DPCC_ROLE_DENOISER = 1 };
//+------------------------------------------------------------------+
//| Declaration CDPCCAdmittedTrainingConfig                          |
//+------------------------------------------------------------------+
class CDPCCAdmittedTrainingConfig
  {
private:
   bool              m_admitted;
   SDPCCTrainingConfigAdmission m_config;
   string            m_model_source;
public:
                     CDPCCAdmittedTrainingConfig(void) {m_admitted = false;}
   bool              Admit(const string package_root, const string containing_json,
              const SDPCCResourceReference &training_reference, const SDPCCResourceReference &model_reference,
              const bool common_files, const string schema, const string model_schema, const string bank_schema,
                 const string dataset_schema, const string time_index_schema, const SDPCCTrainingBankSource &bank,
                 string &reason)
     {
      if(m_admitted) {reason = "training.config_already_admitted"; return(false);
        }
      SDPCCArtifactResolveResult t, m;
      if(!DPCCResolveArtifact(package_root, containing_json, training_reference, common_files,
         DPCC_RESOLVER_MAX_JSON_BYTES, t, reason) ||
         !DPCCResolveArtifact(package_root, containing_json, model_reference, common_files,
            DPCC_RESOLVER_MAX_JSON_BYTES, m, reason))
         return(false);
      string ts = CharArrayToString(t.bytes, 0, ArraySize(t.bytes), CP_UTF8), ms = CharArrayToString(m.bytes, 0,
         ArraySize(m.bytes), CP_UTF8);
      string schema_digest;
      if(!DPCCBankSourceHash(model_schema, schema_digest, reason, "model.schema") ||
         schema_digest != "10498a359f69fb249441f3bdbe6c3f52f0823a6b854205e42d2da6b9ae482248")
        {reason = "training.model_schema_sha256"; return(false);}
      CDPCCJsonDocument model_document;
      SDPCCCentralModel model_typed;
      if(!DPCCCentralSchemaValidate(model_document, ms, model_schema, reason, "model") ||
         !DPCCDecodeCentralModel(model_document, model_typed, reason) ||
         !DPCCDatasetShapeEqual(bank.dataset.shapes, model_typed.shapes, reason))
         return(false);
      string training_schema_hash;
      CDPCCJsonDocument training_document;
      if(!DPCCBankSourceHash(schema, training_schema_hash, reason, "training.schema") ||
         training_schema_hash != "7c630093d92684a80dede93bd51c0fa339521d8586660b019e4107703a338a2a")
        {reason = "training.schema_sha256"; return(false);}
      if(!DPCCCentralSchemaValidate(training_document, ts, schema, reason, "training"))
         return(false);
      if(model_typed.type_ids.decoder != defNeuronScenarioDecoderOCL || model_typed.type_ids.rollout !=
         defNeuronScenarioRolloutOCL ||
         model_typed.type_ids.projection != defNeuronPlanProjectionOCL || model_typed.type_ids.denoiser !=
            defNeuronPlanDenoiserOCL ||
         model_typed.type_ids.dpcc != defNeuronDPCCOCL)
        {
         reason = "training.native_type_ids";
         return(false);
        }
      SDPCCTrainingConfigAdmission value;
      if(!DPCCDecodeTrainingConfigDocuments(training_document, model_document, ts, bank, value, reason))
         return(false);
      if(value.source_sha256 != t.observed_sha256 ||
         value.training_id != training_reference.id)
        {
         reason = "training.resolved_identity";
         return(false);
        }
      string model_id;
      if(!DPCCResourceReadString(model_document, model_document.Root(), "model_id", model_id, reason,
         "training.model_id") || model_id != model_reference.id)
        {reason = "training.model_id"; return(false);}
      SDPCCResourceReference linked_training;
      if(!DPCCBankReadReference(model_document, model_document.FindMember(model_document.Root(), "training"),
         "training_config", linked_training, reason, "model.training_config"))
         return(false);
      if(linked_training.id != training_reference.id || linked_training.sha256 != t.observed_sha256)
        {reason = "training.model_training_link"; return(false);}
      SDPCCResourceReference linked_dataset, linked_bank;
      const int training_node = model_document.FindMember(model_document.Root(), "training");
      if(!DPCCBankReadReference(model_document, training_node, "dataset_manifest", linked_dataset, reason,
         "model.training.dataset_manifest") ||
         !DPCCBankReadReference(model_document, training_node, "bank_manifest", linked_bank, reason,
            "model.training.bank_manifest"))
         return(false);
      if(linked_dataset.id != bank.dataset.dataset_id || linked_dataset.sha256 != bank.links.dataset_sha256 ||
         linked_bank.id != bank.bank.bank_id)
        {reason = "training.model_data_link"; return(false);}
      string bank_schema_hash, dataset_schema_hash;
      if(!DPCCBankSourceHash(bank_schema, bank_schema_hash, reason, "bank.schema") ||
         bank_schema_hash != "13780a0801286e89c276e20fe892bfcc08ee5fc38aac710c0c044b698ce9cb06" ||
         !DPCCBankSourceHash(dataset_schema, dataset_schema_hash, reason, "dataset.schema") ||
         dataset_schema_hash != "a52ba580e67dbf507622c85fe336b45d9f54286c8d18a0839f99bdccf812417c")
        {reason = "training.linked_schema_sha256"; return(false);}
      string model_containing;
      if(!DPCCRunContainingArtifact(package_root, m.canonical_path, model_containing, reason))
         return(false);
      SDPCCArtifactResolveResult actual_training, actual_bank, actual_dataset;
      if(!DPCCResolveArtifact(package_root, model_containing, linked_training, common_files,
         DPCC_RESOLVER_MAX_JSON_BYTES, actual_training, reason) ||
         !DPCCResolveArtifact(package_root, model_containing, linked_bank, common_files, DPCC_RESOLVER_MAX_JSON_BYTES,
            actual_bank, reason) ||
         !DPCCResolveArtifact(package_root, model_containing, linked_dataset, common_files,
            DPCC_RESOLVER_MAX_JSON_BYTES, actual_dataset, reason))
         return(false);
      if(actual_training.observed_sha256 != t.observed_sha256)
        {
         reason = "training.backlink_actual_hash";
         return(false);
        }
      string bs, ds;
      if(!DPCCCentralBytesSource(actual_bank.bytes, bs, reason, "bank") ||
         !DPCCCentralBytesSource(actual_dataset.bytes, ds, reason, "dataset"))
         return(false);
      uchar header_bytes[];
      int header_count = StringToCharArray(bank.header, header_bytes, 0, WHOLE_ARRAY, CP_UTF8);
      if(header_count <= 0 || ArrayResize(header_bytes, header_count - 1) != header_count - 1)
        {
         reason = "training.header_bytes";
         return(false);
        }
      if(!DPCCValidateBankMetadata(bs, header_bytes, ds, bank_schema, bank.header_schema, dataset_schema,
                                   bank.dataset, bank.links, bank.profile, bank.bank.bank_id, bank.bank.bank_sha256,
                                      bank.bank.record_count,
                                   !bank.dataset.example_only, value.bank_receipt, reason))
         return(false);
      if(value.bank_receipt.header_sha256 != bank.bank.header_sha256 || value.bank_receipt.time_index_id !=
         bank.bank.time_index_id ||
         value.bank_receipt.dataset_id != bank.bank.dataset_id)
        {
         reason = "training.linked_bank_receipt";
         return(false);
        }
      if(!DPCCRunModelValues(model_document, model_typed.shapes, value.model_binding, reason))
         return(false);
      if(!DPCCRunNormalizationSection(model_document, value.model_binding, bank.dataset,
         value.normalization_section_sha256, reason))
         return(false);
      //--- Authenticate the actual declared TimeIndex and BankManifest dataset backlink.
      CDPCCJsonDocument dataset_document, bank_document;
      SDPCCDatasetManifest actual_dataset_metadata;
      if(!dataset_document.Parse(ds, reason) || !DPCCDecodeDatasetManifest(dataset_document, dataset_document.Root(),
         actual_dataset_metadata, reason) ||
         !DPCCRunSameDatasetContract(actual_dataset_metadata, bank.dataset, reason) || !bank_document.Parse(bs, reason))
         return(false);
      const int model_price = model_document.FindMember(model_document.Root(), "price_contract"), dataset_price =
         dataset_document.FindMember(dataset_document.Root(), "price_contract");
      if(!DPCCBankJsonEqual(model_document, model_price, dataset_document, dataset_price, 0))
        {
         reason = "training.model_dataset_price_contract";
         return(false);
        }
      SDPCCResourceReference bank_dataset;
      if(!DPCCBankReadReference(bank_document, bank_document.Root(), "dataset_manifest", bank_dataset, reason,
         "bank.dataset_manifest"))
         return(false);
      string bank_containing, dataset_containing;
      if(!DPCCRunContainingArtifact(package_root, actual_bank.canonical_path, bank_containing, reason) ||
         !DPCCRunContainingArtifact(package_root, actual_dataset.canonical_path, dataset_containing, reason))
         return(false);
      SDPCCArtifactResolveResult bank_dataset_artifact, index_artifact;
      if(!DPCCResolveArtifact(package_root, bank_containing, bank_dataset, common_files, DPCC_RESOLVER_MAX_JSON_BYTES,
         bank_dataset_artifact, reason) ||
         bank_dataset_artifact.observed_sha256 != actual_dataset.observed_sha256 ||
         !DPCCResolveArtifact(package_root, dataset_containing, actual_dataset_metadata.time_index, common_files,
            DPCC_RESOLVER_MAX_JSON_BYTES, index_artifact, reason))
         return(false);
      string index_source, index_schema_hash;
      if(!DPCCCentralBytesSource(index_artifact.bytes, index_source, reason, "time_index") ||
         !DPCCBankSourceHash(time_index_schema, index_schema_hash, reason, "time_index.schema") ||
         index_schema_hash != "040554860c0a1c1ff9f823c70710f5d7c51934c8c18c97e8c06e709f217ffb57")
        {reason = "training.time_index_schema"; return(false);}
      CDPCCJsonDocument index_document;
      if(!DPCCCentralSchemaValidate(index_document, index_source, time_index_schema, reason, "time_index") ||
         !DPCCDecodeDatasetTimeIndex(index_document, index_document.Root(), bank.dataset.dataset_id, value.time_index,
            reason) ||
         value.time_index.time_index_id != bank.links.time_index_id || index_artifact.observed_sha256 !=
            bank.links.time_index_sha256)
        {reason = "training.actual_time_index"; return(false);}
      value.time_index_sha256 = index_artifact.observed_sha256;
      value.model_sha256 = m.observed_sha256;
      value.bank_manifest_sha256 = actual_bank.observed_sha256;
      m_config = value;
      m_model_source = ms;
      m_admitted = true;
      return(true);
     }
   bool              ModelSource(string &source) {source = ""; if(!m_admitted)return(false); source = m_model_source;
      return(true);}
   bool              Get(const ENUM_DPCC_TRAIN_ROLE role, SDPCCTrainingConfigAdmission &config,
      SDPCCTrainingRoleConfig &value)
     {
      if(!m_admitted || (role != DPCC_ROLE_DECODER && role != DPCC_ROLE_DENOISER))
         return(false);
      config = m_config;
      if(role == DPCC_ROLE_DECODER)
         value = m_config.decoder;
      else
         value = m_config.denoiser;
      return(true);
     }
  };
//+------------------------------------------------------------------+
//| Function DPCCRunPlanHash                                         |
//+------------------------------------------------------------------+
bool DPCCRunPlanHash(const SDPCCTrainingConfigAdmission &config, const SDPCCTrainingRoleConfig &role,
                     const SDPCCTrainingRecordIdentity &records[], const SDPCCTrainingPlanEntry &fit[],
                     const SDPCCTrainingPlanEntry &validation[], string &digest, string &reason)
  {
   string wire = "DPCC_EXPLICIT_RUN_PLAN_V1\n" + config.source_sha256 + "\n" + config.model_sha256 + "\n" +
      config.bank_manifest_sha256 + "\n" + config.dataset_sha256 + "\n" + config.time_index_sha256 + "\n" +
      config.normalization_section_sha256 + "\n" + (string)role.max_epochs + "\n" + role.loss + "\n" +
      role.training_seed + "\n" + role.validation_seed + "\n";
   for(int k = 0; k < ArraySize(fit); k++)
     {SDPCCTrainingPlanEntry p = fit[k]; wire += (string)p.epoch + ":" + (string)p.ordinal + ":" + (
        string)p.record_index + ":" + p.window_id + ":" + (string)p.j + ":" + (string)p.repeat + "\n";}
   for(int k = 0; k < ArraySize(validation); k++)
     {SDPCCTrainingPlanEntry p = validation[k]; wire += "V:" + (string)p.ordinal + ":" + (string)p.record_index + ":" +
        p.window_id + ":" + (string)p.j + ":" + (string)p.repeat + "\n";}
   for(int i = 0; i < ArraySize(records); i++)
      wire += "R:" + (string)i + ":" + records[i].window_id + ":" + records[i].source_id + ":" + records[i].split +
         ":" +
              records[i].bank_sha256 + ":" + records[i].header_sha256 + ":" + (string)records[i].decision_time + ":" + (
                 string)records[i].decision_bar_index + ":" +
              (string)records[i].keys.decision_identity + ":" + (string)records[i].keys.context_identity + ":" + (
                 string)records[i].keys.owner_identity + "\n";
   return(DPCCBankSourceHash(wire, digest, reason, "plan"));
  }
//--- Immutable owned plans; no model math, optimizer calls, READY or invented PRNG.
class CDPCCFrozenRolePlan
  {
private:
   bool              m_admitted;
   SDPCCTrainingPlanEntry m_fit[], m_validation[];
   string            m_sha;
public:
                     CDPCCFrozenRolePlan(void) {m_admitted = false;}
   bool              Admit(CDPCCAdmittedTrainingConfig &admitted_config, const ENUM_DPCC_TRAIN_ROLE role_id,
      const uint J,
              CDPCCTrainingExamples &owner, const uint validation_repeat,
              const SDPCCTrainingPlanEntry &fit[],
              const SDPCCTrainingPlanEntry &validation[], const string expected_sha, string &reason)
     {
      SDPCCTrainingRoleConfig role;
      SDPCCTrainingConfigAdmission config;
      if(!admitted_config.Get(role_id, config, role))
        {
         reason = "plan.config_not_admitted";
         return(false);
        }
      reason = "";
      if(m_admitted)
        {
         reason = "plan.already_admitted";
         return(false);
        }
      if(J == 0 || role.max_epochs < 1 || !DPCCResolverLowerSha256(expected_sha))
        {
         reason = "plan.config";
         return(false);
        }
      if(!owner.RunBinding(config.dataset_id, config.bank_id, config.normalization_id, config.dataset_sha256,
         config.bank_receipt, config.model_binding, config.time_index_sha256, config.time_index, config.architecture,
                           role.training_seed, role.validation_seed, validation_repeat, J, role_id ==
                              DPCC_ROLE_DENOISER, reason))
         return(false);
      SDPCCTrainingRecordIdentity records[];
      int size = owner.RecordCount();
      if(size <= 0 || ArrayResize(records, size) != size)
        {
         reason = "plan.owner_records";
         return(false);
        }
      for(int i = 0; i < size; i++)
         if(!owner.RecordIdentity(i, records[i]))
           {
            reason = "plan.owner_record";
            return(false);
           }
      int nf = 0, nv = 0;
      for(int i = 0; i < ArraySize(records); i++)
        {
         if(records[i].record_index != i || records[i].window_id == "" || records[i].keys.window_id !=
            records[i].window_id)
           {reason = "plan.record_identity"; return(false);}
         if(records[i].split == "fit")
            nf++;
         if(records[i].split == "validation")
            nv++;
        }
      if(nf == 0 || nv == 0 || (nf > 0 && (ArraySize(fit) % nf != 0 || (long)(ArraySize(fit) / nf) !=
         role.max_epochs)) || ArraySize(validation) != nv)
        {reason = "plan.count"; return(false);}
      for(int k = 0; k < ArraySize(fit); k++)
        {
         SDPCCTrainingPlanEntry p = fit[k];
         if(p.epoch != (uint)(k / nf + 1) || p.ordinal != (uint)(k % nf) || p.record_index < 0 || p.record_index >=
            ArraySize(records) ||
            records[p.record_index].split != "fit" || p.window_id != records[p.record_index].window_id ||
            (role_id == DPCC_ROLE_DENOISER ? (p.j == 0 || p.j > J) : (p.j != 0 || p.repeat != 0)))
           {reason = "plan.fit_binding"; return(false);}
         for(int q = k - k % nf; q < k; q++)
            if(fit[q].record_index == p.record_index)
              {
               reason = "plan.fit_duplicate";
               return(false);
              }
        }
      int cursor = 0;
      for(int i = 0; i < ArraySize(records); i++)
         if(records[i].split == "validation")
           {
            SDPCCTrainingPlanEntry p = validation[cursor];
            if(p.epoch != 0 || p.ordinal != (uint)cursor || p.record_index != i || p.window_id !=
               records[i].window_id ||
               (role_id == DPCC_ROLE_DENOISER ? (p.repeat != validation_repeat || p.j != records[i].keys.validation_j ||
                  p.j == 0 || p.j > J) : (p.j != 0 || p.repeat != 0)))
              {reason = "plan.validation_binding"; return(false);}
            cursor++;
           }
      string digest;
      if(!DPCCRunPlanHash(config, role, records, fit, validation, digest, reason) || digest != expected_sha)
        {
         reason = "plan.sha256";
         return(false);
        }
      if(ArrayResize(m_fit, ArraySize(fit)) != ArraySize(fit) || ArrayResize(m_validation, ArraySize(validation)) !=
         ArraySize(validation))
        {ArrayResize(m_fit, 0); ArrayResize(m_validation, 0); reason = "plan.copy"; return(false);}
      for(int i = 0; i < ArraySize(fit); i++)
         m_fit[i] = fit[i];
      for(int i = 0; i < ArraySize(validation); i++)
         m_validation[i] = validation[i];
      m_sha = digest;
      m_admitted = true;
      return(true);
     }
   int               FitCount(void) {return(m_admitted ? ArraySize(m_fit) : 0);}
   int               ValidationCount(void) {return(m_admitted ? ArraySize(m_validation) : 0);}
   string            Digest(void) {return(m_admitted ? m_sha : "");}
   bool              Fit(const int index, SDPCCTrainingPlanEntry &entry)
                     {if(!m_admitted || index < 0 || index >= ArraySize(m_fit))return(false); entry = m_fit[index];
                        return(true);}
   bool              Validation(const int index, SDPCCTrainingPlanEntry &entry)
                     {if(!m_admitted || index < 0 || index >= ArraySize(m_validation))return(false); entry =
                        m_validation[index]; return(true);}
  };
#endif
//--- WORK stage C1: native execution and private progress, not exact run resume.
struct SDPCCEpochProgress
  {
   uint              role, completed_epoch, fit_cursor, validations, stale_validations, decoder_updates,
      denoiser_updates;
   bool              complete, failed, has_best;
   double            best_loss, best_patience_loss;
  };
#ifndef DPCC_EPOCH_STATE_MQH
#define DPCC_EPOCH_STATE_MQH
bool DPCCEpochValidationDue(const uint epoch, const SDPCCTrainingRoleConfig &role)
  {return(epoch > 0 && role.validation_every_epochs > 0 && (long)epoch % role.validation_every_epochs == 0);}
//+------------------------------------------------------------------+
//| Function DPCCEpochFinished                                       |
//+------------------------------------------------------------------+
bool DPCCEpochFinished(const uint epoch, const bool validation, const SDPCCTrainingRoleConfig &role,
   const SDPCCEpochProgress &progress)
  {return((long)epoch >= role.max_epochs || (validation && (long)progress.stale_validations >= role.patience));}
//--- Production transition reused by native runner and persisted history replay.
bool DPCCEpochObserve(const double loss, const SDPCCTrainingRoleConfig &role,
                      SDPCCEpochProgress &progress, bool &improved)
  {
   improved = false;
   if(!MathIsValidNumber(loss) || loss < 0 || role.min_delta < 0 || !MathIsValidNumber(role.min_delta) ||
      progress.validations == UINT_MAX || progress.stale_validations == UINT_MAX)
      return(false);
   improved = !progress.has_best || loss < progress.best_loss;
   if(!progress.has_best || loss < progress.best_patience_loss - role.min_delta)
     {progress.best_patience_loss = loss; progress.stale_validations = 0;}
   else
      progress.stale_validations++;
   if(improved)
      progress.best_loss = loss;
   progress.has_best = true;
   progress.validations++;
   return(true);
  }
struct SDPCCEpochHistory
  {
   uint              role, epoch;
   bool              validation;
   double            loss;
   string            path, sha;
  };
//+------------------------------------------------------------------+
//| Function DPCCEpochProgressWire                                   |
//+------------------------------------------------------------------+
string DPCCEpochProgressWire(const SDPCCEpochProgress &p)
  {
   return((string)p.role + "\n" + (string)(uint)p.completed_epoch + "\n" + (string)p.fit_cursor + "\n" +
          (string)p.validations + "\n" + (string)p.stale_validations + "\n" + (string)(uint)p.complete + "\n" +
          (string)(uint)p.failed + "\n" + (string)(uint)p.has_best + "\n" +
          StringFormat("%.17g\n%.17g\n", p.best_loss, p.best_patience_loss));
  }
//+------------------------------------------------------------------+
//| Function DPCCEpochNumber                                         |
//+------------------------------------------------------------------+
bool DPCCEpochNumber(const string text, double &value, string &reason)
  {
   CDPCCJsonDocument number;
   return(number.Parse(text, reason) && number.TryNumber(number.Root(), value) && MathIsValidNumber(value) &&
          value >= 0 && StringFormat("%.17g", value) == text);
  }
#endif
#ifndef DPCC_STAGE_FIT_SOURCE_MQH
#define DPCC_STAGE_FIT_SOURCE_MQH

#ifndef DPCC_FIXED_NORMALIZATION_FULL_WORK_MQH
#define DPCC_FIXED_NORMALIZATION_FULL_WORK_MQH

#ifndef DPCC_FIT_STATISTICS_MQH
#define DPCC_FIT_STATISTICS_MQH
//--- DPCC_FIT_FIXED_POPULATION_WELFORD_V1: deterministic host double population statistics.
struct SDPCCFitPriceNorm16
  {
   float             mean[4], std[4], gain[4], bias[4];
  };
//+------------------------------------------------------------------+
//| Function DPCCFitPriceNorm16                                      |
//+------------------------------------------------------------------+
bool DPCCFitPriceNorm16(const float &feature_major[], const uint rows, const ulong record_cap,
                        SDPCCFitPriceNorm16 &out, string &reason)
  {
   ZeroMemory(out);
   reason = "";
   if(rows < 2 || rows > record_cap || rows > (uint)(INT_MAX / 4) || ArraySize(feature_major) != (int)(rows * 4))
     {
      reason = "fit.statistics.capacity";
      return(false);
     }
   double mean[4], m2[4];
   ZeroMemory(mean);
   ZeroMemory(m2);
   for(uint r = 0; r < rows; r++)
     {
      const double open = feature_major[r], high = feature_major[rows + r];
      const double low = feature_major[2 * rows + r], close = feature_major[3 * rows + r];
      if(!MathIsValidNumber(open) || !MathIsValidNumber(high) || !MathIsValidNumber(low) ||
         !MathIsValidNumber(close) || open <= 0 || high <= 0 || low <= 0 || close <= 0 ||
         high < low || high < open || high < close || low > open || low > close)
        {
         reason = "fit.statistics.ohlc";
         return(false);
        }
      const double values[] = {open, high, low, close};
      for(int c = 0; c < 4; c++)
        {
         const double delta = values[c] - mean[c];
         mean[c] += delta / (double)(r + 1);
         m2[c] += delta * (values[c] - mean[c]);
        }
     }
   SDPCCFitPriceNorm16 prepared;
   ZeroMemory(prepared);
   for(int c = 0; c < 4; c++)
     {
      const double variance = m2[c] / (double)rows;
      const double sd = MathSqrt(variance);
      const float fm = (float)mean[c], fs = (float)sd, fv = fs * fs;
      if(!MathIsValidNumber(mean[c]) || !MathIsValidNumber(variance) || variance <= 0 ||
         !MathIsValidNumber(sd) || sd <= 0 || !MathIsValidNumber(fm) || !MathIsValidNumber(fs) ||
         !MathIsValidNumber(fv) || fs <= 0 || fv <= 0)
        {
         reason = "fit.statistics.variance";
         return(false);
        }
      prepared.mean[c] = fm;
      prepared.std[c] = fs;
      prepared.gain[c] = 1;
      prepared.bias[c] = 0;
     }
   out = prepared;
   return(true);
  }
#endif
//--- Internal materialization binding, not a new Model component or readiness receipt.
//--- Caller obtains fit_rows_sha256 from the admitted immutable OHLC producer, before this call.
//--- The digest authenticates the exact UTC-indexed float rows consumed below; it does not
//--- independently prove their market origin. No API guesses that missing origin binding.
struct SDPCCFullFitSource
  {
   string            model_sha256, dataset_sha256, time_index_sha256, normalization_section_sha256;
   string            fit_rows_sha256, actor_sha256;
   long              data_cutoff;
   ulong             record_cap;
   string            calculation_profile, calculation_source_sha256;
   ulong             actor_contract, actor_weights, actor_trainable;
  };
//+------------------------------------------------------------------+
//| Declaration CDPCCFullFitNormalization                            |
//+------------------------------------------------------------------+
class CDPCCFullFitNormalization
  {
private:
   CNeuronDPCCOCL    *m_actor;
   SDPCCFullFitSource m_binding;
   float             m_profile[16], m_snapshot[16];
   string            m_statistics_sha256, m_model_source;
   SDPCCResourceShape m_shapes;
   SDPCCTrainingModelBinding m_values;
   bool              m_calculated;
   bool              m_valid;
   bool              Refuse(const string text, string &reason)
     {
      m_valid = false;
      reason = text;
      return(false);
     }
public:
                     CDPCCFullFitNormalization(void) { m_actor = NULL; m_valid = false; m_calculated = false; }
   void              Reset(void) { m_actor = NULL; m_valid = false; m_calculated = false; ZeroMemory(m_profile);
      ZeroMemory(m_snapshot); m_statistics_sha256 = ""; m_model_source = ""; }
   //--- Four feature-major OHLC channels, one value per actual fit bar, ascending UTC.
   //--- All records in the half-open normalization_fit interval are required exactly once.
   bool              PrepareSource(const string actual_model_source,
                      const SDPCCTrainingConfigAdmission &admission,
                      const string actual_dataset_source, const string actual_time_index_source,
                      const SDPCCFullFitSource &binding,
                      const float &fit_ohlc[], const long &start_utc[], const long &end_utc[],
                      string &reason)
     {
      Reset();
      string hash;
      SDPCCDatasetManifest dataset;
      SDPCCDatasetTimeIndex index;
      CDPCCJsonDocument dataset_document, index_document;
      if(!DPCCBankSourceHash(actual_dataset_source, hash, reason, "fixed_norm.dataset") ||
         hash != binding.dataset_sha256 || hash != admission.dataset_sha256 ||
         !dataset_document.Parse(actual_dataset_source, reason) ||
         !DPCCDecodeDatasetManifest(dataset_document, dataset_document.Root(), dataset, reason) ||
         !DPCCBankSourceHash(actual_time_index_source, hash, reason, "fixed_norm.time_index") ||
         hash != binding.time_index_sha256 || hash != admission.time_index_sha256 ||
         !index_document.Parse(actual_time_index_source, reason) ||
         !DPCCDecodeDatasetTimeIndex(index_document, index_document.Root(), dataset.dataset_id, index, reason))
         return(Refuse("BLOCKED.fixed_norm.actual_Dataset_TimeIndex_bytes", reason));
      if(!DPCCResolverLowerSha256(binding.fit_rows_sha256) || !DPCCResolverLowerSha256(binding.actor_sha256))
         return(Refuse("BLOCKED.fixed_norm.actual_fit_OHLC_source_binding", reason));
      if(!DPCCBankSourceHash(actual_model_source, hash, reason, "fixed_norm.model") ||
         hash != binding.model_sha256 || hash != admission.model_sha256 ||
         binding.dataset_sha256 != admission.dataset_sha256 ||
         binding.time_index_sha256 != admission.time_index_sha256 ||
         binding.normalization_section_sha256 != admission.normalization_section_sha256 ||
         dataset.dataset_id != admission.dataset_id || dataset.normalization_id != admission.normalization_id)
         return(Refuse("BLOCKED.fixed_norm.admitted_source_identity", reason));
      CDPCCJsonDocument document;
      if(!document.Parse(actual_model_source, reason))
         return(false);
      if(!DPCCDecodeResourceShape(document, document.FindMember(document.Root(), "shapes"), m_shapes, reason,
         "fixed_norm.Model.shapes") ||
         !DPCCRunModelValues(document, m_shapes, m_values, reason))
         return(false);
      const int norm = document.FindMember(document.Root(), "normalization");
      string mode;
      if(!DPCCResourceReadString(document, norm, "statistics_source", mode, reason, "normalization") ||
         mode != "FIT_FIXED" ||
         !DPCCRunNormalizationSection(document, admission.model_binding, dataset, hash, reason) ||
         hash != binding.normalization_section_sha256)
         return(Refuse("BLOCKED.fixed_norm.actual_Model_FIT_FIXED_section", reason));
      SDPCCResourceReference component, linked_dataset;
      const int components = document.FindMember(document.Root(), "components");
      const int training = document.FindMember(document.Root(), "training");
      if(!DPCCBankReadReference(document, document.FindMember(components, "actor"), "file", component, reason,
         "model.components.actor.file") ||
         !DPCCBankReadReference(document, training, "dataset_manifest", linked_dataset, reason, "model.dataset") ||
         component.sha256 != binding.actor_sha256 || linked_dataset.sha256 != binding.dataset_sha256 ||
         linked_dataset.id != dataset.dataset_id)
         return(Refuse("BLOCKED.fixed_norm.Model_component_data_binding", reason));
      string index_reason;
      const SDPCCDatasetInterval fit = dataset.normalization_fit;
      if(!DPCCValidateDatasetTimeIndex(index, dataset.dataset_id, index_reason) ||
         dataset.time_index.sha256 != binding.time_index_sha256 ||
         dataset.time_index.id != index.time_index_id || dataset.data_source != index.data_source ||
         dataset.timezone_mapping.sha256 != index.timezone_mapping.sha256 ||
         !DPCCDatasetValidateInterval(fit, index, reason, "fixed_norm.fit") ||
         fit.bar_start < dataset.fit.bar_start || fit.bar_end > dataset.fit.bar_end ||
         fit.start_utc < dataset.fit.start_utc || fit.end_utc > dataset.fit.end_utc ||
         binding.data_cutoff < fit.end_utc || binding.data_cutoff > dataset.fit.end_utc)
         return(Refuse("BLOCKED.fixed_norm.fit_interval_or_calculation_cutoff", reason));
      const long total = fit.bar_end - fit.bar_start;
      if(total < 2 || total > INT_MAX / 4 || binding.record_cap < 2 || (ulong)total > binding.record_cap ||
         ArraySize(fit_ohlc) != 4 * total ||
         ArraySize(start_utc) != total || ArraySize(end_utc) != total)
         return(Refuse("BLOCKED.fixed_norm.complete_fit_rows", reason));
      const int count = (int)total;
      string wire = "DPCC_INTERNAL_FIT_OHLC_FLOAT_ROWS_V1\n" + binding.dataset_sha256 + "\n" +
                    binding.time_index_sha256 + "\n" + binding.normalization_section_sha256 + "\n";
      for(int row = 0; row < count; row++)
        {
         const int position = (int)fit.bar_start + row;
         if(start_utc[row] != index.start_utc[position] || end_utc[row] != index.end_utc[position] ||
            end_utc[row] > binding.data_cutoff)
            return(Refuse("BLOCKED.fixed_norm.fit_row_times", reason));
         wire += (string)position + ":" + (string)start_utc[row] + ":" + (string)end_utc[row];
         for(int channel = 0; channel < 4; channel++)
           {
            const float value = fit_ohlc[channel * count + row];
            if(!MathIsValidNumber((double)value) || value <= 0)
               return(Refuse("BLOCKED.fixed_norm.fit_OHLC_values", reason));
            URAGFloatBits raw;
            raw.value = value;
            wire += ":" + (string)raw.bits;
           }
         if(fit_ohlc[count + row] < MathMax(fit_ohlc[row], fit_ohlc[3 * count + row]) ||
            fit_ohlc[2 * count + row] > MathMin(fit_ohlc[row], fit_ohlc[3 * count + row]))
            return(Refuse("BLOCKED.fixed_norm.fit_OHLC_geometry", reason));
         wire += "\n";
        }
      if(!DPCCBankSourceHash(wire, hash, reason, "fixed_norm.fit_rows") || hash != binding.fit_rows_sha256)
         return(Refuse("BLOCKED.fixed_norm.fit_rows_hash", reason));
      //--- This is the exact frozen whole-fit helper, not native PeriodNorm arithmetic.
      const string profile = "DPCC_FIT_FIXED_POPULATION_WELFORD_V1";
      const string implementation = "dc36436fc0ddacab261a3fc7e249fd3491e1b28eb4a21af2991af4fcce0109c0";
      if(binding.calculation_profile != profile || binding.calculation_source_sha256 != implementation ||
         binding.record_cap == 0)
         return(Refuse("BLOCKED.fixed_norm.frozen_whole_fit_calculation_profile", reason));
      SDPCCFitPriceNorm16 observed;
      if(!DPCCFitPriceNorm16(fit_ohlc, (uint)count, binding.record_cap, observed, reason))
         return(false);
      string statistics_wire = "DPCC_INTERNAL_FIT_STATISTICS_V1\n" + profile + "\n" + implementation + "\n" +
                               binding.fit_rows_sha256 + "\n" + (string)binding.data_cutoff + "\n";
      for(int channel = 0; channel < 4; channel++)
        {
         const int target = 4 * channel;
         m_profile[target] = observed.mean[channel];
         m_profile[target + 1] = observed.std[channel];
         m_profile[target + 2] = observed.gain[channel];
         m_profile[target + 3] = observed.bias[channel];
         const float variance = observed.std[channel] * observed.std[channel];
         m_snapshot[target] = observed.mean[channel];
         m_snapshot[target + 1] = (float)MathSqrt((double)variance);
         m_snapshot[target + 2] = observed.gain[channel];
         m_snapshot[target + 3] = observed.bias[channel];
         for(int field = 0; field < 4; field++)
           {
            URAGFloatBits raw;
            raw.value = m_profile[target + field];
            statistics_wire += (string)raw.bits + ":";
           }
         URAGFloatBits raw_variance;
         raw_variance.value = variance;
         statistics_wire += (string)raw_variance.bits + "\n";
        }
      if(!DPCCBankSourceHash(statistics_wire, m_statistics_sha256, reason, "fixed_norm.statistics"))
         return(false);
      m_binding = binding;
      m_model_source = actual_model_source;
      m_calculated = true;
      reason = "";
      return(true);
     }
   //--- Exact effective native PriceNorm profile, owned copy only; not an Actor admission.
   //--- Native holder stores float variance=raw_std*raw_std; std is sqrt(variance).
   bool              PreparedTrainingPriceNorm(float &profile[], string &reason)
     {
      ArrayResize(profile, 0);
      if(!m_calculated || ArrayResize(profile, 16) != 16)
        {reason = "BLOCKED.fixed_norm.calculated_training_profile_required"; return(false);}
      for(int i = 0; i < 16; i++)
         profile[i] = m_snapshot[i];
      reason = "";
      return(true);
     }
   bool              PreparedMetadata(SDPCCFullFitSource &binding, string &statistics_sha256)
     {
      ZeroMemory(binding);
      statistics_sha256 = "";
      if(!m_calculated)
         return(false);
      binding = m_binding;
      statistics_sha256 = m_statistics_sha256;
      return(true);
     }
   //--- This API prepares parameters only. It does not adopt a saved/native-loaded artifact.
   //--- Selected checkpoint verification and import are delegated to the canonical owner.
   bool              AssembleSelected(CNet &destination, const SDPCCConfig &training,
                         const SDPCCConfig &config, const SDPCCDecoderComposition &decoder,
                         const SDPCCDenoiserComposition &denoiser,
                         const double &beta[], const double &alpha[], const double &sigma[],
                         const SDPCCCheckpointArtifact &selected_decoder,
                         const SDPCCCheckpointArtifact &selected_denoiser,
                         const string expected_checkpoint_binding, const ulong maximum_bytes,
                         CNeuronDPCCOCL *&actor, string &reason)
     {
      actor = NULL;
      if(!m_calculated)
         return(Refuse("BLOCKED.fixed_norm.actual_fit_source_not_calculated", reason));
      if(training.shape.K != m_shapes.K || training.shape.V != m_shapes.V || training.shape.H != m_shapes.H ||
         training.shape.D != m_shapes.D || training.shape.M != m_shapes.M || training.shape.J != m_shapes.J ||
         training.shape.E != m_shapes.E || training.shape.NActions != m_shapes.A ||
         training.shape.StateSize != m_shapes.account_features || training.price_basis != m_values.price_basis ||
         training.volume_scale != m_values.volume_scale || training.price_scale != m_values.price_scale ||
         training.money_scale != m_values.money_scale || ArraySize(beta) != ArraySize(m_values.beta) ||
         ArraySize(alpha) != ArraySize(m_values.alpha_bar) || ArraySize(sigma) != ArraySize(m_values.sigma))
         return(Refuse("BLOCKED.fixed_norm.actual_Model_shape_scales", reason));
      for(int i = 0; i < 6; i++)
         if(training.action_bias[i] != m_values.action_bias[i] || training.action_scale[i] != m_values.action_scale[i])
            return(Refuse("BLOCKED.fixed_norm.actual_Model_action_affine", reason));
      for(int i = 0; i < ArraySize(beta); i++)
         if(beta[i] != m_values.beta[i] || alpha[i] != m_values.alpha_bar[i] || sigma[i] != m_values.sigma[i])
            return(Refuse("BLOCKED.fixed_norm.actual_Model_schedule", reason));
      SDPCCConfig derived;
      float limits[];
      if(!DPCCDecodePreparedActorConfig(m_model_source, training, derived, limits, reason) ||
         DPCCFixedSignature(derived, defNeuronDPCCOCL) != DPCCFixedSignature(config, defNeuronDPCCOCL))
         return(Refuse("BLOCKED.fixed_norm.actual_Model_Actor_config", reason));
      CNeuronDPCCOCL *candidate = NULL;
      if(!DPCCAssembleSelectedCheckpoints(destination, training, derived, decoder, denoiser, beta, alpha, sigma,
                                          selected_decoder, selected_denoiser, expected_checkpoint_binding,
                                          m_profile, maximum_bytes, candidate, reason))
         return(false);
      if(!candidate || !ProfileMatches(candidate, reason))
         return(false);
      //--- Successful preparation is not a native artifact/model-hash adoption.
      actor = candidate;
      reason = "";
      return(true);
     }
   bool              BindLoaded(CNet &actor, const SDPCCFullFitSource &binding,
                   const string actual_model_source, string &reason)
     {
      m_valid = false;
      m_actor = NULL;
      if(!m_calculated || !SameSource(binding))
         return(Refuse("BLOCKED.fixed_norm.prepared_source_profile_binding", reason));
      CDPCCJsonDocument document;
      string hash, format;
      bool prepared = false;
      if(!DPCCBankSourceHash(actual_model_source, hash, reason, "fixed_norm.loaded_Model") ||
         hash != m_binding.model_sha256 || !document.Parse(actual_model_source, reason))
         return(false);
      const int components = document.FindMember(document.Root(), "components");
      const int actor_node = document.FindMember(components, "actor");
      SDPCCResourceReference reference;
      if(!DPCCBankReadReference(document, actor_node, "file", reference, reason, "model.actor.file") ||
         !DPCCResourceReadString(document, actor_node, "format", format, reason, "model.actor.format") ||
         !DPCCResourceReadBool(document, actor_node, "prepared", prepared, reason, "model.actor.prepared") ||
         reference.sha256 != binding.actor_sha256 || format != "CNET_BINARY" || !prepared)
         return(Refuse("BLOCKED.fixed_norm.actual_prepared_Model_Actor", reason));
      CNeuronDPCCOCL *candidate = dynamic_cast<CNeuronDPCCOCL*>(actor.Layer(-1));
      if(!candidate || !actor.IsOpenCLTransferReady() || !actor.GetOpenCL() ||
         candidate.GetOpenCL() != actor.GetOpenCL() || binding.actor_contract == 0 ||
         binding.actor_weights == 0 || binding.actor_trainable == 0 ||
         candidate.ContractSignature() != binding.actor_contract ||
         candidate.WeightSignature() != binding.actor_weights ||
         candidate.TrainableStateFingerprint() != binding.actor_trainable || !ProfileMatches(candidate, reason))
         return(Refuse("BLOCKED.fixed_norm.admitted_loaded_Actor_identity_or_statistics", reason));
      m_binding = binding;
      m_actor = candidate;
      m_valid = true;
      reason = "";
      return(true);
     }
   bool              Initialize(CNet &actor, const string actual_model_source,
                   const SDPCCTrainingConfigAdmission &admission,
                   const string actual_dataset_source, const string actual_time_index_source,
                   const SDPCCFullFitSource &binding, const float &fit_ohlc[],
                   const long &start_utc[], const long &end_utc[], string &reason)
     {
      return(PrepareSource(actual_model_source, admission, actual_dataset_source, actual_time_index_source,
                           binding, fit_ohlc, start_utc, end_utc, reason) &&
             BindLoaded(actor, binding, actual_model_source, reason));
     }
   bool              Matches(COpenCLMy *context, const ulong contract, const ulong weights, const ulong trainable)
     {
      return(m_valid && CheckPointer(m_actor) != POINTER_INVALID && m_actor.GetOpenCL() == context &&
             contract == m_binding.actor_contract && weights == m_binding.actor_weights &&
             trainable == m_binding.actor_trainable);
     }
   bool              Copy(const string model_sha256, const string section_sha256, const long decision_time,
             float &price_norm[], string &reason)
     {
      ArrayResize(price_norm, 0);
      if(!m_valid || CheckPointer(m_actor) == POINTER_INVALID || model_sha256 != m_binding.model_sha256 ||
         section_sha256 != m_binding.normalization_section_sha256 || decision_time < m_binding.data_cutoff ||
         m_actor.ContractSignature() != m_binding.actor_contract || m_actor.WeightSignature() !=
            m_binding.actor_weights ||
         m_actor.TrainableStateFingerprint() != m_binding.actor_trainable)
         return(Refuse("BLOCKED.fixed_norm.frozen_profile_identity_or_cutoff", reason));
      if(ArrayResize(price_norm, 16) != 16)
         return(Refuse("fixed_norm.output_capacity", reason));
      for(int i = 0; i < 16; i++)
         price_norm[i] = m_snapshot[i];
      reason = "";
      return(true);
     }
private:
   bool              SameSource(const SDPCCFullFitSource &value)
     {
      return(value.model_sha256 == m_binding.model_sha256 && value.dataset_sha256 == m_binding.dataset_sha256 &&
             value.time_index_sha256 == m_binding.time_index_sha256 &&
             value.normalization_section_sha256 == m_binding.normalization_section_sha256 &&
             value.fit_rows_sha256 == m_binding.fit_rows_sha256 && value.actor_sha256 == m_binding.actor_sha256 &&
             value.data_cutoff == m_binding.data_cutoff && value.record_cap == m_binding.record_cap &&
             value.calculation_profile == m_binding.calculation_profile &&
             value.calculation_source_sha256 == m_binding.calculation_source_sha256);
     }
   bool              ProfileMatches(CNeuronDPCCOCL *actor, string &reason)
     {
      if(!m_calculated || CheckPointer(actor) == POINTER_INVALID)
         return(Refuse("fixed_norm.native_profile_lifecycle", reason));
      const ulong contract = actor.ContractSignature(), weights = actor.WeightSignature(), state =
         actor.TrainableStateFingerprint();
      float saved[];
      if(contract == 0 || weights == 0 || state == 0 || !actor.ReadNormalizationSnapshot(saved) || ArraySize(saved) !=
         16)
         return(Refuse("fixed_norm.native_profile_read", reason));
      for(int i = 0; i < 16; i++)
        {
         URAGFloatBits expected, observed;
         expected.value = m_snapshot[i];
         observed.value = saved[i];
         if(expected.bits != observed.bits)
            return(Refuse("BLOCKED.fixed_norm.saved_Actor_vs_WELFORD_V1_fit_statistics", reason));
        }
      if(actor.ContractSignature() != contract || actor.WeightSignature() != weights ||
         actor.TrainableStateFingerprint() != state)
         return(Refuse("fixed_norm.Actor_changed", reason));
      return(true);
     }
  };
#endif
#ifndef DPCC_STAGE_FIT_SOURCE_SCHEMA_MQH
#define DPCC_STAGE_FIT_SOURCE_SCHEMA_MQH
string DPCCStageFitSourceSchema(void)
  {
   return("{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"Internal DPCC stage fit rows, not a Model role or readiness evidence\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"schema_version\":{\"const\":1},\"source_kind\":{\"const\":\"DPCC_STAGE_FIT_OHLC_ROWS_V1\"},\"model_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"dataset_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"time_index_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"normalization_section_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"fit_rows_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"calculation_source_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"calculation_profile\":{\"const\":\"DPCC_FIT_FIXED_POPULATION_WELFORD_V1\"},\"data_cutoff\":{\"type\":\"integer\",\"minimum\":0},\"record_cap\":{\"type\":\"integer\",\"minimum\":2},\"rows\":{\"type\":\"array\",\"minItems\":2,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"bar_index\":{\"type\":\"integer\",\"minimum\":0},\"start_utc\":{\"type\":\"integer\",\"minimum\":0},\"end_utc\":{\"type\":\"integer\",\"minimum\":0},\"open\":{\"type\":\"number\",\"exclusiveMinimum\":0},\"high\":{\"type\":\"number\",\"exclusiveMinimum\":0},\"low\":{\"type\":\"number\",\"exclusiveMinimum\":0},\"close\":{\"type\":\"number\",\"exclusiveMinimum\":0}},\"required\":[\"bar_index\",\"start_utc\",\"end_utc\",\"open\",\"high\",\"low\",\"close\"]}}},\"required\":[\"schema_version\",\"source_kind\",\"model_sha256\",\"dataset_sha256\",\"time_index_sha256\",\"normalization_section_sha256\",\"fit_rows_sha256\",\"calculation_source_sha256\",\"calculation_profile\",\"data_cutoff\",\"record_cap\",\"rows\"]}");
  }
#endif
//--- Internal operational source, never a Model component or a READY receipt.
//--- Reference SHA authenticates these exact rows; their physical origin remains
//--- part of the caller's admitted source policy, not inferred from a nonempty ID.
struct SDPCCStageFitSource
  {
   SDPCCResourceReference reference;
   string            package_root, containing_json;
   ulong             maximum_bytes;
   bool              common_files;
  };
struct SDPCCStageFitReceipt
  {
   string            payload_sha256, fit_rows_sha256, normalization_section_sha256;
   string            calculation_profile, calculation_source_sha256, statistics_sha256;
   long              data_cutoff;
   ulong             record_cap;
  };
//+------------------------------------------------------------------+
//| Function DPCCStageFitBlocked                                     |
//+------------------------------------------------------------------+
bool DPCCStageFitBlocked(const string prerequisite, string &reason)
  {
   reason = "BLOCKED:study_fit." + prerequisite;
   return(false);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageFitPrepare                                     |
//+------------------------------------------------------------------+
bool DPCCStageFitPrepare(const SDPCCStageFitSource &source,
                         const string actual_model, const SDPCCTrainingConfigAdmission &admission,
                         const string actual_dataset, const string actual_index,
                         CDPCCFullFitNormalization &prepared, SDPCCStageFitReceipt &receipt, string &reason)
  {
   prepared.Reset();
   ZeroMemory(receipt);
   reason = "";
   if(source.maximum_bytes == 0 || source.maximum_bytes > DPCC_RESOLVER_MAX_JSON_BYTES ||
      !DPCCResolverLowerSha256(source.reference.sha256))
      return(DPCCStageFitBlocked("immutable_source_reference_and_capacity", reason));
   SDPCCArtifactResolveResult artifact;
   string raw = "";
   if(!DPCCResolveArtifact(source.package_root, source.containing_json, source.reference, source.common_files,
                           (long)source.maximum_bytes, artifact, reason) || !DPCCCentralBytesSource(artifact.bytes, raw,
                              reason, "study_fit"))
      return(false);
   CDPCCJsonDocument document;
   if(!DPCCCentralSchemaValidate(document, raw, DPCCStageFitSourceSchema(), reason, "study_fit"))
      return(false);
   SDPCCFullFitSource binding;
   ZeroMemory(binding);
   const int root = document.Root();
   string kind = "";
   ulong cap = 0;
   if(!DPCCResourceReadString(document, root, "source_kind", kind, reason, "study_fit.source_kind") || kind !=
      "DPCC_STAGE_FIT_OHLC_ROWS_V1" ||
      !DPCCResourceReadString(document, root, "model_sha256", binding.model_sha256, reason, "study_fit.model") ||
      !DPCCResourceReadString(document, root, "dataset_sha256", binding.dataset_sha256, reason, "study_fit.dataset") ||
      !DPCCResourceReadString(document, root, "time_index_sha256", binding.time_index_sha256, reason,
         "study_fit.index") ||
      !DPCCResourceReadString(document, root, "normalization_section_sha256", binding.normalization_section_sha256,
         reason, "study_fit.normalization") ||
      !DPCCResourceReadString(document, root, "fit_rows_sha256", binding.fit_rows_sha256, reason,
         "study_fit.rows_sha") ||
      !DPCCResourceReadString(document, root, "calculation_profile", binding.calculation_profile, reason,
         "study_fit.profile") ||
      !DPCCResourceReadString(document, root, "calculation_source_sha256", binding.calculation_source_sha256, reason,
         "study_fit.helper") ||
      !DPCCResourceReadLong(document, root, "data_cutoff", binding.data_cutoff, reason, "study_fit.cutoff") ||
      document.Type(document.FindMember(root, "record_cap")) != DPCC_JSON_NUMBER ||
      !DPCCCheckpointReadUnsigned(document.Text(document.FindMember(root, "record_cap")), ULONG_MAX, cap))
      return(DPCCStageFitBlocked("typed_source_fields", reason));
   binding.record_cap = cap;
//--- Actor reference comes from actual admitted Model bytes, never a guessed future hash.
   CDPCCJsonDocument model, data;
   SDPCCDatasetManifest dataset;
   SDPCCResourceReference actor_ref;
   if(!model.Parse(actual_model, reason) || !data.Parse(actual_dataset, reason) ||
      !DPCCDecodeDatasetManifest(data, data.Root(), dataset, reason) ||
      !DPCCBankReadReference(model, model.FindMember(model.FindMember(model.Root(), "components"), "actor"),
                             "file", actor_ref, reason, "study_fit.actual_Model.actor"))
      return(false);
   binding.actor_sha256 = actor_ref.sha256;
   const long total = dataset.normalization_fit.bar_end - dataset.normalization_fit.bar_start;
   const int rows_node = document.FindMember(root, "rows");
   if(total < 2 || total > INT_MAX / 4 || cap < 2 || (ulong)total > cap || document.ChildCount(rows_node) != total)
      return(DPCCStageFitBlocked("complete_fit_row_count_and_cap", reason));
   const int rows = (int)total;
   float ohlc[];
   long starts[], ends[];
   if(ArrayResize(ohlc, 4 * rows) != 4 * rows || ArrayResize(starts, rows) != rows || ArrayResize(ends, rows) != rows)
      return(DPCCStageFitBlocked("fit_materialization_capacity", reason));
   const string channels[] = {"open", "high", "low", "close"};
   for(int row = 0; row < rows; row++)
     {
      const int node = document.ChildAt(rows_node, row);
      long ordinal = 0;
      if(!DPCCResourceReadLong(document, node, "bar_index", ordinal, reason, "study_fit.ordinal") ||
         ordinal != dataset.normalization_fit.bar_start + row ||
         !DPCCResourceReadLong(document, node, "start_utc", starts[row], reason, "study_fit.start") ||
         !DPCCResourceReadLong(document, node, "end_utc", ends[row], reason, "study_fit.end"))
         return(DPCCStageFitBlocked("fit_row_ordinals_and_times", reason));
      for(int channel = 0; channel < 4; channel++)
        {
         double value = 0;
         if(!DPCCResourceReadDouble(document, node, channels[channel], value, reason, "study_fit.OHLC") || value <= 0)
            return(DPCCStageFitBlocked("fit_OHLC_numeric_domain", reason));
         ohlc[channel * rows + row] = (float)value;
         if(!MathIsValidNumber((double)ohlc[channel * rows + row]) || ohlc[channel * rows + row] <= 0)
            return(DPCCStageFitBlocked("fit_OHLC_float_domain", reason));
        }
     }
//--- Existing observer enforces exact actual source closure, all UTC rows, fit
//--- interval/cutoff, float-row digest, frozen helper/profile, population stats.
   if(!prepared.PrepareSource(actual_model, admission, actual_dataset, actual_index, binding, ohlc, starts, ends,
      reason))
      return(false);
   string statistics = "";
   SDPCCFullFitSource calculated;
   if(!prepared.PreparedMetadata(calculated, statistics))
      return(DPCCStageFitBlocked("private_calculated_statistics", reason));
   receipt.payload_sha256 = artifact.observed_sha256;
   receipt.fit_rows_sha256 = calculated.fit_rows_sha256;
   receipt.normalization_section_sha256 = calculated.normalization_section_sha256;
   receipt.calculation_profile = calculated.calculation_profile;
   receipt.calculation_source_sha256 = calculated.calculation_source_sha256;
   receipt.statistics_sha256 = statistics;
   receipt.data_cutoff = calculated.data_cutoff;
   receipt.record_cap = calculated.record_cap;
   return(true);
  }
#endif
class CDPCCEpochOwner
  {
private:
   CDPCCTrainingExamples m_examples;
   CDPCCAdmittedTrainingConfig m_admitted;
   CDPCCFrozenRolePlan m_decoder_plan, m_denoiser_plan;
   SDPCCTrainingRoleConfig m_decoder_role, m_denoiser_role;
   SDPCCEpochProgress m_progress, m_decoder_progress, m_denoiser_progress;
   SDPCCEpochHistory m_history[];
   string            m_run_binding, m_confirmed_path, m_confirmed_sha;
   bool              m_restore_required;
   bool              m_fixed_required, m_fixed_admitted;
   float             m_fixed_profile[16];
   SDPCCStageFitReceipt m_fixed_receipt;
   SDPCCCheckpointArtifact m_initial, m_latest, m_decoder_best, m_denoiser_best;
   string            m_stem;
   bool              m_common, m_initialized;
   ulong             m_training_seed, m_validation_seed, m_actor_maximum_bytes;

   bool              Failure(const string cause, string &reason)
     {m_progress.failed = true; reason = cause; return(false);}
   bool              DecoderSelectionBinding(string &reason)
     {
      if(!m_initialized || m_restore_required || m_progress.failed || !m_decoder_progress.complete ||
         !m_decoder_progress.has_best || StringLen(m_decoder_best.manifest_sha256) == 0)
        {reason = "epoch.decoder_not_selected"; return(false);}
      if(m_decoder_best.cursor.stage != 1 || m_decoder_best.binding_sha256 != m_initial.binding_sha256 ||
         m_decoder_best.cursor.decoder_updates == 0 || m_decoder_best.cursor.denoiser_updates != 0)
        {reason = "epoch.decoder_selected_binding"; return(false);}
      return(true);
     }
   bool              StateCheckpoint(const uint stage, const uint epoch, SDPCCCheckpointArtifact &artifact,
      string &reason)
     {
      SDPCCCheckpointCursor cursor;
      ZeroMemory(cursor);
      ulong decoder_state = 0, denoiser_state = 0;
      if(!m_examples.NativeState(cursor.decoder_updates, cursor.denoiser_updates, decoder_state, denoiser_state))
         return(Failure("epoch.native_state", reason));
      cursor.stage = stage;
      cursor.completed_epoch = epoch;
      cursor.next_epoch = epoch + 1;
      cursor.next_record = 0;
      const string path = m_stem + ".stage" + (string)stage + ".epoch" + (string)epoch;
      if(!m_examples.SaveVerifiedCheckpointArtifact(path, m_common, cursor, artifact, reason))
         return(Failure(reason, reason));
      return(true);
     }
   bool              ValidateRole(CDPCCFrozenRolePlan &plan, const bool denoiser, double &loss, string &reason)
     {
      const int count = plan.ValidationCount();
      if(count <= 0)
         return(Failure("epoch.validation_empty", reason));
      uint db = 0, nb = 0, da = 0, na = 0;
      ulong dsb = 0, nsb = 0, dsa = 0, nsa = 0;
      if(!m_examples.NativeState(db, nb, dsb, nsb))
         return(Failure("epoch.validation_state_before", reason));
      double sum = 0;
      for(int i = 0; i < count; i++)
        {
         SDPCCTrainingPlanEntry entry;
         SDPCCTrainingRecordIdentity identity;
         SDPCCTrainingExampleResult result;
         if(!plan.Validation(i, entry) || !m_examples.RecordIdentity(entry.record_index, identity))
            return(Failure("epoch.validation_identity", reason));
         bool ok = false;
         if(denoiser)
           {
            SDPCCTrainingExampleKeys keys;
            keys.j = entry.j;
            keys.repeat = entry.repeat;
            keys.seed = m_validation_seed;
            keys.decision_time = identity.decision_time;
            keys.decision_identity = identity.keys.decision_identity;
            keys.context_identity = identity.keys.context_identity;
            keys.owner_identity = identity.keys.owner_identity;
            ok = m_examples.DenoiserExample(entry.record_index, DPCC_TRAIN_VALIDATE, keys, result);
           }
         else
            ok = m_examples.DecoderExample(entry.record_index, DPCC_TRAIN_VALIDATE, result);
         if(!ok || !result.completed || result.update_attempted || !MathIsValidNumber(result.loss))
            return(Failure("epoch.validation:" + result.reason, reason));
         sum += result.loss;
         if(!MathIsValidNumber(sum))
            return(Failure("epoch.validation_sum", reason));
        }
      if(!m_examples.NativeState(da, na, dsa, nsa) || db != da || nb != na || dsb != dsa || nsb != nsa)
         return(Failure("epoch.validation_mutation", reason));
      //--- Explicit C1 aggregation: equal-example arithmetic mean of native losses.
      loss = sum / (double)count;
      return(MathIsValidNumber(loss) || Failure("epoch.validation_mean", reason));
     }
   string            RunStateText(const SDPCCCheckpointArtifact &initial, const SDPCCCheckpointArtifact &latest,
                       const SDPCCCheckpointArtifact &decoder_best, const SDPCCCheckpointArtifact &denoiser_best,
                       const SDPCCEpochProgress &decoder, const SDPCCEpochProgress &denoiser,
                       const uint current_role, const bool complete, const SDPCCEpochHistory &history[])
     {
      string text = "DPCC_EPOCH_BOUNDARY_STATE_V1\n" + m_run_binding + "\n" +
                    initial.manifest_path + "\n" + initial.manifest_sha256 + "\n" +
                    latest.manifest_path + "\n" + latest.manifest_sha256 + "\n" +
                    decoder_best.manifest_path + "\n" + decoder_best.manifest_sha256 + "\n" +
                    denoiser_best.manifest_path + "\n" + denoiser_best.manifest_sha256 + "\n" +
                    (string)current_role + "\n" + (string)(uint)complete + "\n" + (string)ArraySize(history) + "\n" +
                    DPCCEpochProgressWire(decoder) + DPCCEpochProgressWire(denoiser);
      for(int i = 0; i < ArraySize(history); i++)
         text += (string)history[i].role + "\n" + (string)history[i].epoch + "\n" + (string)(
            uint)history[i].validation + "\n" +
                 StringFormat("%.17g\n", history[i].loss) + history[i].path + "\n" + history[i].sha + "\n";
      return(text + "END_DPCC_EPOCH_BOUNDARY_STATE_V1\n");
     }
   bool              PersistRunState(string &reason)
     {
      const string text = RunStateText(m_initial, m_latest, m_decoder_best, m_denoiser_best,
                                       m_decoder_progress, m_denoiser_progress, m_progress.role, m_progress.complete,
                                          m_history);
      const string path = m_stem + ".boundary" + (string)ArraySize(m_history) + ".dpccrun";
      string canonical = "", expected = "", actual = "";
      if(!DPCCCheckpointCanonicalPath(path, canonical, reason) ||
         !DPCCCheckpointTextSHA(text, expected, reason) ||
         !DPCCCheckpointWriteText(canonical, m_common, text, reason) ||
         !DPCCCheckpointFileSHA(canonical, m_common, 4194304, actual, reason) || actual != expected)
         return(Failure("epoch.runstate.publish:" + reason, reason));
      m_confirmed_path = canonical;
      m_confirmed_sha = actual;
      return(true);
     }
   bool              ReplayEpoch(const SDPCCEpochHistory &h, const SDPCCCheckpointArtifact &artifact,
                    CDPCCFrozenRolePlan &plan, const SDPCCTrainingRoleConfig &role,
                    SDPCCEpochProgress &progress, SDPCCCheckpointArtifact &best,
                    const uint other_updates, string &reason)
     {
      const int fit_count = plan.FitCount();
      if(role.max_epochs <= 0 || fit_count <= 0 || fit_count % role.max_epochs != 0 || progress.complete ||
         h.role != progress.role || h.epoch != progress.completed_epoch + 1 || (long)h.epoch > role.max_epochs ||
         artifact.cursor.stage != h.role + 1 || artifact.cursor.completed_epoch != h.epoch ||
         h.validation != DPCCEpochValidationDue(h.epoch, role))
        {reason = "epoch.resume.history_order"; return(false);}
      const uint expected_updates = h.epoch * (uint)(fit_count / role.max_epochs);
      if((h.role == 0 && (artifact.cursor.decoder_updates != expected_updates || artifact.cursor.denoiser_updates !=
         other_updates)) ||
         (h.role == 1 && (artifact.cursor.denoiser_updates != expected_updates || artifact.cursor.decoder_updates !=
            other_updates)))
        {reason = "epoch.resume.plan_update_count"; return(false);}
      double dl = 0, nl = 0;
      if(!m_examples.VerifyRunnerArtifact(artifact, dl, nl, reason))
         return(false);
      if(h.validation)
        {
         const double actual = (h.role == 0 ? dl : nl);
         if(actual != h.loss)
           {
            reason = "epoch.resume.actual_validation_loss";
            return(false);
           }
         bool improved = false;
         if(!DPCCEpochObserve(actual, role, progress, improved))
           {
            reason = "epoch.resume.validation_transition";
            return(false);
           }
         if(improved)
            best = artifact;
        }
      else
         if(h.loss != 0)
           {
            reason = "epoch.resume.unperformed_validation";
            return(false);
           }
      progress.completed_epoch = h.epoch;
      progress.fit_cursor = expected_updates;
      progress.complete = DPCCEpochFinished(h.epoch, h.validation, role, progress);
      if(progress.complete && !progress.has_best)
        {
         reason = "epoch.resume.no_best";
         return(false);
        }
      return(true);
     }
   bool              RestoreRunStateImpl(const string path, const string expected_sha, string &reason)
     {
      if(!m_initialized || !m_restore_required || m_progress.failed)
        {reason = "epoch.resume.destination"; return(false);}
      string canonical = "", observed = "", source = "";
      uchar bytes[];
      if(!DPCCResolverLowerSha256(expected_sha) || !DPCCCheckpointCanonicalPath(path, canonical, reason) ||
         !DPCCReadArtifactBytes(canonical, m_common, 4194304, bytes, reason) ||
         !DPCCSHA256Lower(bytes, observed, reason) || observed != expected_sha ||
         !DPCCStrictUtf8Decode(bytes, ArraySize(bytes), 4194304, source, reason))
        {reason = "epoch.resume.state_bytes"; return(false);}
      string fields[];
      const int size = StringSplit(source, 10, fields);
      ulong count = 0;
      if(size < 35 || fields[0] != "DPCC_EPOCH_BOUNDARY_STATE_V1" || fields[1] != m_run_binding ||
         !DPCCCheckpointReadUnsigned(fields[12], UINT_MAX, count) ||
         count > (ulong)m_decoder_role.max_epochs + (ulong)m_denoiser_role.max_epochs ||
         (ulong)size != 35 + count * 6 || fields[size - 2] != "END_DPCC_EPOCH_BOUNDARY_STATE_V1" || fields[size - 1] !=
            "")
        {reason = "epoch.resume.state_contract"; return(false);}
      SDPCCCheckpointArtifact initial, latest, decoder_best, denoiser_best;
      if(!DPCCReadCheckpointArtifact(fields[2], m_common, fields[3], initial, reason) || initial.cursor.stage != 0)
         return(false);
      double initial_dl = 0, initial_nl = 0;
      if(!m_examples.VerifyRunnerArtifact(initial, initial_dl, initial_nl, reason))
         return(false);
      latest = initial;
      ZeroMemory(decoder_best);
      ZeroMemory(denoiser_best);
      SDPCCEpochProgress decoder, denoiser;
      ZeroMemory(decoder);
      ZeroMemory(denoiser);
      denoiser.role = 1;
      SDPCCEpochHistory history[];
      if(ArrayResize(history, (int)count) != (int)count)
        {
         reason = "epoch.resume.capacity";
         return(false);
        }
      for(int i = 0; i < (int)count; i++)
        {
         const int offset = 33 + i * 6;
         ulong role = 0, epoch = 0, validation = 0;
         if(!DPCCCheckpointReadUnsigned(fields[offset], 1, role) ||
            !DPCCCheckpointReadUnsigned(fields[offset + 1], UINT_MAX, epoch) ||
            !DPCCCheckpointReadUnsigned(fields[offset + 2], 1, validation) ||
            !DPCCEpochNumber(fields[offset + 3], history[i].loss, reason))
           {reason = "epoch.resume.history_fields"; return(false);}
         history[i].role = (uint)role;
         history[i].epoch = (uint)epoch;
         history[i].validation = (bool)validation;
         history[i].path = fields[offset + 4];
         history[i].sha = fields[offset + 5];
         SDPCCCheckpointArtifact artifact;
         if(!DPCCReadCheckpointArtifact(history[i].path, m_common, history[i].sha, artifact, reason) ||
            artifact.binding_sha256 != initial.binding_sha256 ||
            artifact.initial_manifest_path != initial.manifest_path || artifact.initial_manifest_sha256 !=
               initial.manifest_sha256)
           {reason = "epoch.resume.history_native_binding"; return(false);}
         if(role == 0)
           {
            if(denoiser.completed_epoch != 0 || !ReplayEpoch(history[i], artifact, m_decoder_plan, m_decoder_role,
               decoder, decoder_best, 0, reason))
               return(false);
           }
         else
           {
            if(!decoder.complete || !ReplayEpoch(history[i], artifact, m_denoiser_plan, m_denoiser_role, denoiser,
               denoiser_best, decoder.fit_cursor, reason))
               return(false);
           }
         latest = artifact;
        }
      const uint current_role = (decoder.complete ? 1 : 0);
      const bool complete = denoiser.complete;
      if(RunStateText(initial, latest, decoder_best, denoiser_best, decoder, denoiser, current_role, complete,
         history) != source)
        {reason = "epoch.resume.replayed_state"; return(false);}
      //--- Rehash durable run state after all linked candidate probes, before adoption.
      if(!DPCCCheckpointFileSHA(canonical, m_common, 4194304, observed, reason) || observed != expected_sha)
        {reason = "epoch.resume.state_changed"; return(false);}
      if(ArrayResize(m_history, (int)count) != (int)count)
        {
         reason = "epoch.resume.adoption_capacity";
         return(false);
        }
      SDPCCCheckpointCursor restored;
      if(!m_examples.RestoreTrainingCheckpoint(latest, restored, reason))
         return(Failure("epoch.resume.native_adoption:" + reason, reason));
      //--- No fallible allocation or external checks after native pair adoption.
      m_initial = initial;
      m_latest = latest;
      m_decoder_best = decoder_best;
      m_denoiser_best = denoiser_best;
      m_decoder_progress = decoder;
      m_denoiser_progress = denoiser;
      if(current_role == 0)
         m_progress = decoder;
      else
         m_progress = denoiser;
      for(int i = 0; i < (int)count; i++)
         m_history[i] = history[i];
      m_confirmed_path = canonical;
      m_confirmed_sha = expected_sha;
      m_restore_required = false;
      return(true);
     }

   bool              AdvanceRole(CDPCCFrozenRolePlan &plan, const SDPCCTrainingRoleConfig &role,
                    const bool denoiser, string &reason)
     {
      if(m_fixed_required && !m_fixed_admitted)
         return(Failure("BLOCKED.epoch.fixed_profile_before_UPDATE", reason));
      SDPCCTrainingPlanEntry entry;
      if(!plan.Fit((int)m_progress.fit_cursor, entry))
         return(Failure("epoch.plan_cursor", reason));
      SDPCCTrainingRecordIdentity identity;
      if(!m_examples.RecordIdentity(entry.record_index, identity) || identity.window_id != entry.window_id)
         return(Failure("epoch.fit_identity", reason));
      SDPCCTrainingExampleResult result;
      bool ok = false;
      if(denoiser)
        {
         SDPCCTrainingExampleKeys keys;
         keys.j = entry.j;
         keys.repeat = entry.repeat;
         keys.seed = m_training_seed;
         keys.decision_time = identity.decision_time;
         keys.decision_identity = identity.keys.decision_identity;
         keys.context_identity = identity.keys.context_identity;
         keys.owner_identity = identity.keys.owner_identity;
         ok = m_examples.DenoiserExample(entry.record_index, DPCC_TRAIN_UPDATE, keys, result);
        }
      else
         ok = m_examples.DecoderExample(entry.record_index, DPCC_TRAIN_UPDATE, result);
      if(!ok || !result.completed || !result.update_attempted || result.updates_before == UINT_MAX ||
         result.updates_after != result.updates_before + 1 || !MathIsValidNumber(result.loss))
         return(Failure("epoch.update:" + result.reason, reason));
      //--- Only this executed native update grants advancement.
      m_progress.fit_cursor++;
      SDPCCTrainingPlanEntry next;
      const bool boundary = !plan.Fit((int)m_progress.fit_cursor, next) || next.epoch != entry.epoch;
      if(!boundary)
         return(true);
      m_progress.completed_epoch = entry.epoch;
      const bool validation = DPCCEpochValidationDue(entry.epoch, role);
      bool improved = false;
      double loss = 0;
      if(validation)
        {
         if(!ValidateRole(plan, denoiser, loss, reason))
            return(false);
         if(!DPCCEpochObserve(loss, role, m_progress, improved))
            return(Failure("epoch.validation_transition", reason));
        }
      SDPCCCheckpointArtifact artifact;
      if(!StateCheckpoint(denoiser ? 2 : 1, entry.epoch, artifact, reason))
         return(false);
      m_latest = artifact;
      if(validation && improved)
        {
         m_progress.best_loss = loss;
         m_progress.has_best = true;
         if(denoiser)
            m_denoiser_best = artifact;
         else
            m_decoder_best = artifact;
        }
      const bool finished = DPCCEpochFinished(entry.epoch, validation, role, m_progress);
      m_progress.complete = finished;
      if(denoiser)
         m_denoiser_progress = m_progress;
      else
         m_decoder_progress = m_progress;
      const int history_size = ArraySize(m_history);
      if(ArrayResize(m_history, history_size + 1) != history_size + 1)
         return(Failure("epoch.history_capacity", reason));
      m_history[history_size].role = (denoiser ? 1 : 0);
      m_history[history_size].epoch = entry.epoch;
      m_history[history_size].validation = validation;
      m_history[history_size].loss = (validation ? loss : 0);
      m_history[history_size].path = artifact.manifest_path;
      m_history[history_size].sha = artifact.manifest_sha256;
      if(finished)
        {
         if(!m_progress.has_best)
            return(Failure("epoch.no_selected_checkpoint", reason));
         if(denoiser)
            m_progress.complete = true;
         else
           {
            ZeroMemory(m_progress);
            m_progress.role = 1;
           }
        }
      return(PersistRunState(reason));
     }
public:
                     CDPCCEpochOwner(void) {m_fixed_required = false; m_fixed_admitted = false; ZeroMemory(
                        m_fixed_profile); ZeroMemory(m_fixed_receipt); m_initialized = false; m_common = false;
                        m_training_seed = 0; m_validation_seed = 0; m_restore_required = false; ZeroMemory(m_progress);
                        ZeroMemory(m_decoder_progress); ZeroMemory(m_denoiser_progress); m_denoiser_progress.role = 1;}
   bool              Initialize(const SDPCCTrainingBankSource &source, const SDPCCConfig &config,
                   const SDPCCDecoderComposition &decoder_composition, const SDPCCDenoiserComposition &composition,
                   const double &alpha[], const SDPCCTrainingFrozenRecordKeys &keys[],
                   const ulong training_seed, const ulong validation_seed, const uint validation_repeat,
                   const string package_root, const string containing_json,
                      const SDPCCResourceReference &config_reference, const SDPCCResourceReference &model_reference,
                   const string schema, const string model_schema, const string bank_schema,
                      const string dataset_schema, const string time_schema,
                   const SDPCCTrainingPlanEntry &decoder_fit[], const SDPCCTrainingPlanEntry &decoder_validation[],
                      const string decoder_plan_sha,
                   const SDPCCTrainingPlanEntry &denoiser_fit[], const SDPCCTrainingPlanEntry &denoiser_validation[],
                      const string denoiser_plan_sha,
                   const string checkpoint_stem, const ulong maximum_checkpoint_bytes, string &reason,
                      const bool for_resume = false)
     {
      SDPCCStageFitSource absent;
      ZeroMemory(absent);
      return(InitializeWithFitSource(source, config, decoder_composition, composition, alpha, keys,
                                     training_seed, validation_seed, validation_repeat, package_root, containing_json,
                                        config_reference, model_reference,
                                     schema, model_schema, bank_schema, dataset_schema, time_schema, decoder_fit,
                                        decoder_validation, decoder_plan_sha,
                                     denoiser_fit, denoiser_validation, denoiser_plan_sha, checkpoint_stem, absent,
                                        maximum_checkpoint_bytes, reason, for_resume));
     }
   bool              InitializeWithFitSource(const SDPCCTrainingBankSource &source, const SDPCCConfig &config,
                                const SDPCCDecoderComposition &decoder_composition,
                                   const SDPCCDenoiserComposition &composition,
                                const double &alpha[], const SDPCCTrainingFrozenRecordKeys &keys[],
                                const ulong training_seed, const ulong validation_seed, const uint validation_repeat,
                                const string package_root, const string containing_json,
                                   const SDPCCResourceReference &config_reference,
                                   const SDPCCResourceReference &model_reference,
                                const string schema, const string model_schema, const string bank_schema,
                                   const string dataset_schema, const string time_schema,
                                const SDPCCTrainingPlanEntry &decoder_fit[],
                                   const SDPCCTrainingPlanEntry &decoder_validation[], const string decoder_plan_sha,
                                const SDPCCTrainingPlanEntry &denoiser_fit[],
                                   const SDPCCTrainingPlanEntry &denoiser_validation[], const string denoiser_plan_sha,
                                const string checkpoint_stem, const SDPCCStageFitSource &fit_source,
                                   const ulong maximum_checkpoint_bytes, string &reason, const bool for_resume = false)
     {
      reason = "";
      if(m_initialized || m_progress.failed)
         return(Failure("epoch.destination_not_empty", reason));
      if(!m_examples.Initialize(source, config, decoder_composition, composition, composition, .008, .999, alpha, keys,
                                training_seed, validation_seed, validation_repeat, reason))
         return(Failure(reason, reason));
      if(!m_admitted.Admit(package_root, containing_json, config_reference, model_reference, source.common_files,
                           schema, model_schema, bank_schema, dataset_schema, time_schema, source, reason))
         return(Failure(reason, reason));
      //--- Actual retained Model selects the policy, not a caller config or flag.
      string actual_model = "", dataset_source = "", index_source = "", observed = "", mode = "";
      CDPCCJsonDocument model_document;
      SDPCCTrainingConfigAdmission fixed_admission;
      SDPCCTrainingRoleConfig fixed_role;
      if(!m_admitted.ModelSource(actual_model) || !model_document.Parse(actual_model, reason) ||
         !DPCCResourceReadString(model_document, model_document.FindMember(model_document.Root(), "normalization"),
                                 "statistics_source", mode, reason, "epoch.actual_normalization_source"))
         return(Failure(reason, reason));
      m_fixed_required = (mode == "FIT_FIXED");
      if(mode != "FIT_FIXED" && mode != "INPUT_WINDOW")
         return(Failure("epoch.normalization_source", reason));
      if(m_fixed_required)
        {
         if(!DPCCResolverLowerSha256(fit_source.reference.sha256) || fit_source.maximum_bytes == 0)
            return(Failure("BLOCKED.epoch.immutable_FIT_FIXED_source_before_UPDATE", reason));
         if(fit_source.common_files != source.common_files)
            return(Failure("BLOCKED.epoch.fixed_source_namespace", reason));
         if(!m_admitted.Get(DPCC_ROLE_DECODER, fixed_admission, fixed_role) ||
            !DPCCDatasetReadSource(source.links.dataset_path, source.common_files, fixed_admission.dataset_sha256,
               dataset_source, observed, reason, "epoch.fit.dataset") ||
            !DPCCDatasetReadSource(source.links.time_index_path, source.common_files, fixed_admission.time_index_sha256,
               index_source, observed, reason, "epoch.fit.index"))
            return(Failure(reason, reason));
         uint db = 0, nb = 0, da = 0, na = 0;
         ulong ds = 0, ns = 0, dsa = 0, nsa = 0;
         if(!m_examples.NativeState(db, nb, ds, ns))
            return(Failure("epoch.fit.initial_native_state", reason));
         CDPCCFullFitNormalization prepared;
         SDPCCStageFitReceipt fit_receipt;
         float profile[];
         if(!DPCCStageFitPrepare(fit_source, actual_model, fixed_admission, dataset_source, index_source, prepared,
            fit_receipt, reason) ||
            !prepared.PreparedTrainingPriceNorm(profile, reason) ||
            !m_examples.CheckFixedPriceNorm(profile, fit_receipt.data_cutoff, reason))
            return(Failure(reason, reason));
         if(!m_examples.NativeState(da, na, dsa, nsa) || db != da || nb != na || ds != dsa || ns != nsa)
            return(Failure("epoch.fit.admission_mutated_native_state", reason));
         for(int i = 0; i < 16; i++)
            m_fixed_profile[i] = profile[i];
         m_fixed_receipt = fit_receipt;
         m_fixed_admitted = true;
        }
      if(!m_decoder_plan.Admit(m_admitted, DPCC_ROLE_DECODER, config.shape.J, m_examples, 0, decoder_fit,
         decoder_validation, decoder_plan_sha, reason) ||
         !m_denoiser_plan.Admit(m_admitted, DPCC_ROLE_DENOISER, config.shape.J, m_examples, validation_repeat,
            denoiser_fit, denoiser_validation, denoiser_plan_sha, reason))
         return(Failure(reason, reason));
      SDPCCTrainingConfigAdmission receipts, denoiser_receipts;
      if(!m_admitted.Get(DPCC_ROLE_DECODER, receipts, m_decoder_role) ||
         !m_admitted.Get(DPCC_ROLE_DENOISER, denoiser_receipts, m_denoiser_role))
         return(Failure("epoch.config_copy", reason));
      SDPCCCheckpointBinding binding;
      binding.training_config_sha256 = receipts.source_sha256;
      binding.model_manifest_sha256 = receipts.model_sha256;
      binding.bank_manifest_sha256 = receipts.bank_manifest_sha256;
      binding.dataset_manifest_sha256 = receipts.dataset_sha256;
      binding.time_index_sha256 = receipts.time_index_sha256;
      binding.normalization_section_sha256 = receipts.normalization_section_sha256;
      binding.decoder_plan_sha256 = m_decoder_plan.Digest();
      binding.denoiser_plan_sha256 = m_denoiser_plan.Digest();
      if(!m_examples.BindCheckpointMetadata(binding, maximum_checkpoint_bytes, reason))
         return(Failure(reason, reason));
      m_stem = checkpoint_stem;
      m_common = source.common_files;
      m_training_seed = training_seed;
      m_validation_seed = validation_seed;
      m_actor_maximum_bytes = maximum_checkpoint_bytes;
      string binding_wire = "DPCC_EPOCH_BINDING_V1\n" + binding.training_config_sha256 + "\n" +
         binding.model_manifest_sha256 + "\n" +
                            binding.bank_manifest_sha256 + "\n" + binding.dataset_manifest_sha256 + "\n" +
                               binding.time_index_sha256 + "\n" +
                            binding.normalization_section_sha256 + "\n" + binding.decoder_plan_sha256 + "\n" +
                               binding.denoiser_plan_sha256 + "\n";
      if(m_fixed_required)
         binding_wire += "DPCC_EPOCH_FIXED_PROFILE_V1\n" + m_fixed_receipt.payload_sha256 + "\n" +
                         m_fixed_receipt.fit_rows_sha256 + "\n" + m_fixed_receipt.calculation_profile + "\n" +
                         m_fixed_receipt.calculation_source_sha256 + "\n" + m_fixed_receipt.statistics_sha256 + "\n" +
                         (string)m_fixed_receipt.data_cutoff + "\n";
      if(!DPCCCheckpointTextSHA(binding_wire, m_run_binding, reason))
         return(Failure(reason, reason));
      m_restore_required = for_resume;
      if(for_resume)
        {
         m_initialized = true;
         return(true);
        }
      if(!StateCheckpoint(0, 0, m_initial, reason))
         return(false);
      m_latest = m_initial;
      m_initialized = true;
      return(PersistRunState(reason));
     }
   bool              ConfirmedBoundary(string &path, string &sha)
     {path = m_confirmed_path; sha = m_confirmed_sha; return(m_initialized && !m_restore_required &&
        !m_progress.failed && StringLen(sha) > 0);}
   bool              RestoreConfirmedBoundary(const string path, const string sha, string &reason)
     {reason = "";   return(RestoreRunStateImpl(path, sha, reason));}
   bool              RejectedInitializationNativeState(uint &decoder_updates, uint &denoiser_updates,
      ulong &decoder_state, ulong &denoiser_state)
                     {return(m_progress.failed && m_examples.NativeState(decoder_updates, denoiser_updates,
                        decoder_state, denoiser_state));}
   bool              NativeFingerprint(uint &decoder_updates, uint &denoiser_updates, ulong &decoder_state,
      ulong &denoiser_state)
                     {return(m_initialized && !m_restore_required && !m_progress.failed && m_examples.NativeState(
                        decoder_updates, denoiser_updates, decoder_state, denoiser_state));}
   bool              NormalizationStatisticsSource(string &mode, string &reason)
     {
      mode = "";
      string source = "";
      CDPCCJsonDocument model;
      if(!m_initialized || m_restore_required || m_progress.failed || !m_admitted.ModelSource(source) || !model.Parse(
         source, reason))
        {reason = "study.normalization_actual_Model_required"; return(false);}
      if(!DPCCResourceReadString(model, model.FindMember(model.Root(), "normalization"), "statistics_source", mode,
         reason, "study.normalization_source"))
         return(false);
      if(mode != "INPUT_WINDOW" && mode != "FIT_FIXED")
        {reason = "study.normalization_source_unsupported"; return(false);}
      return(true);
     }
   bool              PrepareSelectedActorFullFit(CNet &net, const SDPCCStageFitSource &fit_source,
                                    const string dataset_path, const string time_index_path,
                                    SDPCCConfig &config, float &limits[], CNeuronDPCCOCL *&actor,
                                    SDPCCStageFitReceipt &fit_receipt, string &reason)
     {
      actor = NULL;
      ZeroMemory(fit_receipt);
      reason = "";
      if(!m_initialized || m_restore_required || m_progress.failed || !m_progress.complete)
        {reason = "actor.owner_run_not_selected"; return(false);}
      if(fit_source.common_files != m_common)
         return(DPCCStageFitBlocked("owner_namespace", reason));
      SDPCCConfig training;
      SDPCCDecoderComposition decoder;
      SDPCCDenoiserComposition denoiser;
      SDPCCTrainingConfigAdmission receipt;
      SDPCCTrainingRoleConfig role;
      string model_source = "", dataset_source = "", index_source = "", observed = "";
      double beta[], alpha[], sigma[], dl = 0, nl = 0;
      if(!m_examples.PreparedActorContract(training, decoder, denoiser, reason) ||
         !m_admitted.ModelSource(model_source) || !m_admitted.Get(DPCC_ROLE_DECODER, receipt, role) ||
         !DPCCDatasetReadSource(dataset_path, m_common, receipt.dataset_sha256, dataset_source, observed, reason,
            "study_fit.dataset") ||
         !DPCCDatasetReadSource(time_index_path, m_common, receipt.time_index_sha256, index_source, observed, reason,
            "study_fit.index") ||
         !DPCCDecodePreparedActorConfig(model_source, training, config, limits, reason) ||
         !DPCCBuildCosineDiffusionSchedule(config.shape.J, receipt.model_binding.schedule_s,
            receipt.model_binding.beta_cap, beta, alpha, sigma, reason) ||
         !m_examples.VerifyRunnerArtifact(m_decoder_best, dl, nl, reason) ||
         !m_examples.VerifyRunnerArtifact(m_denoiser_best, dl, nl, reason))
         return(false);
      CDPCCFullFitNormalization prepared;
      if(!DPCCStageFitPrepare(fit_source, model_source, receipt, dataset_source, index_source, prepared, fit_receipt,
         reason))
         return(false);
      if(!m_fixed_admitted || fit_receipt.payload_sha256 != m_fixed_receipt.payload_sha256 ||
         fit_receipt.statistics_sha256 != m_fixed_receipt.statistics_sha256 || fit_receipt.data_cutoff !=
            m_fixed_receipt.data_cutoff)
         return(DPCCStageFitBlocked("original_preUPDATE_profile_binding", reason));
      float assembly_profile[];
      if(!prepared.PreparedTrainingPriceNorm(assembly_profile, reason))
         return(false);
      for(int i = 0; i < 16; i++)
        {
         URAGFloatBits a, b;
         a.value = assembly_profile[i];
         b.value = m_fixed_profile[i];
         if(a.bits != b.bits)
            return(DPCCStageFitBlocked("original_preUPDATE_profile_bits", reason));
        }
      return(prepared.AssembleSelected(net, training, config, decoder, denoiser, beta, alpha, sigma,
                                       m_decoder_best, m_denoiser_best, m_initial.binding_sha256, m_actor_maximum_bytes,
                                          actor, reason));
     }
   bool              PrepareSelectedActor(CNet &net, const int normalization_record, SDPCCConfig &config,
      float &limits[],
                             float &causal_price_norm[], CNeuronDPCCOCL *&actor, string &reason)
     {
      actor = NULL;
      reason = "";
      if(!m_initialized || m_restore_required || m_progress.failed || !m_progress.complete)
        {reason = "actor.owner_run_not_selected"; return(false);}
      string statistics_source = "";
      if(!NormalizationStatisticsSource(statistics_source, reason))
         return(false);
      if(statistics_source != "INPUT_WINDOW")
         return(DPCCStageFitBlocked("FIT_FIXED_requires_whole_fit_source_not_record", reason));
      SDPCCConfig training;
      SDPCCDecoderComposition decoder;
      SDPCCDenoiserComposition denoiser;
      string model_source = "";
      double beta[], alpha[], sigma[], dl = 0, nl = 0;
      SDPCCTrainingConfigAdmission receipt;
      SDPCCTrainingRoleConfig role;
      if(!m_examples.PreparedActorProfile(normalization_record, training, decoder, denoiser, causal_price_norm,
         reason) ||
         !m_admitted.ModelSource(model_source) || !m_admitted.Get(DPCC_ROLE_DECODER, receipt, role) ||
         !DPCCDecodePreparedActorConfig(model_source, training, config, limits, reason) ||
         !DPCCBuildCosineDiffusionSchedule(config.shape.J, receipt.model_binding.schedule_s,
            receipt.model_binding.beta_cap, beta, alpha, sigma, reason) ||
         !m_examples.VerifyRunnerArtifact(m_decoder_best, dl, nl, reason) ||
         !m_examples.VerifyRunnerArtifact(m_denoiser_best, dl, nl, reason))
         return(false);
      return(DPCCAssembleSelectedCheckpoints(net, training, config, decoder, denoiser, beta, alpha, sigma,
                                             m_decoder_best, m_denoiser_best, m_initial.binding_sha256,
                                                causal_price_norm, m_actor_maximum_bytes, actor, reason));
     }
   //--- Stage authority derives only from the executed private role progress.
   bool              AdvanceDecoder(string &reason)
     {
      reason = "";
      if(!m_initialized || m_restore_required || m_progress.failed || m_progress.complete || m_progress.role != 0)
        {reason = "epoch.decoder_not_running"; return(false);}
      return(AdvanceRole(m_decoder_plan, m_decoder_role, false, reason));
     }
   bool              AdvanceDenoiser(string &reason)
     {
      reason = "";
      if(!m_initialized || m_restore_required || m_progress.failed || m_progress.complete || m_progress.role != 1 ||
         !m_decoder_progress.complete || !m_decoder_progress.has_best)
        {reason = "epoch.denoiser_not_running"; return(false);}
      return(AdvanceRole(m_denoiser_plan, m_denoiser_role, true, reason));
     }
   bool              DecoderSelection(SDPCCCheckpointArtifact &artifact, double &normalized_loss, string &reason)
     {
      ZeroMemory(artifact);
      normalized_loss = 0;
      reason = "";
      if(!DecoderSelectionBinding(reason))
         return(false);
      double denoiser_loss = 0;
      if(!m_examples.VerifyRunnerArtifact(m_decoder_best, normalized_loss, denoiser_loss, reason))
         return(false);
      if(normalized_loss != m_decoder_progress.best_loss)
        {reason = "epoch.decoder_selected_loss"; return(false);}
      artifact = m_decoder_best;
      return(true);
     }
   int               DecoderValidationCount(void)
                     {return(m_initialized && !m_restore_required && !m_progress.failed && m_decoder_progress.complete ?
                        m_decoder_plan.ValidationCount() : 0);}
   bool              BeginDecoderInference(string &reason)
     {
      if(!DecoderSelectionBinding(reason))
         return(false);
      return(m_examples.BeginSelectedDecoderInference(m_decoder_best, reason));
     }
   bool              DecoderInferenceObservation(const int record_index, SDPCCDecoderInferenceObservation &out,
      string &reason)
     {
      out.record_index = -1;
      out.window_id = "";
      out.selected_manifest_sha = "";
      out.decision_time = 0;
      ArrayResize(out.normalized, 0);
      return(m_examples.InferSelectedDecoderRow(record_index, out, reason));
     }
   bool              EndDecoderInference(string &reason)
     {
      return(m_examples.EndSelectedDecoderInference(reason));
     }
   bool              DecoderValidationObservation(const int ordinal, SDPCCDecoderValidationObservation &out,
      string &reason)
     {
      out.record_index = -1;
      out.window_id = "";
      out.selected_manifest_sha = "";
      out.normalized_loss = 0;
      ArrayResize(out.normalized, 0);
      ArrayResize(out.native_ohlc, 0);
      ArrayResize(out.causal_price_norm, 0);
      SDPCCTrainingPlanEntry entry;
      if(!DecoderSelectionBinding(reason) || !m_decoder_plan.Validation(ordinal, entry))
        {if(StringLen(reason) == 0)reason = "epoch.decoder_validation_ordinal"; return(false);}
      return(m_examples.ObserveSelectedDecoder(m_decoder_best, entry.record_index, out, reason));
     }
   bool              DecoderValidationStream(const string path, SDPCCCheckpointArtifact &selected, double &mean,
      uint &records,
                                ulong &bytes, string &sha, string &reason)
     {
      ZeroMemory(selected);
      mean = 0;
      records = 0;
      bytes = 0;
      sha = "";
      if(!DecoderSelectionBinding(reason))
         return(false);
      const int count = m_decoder_plan.ValidationCount();
      int indices[];
      if(count <= 0 || ArrayResize(indices, count) != count)
        {
         reason = "epoch.decoder_stream.plan_capacity";
         return(false);
        }
      for(int i = 0; i < count; i++)
        {
         SDPCCTrainingPlanEntry entry;
         if(!m_decoder_plan.Validation(i, entry))
           {
            reason = "epoch.decoder_stream.private_ordinal";
            return(false);
           }
         indices[i] = entry.record_index;
        }
      if(!m_examples.StreamSelectedDecoder(m_decoder_best, indices, path, m_actor_maximum_bytes, mean, records, bytes,
         sha, reason))
         return(false);
      if(mean != m_decoder_progress.best_loss)
        {
         reason = "epoch.decoder_stream.selected_mean";
         return(false);
        }
      selected = m_decoder_best;
      return(true);
     }
   uint              DecoderValidationNativeLoads(void) {return(m_examples.DecoderValidationNativeLoads());}
   bool              RoleProgress(const ENUM_DPCC_TRAIN_ROLE role, SDPCCEpochProgress &progress)
     {
      ZeroMemory(progress);
      if(!m_initialized || m_restore_required || m_progress.failed)
         return(false);
      if(role == DPCC_ROLE_DECODER)
         progress = m_decoder_progress;
      else
         if(role == DPCC_ROLE_DENOISER)
            progress = m_denoiser_progress;
         else
            return(false);
      return(true);
     }
   //--- Read-only access to the rows admitted by this epoch owner.
   bool              AdmittedRecordCount(int &count, string &reason) const
     {
      count = 0;
      reason = "";
      if(!m_initialized)
        {reason = "epoch.not_initialized"; return(false);}
      if(m_restore_required)
        {reason = "epoch.restore_required"; return(false);}
      if(m_progress.failed)
        {reason = "epoch.failed"; return(false);}
      return(m_examples.AdmittedRecordCount(count, reason));
     }
   bool              CopyAdmittedRecord(const int index, SDPCCMaterializedRecord &record, string &reason) const
     {
      DPCCClearMaterializedRecord(record);
      reason = "";
      if(!m_initialized)
        {reason = "epoch.not_initialized"; return(false);}
      if(m_restore_required)
        {reason = "epoch.restore_required"; return(false);}
      if(m_progress.failed)
        {reason = "epoch.failed"; return(false);}
      return(m_examples.CopyAdmittedRecord(index, record, reason));
     }
   bool              Advance(string &reason)
     {
      reason = "";
      if(!m_initialized || m_restore_required || m_progress.failed || m_progress.complete)
        {
         reason = "epoch.not_running";
         return(false);
        }
      if(m_progress.role == 0)
         return(AdvanceRole(m_decoder_plan, m_decoder_role, false, reason));
      return(AdvanceRole(m_denoiser_plan, m_denoiser_role, true, reason));
     }
   bool              Progress(SDPCCEpochProgress &progress)
     {
      progress = m_progress;
      ulong ds = 0, ns = 0;
      return(m_initialized && m_examples.NativeState(progress.decoder_updates, progress.denoiser_updates, ds, ns));
     }
   bool              Selected(const ENUM_DPCC_TRAIN_ROLE role, SDPCCCheckpointArtifact &artifact)
     {
      ZeroMemory(artifact);
      if(!m_initialized || m_restore_required || m_progress.failed || !m_progress.complete)
         return(false);
      if(role == DPCC_ROLE_DECODER)
         artifact = m_decoder_best;
      else
         if(role == DPCC_ROLE_DENOISER)
            artifact = m_denoiser_best;
         else
            return(false);
      return(StringLen(artifact.manifest_sha256) > 0);
     }
  };
#endif
//--- This is a typed call input, not a readiness receipt or an alternative manifest schema.
//--- Loader fills actual resolved data, explicit immutable keys/tables and pinned schema bytes.
struct SDPCCStudyStageInput
  {
   SDPCCTrainingBankSource source;
   SDPCCConfig       config;
   SDPCCDecoderComposition decoder;
   SDPCCDenoiserComposition denoiser;
   double            alpha[];
   SDPCCTrainingFrozenRecordKeys keys[];
   ulong             training_seed, validation_seed;
   uint              validation_repeat;
   string            package_root, containing_json;
   SDPCCResourceReference training_reference, model_reference;
   string            training_schema, model_schema, bank_schema, dataset_schema, time_index_schema;
   SDPCCTrainingPlanEntry decoder_fit[], decoder_validation[], denoiser_fit[], denoiser_validation[];
   string            decoder_plan_sha, denoiser_plan_sha, checkpoint_stem;
   ulong             maximum_checkpoint_bytes;
   string            boundary_path, boundary_sha, selected_decoder_path, selected_decoder_sha;
   string            result_path, actor_path;
   int               normalization_record;
   SDPCCStageFitSource fit_source;
   SDPCCOfflinePolicyProfile offline_policy;
   SDPCCOfflineFitKey offline_fit[];
   SDPCCOfflinePolicyAdmission offline_admission;
   SDPCCClockIdentity offline_clock_identity;
   bool              offline_clock_historical_policy;
   bool              offline_clock_server_calendar;
   SDPCCResourceReference offline_clock_map, offline_clock_index, offline_reviewed_origin;
   bool              offline_resume;
   SDPCCResourceReference offline_resume_manifest;
   string            offline_checkpoint_stem;
   //--- Optional copy from the same authoritative loader admission; no second bank parser.
   SDPCCMaterializedRecord online_records[];
   SDPCCOfflineFitWitness online_witnesses[];
  };
//--- Direct-history rows contain financial context only; no behavior actions or rewards.
struct SDPCCOracleHistoryRow
  {
   long              decision_bar;
   float             context[], native_ohlc[];
   long              timeline_opens[], timeline_closes[];
   string            time_domain;
  };
struct SDPCCOracleHistoryInput
  {
   SDPCCConfig       config;
   ENUM_TIMEFRAMES   timeframe;
   double            actor_beta[], actor_alpha_bar[], actor_sigma[];
   SDPCCStudyStageInput clock;
   //--- Raw source plus decision indices; one financial row is built per step.
   SDPCCStudyForecastBar raw_bars[];
   int               fit_indices[];
   long              decision_bars[];
   SDPCCHistoricalFinancialProfile financial_profile;
   float             deltas[];
   string            model_sha, model_text, rows_sha, raw_sha, raw_path, raw_indicator_params, output_stem,
      execution_sha, source_server;
   long              raw_successor_open_server;
   string            source_labels[], source_paths[], source_hashes[];
   string            config_sha, deltas_sha;
  };
//+------------------------------------------------------------------+
//| Canonical history config includes every native fixed-profile     |
//| field                                                            |
//+------------------------------------------------------------------+
bool DPCCOracleHistoryConfigSHA(const SDPCCConfig &config, string &sha, string &reason)
  {
   string wire = "DPCC_ORACLE_HISTORY_CONFIG_V1\n";
   const long integers[] = {config.shape.K, config.shape.V, config.shape.H, config.shape.D,
                            config.shape.M, config.shape.J, config.shape.E, config.shape.PlanBatch,
                               config.shape.NActions,
                            config.shape.StateSize, config.shape.Embedding, config.shape.Heads,
                               config.shape.KeyDimension,
                            config.shape.Depth, config.contract_version, config.binary_layer_version, (long)config.mode,
                            config.projection_max_iterations, config.projection_max_evaluations,
                               config.projection_lookback_steps,
                            config.price_basis, config.quote_adapter, config.event_model, config.risk_type,
                               config.normalization_mode,
                            config.loss_coordinates, config.randomness_version, config.margin_fx_profile,
                               config.account_currency_digits
                           };
   for(int i = 0; i < ArraySize(integers); i++)
      DPCCOfflineField(wire, (string)integers[i]);
   const double reals[] = {config.projection_improvement_atol, config.projection_distance_tie_atol,
                           config.volume_scale, config.price_scale, config.money_scale, config.max_quote_age_seconds,
                           config.max_last_age_seconds
                          };
   for(int i = 0; i < ArraySize(reals); i++)
     {
      if(!MathIsValidNumber(reals[i]))
        {
         reason = "study.history.config_nonfinite";
         return(false);
        }
      DPCCOfflineField(wire, StringFormat("%.17g", reals[i]));
     }
   const float scalars[] = {config.risk_parameter, config.mean_weight, config.gamma, config.probability_tolerance};
   if(!DPCCOfflineFloats(wire, scalars, reason) || !DPCCOfflineFloats(wire, config.action_bias, reason) ||
      !DPCCOfflineFloats(wire, config.action_scale, reason))
      return(false);
   return(DPCCCheckpointTextSHA(wire, sha, reason));
  }
//+------------------------------------------------------------------+
//| Function DPCCOracleHistoryDeltasSHA                              |
//+------------------------------------------------------------------+
bool DPCCOracleHistoryDeltasSHA(const float &deltas[], string &sha, string &reason)
  {
   string wire = "DPCC_ORACLE_HISTORY_ORACLE_DELTAS_V1\n";
   return(ArraySize(deltas) == 6 && DPCCOfflineFloats(wire, deltas, reason) &&
          DPCCCheckpointTextSHA(wire, sha, reason));
  }
#endif
//--- Internal call envelope only. Normative artifact validation stays in DPCC.
//--- A trusted expected envelope SHA pins external review claims, keys and tables.
bool DPCCStageBlocked(string &reason, const string prerequisite)
  {
   reason = "BLOCKED:study_input." + prerequisite;
   return(false);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageGate                                           |
//+------------------------------------------------------------------+
bool DPCCStageGate(string &reason, const string name, const ENUM_DPCC_GATE_VERDICT verdict)
  {
   reason = (verdict == DPCC_GATE_FAIL ? "FAIL:" : "BLOCKED:") + "study_input." + name + "." + reason;
   return(false);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageResolve                                        |
//+------------------------------------------------------------------+
bool DPCCStageResolve(CDPCCJsonDocument &d, const int object, const string name,
                      const string root, const string containing, const bool common,
                      SDPCCArtifactResolveResult &artifact, string &text, string &reason)
  {
   SDPCCResourceReference reference;
   text = "";
   if(!DPCCBankReadReference(d, object, name, reference, reason, "study_input." + name) ||
      !DPCCResolveArtifact(root, containing, reference, common, DPCC_RESOLVER_MAX_JSON_BYTES, artifact, reason) ||
      !DPCCCentralBytesSource(artifact.bytes, text, reason, name))
      return(false);
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageSchema                                         |
//+------------------------------------------------------------------+
bool DPCCStageSchema(CDPCCJsonDocument &d, const int schemas, const string name, const string pin,
                     const string root, const string containing, const bool common, string &text, string &reason)
  {
   SDPCCArtifactResolveResult artifact;
   if(!DPCCStageResolve(d, schemas, name, root, containing, common, artifact, text, reason))
      return(false);
   if(artifact.observed_sha256 != pin)
      return(DPCCStageBlocked(reason, "schema_pin." + name));
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageReadHex                                        |
//+------------------------------------------------------------------+
bool DPCCStageReadHex(CDPCCJsonDocument &d, const int object, const string name, ulong &value, string &reason)
  {
   string text = "";
   value = 0;
   if(!DPCCResourceReadString(d, object, name, text, reason, "study_input." + name) || StringLen(text) != 16)
      return(DPCCStageBlocked(reason, "hex16." + name));
   for(int i = 0; i < 16; i++)
     {
      const ushort ch = StringGetCharacter(text, i);
      if(!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')))
         return(DPCCStageBlocked(reason, "hex16." + name));
      value = (value << 4) | (ulong)(ch <= '9' ? ch - '0' : ch - 'a' + 10);
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageReadUnsigned                                   |
//+------------------------------------------------------------------+
bool DPCCStageReadUnsigned(CDPCCJsonDocument &d, const int object, const string name,
                           const ulong maximum, ulong &value, string &reason)
  {
   const int node = d.FindMember(object, name);
   if(d.Type(node) != DPCC_JSON_NUMBER || !DPCCCheckpointReadUnsigned(d.Text(node), maximum, value))
      return(DPCCStageBlocked(reason, "unsigned." + name));
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageOutputPath                                     |
//+------------------------------------------------------------------+
bool DPCCStageOutputPath(CDPCCJsonDocument &d, const int object, const string name,
                         const string root, const string containing, string &path, string &reason)
  {
   string supplied = "";
   if(!DPCCResourceReadString(d, object, name, supplied, reason, "study_input." + name) ||
      !DPCCNormalizePackagePath(root, containing, supplied, path, reason))
      return(false);
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageSamePath                                       |
//+------------------------------------------------------------------+
bool DPCCStageSamePath(const string path_a, const string path_b)
  {
   return(StringCompare(path_a, path_b, false) == 0);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageNormalizeReviewedOrigin                        |
//+------------------------------------------------------------------+
bool DPCCStageNormalizeReviewedOrigin(const string package_root, const string containing_json,
                                      SDPCCResourceReference &origin, string &reason)
  {
   string canonical = "", relative = "";
   if(!DPCCNormalizePackagePath(package_root, containing_json, origin.path, canonical, reason) ||
      !DPCCRunContainingArtifact(package_root, canonical, relative, reason))
      return(false);
   origin.path = relative;
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageReadOfflineClock                               |
//+------------------------------------------------------------------+
bool DPCCStageReadOfflineClock(CDPCCJsonDocument &d, const int object, const string package_root,
                               const string containing_json, SDPCCStudyStageInput &out, string &reason)
  {
   ZeroMemory(out.offline_clock_identity);
   ZeroMemory(out.offline_reviewed_origin);
   out.offline_clock_historical_policy = false;
   const int node = d.FindMember(object, "offline_clock");
   if(d.Type(node) != DPCC_JSON_OBJECT)
      return(DPCCStageBlocked(reason, "offline_clock_identity_and_origin"));
   const int scope_node = d.FindMember(node, "mapping_scope");
   string mapping_scope = "ACCOUNT_OBSERVED_V1";
   if(scope_node >= 0 &&
      !DPCCResourceReadString(d, node, "mapping_scope", mapping_scope, reason, "offline_clock.mapping_scope"))
      return(DPCCStageBlocked(reason, "offline_clock_mapping_scope"));
   if(mapping_scope != "ACCOUNT_OBSERVED_V1" && mapping_scope != "HISTORICAL_POLICY_V1")
      return(DPCCStageBlocked(reason, "offline_clock_mapping_scope"));
   const bool historical_policy = (mapping_scope == "HISTORICAL_POLICY_V1");
   const int login_node = d.FindMember(node, "account_login");
   const int expected_children = (historical_policy ? 4 : (scope_node >= 0 ? 5 : 4));
   if(d.ChildCount(node) != expected_children ||
      !DPCCResourceReadString(d, node, "broker_server", out.offline_clock_identity.broker_server, reason,
         "offline_clock") ||
      !DPCCResourceReadString(d, node, "broker_domain", out.offline_clock_identity.broker_domain, reason,
         "offline_clock") ||
      !DPCCBankReadReference(d, node, "reviewed_origin", out.offline_reviewed_origin, reason,
         "offline_clock.reviewed_origin"))
      return(DPCCStageBlocked(reason, "offline_clock_identity_and_origin"));
   if(historical_policy)
     {
      if(login_node >= 0)
         return(DPCCStageBlocked(reason, "offline_clock_policy_must_not_bind_account"));
     }
   else
      if(login_node < 0 || !DPCCResourceReadLong(d, node, "account_login", out.offline_clock_identity.account_login,
         reason, "offline_clock.account_login"))
         return(DPCCStageBlocked(reason, "offline_clock_identity_and_origin"));
   if(StringLen(out.offline_clock_identity.broker_server) == 0 ||
      out.offline_clock_identity.broker_domain != "BROKER_SERVER_SECONDS_V1" ||
      (historical_policy ? out.offline_clock_identity.account_login != 0 : out.offline_clock_identity.account_login <=
         0) ||
      StringLen(out.offline_reviewed_origin.path) == 0 || StringLen(out.offline_reviewed_origin.id) == 0 ||
      !DPCCResolverLowerSha256(out.offline_reviewed_origin.sha256))
      return(DPCCStageBlocked(reason, "offline_clock_identity_and_origin"));
   out.offline_clock_historical_policy = historical_policy;
   if(!DPCCStageNormalizeReviewedOrigin(package_root, containing_json, out.offline_reviewed_origin, reason))
      return(DPCCStageBlocked(reason, "offline_reviewed_origin_path"));
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageReadOfflineOutputs                             |
//+------------------------------------------------------------------+
bool DPCCStageReadOfflineOutputs(CDPCCJsonDocument &d, const int outputs, const string root, const string containing,
                                 const bool common, SDPCCStudyStageInput &out, string &reason)
  {
   out.offline_resume = false;
   ZeroMemory(out.offline_resume_manifest);
   out.offline_checkpoint_stem = "";
   const int node = d.FindMember(outputs, "offline");
   if(d.Type(node) != DPCC_JSON_OBJECT || d.ChildCount(node) != 2 ||
      !DPCCStageOutputPath(d, node, "checkpoint_stem", root, containing, out.offline_checkpoint_stem, reason))
      return(DPCCStageBlocked(reason, "offline_checkpoint_output"));
   if(DPCCStageSamePath(out.offline_checkpoint_stem, out.checkpoint_stem) || DPCCStageSamePath(
      out.offline_checkpoint_stem, out.result_path))
      return(DPCCStageBlocked(reason, "offline_checkpoint_distinct_from_epoch_outputs"));
   const int resume = d.FindMember(node, "resume_manifest");
   if(resume < 0)
      return(DPCCStageBlocked(reason, "offline_resume_manifest_explicit_null_or_reference"));
   if(d.Type(resume) == DPCC_JSON_NULL)
      return(true);
   SDPCCArtifactResolveResult manifest;
   string ignored = "";
   if(d.Type(resume) != DPCC_JSON_OBJECT || d.ChildCount(resume) != 3 ||
      !DPCCStageResolve(d, node, "resume_manifest", root, containing, common, manifest, ignored, reason))
      return(DPCCStageBlocked(reason, "offline_trusted_resume_manifest"));
   if(DPCCStageSamePath(manifest.canonical_path, out.offline_checkpoint_stem) || DPCCStageSamePath(
      manifest.canonical_path, out.result_path))
      return(DPCCStageBlocked(reason, "offline_resume_output_collision"));
   out.offline_resume = true;
   if(!DPCCBankReadReference(d, node, "resume_manifest", out.offline_resume_manifest, reason,
      "outputs.offline.resume_manifest"))
      return(DPCCStageBlocked(reason, "offline_trusted_resume_manifest"));
   out.offline_resume_manifest.path = manifest.canonical_path;
   out.offline_resume_manifest.sha256 = manifest.observed_sha256;
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageAdmitOfflineClock                              |
//+------------------------------------------------------------------+
bool DPCCStageAdmitOfflineClock(const string root, const bool common, SDPCCStudyStageInput &out, string &reason)
  {
   string dataset_container = "", map_relative = "", index_relative = "";
   if(!DPCCRunContainingArtifact(root, out.source.links.dataset_path, dataset_container, reason))
      return(DPCCStageBlocked(reason, "offline_dataset_container"));
   SDPCCArtifactResolveResult map_artifact, index_artifact;
   if(!DPCCResolveArtifact(root, dataset_container, out.source.dataset.timezone_mapping, common,
                           DPCC_RESOLVER_MAX_JSON_BYTES, map_artifact, reason) ||
      !DPCCResolveArtifact(root, dataset_container, out.source.dataset.time_index, common,
                           DPCC_RESOLVER_MAX_JSON_BYTES, index_artifact, reason))
      return(DPCCStageBlocked(reason, "offline_dataset_clock_artifacts"));
   if(map_artifact.canonical_path == "" || index_artifact.canonical_path != out.source.links.time_index_path ||
      index_artifact.observed_sha256 != out.source.links.time_index_sha256 ||
      out.source.time_index.time_index_id != out.source.links.time_index_id ||
      out.source.time_index.dataset_id != out.source.links.dataset_id ||
      out.source.time_index.timezone_mapping.id != out.source.dataset.timezone_mapping.id ||
      out.source.time_index.timezone_mapping.sha256 != out.source.dataset.timezone_mapping.sha256 ||
      !DPCCRunContainingArtifact(root, map_artifact.canonical_path, map_relative, reason) ||
      !DPCCRunContainingArtifact(root, index_artifact.canonical_path, index_relative, reason))
      return(DPCCStageBlocked(reason, "offline_clock_dataset_index_binding"));
   out.offline_clock_map = out.source.dataset.timezone_mapping;
   out.offline_clock_map.path = map_relative;
   out.offline_clock_index = out.source.dataset.time_index;
   out.offline_clock_index.path = index_relative;
   CDPCCMarketClock clock;
   bool clock_ready = false;
   if(out.offline_clock_historical_policy)
      clock_ready = clock.InitializeHistoricalPolicy(root, "root.json", out.offline_clock_map, out.offline_clock_index,
                    out.offline_reviewed_origin, out.offline_clock_identity, common, reason);
   else
      clock_ready = clock.Initialize(root, "root.json", out.offline_clock_map, out.offline_clock_index,
                                     out.offline_reviewed_origin, out.offline_clock_identity, common, false, reason);
   if(!clock_ready)
      return(DPCCStageBlocked(reason, "offline_reviewed_clock_identity_origin_and_index"));
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageExternalReview                                 |
//+------------------------------------------------------------------+
bool DPCCStageExternalReview(CDPCCJsonDocument &envelope, CDPCCJsonDocument &report,
                             const string root, const string containing, const bool common, string &reason)
  {
   string policy = "";
   if(!DPCCResourceReadString(envelope, envelope.Root(), "external_review_policy", policy, reason,
      "study_input.external_review_policy") ||
      policy != "TRUST_PINNED_REVIEWED_BASELINE_EXECUTION_V1")
      return(DPCCStageBlocked(reason, "externally_reviewed_baseline_execution_policy"));
   const string names[] = {"baseline", "execution"};
   for(int gate = 0; gate < 2; gate++)
     {
      const int node = report.FindMember(report.Root(), names[gate]);
      string verdict = "", explanation = "";
      if(!DPCCResourceReadString(report, node, "verdict", verdict, reason, names[gate]) || verdict != "PASS" ||
         !DPCCResourceReadString(report, node, "reason", explanation, reason, names[gate]) || !DPCCDataNonemptyText(
            explanation))
         return(DPCCStageBlocked(reason, "external_claim." + names[gate]));
      SDPCCResourceReference evidence[];
      if(!DPCCDecodeDataReferenceArray(report, report.FindMember(node, "evidence"), evidence, reason, names[gate]) ||
         ArraySize(evidence) == 0)
         return(DPCCStageBlocked(reason, "external_evidence." + names[gate]));
      for(int i = 0; i < ArraySize(evidence); i++)
        {
         SDPCCArtifactResolveResult actual;
         if(!DPCCResolveArtifact(root, containing, evidence[i], common, DPCC_RESOLVER_MAX_JSON_BYTES, actual, reason))
            return(false);
        }
     }
//--- These are pinned externally reviewed claims, not machine-derived PASS.
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStagePretrainResources                              |
//+------------------------------------------------------------------+
bool DPCCStagePretrainResources(CDPCCJsonDocument &report, const string schema,
                                const SDPCCResourceProfile &profile, const string profile_sha,
                                const string root, const string containing, const bool common, string &reason)
  {
   SDPCCResourceReport decoded;
   if(!DPCCDecodeResourceReport(report, report.Root(), decoded, reason) ||
      !DPCCBindResourceReportProfile(profile, decoded, profile_sha, reason))
      return(false);
   SDPCCResourceMeasurement rows[];
   ENUM_DPCC_GATE_VERDICT verdicts[];
   int count = 0;
   for(int i = 0; i < ArraySize(decoded.rows); i++)
     {
      if(decoded.rows[i].measurement.stage != "PRETRAIN_ESTIMATE")
         continue;
      if(ArraySize(decoded.rows[i].evidence) == 0)
         return(DPCCStageBlocked(reason, "pretrain.raw_evidence"));
      SDPCCResourceMeasurement derived;
      ZeroMemory(derived);
      ENUM_DPCC_GATE_VERDICT verdict = DPCC_GATE_BLOCKED;
      for(int e = 0; e < ArraySize(decoded.rows[i].evidence); e++)
        {
         SDPCCArtifactResolveResult actual;
         string text = "";
         CDPCCJsonDocument raw;
         SDPCCResourceEvidence evidence;
         if(!DPCCResolveArtifact(root, containing, decoded.rows[i].evidence[e], common, DPCC_RESOLVER_MAX_JSON_BYTES,
            actual, reason) ||
            !DPCCCentralBytesSource(actual.bytes, text, reason, "resource_evidence") ||
            !DPCCCentralSchemaValidate(raw, text, schema, reason, "resource_evidence") ||
            !DPCCDecodeResourceEvidence(raw, raw.Root(), evidence, reason) ||
            !DPCCBindResourceReportRow(profile, decoded.rows[i], evidence, actual.observed_sha256, profile_sha, reason))
            return(false);
         string evidence_relative = "";
         SDPCCArtifactResolveResult linked_profile;
         string ignored = "";
         if(!DPCCRunContainingArtifact(root, actual.canonical_path, evidence_relative, reason) ||
            !DPCCStageResolve(raw, raw.Root(), "readiness_profile", root, evidence_relative, common, linked_profile,
               ignored, reason) ||
            linked_profile.observed_sha256 != profile_sha)
            return(DPCCStageBlocked(reason, "pretrain.actual_profile"));
         bool example = false;
         if(!DPCCResourceReadBool(raw, raw.Root(), "example_only", example, reason, "resource_evidence.example_only") ||
            example)
            return(DPCCStageBlocked(reason, "pretrain.example_only"));
         verdict = DPCCRecomputeResourceEvidence(profile, evidence, derived, reason);
         if(verdict != DPCC_GATE_PASS)
            return(DPCCStageGate(reason, "pretrain.raw", verdict));
         if(!DPCCResourceMeasurementEqual(derived, decoded.rows[i].measurement))
            return(DPCCStageBlocked(reason, "pretrain.derived_measurement"));
        }
      if(ArrayResize(rows, count + 1) != count + 1 || ArrayResize(verdicts, count + 1) != count + 1)
         return(DPCCStageBlocked(reason, "pretrain.capacity"));
      rows[count] = derived;
      verdicts[count] = verdict;
      count++;
     }
   const ENUM_DPCC_GATE_VERDICT derived_gate = DPCCEvaluateResourceGate(profile, "PRETRAIN_ESTIMATE",
      decoded.claims.evaluated_at_utc, rows, verdicts, reason);
   if(derived_gate != DPCC_GATE_PASS || decoded.claims.pretrain_resources != derived_gate)
      return(DPCCStageGate(reason, "pretrain.matrix", derived_gate));
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageReadPlan                                       |
//+------------------------------------------------------------------+
bool DPCCStageReadPlan(CDPCCJsonDocument &d, const int plans, const string name,
                       SDPCCTrainingPlanEntry &rows[], string &reason)
  {
   const int node = d.FindMember(plans, name);
   if(d.Type(node) != DPCC_JSON_ARRAY || d.ChildCount(node) <= 0 || ArrayResize(rows, d.ChildCount(node)) !=
      d.ChildCount(node))
      return(DPCCStageBlocked(reason, "plan_array." + name));
   for(int i = 0; i < ArraySize(rows); i++)
     {
      const int item = d.ChildAt(node, i);
      ulong epoch = 0, ordinal = 0, index = 0, j = 0, repeat = 0;
      if(!DPCCStageReadUnsigned(d, item, "epoch", UINT_MAX, epoch, reason) ||
         !DPCCStageReadUnsigned(d, item, "ordinal", UINT_MAX, ordinal, reason) ||
         !DPCCStageReadUnsigned(d, item, "record_index", INT_MAX, index, reason) ||
         !DPCCStageReadUnsigned(d, item, "j", UINT_MAX, j, reason) ||
         !DPCCStageReadUnsigned(d, item, "repeat", UINT_MAX, repeat, reason) ||
         !DPCCResourceReadString(d, item, "window_id", rows[i].window_id, reason, "study_input.plan.window_id"))
         return(false);
      rows[i].epoch = (uint)epoch;
      rows[i].ordinal = (uint)ordinal;
      rows[i].record_index = (int)index;
      rows[i].j = (uint)j;
      rows[i].repeat = (uint)repeat;
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCStageReadKeys                                       |
//+------------------------------------------------------------------+
bool DPCCStageReadKeys(CDPCCJsonDocument &d, const SDPCCMaterializedRecord &records[],
                       const uint J, SDPCCTrainingFrozenRecordKeys &keys[], string &reason)
  {
   const int node = d.FindMember(d.Root(), "keys");
   const int count = ArraySize(records);
   if(d.Type(node) != DPCC_JSON_ARRAY || d.ChildCount(node) != count || count <= 0 || ArrayResize(keys, count) != count)
      return(DPCCStageBlocked(reason, "exact_materialized_record_keys"));
   for(int i = 0; i < count; i++)
     {
      const int item = d.ChildAt(node, i);
      ulong j = 0;
      if(!DPCCResourceReadString(d, item, "window_id", keys[i].window_id, reason, "study_input.key.window_id") ||
         !DPCCResourceReadLong(d, item, "decision_time", keys[i].decision_time, reason,
            "study_input.key.decision_time") ||
         !DPCCStageReadHex(d, item, "decision_identity", keys[i].decision_identity, reason) ||
         !DPCCStageReadHex(d, item, "context_identity", keys[i].context_identity, reason) ||
         !DPCCStageReadHex(d, item, "owner_identity", keys[i].owner_identity, reason) ||
         !DPCCStageReadUnsigned(d, item, "validation_j", J, j, reason))
         return(false);
      keys[i].validation_j = (uint)j;
      if(keys[i].window_id != records[i].window_id || keys[i].decision_time != records[i].admission.decision_time ||
         keys[i].decision_identity == 0 || keys[i].context_identity == 0 || keys[i].owner_identity == 0 ||
         (records[i].admission.split == "validation" ? j == 0 : j != 0))
         return(DPCCStageBlocked(reason, "record_key_binding"));
      for(int before = 0; before < i; before++)
         if(keys[before].decision_identity == keys[i].decision_identity)
            return(DPCCStageBlocked(reason, "duplicate_decision_identity"));
     }
   return(true);
  }
//+------------------------------------------------------------------+
//| Project the complete materialized record into a pinned witness   |
//+------------------------------------------------------------------+
bool DPCCStageOfflineWitness(const SDPCCMaterializedRecord &record,
                             const SDPCCTrainingFrozenRecordKeys &key,
                             SDPCCOfflineFitWitness &out, string &reason)
  {
   ZeroMemory(out);
   string wire = "DPCC_OFFLINE_MATERIALIZED_RECORD_V1\n";
   const string text[] = {record.admission.split, record.window_id, record.dataset_id, record.forecast_id,
                          record.normalization_id, record.source_id, record.noise_seed, record.execution_label
                         };
   for(int i = 0; i < ArraySize(text); i++)
      DPCCOfflineField(wire, text[i]);
   DPCCOfflineField(wire, (string)record.admission.admitted);
   DPCCOfflineField(wire, (string)record.admission.decision_bar_index);
   DPCCOfflineField(wire, (string)record.admission.decision_time);
   DPCCOfflineField(wire, (string)record.admission.horizon);
   DPCCOfflineField(wire, (string)record.episode_id);
   DPCCOfflineField(wire, (string)record.forecast_asof);
   DPCCOfflineField(wire, (string)record.normalization_asof);
   DPCCOfflineField(wire, StringFormat("%016I64x", record.noise_seed_u64));
   if(!DPCCOfflineFloats(wire, record.account_features, reason) ||
      !DPCCOfflineFloats(wire, record.context_without_noise, reason) ||
      !DPCCOfflineFloats(wire, record.target_native_ohlc, reason) || !DPCCOfflineFloats(wire, record.rho, reason) ||
      !DPCCOfflineFloats(wire, record.actions, reason) || !DPCCOfflineFloats(wire, record.executed_actions, reason) ||
      !DPCCOfflineFloats(wire, record.rewards, reason))
      return(false);
   DPCCOfflineField(wire, (string)ArraySize(record.terminal_flags));
   for(int i = 0; i < ArraySize(record.terminal_flags); i++)
      DPCCOfflineField(wire, (string)record.terminal_flags[i]);
   DPCCOfflineLongs(wire, record.bar_open_times);
   DPCCOfflineLongs(wire, record.bar_close_times);
   DPCCOfflineLongs(wire, record.bar_indices);
   DPCCOfflineLongs(wire, record.source_action_times);
   if(!DPCCCheckpointTextSHA(wire, out.record_sha256, reason))
      return(false);
   out.split = record.admission.split;
   out.window_id = record.window_id;
   out.episode_id = record.episode_id;
   out.decision_bar = record.admission.decision_bar_index;
   out.decision_time = record.admission.decision_time;
   out.horizon = record.admission.horizon;
   out.decision_identity = key.decision_identity;
   out.context_identity = key.context_identity;
   out.owner_identity = key.owner_identity;
   if(ArrayCopy(out.bar_indices, record.bar_indices) != ArraySize(record.bar_indices) ||
      ArrayCopy(out.bar_open_times, record.bar_open_times) != ArraySize(record.bar_open_times) ||
      ArrayCopy(out.bar_close_times, record.bar_close_times) != ArraySize(record.bar_close_times))
      return(DPCCStageBlocked(reason, "offline_witness_capacity"));
   out.admitted = record.admission.admitted;
   return(true);
  }
//+------------------------------------------------------------------+
//| Parse required Oracle inputs into the shared typed admission     |
//+------------------------------------------------------------------+
bool DPCCStageReadOfflinePolicy(CDPCCJsonDocument &d, const SDPCCMaterializedRecord &records[],
                                SDPCCStudyStageInput &out, const float &model_limits[],
                                const string actual_bank_sha, string &reason)
  {
   ZeroMemory(out.offline_policy);
   DPCCClearOfflinePolicyAdmission(out.offline_admission);
   ArrayResize(out.offline_fit, 0);
   const int root = d.Root(), node = d.FindMember(root, "offline_policy"), plan = d.FindMember(root, "offline_fit");
   SDPCCOfflinePolicyProfile p;
   ZeroMemory(p);
   const int optimizer = d.FindMember(node, "optimizer"), seed = d.FindMember(node, "seed");
   ulong version = 0, horizon = 0;
   if(d.Type(node) != DPCC_JSON_OBJECT || d.ChildCount(node) != 19 ||
      d.Type(seed) != DPCC_JSON_OBJECT || d.ChildCount(seed) != 9 ||
      d.Type(optimizer) != DPCC_JSON_OBJECT || d.ChildCount(optimizer) != 13 ||
      !DPCCRunOptimizer(d, node, reason) ||
      !DPCCStageReadUnsigned(d, node, "version", 1, version, reason) || version != 1 ||
      !DPCCStageReadUnsigned(d, node, "horizon", INT_MAX, horizon, reason) ||
      !DPCCStageReadUnsigned(d, node, "maximum_candidates", INT_MAX, p.maximum_candidates, reason) ||
      !DPCCStageReadUnsigned(d, node, "maximum_work", ULONG_MAX, p.maximum_work, reason) ||
      !DPCCResourceReadLong(d, node, "episode_id", p.episode_id, reason, "offline_policy") ||
      !DPCCResourceReadLong(d, node, "first_decision_bar", p.first_decision_bar, reason, "offline_policy") ||
      !DPCCResourceReadLong(d, node, "last_decision_bar", p.last_decision_bar, reason, "offline_policy"))
      return(DPCCStageBlocked(reason, "required_offline_policy." + reason));
   p.version = (uint)version;
   p.horizon = (uint)horizon;
   if(!DPCCResourceReadString(d, node, "model_sha256", p.model_sha256, reason, "offline_policy") ||
      !DPCCResourceReadString(d, node, "training_sha256", p.training_sha256, reason, "offline_policy") ||
      !DPCCResourceReadString(d, node, "bank_sha256", p.bank_sha256, reason, "offline_policy") ||
      !DPCCResourceReadString(d, node, "time_index_sha256", p.time_index_sha256, reason, "offline_policy") ||
      !DPCCResourceReadString(d, node, "decoder_sha256", p.decoder_sha256, reason, "offline_policy") ||
      !DPCCResourceReadString(d, node, "seed_sha256", p.seed_sha256, reason, "offline_policy") ||
      !DPCCResourceReadString(d, node, "profile_sha256", p.profile_sha256, reason, "offline_policy") ||
      !DPCCResourceReadString(d, node, "fit_plan_sha256", p.fit_plan_sha256, reason, "offline_policy"))
      return(false);
   double gamma = 0;
   if(!DPCCResourceReadDouble(d, node, "gamma", gamma, reason, "offline_policy") ||
      !MathIsValidNumber(gamma) || gamma <= 0 || gamma > 1 || (float)gamma != out.config.gamma ||
      !DPCCRecordFloatArray(d, d.FindMember(node, "coordinate_deltas"), 6, p.coordinate_deltas,
                            "offline_policy.coordinate_deltas", reason))
      return(DPCCStageBlocked(reason, "explicit_delta_model_discount." + reason));
   p.gamma = (float)gamma;
   if(!DPCCResourceReadString(d, optimizer, "name", p.optimizer_name, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadString(d, optimizer, "profile", p.optimizer_profile, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadString(d, optimizer, "bias_correction", p.bias_correction, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadString(d, optimizer, "gradient_convention", p.gradient_convention, reason,
         "offline_policy.optimizer") ||
      !DPCCResourceReadString(d, optimizer, "clip_location", p.clip_location, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadString(d, optimizer, "zero_variance_update", p.zero_variance_update, reason,
         "offline_policy.optimizer") ||
      !DPCCResourceReadDouble(d, optimizer, "learning_rate", p.learning_rate, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadDouble(d, optimizer, "beta1", p.beta1, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadDouble(d, optimizer, "beta2", p.beta2, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadDouble(d, optimizer, "epsilon", p.epsilon, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadDouble(d, optimizer, "weight_decay", p.weight_decay, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadDouble(d, optimizer, "gradient_clip", p.gradient_clip, reason, "offline_policy.optimizer") ||
      !DPCCResourceReadLong(d, optimizer, "initial_step", p.initial_step, reason, "offline_policy.optimizer"))
      return(false);
   if(!DPCCResourceReadString(d, seed, "schema", p.seed.schema, reason, "offline_policy.seed") ||
      !DPCCResourceReadString(d, seed, "account_currency", p.seed.account_currency, reason, "offline_policy.seed") ||
      !DPCCResourceReadString(d, seed, "source_sha256", p.seed.source_sha256, reason, "offline_policy.seed") ||
      !DPCCResourceReadLong(d, seed, "snapshot_bar", p.seed.snapshot_bar, reason, "offline_policy.seed") ||
      !DPCCResourceReadLong(d, seed, "snapshot_utc", p.seed.snapshot_utc, reason, "offline_policy.seed") ||
      !DPCCResourceReadLong(d, seed, "snapshot_server", p.seed.snapshot_server, reason, "offline_policy.seed") ||
      !DPCCRecordFloatArray(d, d.FindMember(seed, "state"), 33, p.seed.state, "offline_policy.seed.state", reason) ||
      !DPCCRecordFloatArray(d, d.FindMember(seed, "risk_limits"), 24, p.seed.risk_limits,
                            "offline_policy.seed.risk_limits", reason))
      return(DPCCStageBlocked(reason, "required_starting_seed." + reason));
   p.seed.position.time_domain = "UTC_SECONDS_V1";
   const int position = d.FindMember(seed, "position");
   if(d.Type(position) != DPCC_JSON_OBJECT || d.ChildCount(position) != 12 ||
      !DPCCResourceReadBool(d, position, "initialized", p.seed.position.initialized, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "snapshot_bar", p.seed.position.snapshot_bar, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "snapshot_server", p.seed.position.snapshot_server, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "snapshot_utc", p.seed.position.snapshot_time, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "bar_server_open", p.seed.position.bar_server_open, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "bar_server_close", p.seed.position.bar_server_close, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "bar_open_utc", p.seed.position.bar_open_time, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "bar_close_utc", p.seed.position.bar_close_time, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "first_open_bar", p.seed.position.first_open_bar, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "first_open_server", p.seed.position.first_open_server, reason,
         "offline_policy.position") ||
      !DPCCResourceReadLong(d, position, "first_open_utc", p.seed.position.first_open_time, reason,
         "offline_policy.position"))
      return(false);
   double lots = 0;
   if(!DPCCResourceReadDouble(d, position, "signed_lots", lots, reason, "offline_policy.position") ||
      !MathIsValidNumber(lots) || !MathIsValidNumber((float)lots) ||
      (lots != 0 && (float)lots == 0))
      return(DPCCStageBlocked(reason, "exact_starting_position_lots"));
   p.seed.position.signed_lots = (float)lots;
   if(p.model_sha256 != out.model_reference.sha256 || p.training_sha256 != out.training_reference.sha256 ||
      p.bank_sha256 != actual_bank_sha || p.time_index_sha256 != out.source.links.time_index_sha256)
      return(DPCCStageBlocked(reason, "offline_actual_artifact_binding"));
   const int count = d.ChildCount(plan);
   if(d.Type(plan) != DPCC_JSON_ARRAY || count <= 0 || (ulong)count > p.maximum_work ||
      ArrayResize(out.offline_fit, count) != count)
      return(DPCCStageBlocked(reason, "required_offline_fit"));
   for(int i = 0; i < count; i++)
     {
      const int item = d.ChildAt(plan, i);
      ulong record = 0;
      if(d.Type(item) != DPCC_JSON_OBJECT || d.ChildCount(item) != 9 ||
         !DPCCStageReadUnsigned(d, item, "record_index", INT_MAX, record, reason) ||
         !DPCCResourceReadString(d, item, "window_id", out.offline_fit[i].window_id, reason, "offline_fit") ||
         !DPCCResourceReadString(d, item, "record_sha256", out.offline_fit[i].record_sha256, reason, "offline_fit") ||
         !DPCCResourceReadLong(d, item, "episode_id", out.offline_fit[i].episode_id, reason, "offline_fit") ||
         !DPCCResourceReadLong(d, item, "decision_bar", out.offline_fit[i].decision_bar, reason, "offline_fit") ||
         !DPCCResourceReadLong(d, item, "decision_time", out.offline_fit[i].decision_time, reason, "offline_fit") ||
         !DPCCStageReadHex(d, item, "decision_identity", out.offline_fit[i].decision_identity, reason) ||
         !DPCCStageReadHex(d, item, "context_identity", out.offline_fit[i].context_identity, reason) ||
         !DPCCStageReadHex(d, item, "owner_identity", out.offline_fit[i].owner_identity, reason))
         return(false);
      out.offline_fit[i].record_index = (int)record;
     }
   SDPCCOfflineFitWitness witnesses[];
   if(ArraySize(records) != ArraySize(out.keys) || ArrayResize(witnesses, ArraySize(records)) != ArraySize(records))
      return(DPCCStageBlocked(reason, "offline_witness_array"));
   for(int i = 0; i < ArraySize(records); i++)
      if(!DPCCStageOfflineWitness(records[i], out.keys[i], witnesses[i], reason))
         return(false);
   SDPCCOfflineFitPartition fit;
   fit.dataset_id = out.source.dataset.dataset_id;
   fit.bar_start = out.source.dataset.fit.bar_start;
   fit.bar_end = out.source.dataset.fit.bar_end;
   fit.start_utc = out.source.dataset.fit.start_utc;
   fit.end_utc = out.source.dataset.fit.end_utc;
   fit.validation_bar_start = out.source.dataset.validation.bar_start;
   fit.validation_start_utc = out.source.dataset.validation.start_utc;
   fit.embargo_bars = out.source.dataset.embargo_bars;
   if(!DPCCAdmitOfflinePolicy(p, out.offline_fit, witnesses, fit, out.source.time_index, out.config,
                              model_limits, out.offline_admission, reason))
      return(false);
   out.offline_policy = p;
   return(true);
  }
//+------------------------------------------------------------------+
//| Function DPCCLoadStudyStageInputImpl                             |
//+------------------------------------------------------------------+
bool DPCCLoadStudyStageInputImpl(const string path, const string expected_sha, const bool common_files,
                                 SDPCCStudyStageInput &out, string &loaded_phase, string &reason,
                                 const bool retain_online_records = false)
  {
   ZeroMemory(out);
   loaded_phase = "";
   reason = "";
//--- Candidate publishes only after real artifacts, readiness and owner admission.
   SDPCCStudyStageInput candidate;
   ZeroMemory(candidate);
   uchar bytes[];
   string source = "", observed = "", normalized = "";
   if(!DPCCResolverLowerSha256(expected_sha) || !DPCCResolverPreparePath(path, normalized, reason, "study_input.path"))
      return(DPCCStageBlocked(reason, "trusted_envelope_path_sha"));
   string segments[];
   if(!DPCCResolverAppendSegments(normalized, segments, 0, reason, "study_input.path"))
      return(false);
   normalized = DPCCResolverJoinSegments(segments);
   if(!DPCCReadArtifactBytes(normalized, common_files, DPCC_RESOLVER_MAX_JSON_BYTES, bytes, reason) ||
      !DPCCSHA256Lower(bytes, observed, reason) || observed != expected_sha ||
      !DPCCCentralBytesSource(bytes, source, reason, "study_input"))
      return(DPCCStageBlocked(reason, "envelope_bytes_sha." + reason));
   CDPCCJsonDocument envelope;
   if(!envelope.Parse(source, reason))
      return(false);
   const int root = envelope.Root();
   ulong version = 0;
   string phase = "";
   if(!DPCCStageReadUnsigned(envelope, root, "version", 1, version, reason) || version != 1 ||
      !DPCCResourceReadString(envelope, root, "phase", phase, reason, "study_input.phase") ||
      (phase != "DECODER_TRAIN" && phase != "DECODER_VALIDATE" && phase != "DENOISER_TRAIN" && phase != "ASSEMBLE" &&
       phase != "OFFLINE_ORACLE") ||
      !DPCCResourceReadString(envelope, root, "package_root", candidate.package_root, reason,
         "study_input.package_root") ||
      !DPCCRunContainingArtifact(candidate.package_root, normalized, candidate.containing_json, reason))
      return(DPCCStageBlocked(reason, "version_phase_package." + reason));
   candidate.source.common_files = common_files;
   const int schemas = envelope.FindMember(root, "schemas");
   string integration_schema = "", profile_schema = "", report_schema = "", data_schema = "", resource_schema = "";
