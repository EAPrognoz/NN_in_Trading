   bool                   m_verify_configured, m_verify_started;
   double                 m_verify_error_sum[48], m_verify_max_price_error, m_verify_coverage;
   uint                   m_verify_snapshots, m_verify_covered, m_verify_min_distinct;
   ulong                  m_verify_market_fingerprint, m_verify_target_fingerprint;
   string                 m_verify_status;
   SDPCCHistoricalPriceSnapshot m_price_observation;

   bool              NetworkTrainingEnabled(CNet &network)
     {
      CNeuronBaseOCL *last = network.Layer(-1);
      if(CheckPointer(last) == POINTER_INVALID)
         return(true);
      for(int i = 0; i < 1024; i++)
        {
         CNeuronBaseOCL *layer = network.Layer(i);
         if(CheckPointer(layer) == POINTER_INVALID)
            return(true);
         if(layer.TrainMode())
            return(true);
         if(layer == last)
            return(false);
        }
      return(true);
     }

   bool              HasTeacherNetwork(void)
     {
      return(m_target.Layer(0) != NULL);
     }

   bool              MissingTeacherAllowed(void)
     {
      return(m_price_forward_only || m_price_joint || m_m05);
     }

   bool              TeacherFrozenPolicy(void)
     {
      if(!HasTeacherNetwork())
         return(MissingTeacherAllowed());
      return(!NetworkTrainingEnabled(m_target) && !m_target.WeightsUpdateEnabled());
     }

   bool              SetTeacherFrozenPolicy(void)
     {
      if(!HasTeacherNetwork())
         return(MissingTeacherAllowed());
      return(m_target.TrainMode(false) && m_target.SetWeightsUpdate(false) && TeacherFrozenPolicy());
     }

   bool              ClearTeacherState(void)
     {
      if(!HasTeacherNetwork())
         return(MissingTeacherAllowed());
      return(m_target.Clear());
     }

   bool              TeacherFingerprint(ulong &fingerprint)
     {
      if(!HasTeacherNetwork())
        {
         fingerprint = 0;
         return(MissingTeacherAllowed());
        }
      return(m_target.ParameterFingerprint(fingerprint));
     }

   bool              FrozenProducer(string &reason)
     {
      if(m_ready_encoder_restored)
        {
         CNeuronScenarioForecastPriceOCL *forecast =
            dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
         CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
         CNeuronBaseOCL *ompb_base = ompb;
         if(!m_restore_only || !m_price_forward_only || m_encoder_only || !forecast || !ompb ||
            m_market.WeightsUpdateEnabled() || m_target.Layer(0) != NULL || forecast.CodebookUpdate() ||
            forecast.PricePhase() != defForecastPriceVerify || ompb_base.TrainMode() ||
            ompb.Mode() != OMPB_INFERENCE || ompb.SourceAnchor())
            return(Fail("ready_encoder.frozen_producer_state", reason));
         for(int i = 0; i < 8; i++)
            if(!m_market.Layer(i) || m_market.Layer(i).TrainMode())
               return(Fail("ready_encoder.trainable_layer", reason));
         return(true);
        }
      if(m_encoder_only && m_restore_only)
        {
         CNeuronBaseOCL *encoder_input = m_market.Layer(0);
         CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
         CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
         CNeuronBaseOCL *ompb_base = ompb;
         if(!encoder_input || encoder_input.TrainMode() || NetworkTrainingEnabled(m_market) ||
            m_market.WeightsUpdateEnabled() || m_target.Layer(0) != NULL || !forecast ||
            forecast.CodebookUpdate() || !ompb || ompb_base.TrainMode() || ompb.Mode() != OMPB_BYPASS ||
               ompb.SourceAnchor())
            return(Fail("study_encoder.restore_producer_state", reason));
         return(true);
        }
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(NetworkTrainingEnabled(m_market) || m_market.WeightsUpdateEnabled() || !TeacherFrozenPolicy() ||
         !forecast || forecast.CodebookUpdate())
         return(Fail("study_decoder.frozen_producer_changed", reason));
      return(true);
     }

   bool              VerifyFrozenProducerFingerprints(string &reason)
     {
      if(!FrozenProducer(reason))
         return(false);
      ulong market = 0, target = 0;
      if(!m_market.ParameterFingerprint(market) || market != m_decoder_market_fingerprint ||
         !TeacherFingerprint(target) || target != m_decoder_target_fingerprint)
         return(Fail("study_decoder.frozen_producer_changed", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| PublishZ copies a finite latent snapshot owned by the caller     |
   //+------------------------------------------------------------------+
   bool              PublishZ(float &z[], string &reason)
     {
      ArrayResize(z, 0);
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      float candidate[];
      if(!forecast || forecast.CodebookUpdate() || !forecast.GetZ() ||
         forecast.GetZ().GetOpenCL() != m_market.GetOpenCL() || forecast.GetZ().Total() != 21 * 9 * 12 * 16 ||
         forecast.GetZ().GetData(candidate) != 21 * 9 * 12 * 16)
         return(Fail("study_encoder.inference.z_shape_or_context", reason));
      for(int i = 0; i < ArraySize(candidate); i++)
         if(!MathIsValidNumber(candidate[i]))
            return(Fail("study_encoder.inference.z_nonfinite", reason));
      if(ArrayCopy(z, candidate) != 21 * 9 * 12 * 16)
        {
         ArrayResize(z, 0);
         return(Fail("study_encoder.inference.z_publish", reason));
        }
      reason = "";
      m_z_available = true;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| SaveEncoderCompleted publishes only the new two-network run      |
   //+------------------------------------------------------------------+
   bool              SaveEncoderCompleted(string &reason)
     {
      if(!m_encoder_only || !Finished() || !m_full_run || m_restore_only ||
         m_cursor != ArraySize(m_fit) || m_updates != (ulong)ArraySize(m_fit) ||
         m_holdout_cursor != ArraySize(m_holdout) || m_holdout_valid != (double)ArraySize(m_holdout) ||
         m_holdout_invalid != 0 || !MathIsValidNumber(m_holdout_latent) || m_holdout_latent < 0 ||
         !VerifyFrozenProducerFingerprints(reason) || m_decoder_target_fingerprint != m_teacher_initial_fingerprint)
         return(Fail("study_encoder.save.before_successful_holdout", reason));
      const string encoder_path = m_root + "/Encoder.trained.nnw";
      const string teacher_path = m_root + "/Teacher.frozen_untrained.nnw";
      const string receipt_path = m_root + "/EncoderTeacher.study.txt";
      if(FileIsExist(encoder_path) || FileIsExist(teacher_path) || FileIsExist(receipt_path))
         return(Fail("study_encoder.save.output_exists", reason));
      const datetime now = TimeCurrent();
      if(!m_market.Save(encoder_path, 0, 0, 0, now, false))
         return(Fail("study_encoder.save.encoder", reason));
      if(!m_target.Save(teacher_path, 0, 0, 0, now, false))
         return(Fail("study_encoder.save.teacher", reason));
      string encoder_sha = "", teacher_sha = "", profile_sha = "", receipt_sha = "";
      if(!DPCCCheckpointFileSHA(encoder_path, false, DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES, encoder_sha, reason) ||
         !DPCCCheckpointFileSHA(teacher_path, false, DPCC_STUDY_FORECAST_ARTIFACT_MAX_BYTES, teacher_sha, reason) ||
         !DPCCStudyEncoderProfileSHA(profile_sha, reason) || !VerifyFrozenProducerFingerprints(reason))
         return(Fail("study_encoder.save.artifact_binding:" + reason, reason));
      const string loss = DoubleToString(m_holdout_latent, 17);
      const string wire = "DPCC_ENCODER_TEACHER_STUDY_V1\nraw_sha256=" + m_raw_sha +
                          "\nencoder_sha256=" + encoder_sha + "\nteacher_frozen_untrained_sha256=" + teacher_sha +
                          "\nprofile_sha256=" + profile_sha + "\nfit_updates=" + (string)m_updates +
                          "\nholdout_examples=" + (string)m_holdout_cursor + "\nlatent_coordinate_mae=" + loss +
                          "\nholdout_server_time=2026.01.01..2026.02.01\nteacher=fresh_frozen_untrained"
                          "\ntimezone_resolution=NOT_CLAIMED\nresearch_acceptance=NOT_CLAIMED\n";
      if(!DPCCCheckpointTextSHA(wire, receipt_sha, reason) ||
         !DPCCCheckpointWriteText(receipt_path, false, wire, reason))
         return(Fail("study_encoder.save.receipt:" + reason, reason));
      SDPCCStudyEncoderReceipt decoded;
      if(!DPCCReadStudyEncoderReceipt(m_root, receipt_sha, m_raw_sha, (uint)ArraySize(m_fit),
                                      (uint)ArraySize(m_holdout), decoded, reason) ||
         decoded.encoder_sha256 != encoder_sha || decoded.teacher_sha256 != teacher_sha ||
         decoded.profile_sha256 != profile_sha || decoded.latent_coordinate_mae != StringToDouble(loss))
         return(Fail("study_encoder.save.receipt_readback:" + reason, reason));
      Print("DPCC_STUDYENCODER_RECEIPT root=", m_root, " receipt_sha256=", receipt_sha,
            " encoder_sha256=", encoder_sha, " teacher_sha256=", teacher_sha);
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Forward one causal state through the frozen Market CNet          |
   //+------------------------------------------------------------------+
   bool              ForwardInferenceState(const float &values[], string &reason)
     {
      m_z_available = false;
      if(ArraySize(values) != 45)
         return(Fail("study_decoder.inference.input", reason));
      for(int i = 0; i < 45; i++)
         if(!MathIsValidNumber(values[i]) || !m_state.Update(i, values[i]))
            return(Fail("study_decoder.inference.input_buffer", reason));
      if(!m_state.BufferWrite() || !m_market.feedForward(GetPointer(m_state), 1, false, (CBufferFloat*)NULL))
         return(Fail("study_decoder.inference.market_forward", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Bind historical Open and the preceding completed ATR(14)         |
   //+------------------------------------------------------------------+
   bool              ForwardHistoricalState(const int decision, const float &values[], string &reason)
     {
      if(decision < 0 || decision >= ArraySize(m_bars))
         return(Fail("study_forecast.historical_identity", reason));
      if(m_price_joint)
        {
         SDPCCHistoricalPriceSnapshot snapshot;
         CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
         if(!decoder || !BuildHistoricalPriceSnapshot(decision, snapshot, reason) ||
            !decoder.BindPriceAnchor(snapshot.anchor, snapshot.scale, snapshot.decision_id))
            return(Fail("study_forecast.price_joint.causal_anchor:" + reason, reason));
         m_price_observation = snapshot;
        }
      return(ForwardInferenceState(values, reason));
     }
   //+------------------------------------------------------------------+
   //| Build the four predecessors without admitting live rows offline  |
   //+------------------------------------------------------------------+
   bool              LivePredecessors(const int live_position, SDPCCStudyForecastBar &prior[], string &reason)
     {
      const int pinned = ArraySize(m_bars);
      if(live_position < 0 || live_position > m_live_count || pinned < 5 || ArrayResize(prior, 4) != 4)
         return(Fail("study_decoder.live.predecessors", reason));
      for(int i = 0; i < 4; i++)
        {
         const long index = (long)pinned + live_position - 4 + i;
         if(index < pinned)
            prior[i] = m_bars[(int)index];
         else
            prior[i] = m_live_bars[(int)(index - pinned)];
        }
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Replay causal Market origins from the existing holdout boundary  |
   //+------------------------------------------------------------------+
   bool              PrepareLiveState(string &reason)
     {
      if(m_live_prepared)
         return(true);
      if(ArraySize(m_holdout) == 0 || !m_market.Clear())
         return(Fail("study_decoder.live.replay_clear", reason));
      m_inference_split = -1;
      m_inference_cursor = -1;
      for(int decision = m_holdout[0]; decision <= ArraySize(m_bars); decision++)
        {
         float state_values[];
         if(!DPCCPackStudyForecastInput(m_bars, decision, state_values) ||
            !ForwardHistoricalState(decision, state_values, reason))
            return(Fail("study_decoder.live.pinned_replay:" + reason, reason));
        }
      for(int live = 0; live < m_live_count; live++)
        {
         SDPCCStudyForecastBar prior[], context[];
         if(!LivePredecessors(live, prior, reason) || ArrayResize(context, 5) != 5)
            return(Fail("study_decoder.live.accepted_replay_context:" + reason, reason));
         for(int i = 0; i < 4; i++)
            context[i] = prior[i];
         context[4] = m_live_bars[live];
         float state_values[];
         if(!DPCCPackStudyForecastInput(context, 5, state_values) || !ForwardInferenceState(state_values, reason))
            return(Fail("study_decoder.live.accepted_replay:" + reason, reason));
        }
      m_live_prepared = true;
      return(true);
     }

   bool              Fail(const string code, string &reason)
     {
      m_failed = true;
      reason = code;
      if(m_m05 && m_price_study_phase == defForecastPriceOMPBCalibrate)
        {
         CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
         if(forecast && !forecast.SetGradientNormalization(true))
            reason += ";study_forecast.ompb.gradient_normalization_restore";
        }
      return(false);
     }

   bool              CreateGraphs(string &reason, const bool include_teacher = true)
     {
      const bool price_head = (m_price_forward_only || m_price_joint);
      const bool build_teacher = (include_teacher && !price_head);
      if(!DPCCCreateStudyForecastGraphs(m_market, m_target, reason, build_teacher, price_head))
         return(false);
      COpenCLMy *context = m_market.GetOpenCL();
      if(!context || !m_gradient_ops.Bind(context) ||
         !m_state.BufferInit(45, 0) || !m_state.BufferCreate(context) ||
         !m_future.BufferInit(108, 0) || !m_future.BufferCreate(context) ||
         !m_future_latent.BufferInit(9 * 12 * 16, 0) || !m_future_latent.BufferCreate(context) ||
         !m_zero.BufferInit(144, 0) || !m_zero.BufferCreate(context) ||
         !m_negative.BufferInit(144, 0) || !m_negative.BufferCreate(context) ||
         !m_delta.BufferInit(1728, 0) || !m_delta.BufferCreate(context))
         return(Fail("study_forecast.buffers", reason));
      return(true);
     }

   bool              BuildFactualFutureLatentTarget(const int decision, CBufferFloat *&target, string &reason)
     {
      target = NULL;
      if(decision < 5 || decision + 12 > ArraySize(m_bars) ||
         !MissingTeacherAllowed() || m_future_latent.Total() != 9 * 12 * 16 ||
         m_future_latent.GetOpenCL() != m_market.GetOpenCL())
         return(Fail("study_forecast.factual_target.contract", reason));
      float future[];
      if(ArrayResize(future, 9 * 12) != 9 * 12)
         return(Fail("study_forecast.factual_target.allocate", reason));
      for(int h = 0; h < 12; h++)
        {
         float features[];
         if(!DPCCStudyForecastFeature(m_bars[decision + h], features) || ArraySize(features) != 9)
            return(Fail("study_forecast.factual_target.future_feature", reason));
         for(int v = 0; v < 9; v++)
           {
            const float value = features[v];
            if(!MathIsValidNumber(value))
               return(Fail("study_forecast.factual_target.nonfinite_feature", reason));
            future[v * 12 + h] = value;
           }
        }
      //--- Normalize each future feature over the horizon before shape adaptation.
      for(int v = 0; v < 9; v++)
        {
         double mean = 0.0;
         for(int h = 0; h < 12; h++)
            mean += (double)future[v * 12 + h];
         mean /= 12.0;
         double variance = 0.0;
         for(int h = 0; h < 12; h++)
           {
            const double delta = (double)future[v * 12 + h] - mean;
            variance += delta * delta;
           }
         variance /= 12.0;
         if(!MathIsValidNumber(mean) || !MathIsValidNumber(variance) || variance < 0.0)
            return(Fail("study_forecast.factual_target.normalization", reason));
         const double stdev = MathSqrt(variance);
         if(!MathIsValidNumber(stdev))
            return(Fail("study_forecast.factual_target.normalization", reason));
         const double scale = (stdev > 0.0 ? stdev : 1.0);
         for(int h = 0; h < 12; h++)
           {
            const float value = (float)(((double)future[v * 12 + h] - mean) / scale);
            if(!MathIsValidNumber((double)value))
               return(Fail("study_forecast.factual_target.normalization", reason));
            future[v * 12 + h] = value;
           }
        }
      //--- Match the fixed 16-coordinate latent target using the remaining factual path.
      for(int v = 0; v < 9; v++)
         for(int h = 0; h < 12; h++)
            for(int d = 0; d < 16; d++)
              {
               const double position = (double)h + ((double)(11 - h) * (double)d) / 15.0;
               const int left = (int)MathFloor(position);
               const int right = (int)MathMin(11, left + 1);
               const double fraction = position - left;
               const double a = future[v * 12 + left];
               const double b = future[v * 12 + right];
               const float value = (float)(a + (b - a) * fraction);
               const int index = (v * 12 + h) * 16 + d;
               if(!MathIsValidNumber(value) || !m_future_latent.Update(index, value))
                  return(Fail("study_forecast.factual_target.pack", reason));
              }
      if(!m_future_latent.BufferWrite())
         return(Fail("study_forecast.factual_target.upload", reason));
      target = GetPointer(m_future_latent);
      return(target != NULL);
     }
   //+------------------------------------------------------------------+
   //| Bind retained first-tick quote and the last completed ATR        |
   //+------------------------------------------------------------------+
   bool              BuildHistoricalPriceSnapshot(const int decision, SDPCCHistoricalPriceSnapshot &snapshot,
      string &reason)
     {
      ZeroMemory(snapshot);
      //--- The raw reader has verified each row's successor link.
      if((!m_price_forward_only && !m_price_joint) || !m_ready || m_failed ||
         m_price_timeframe <= PERIOD_CURRENT || PeriodSeconds(m_price_timeframe) <= 0 ||
         m_price_server == "" ||
         (m_raw_identity_bound && (m_price_symbol != _Symbol || !DPCCResolverLowerSha256(m_raw_sha))) ||
         decision < 1 || decision >= ArraySize(m_bars) || m_bars[decision].server_open <= 0 ||
         m_bars[decision - 1].server_open <= 0 ||
         m_bars[decision - 1].server_open >= m_bars[decision].server_open)
         return(Fail("study_forecast.price_snapshot.identity", reason));
      const long target_time_msc = DPCCHistoricalPriceTargetTimeMsc(m_bars[decision]);
      if(target_time_msc <= 0)
         return(Fail("TARGET_TIME_UNAVAILABLE", reason));
      if(!DPCCPriceTargetWindowAvailable(m_bars, decision, 1, m_price_quote_mode, m_price_h1_ohlc_targets,
                                         m_price_timeframe))
         return(Fail("TARGET_TIME_UNAVAILABLE", reason));
      const double anchor = DPCCHistoricalPriceTargetValue(m_bars[decision], 0);
      const double scale = (double)m_bars[decision - 1].indicators[2];
      if(!MathIsValidNumber(anchor) || anchor <= 0)
         return(Fail("INVALID_PRICE_ANCHOR", reason));
      if(!MathIsValidNumber(scale) || scale <= 0 || m_bars[decision - 1].indicators[2] == EMPTY_VALUE)
         return(Fail("INVALID_PRICE_SCALE", reason));
      double tick_size = 0;
      if(!SymbolInfoDouble(m_price_symbol, SYMBOL_TRADE_TICK_SIZE, tick_size) ||
         !MathIsValidNumber(tick_size) || tick_size <= 0)
         return(Fail("study_forecast.price_snapshot.tick_size", reason));
      long chart_mode = -1;
      if(m_raw_identity_bound && m_price_quote_basis_resolved &&
         (!SymbolInfoInteger(m_price_symbol, SYMBOL_CHART_MODE, chart_mode) ||
          chart_mode != (long)m_price_quote_mode))
         return(Fail("study_forecast.price_snapshot.quote_basis_changed", reason));
      //--- Keep raw-source provenance only when the caller requested bound history.
      snapshot.decision_id = (ulong)target_time_msc;
      snapshot.source_server = m_price_server;
      snapshot.symbol = m_price_symbol;
      snapshot.raw_sha256 = (m_raw_identity_bound ? m_raw_sha : "");
      snapshot.resolved_timeframe = m_price_timeframe;
      snapshot.quote_basis_resolved = m_price_quote_basis_resolved;
      snapshot.chart_quote_mode = m_price_quote_mode;
      snapshot.quote_basis = (m_price_quote_basis_resolved ?
                              (m_price_quote_mode == SYMBOL_CHART_MODE_BID ? "BID" : "LAST") : "UNRESOLVED");
      snapshot.quote_basis_source = (m_price_quote_basis_resolved ?
                                     (m_raw_identity_bound ? "CALLER_SYMBOL_CHART_MODE" : "RAW_DATASET") :
                                        "UNRESOLVED");
      snapshot.quote_time_msc = target_time_msc;
      snapshot.quote_time_server = snapshot.quote_time_msc / 1000;
      snapshot.quote_time_resolution = (m_price_h1_ohlc_targets ?
                                        (m_price_timeframe == PERIOD_H1 ? "SERVER_H1_BAR_OPEN_MSC" :
                                           "SERVER_BAR_OPEN_MSC") :
                                        "SERVER_FIRST_AVAILABLE_TICK_MSC");
      snapshot.target_time_resolved = true;
      snapshot.anchor_bar_index = decision;
      snapshot.anchor_bar_open_server = m_bars[decision].server_open;
      snapshot.completed_bar_index = decision - 1;
      snapshot.completed_bar_open_server = m_bars[decision - 1].server_open;
      snapshot.completed_bar_successor_server = m_bars[decision].server_open;
      snapshot.atr_period = 14;
      snapshot.anchor = anchor;
      snapshot.scale = scale;
      snapshot.tick_size = tick_size;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Forward one anchored generation while preserving recurrent state |
   //+------------------------------------------------------------------+
   bool              ForwardHistoricalPriceState(const int decision, const float &values[],
                                    SDPCCHistoricalPriceSnapshot &snapshot, string &reason)
     {
      if(!BuildHistoricalPriceSnapshot(decision, snapshot, reason))
         return(false);
      CNeuronScenarioForecastPriceOCL *forecast = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      //--- Clear the consumed price generation without clearing layers 0-5.
      if(!forecast || !decoder || !decoder.Clear() || !forecast.CancelTrainingFrame() ||
         !forecast.SetPricePhase(defForecastPriceVerify) || !decoder.SetPricePhase(defForecastPriceVerify) ||
         !decoder.BindPriceAnchor(snapshot.anchor, snapshot.scale, snapshot.decision_id))
         return(Fail("study_forecast.price_context.release_or_bind", reason));
      return(ForwardInferenceState(values, reason));
     }

   bool              BuildTargetResponsibilities(const int decision, CNeuronScenarioForecast *forecast,
                                    CNeuronBaseOCL *rank, CNeuronBaseOCL *target, string &reason)
     {
      if(decision < 5 || decision + 12 > ArraySize(m_bars) || !forecast || !rank ||
         (CheckPointer(target) == POINTER_INVALID && !MissingTeacherAllowed()) || !TeacherFrozenPolicy())
         return(Fail("study_forecast.factual_target.freeze_or_shape", reason));
      CBufferFloat *future_target = NULL;
      if(CheckPointer(target) != POINTER_INVALID)
        {
         for(int h = 0; h < 12; h++)
           {
            float values[];
            if(!DPCCStudyForecastFeature(m_bars[decision + h], values))
               return(Fail("study_forecast.future_feature", reason));
            for(int v = 0; v < 9; v++)
               if(!m_future.Update(v * 12 + h, values[v]))
                  return(Fail("study_forecast.future_buffer", reason));
           }
         if(!m_future.BufferWrite() || !m_target.feedForward(GetPointer(m_future), 1, false, (CBufferFloat*)NULL))
            return(Fail("study_forecast.target_forward", reason));
         future_target = target.getOutput();
        }
      else
         if(!BuildFactualFutureLatentTarget(decision, future_target, reason))
            return(false);
      if(!future_target || future_target.Total() != 9 * 12 * 16 ||
         future_target.GetOpenCL() != m_market.GetOpenCL() ||
         !m_gradient_ops.BuildTargetDelta(GetPointer(m_zero), rank.getOutput(), GetPointer(m_negative),
                                          future_target, GetPointer(m_delta), 16, 9) || !TeacherFrozenPolicy())
         return(Fail("study_forecast.factual_target_delta_or_target_changed", reason));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(forecast);
      const bool prepared = (m_price_joint ?
                             (price && price.PrepareLatentSupervision(future_target, GetPointer(m_delta))) :
                             forecast.BuildResponsibilities(future_target, GetPointer(m_delta)));
      if(!prepared || !forecast.LastTargetAccepted() || !forecast.LastBatchControlValid() ||
         !TeacherFrozenPolicy())
         return(Fail("study_forecast.native_loss_or_target_changed", reason));
      return(true);
     }

   bool              BuildSample(const int decision, CNeuronScenarioForecast *&forecast,
                    CNeuronBaseOCL *&rank, CNeuronBaseOCL *&target, string &reason)
     {
      float state_values[];
      if(!DPCCPackStudyForecastInput(m_bars, decision, state_values) || ArraySize(state_values) != 45)
         return(Fail("study_forecast.history_feature", reason));
      if(!ForwardHistoricalState(decision, state_values, reason))
         return(false);
      rank = m_market.Layer(4);
      target = m_target.Layer(-1);
      if(!forecast || !rank || (CheckPointer(target) == POINTER_INVALID && !MissingTeacherAllowed()))
         return(Fail("study_forecast.native_loss.owner", reason));
      return(BuildTargetResponsibilities(decision, forecast, rank, target, reason));
     }

   bool              AdvanceFit(double &rho_sum, uint &rho_nonzero, uint &generator_step, uint &router_step,
                   uint &confidence_step, string &reason)
     {
      const int decision = m_fit[m_cursor];
      if(!m_epoch_started)
        {
         if(!m_market.Clear() || !ClearTeacherState())
            return(Fail("study_forecast.epoch_initial_clear", reason));
         m_epoch_started = true;
        }
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      if(!ompb || !forecast || !rank || !target || !m_market.TrainMode(true) || !m_market.SetWeightsUpdate(true) ||
         !ompb.SetMode(OMPB_BYPASS) || !ompb.SetSourceAnchor(false) || !forecast.SetCodebookUpdate(true))
         return(Fail("study_forecast.train_policy", reason));
      ompb.TrainMode(false);
      if(!BuildSample(decision, forecast, rank, target, reason))
         return(false);
      if(!forecast.CommitBatchDiagnostics())
         return(Fail("study_forecast.fit_diagnostics", reason));
      CBufferFloat *rho = forecast.GetResponsibilities();
      if(!rho || rho.Total() != 21 || !rho.BufferRead())
         return(Fail("study_forecast.rho", reason));
      rho_sum = 0;
      rho_nonzero = 0;
      for(int k = 0; k < 21; k++)
        {
         const float value = (*rho)[k];
         if(!MathIsValidNumber((double)value) || value < 0 || value > 1)
            return(Fail("study_forecast.rho_numeric", reason));
         rho_sum += (double)value;
         if(value > 0)
            rho_nonzero++;
        }
      CNeuronConvOCL *heads[3];
      heads[0] = forecast.GetGenerator();
      heads[1] = forecast.GetRouter();
      heads[2] = forecast.GetConfidenceHead();
      uint steps_before[3], steps_after[3];
      for(int h = 0; h < 3; h++)
        {
         if(!heads[h] || !heads[h].GetWeightsConv())
            return(Fail("study_forecast.learned_head", reason));
         steps_before[h] = heads[h].NativeOptimizerStep();
        }
      if(rho_nonzero == 0 || MathAbs(rho_sum - 1.0) > 1e-5 || !m_market.backPropGradient((CBufferFloat*)NULL, (
         CBufferFloat*)NULL, -1, true))
         return(Fail("study_forecast.backward", reason));
      bool learned = false;
      for(int h = 0; h < 3; h++)
        {
         steps_after[h] = heads[h].NativeOptimizerStep();
         if(steps_before[h] < UINT_MAX && steps_after[h] == steps_before[h] + 1)
            learned = true;
        }
      if(!learned)
         return(Fail("study_forecast.learned_head_no_update", reason));
      generator_step = forecast.GetGenerator().NativeOptimizerStep();
      router_step = forecast.GetRouter().NativeOptimizerStep();
      confidence_step = forecast.GetConfidenceHead().NativeOptimizerStep();
      m_updates++;
      m_cursor++;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Normalize factual prices only after the causal Market forward    |
   //+------------------------------------------------------------------+
   bool              PreparePriceJointTarget(const int decision, CNeuronScenarioDecoderOCL *decoder, string &reason)
     {
      double anchor = 0, scale = 0;
      ulong decision_id = 0;
      if(!decoder || decision < 5 || decision + 12 > ArraySize(m_bars) ||
         !decoder.GetPriceAnchor(anchor, scale, decision_id) ||
         !DPCCPriceTargetWindowAvailable(m_bars, decision, 12, m_price_quote_mode, m_price_h1_ohlc_targets,
                                         m_price_timeframe) ||
         decision_id != (ulong)DPCCHistoricalPriceTargetTimeMsc(m_bars[decision]) ||
         anchor != DPCCHistoricalPriceTargetValue(m_bars[decision], 0) ||
         scale != (double)m_bars[decision - 1].indicators[2] || !MathIsValidNumber(scale) || scale <= 0 ||
         m_price_target.Total() != 12 * 4)
         return(Fail("study_forecast.price_joint.target_frame", reason));
      //--- One physical scenario conversion validates this forward's fp32/tick compatibility.
      if(m_price_observation.decision_id != decision_id || m_price_observation.anchor != anchor ||
         m_price_observation.scale != scale ||
         !decoder.BuildNativeScenarios(GetPointer(m_price_native), 12, m_price_observation.tick_size))
         return(Fail("study_forecast.price_joint.native_precision", reason));
      for(int h = 0; h < 12; h++)
        {
         const int row = decision + h;
         if(m_bars[row].server_open <= m_bars[row - 1].server_open ||
            DPCCHistoricalPriceTargetValue(m_bars[row], 1) < MathMax(DPCCHistoricalPriceTargetValue(m_bars[row], 0),
               DPCCHistoricalPriceTargetValue(m_bars[row], 3)) ||
            DPCCHistoricalPriceTargetValue(m_bars[row], 2) > MathMin(DPCCHistoricalPriceTargetValue(m_bars[row], 0),
               DPCCHistoricalPriceTargetValue(m_bars[row], 3)))
            return(Fail("study_forecast.price_joint.target_geometry", reason));
         for(int c = 0; c < 4; c++)
           {
            const double price = DPCCHistoricalPriceTargetValue(m_bars[row], c);
            const double value = (price - anchor) / scale;
            const float normalized = (float)value;
            if(!MathIsValidNumber(price) || !MathIsValidNumber(value) ||
               !MathIsValidNumber(normalized) || (h == 0 && c == 0 && normalized != 0) ||
               !m_price_target.Update(h * 4 + c, normalized))
               return(Fail("study_forecast.price_joint.target_numeric", reason));
           }
        }
      if(!m_price_target.BufferWrite())
         return(Fail("study_forecast.price_joint.target_upload", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Freeze one completed joint phase and check its immutable owners  |
   //+------------------------------------------------------------------+
   bool              FreezePriceJoint(string &reason)
     {
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronBaseOCL *ompb_base = ompb;
      if(!price || !decoder || !ompb || !decoder.Clear() || !price.CancelTrainingFrame() ||
         !m_market.TrainMode(false) || !m_market.SetWeightsUpdate(false) ||
         !price.SetCodebookUpdate(false) || !price.SetPricePhase(defForecastPriceVerify) ||
         !decoder.SetPricePhase(defForecastPriceVerify) || !FrozenProducer(reason) ||
         ompb_base.TrainMode() || ompb.Mode() != OMPB_BYPASS || ompb.SourceAnchor())
         return(Fail("study_forecast.price_joint.freeze", reason));
      ulong teacher = 0, ompb_after = 0;
      if(!TeacherFingerprint(teacher) || teacher != m_teacher_initial_fingerprint ||
         !ompb.AppendParameterFingerprint(ompb_after) || ompb_after != m_price_joint_ompb_fingerprint)
         return(Fail("study_forecast.price_joint.frozen_boundary", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Commit native latent and detached price signals in one CNet pass |
   //+------------------------------------------------------------------+
   bool              AdvancePriceJointFit(double &loss, double &rho_sum, uint &rho_nonzero, uint &generator_step,
                             uint &router_step, uint &confidence_step, string &reason)
     {
      if(!m_epoch_started)
        {
         if(!m_market.Clear() || !ClearTeacherState())
            return(Fail("study_forecast.price_joint.epoch_clear", reason));
         m_epoch_started = true;
        }
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      CNeuronBaseOCL *ompb_base = ompb;
      if(!ompb || !price || !decoder || !decoder.Clear() || !price.CancelTrainingFrame() ||
         !m_market.TrainMode(true) || !m_market.SetWeightsUpdate(true) ||
         !SetTeacherFrozenPolicy() ||
         !ompb.SetMode(OMPB_BYPASS) || !ompb.SetSourceAnchor(false) ||
         !price.SetPricePhase(m_price_study_phase) || !decoder.SetPricePhase(m_price_study_phase) ||
         !price.SetCodebookUpdate(true))
         return(Fail("study_forecast.price_joint.train_policy", reason));
      ompb.TrainMode(false);
      if(ompb_base.TrainMode() || !TeacherFrozenPolicy())
         return(Fail("study_forecast.price_joint.frozen_owner_policy", reason));
      //--- Check optimizer counters without reading full parameter tensors.
      CNeuronConvOCL *heads[3];
      heads[0] = price.GetGenerator();
      heads[1] = price.GetRouter();
      heads[2] = price.GetConfidenceHead();
      uint steps_before[3];
      for(int h = 0; h < 3; h++)
        {
         if(!heads[h] || heads[h].NativeOptimizerStep() == UINT_MAX)
            return(Fail("study_forecast.price_joint.head_counter", reason));
         steps_before[h] = heads[h].NativeOptimizerStep();
        }
      const uint decoder_before = decoder.UpdateCount();
      if(decoder_before == UINT_MAX)
         return(Fail("study_forecast.price_joint.decoder_counter", reason));
      //--- Future labels enter only after the matching anchored Market generation.
      CNeuronScenarioForecast *forecast = price;
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      const int decision = (m_m05 && m_price_study_phase == defForecastPriceLatentPrepare ?
                            m_latent_fit[m_cursor] : m_fit[m_cursor]);
      if(!BuildSample(decision, forecast, rank, target, reason) || !price.PriceSupervisionPrepared())
         return(Fail("study_forecast.price_fit.latent_supervision:" + reason, reason));
      if(m_price_study_phase == defForecastPriceLatentPrepare)
        {
         //--- Layer7 records and reverses its tape, then its phase gate completes without a weight write.
         if(!decoder.getGradient() || !decoder.getGradient().Fill(0.0f))
            return(Fail("study_forecast.latent_prepare.zero_price_gradient", reason));
        }
      else
         if(m_price_study_phase == defForecastPriceJoint)
           {
            if(!PreparePriceJointTarget(decision, decoder, reason) ||
               !decoder.PreparePriceLoss(price, GetPointer(m_price_target), m_price_lambda, m_price_huber,
                                         m_price_rho_tolerance, true, loss) ||
               !MathIsValidNumber(loss) || loss < 0)
               return(Fail("study_forecast.price_joint.prepare_loss:" + reason, reason));
           }
         else
            return(Fail("study_forecast.price_fit.unsupported_phase", reason));
      if(!price.CommitBatchDiagnostics())
         return(Fail("study_forecast.price_fit.batch_diagnostics", reason));
      CBufferFloat *rho = price.GetResponsibilities();
      if(!rho || rho.Total() != 21 || !rho.BufferRead())
         return(Fail("study_forecast.price_joint.rho", reason));
      for(int k = 0; k < 21; k++)
        {
         const float value = (*rho)[k];
         if(!MathIsValidNumber(value) || value < 0 || value > 1)
            return(Fail("study_forecast.price_joint.rho_numeric", reason));
         rho_sum += (double)value;
         if(value > 0)
            rho_nonzero++;
        }
      if(rho_nonzero == 0 || MathAbs(rho_sum - 1.0) > (double)m_price_rho_tolerance)
         return(Fail("study_forecast.price_joint.rho_mass", reason));
      //--- Decoder writes dZ; ForecastPrice adds native signals before one Adam/EMA update.
      if(!m_market.backPropGradient((CBufferFloat*)NULL, (CBufferFloat*)NULL, 7, false))
         return(Fail("study_forecast.price_joint.partial_transaction", reason));
      for(int h = 0; h < 3; h++)
         if(heads[h].NativeOptimizerStep() != steps_before[h] + 1)
            return(Fail("study_forecast.price_joint.head_single_update", reason));
      const uint expected_decoder = (m_price_study_phase == defForecastPriceJoint ? decoder_before + 1 :
         decoder_before);
      if(decoder.UpdateCount() != expected_decoder || decoder.GenerationPhase() != 0 ||
         price.PriceSupervisionPrepared() || !TeacherFrozenPolicy() ||
         ompb_base.TrainMode() || ompb.Mode() != OMPB_BYPASS || ompb.SourceAnchor() ||
         !decoder.Clear() || !price.CancelTrainingFrame())
         return(Fail("study_forecast.price_joint.release_or_freeze", reason));
      generator_step = heads[0].NativeOptimizerStep();
      router_step = heads[1].NativeOptimizerStep();
      confidence_step = heads[2].NativeOptimizerStep();
      if(m_price_study_phase == defForecastPriceJoint)
        {
         m_price_loss_sum += loss;
         m_price_joint_updates++;
        }
      m_updates++;
      m_cursor++;
      return(true);
     }

   int               ResolveM05TimeBoundary(const datetime boundary) const
     {
      for(int i = 0; i < ArraySize(m_bars); i++)
         if(m_bars[i].server_open >= (long)boundary)
            return(i);
      return(ArraySize(m_bars));
     }
   //+------------------------------------------------------------------+
   //| Bind donor dates to the captured raw identity                    |
   //+------------------------------------------------------------------+
   bool              ResolveM05OMPBIdentity(string &reason)
     {
      reason = "";
      if(!m_ompb_configured || m_raw_sha == "" ||
         !DPCCArchitectureSHA256Encoding(m_raw_sha) ||
         ArraySize(m_bars) < 18)
         return(Fail("study_forecast.ompb.raw_identity", reason));
      m_ompb_profile.raw_sha256 = m_raw_sha;
      m_ompb_profile.reference_first_bar = ResolveM05TimeBoundary(m_ompb_profile.reference_start);
      m_ompb_profile.reference_split_bar = ResolveM05TimeBoundary(m_ompb_profile.reference_split);
      m_ompb_profile.reference_end_bar = ResolveM05TimeBoundary(m_ompb_profile.reference_end);
      m_ompb_profile.calibration_first_bar = ResolveM05TimeBoundary(m_ompb_profile.calibration_start);
      m_ompb_profile.calibration_split_bar = ResolveM05TimeBoundary(m_ompb_profile.calibration_split);
      m_ompb_profile.calibration_end_bar = ResolveM05TimeBoundary(m_ompb_profile.calibration_end);
      if(!DPCCResolverLowerSha256(m_ompb_profile.profile_sha256) ||
         !DPCCResolverLowerSha256(m_ompb_profile.raw_sha256) ||
         m_ompb_profile.reference_first_bar < 5 ||
         m_ompb_profile.reference_split_bar <= m_ompb_profile.reference_first_bar ||
         m_ompb_profile.reference_end_bar <= m_ompb_profile.reference_split_bar ||
         m_ompb_profile.calibration_first_bar < m_ompb_profile.reference_end_bar ||
         m_ompb_profile.calibration_split_bar <= m_ompb_profile.calibration_first_bar ||
         m_ompb_profile.calibration_end_bar <= m_ompb_profile.calibration_split_bar ||
         m_ompb_profile.calibration_end_bar > ArraySize(m_bars))
         return(Fail("study_forecast.ompb.time_window_binding", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Resolve calibration windows using the donor's 80/20 partitions   |
   //+------------------------------------------------------------------+
   bool              ResolveOMPBFitRows(string &reason)
     {
      if(!m_ompb_configured || m_ompb_profile.raw_sha256 != m_raw_sha ||
         m_ompb_profile.calibration_end_bar > ArraySize(m_bars))
         return(Fail("study_forecast.ompb.profile_raw_or_window", reason));
      ArrayResize(m_ompb_reference, 0);
      ArrayResize(m_ompb_calibration, 0);
      ArrayResize(m_ompb_source_evaluation, 0);
      ArrayResize(m_ompb_target_evaluation, 0);
      for(int row = 5; row + 12 < ArraySize(m_bars); row++)
        {
         if(!DPCCPriceTargetWindowAvailable(m_bars, row, 12, m_price_quote_mode, m_price_h1_ohlc_targets,
                                            m_price_timeframe))
            continue;
         const int future = row + 12;
         if(row >= m_ompb_profile.reference_first_bar &&
            future < m_ompb_profile.reference_split_bar)
           {
            const int count = ArraySize(m_ompb_reference);
            if(ArrayResize(m_ompb_reference, count + 1, 256) != count + 1)
               return(Fail("study_forecast.ompb.reference_rows", reason));
            m_ompb_reference[count] = row;
           }
         if(row >= m_ompb_profile.calibration_first_bar &&
            future < m_ompb_profile.calibration_split_bar)
           {
            const int count = ArraySize(m_ompb_calibration);
            if(ArrayResize(m_ompb_calibration, count + 1, 256) != count + 1)
               return(Fail("study_forecast.ompb.calibration_rows", reason));
            m_ompb_calibration[count] = row;
           }
         if(row >= m_ompb_profile.reference_split_bar && future < m_ompb_profile.reference_end_bar)
           {
            const int count = ArraySize(m_ompb_source_evaluation);
            if(ArrayResize(m_ompb_source_evaluation, count + 1, 256) != count + 1)
               return(Fail("study_forecast.ompb.source_evaluation_rows", reason));
            m_ompb_source_evaluation[count] = row;
           }
         if(row >= m_ompb_profile.calibration_split_bar && future < m_ompb_profile.calibration_end_bar)
           {
            const int count = ArraySize(m_ompb_target_evaluation);
            if(ArrayResize(m_ompb_target_evaluation, count + 1, 256) != count + 1)
               return(Fail("study_forecast.ompb.target_evaluation_rows", reason));
            m_ompb_target_evaluation[count] = row;
           }
        }
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CLayerDescription *description = (ompb ? ompb.GetLayerInfo() : NULL);
      if(!description)
         return(Fail("study_forecast.ompb.layer_description", reason));
      const bool shape = (ArraySize(description.units) == 2 && description.units[0] > 0 && description.units[1] > 0);
      if(shape)
        {
         m_ompb_reference_capacity = description.units[0];
         m_ompb_current_capacity = description.units[1];
        }
      delete description;
      if(!shape || (ulong)ArraySize(m_ompb_reference) < m_ompb_reference_capacity ||
         (ulong)ArraySize(m_ompb_calibration) < m_ompb_current_capacity ||
         ArraySize(m_ompb_source_evaluation) == 0 || ArraySize(m_ompb_target_evaluation) == 0)
         return(Fail("study_forecast.ompb.insufficient_full_histories", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Freeze all network writes and permit only the OMPB optimizer     |
   //+------------------------------------------------------------------+
   bool              SetOMPBStudyPolicy(const ENUM_OMPB_MODE mode, string &reason)
     {
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!ompb || !price || !decoder || !decoder.Clear() || !price.CancelTrainingFrame() ||
         !m_market.TrainMode(false) || !m_market.SetWeightsUpdate(false) ||
         !SetTeacherFrozenPolicy() ||
         !price.SetCodebookUpdate(false) || !price.SetGradientNormalization(mode != OMPB_CALIBRATE) ||
         !price.SetPricePhase(defForecastPriceOMPBCalibrate) ||
         !decoder.SetPricePhase(defForecastPriceOMPBCalibrate) || !ompb.SetSourceAnchor(false) || !ompb.SetMode(mode))
         return(Fail("study_forecast.ompb.freeze_policy", reason));
      ompb.TrainMode(mode == OMPB_CALIBRATE);
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Read immutable parameter owners only at calibration boundaries   |
   //+------------------------------------------------------------------+
   bool              OMPBFrozenFingerprint(ulong &fingerprint, string &reason)
     {
      fingerprint = ulong(1469598103934665603);
      if(m_market.WeightsUpdateEnabled() || !TeacherFrozenPolicy())
         return(Fail("study_forecast.ompb.network_write_enabled", reason));
      for(int i = 0; i < 8; i++)
        {
         if(i == 5)
            continue;
         CNeuronBaseOCL *layer = m_market.Layer(i);
         if(!layer || layer.TrainMode() || !layer.AppendParameterFingerprint(fingerprint))
            return(Fail("study_forecast.ompb.frozen_layer", reason));
        }
      ulong target_fingerprint = 0;
      if(!TeacherFingerprint(target_fingerprint) || target_fingerprint != m_teacher_initial_fingerprint)
         return(Fail("study_forecast.ompb.target_changed", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Enter Stage02 on the retained post-PRICE_JOINT Market graph      |
   //+------------------------------------------------------------------+
   bool              BeginOMPBCalibrate(string &reason)
     {
      if(!m_m05 || !m_full_run || !ResolveOMPBFitRows(reason) ||
         !SetOMPBStudyPolicy(OMPB_REFERENCE, reason))
         return(Fail("study_forecast.ompb.begin:" + reason, reason));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!ompb || !forecast || !decoder || !m_market.Clear() || !ClearTeacherState() || !ompb.ResetReference() ||
         !ompb.SetTau(m_ompb_profile.tau) || !ompb.SetDisagreementMult(m_ompb_profile.lambda_dis) ||
         !ompb.SetKLDMult(m_ompb_profile.lambda_kl) || !ompb.SetAlphaMult(m_ompb_profile.lambda_alpha) ||
         !ompb.SetAlphaPrior(m_ompb_profile.alpha_prior) || !ompb.SetMaxKL(m_ompb_profile.max_kl) ||
         !OMPBFrozenFingerprint(m_ompb_frozen_fingerprint, reason) ||
         !ompb.AppendParameterFingerprint(m_ompb_initial_fingerprint))
         return(Fail("study_forecast.ompb.initialize:" + reason, reason));
      CNeuronConvOCL *heads[3];
      heads[0] = forecast.GetGenerator();
      heads[1] = forecast.GetRouter();
      heads[2] = forecast.GetConfidenceHead();
      for(int h = 0; h < 3; h++)
        {
         if(!heads[h] || heads[h].NativeOptimizerStep() == UINT_MAX)
            return(Fail("study_forecast.ompb.forecast_counter", reason));
         m_ompb_forecast_steps[h] = heads[h].NativeOptimizerStep();
        }
      m_ompb_decoder_updates = decoder.UpdateCount();
      m_price_study_phase = defForecastPriceOMPBCalibrate;
      m_cursor = 0;
      m_ompb_reference_cursor = 0;
      m_ompb_epoch = 0;
      m_ompb_epoch_source_updates = 0;
      m_ompb_reference_complete = false;
      m_ompb_epoch_started = false;
      m_ompb_source_pending = false;
      m_ompb_calibration_completed = false;
      m_ompb_stage02_quality_pass = false;
      m_ompb_evaluation_stage = 0;
      m_ompb_evaluation_cursor = 0;
      m_ompb_evaluation_posterior = 0;
      ArrayInitialize(m_ompb_evaluation_loss, 0);
      ArrayInitialize(m_ompb_evaluation_valid, 0);
      ArrayInitialize(m_ompb_evaluation_invalid, 0);
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Commit native Forecast supervision to only posterior and alpha   |
   //+------------------------------------------------------------------+
   bool              RunOMPBCalibrationRow(const int decision, const bool source_anchor, string &reason)
     {
      if(!SetOMPBStudyPolicy(OMPB_CALIBRATE, reason))
         return(false);
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(forecast);
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      if(!ompb || !price || !decoder || !rank || !ompb.SetSourceAnchor(source_anchor))
         return(Fail("study_forecast.ompb.batch_owner", reason));
      const uint current_before = ompb.CurrentCount();
      const uint reference_before = ompb.ReferenceCount();
      if(!source_anchor && !ompb.BeginCurrentTransaction())
         return(Fail("study_forecast.ompb.current_begin", reason));
      //--- The frozen decoder is a forward output only; native Stage02 starts backward at Forecast.
      const bool prepared = BuildSample(decision, forecast, rank, target, reason);
      const bool backward = (prepared && ompb.ForwardAccepted() && price.PriceSupervisionPrepared() &&
                             price.CommitBatchDiagnostics() && decoder.Clear() &&
                             m_market.backPropGradient((CBufferFloat*)NULL, (CBufferFloat*)NULL, 6, false));
      if(!backward)
        {
         const bool cleaned = (source_anchor ? ompb.SetSourceAnchor(false) : ompb.RollbackCurrentTransaction());
         if(!cleaned)
            return(Fail("study_forecast.ompb.batch_rollback:" + reason, reason));
         return(Fail("study_forecast.ompb.native_batch:" + reason, reason));
        }
      //--- Source anchors retain their flag until all native gradients exist, as in Stage02RunBatch.
      if(source_anchor && !ompb.SetSourceAnchor(false))
         return(Fail("study_forecast.ompb.anchor_release", reason));
      if(!ompb.ForwardAccepted() || !ompb.UpdateInputWeights(rank))
        {
         if(!source_anchor && !ompb.RollbackCurrentTransaction())
            return(Fail("study_forecast.ompb.update_rollback", reason));
         return(Fail("study_forecast.ompb.partial_optimizer_transaction", reason));
        }
      if(!source_anchor && !ompb.CommitCurrentTransaction())
        {
         if(!ompb.RollbackCurrentTransaction())
            return(Fail("study_forecast.ompb.commit_rollback", reason));
         return(Fail("study_forecast.ompb.current_commit", reason));
        }
      if(ompb.ReferenceCount() != reference_before ||
         (source_anchor && ompb.CurrentCount() != current_before) || price.PriceSupervisionPrepared() ||
         decoder.GenerationPhase() != 0 || !price.CancelTrainingFrame())
         return(Fail("study_forecast.ompb.batch_release", reason));
      m_updates++;
      if(source_anchor)
         m_ompb_source_updates++;
      else
         m_ompb_target_updates++;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Finish calibration with frozen owners and an inference posterior |
   //+------------------------------------------------------------------+
   bool              FinishOMPBCalibrate(string &reason)
     {
      if(!SetOMPBStudyPolicy(OMPB_INFERENCE, reason))
         return(false);
      ulong frozen = 0, posterior = 0;
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!ompb || !forecast || !decoder || !OMPBFrozenFingerprint(frozen, reason) ||
         frozen != m_ompb_frozen_fingerprint || !ompb.AppendParameterFingerprint(posterior) ||
         posterior == m_ompb_initial_fingerprint || m_ompb_target_updates == 0 ||
         m_ompb_epoch != m_ompb_profile.epochs || decoder.UpdateCount() != m_ompb_decoder_updates ||
         ompb.ReferenceCount() != m_ompb_reference_capacity || ompb.CurrentCount() != m_ompb_current_capacity)
         return(Fail("study_forecast.ompb.frozen_boundary:" + reason, reason));
      CNeuronConvOCL *heads[3];
      heads[0] = forecast.GetGenerator();
      heads[1] = forecast.GetRouter();
      heads[2] = forecast.GetConfidenceHead();
      for(int h = 0; h < 3; h++)
         if(!heads[h] || heads[h].NativeOptimizerStep() != m_ompb_forecast_steps[h])
            return(Fail("study_forecast.ompb.forecast_optimizer_changed", reason));
      m_ompb_calibration_completed = true;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Advance one held-out Stage02 row and retain donor loss metrics   |
   //+------------------------------------------------------------------+
   bool              AdvanceOMPBEvaluation(string &reason)
     {
      const int lane = m_ompb_evaluation_stage;
      if(lane < 0 || lane >= 6 || (lane >= 4 && !m_ompb_calibration_completed))
         return(Fail("study_forecast.ompb.evaluation_stage", reason));
      const bool source = (lane % 2 == 0);
      const int count = (source ? ArraySize(m_ompb_source_evaluation) : ArraySize(m_ompb_target_evaluation));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(forecast);
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!ompb || !price || !decoder || count <= 0 || m_ompb_evaluation_cursor < 0 ||
         m_ompb_evaluation_cursor >= count)
         return(Fail("study_forecast.ompb.evaluation_owner_or_cursor", reason));
      //--- Rewind chronology without discarding the retained OMPB histories.
      if(m_ompb_evaluation_cursor == 0)
        {
         if(!SetOMPBStudyPolicy(lane < 2 ? OMPB_BYPASS : OMPB_INFERENCE, reason))
            return(false);
         for(int i = 0; i < 5; i++)
            if(!m_market.Layer(i) || !m_market.Layer(i).Clear())
               return(Fail("study_forecast.ompb.evaluation_trunk_clear", reason));
         if(!price.Clear() || !decoder.Clear() || !ClearTeacherState() || !price.ResetEpochDiagnostics())
            return(Fail("study_forecast.ompb.evaluation_head_clear", reason));
         m_ompb_evaluation_posterior = 0;
         if(!ompb.AppendParameterFingerprint(m_ompb_evaluation_posterior) ||
            (lane < 4 && m_ompb_evaluation_posterior != m_ompb_initial_fingerprint))
            return(Fail("study_forecast.ompb.pre_evaluation_posterior_changed", reason));
        }
      const int decision = (source ? m_ompb_source_evaluation[m_ompb_evaluation_cursor] :
                            m_ompb_target_evaluation[m_ompb_evaluation_cursor]);
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      if(!BuildSample(decision, forecast, rank, target, reason) || (lane >= 2 && !ompb.ForwardAccepted()) ||
         !price.PriceSupervisionPrepared() || !price.CommitBatchDiagnostics())
        {
         m_ompb_evaluation_invalid[lane]++;
         return(Fail("study_forecast.ompb.evaluation_row:" + reason, reason));
        }
      m_ompb_evaluation_valid[lane]++;
      m_ompb_evaluation_cursor++;
      if(!decoder.Clear() || !price.CancelTrainingFrame())
         return(Fail("study_forecast.ompb.evaluation_release", reason));
      if(m_ompb_evaluation_cursor < count)
         return(true);
      //--- Match ACSRMStage02Baseline / InferenceEvaluation: forecast_loss = lmix / valid.
      double mix = 0, router = 0, trajectory = 0, confidence = 0, latent = 0, observation = 0;
      double valid = 0, invalid = 0, entropy = 0, distance = 0, inactive = 0, recovered = 0;
      ulong frozen = 0, posterior = 0;
      if(!price.BuildEpochCodebookDiagnostics() ||
         !price.ReadEpochDiagnostics(mix, router, trajectory, confidence, latent, observation,
                                     valid, invalid, entropy, distance, inactive, recovered))
         return(Fail("study_forecast.ompb.evaluation_metrics_read", reason));
      const double attempts = m_ompb_evaluation_valid[lane];
      m_ompb_evaluation_valid[lane] = valid;
      m_ompb_evaluation_invalid[lane] += invalid;
      if(!MathIsValidNumber(mix) || !MathIsValidNumber(valid) || !MathIsValidNumber(invalid) ||
         valid <= 0 || valid < attempts || invalid < 0)
         return(Fail("study_forecast.ompb.evaluation_metrics_domain", reason));
      m_ompb_evaluation_loss[lane] = mix / valid;
      if(!MathIsValidNumber(m_ompb_evaluation_loss[lane]) ||
         !OMPBFrozenFingerprint(frozen, reason) || frozen != m_ompb_frozen_fingerprint ||
         !ompb.AppendParameterFingerprint(posterior) || posterior != m_ompb_evaluation_posterior ||
         decoder.UpdateCount() != m_ompb_decoder_updates)
         return(Fail("study_forecast.ompb.evaluation_frozen_or_loss:" + reason, reason));
      PrintFormat("DPCC_M05_STAGE02_EVALUATION lane=%d loss=%.9f valid=%.0f invalid=%.0f",
                  lane, m_ompb_evaluation_loss[lane], valid, m_ompb_evaluation_invalid[lane]);
      m_ompb_evaluation_cursor = 0;
      m_ompb_evaluation_stage++;
      if(m_ompb_evaluation_stage < 6)
         return(true);
      //--- Donor acceptance compares frozen BYPASS baselines with calibrated INFERENCE.
      const double target_improvement = (m_ompb_evaluation_loss[1] - m_ompb_evaluation_loss[5]) /
                                        MathMax(MathAbs(m_ompb_evaluation_loss[1]), 1.0e-12);
      const double source_degradation = (m_ompb_evaluation_loss[4] - m_ompb_evaluation_loss[0]) /
                                        MathMax(MathAbs(m_ompb_evaluation_loss[0]), 1.0e-12);
      m_ompb_stage02_quality_pass = (MathIsValidNumber(target_improvement) &&
                                     MathIsValidNumber(source_degradation) &&
                                     m_ompb_evaluation_valid[4] > 0 && m_ompb_evaluation_valid[5] > 0 &&
                                     target_improvement >= 0.01 && source_degradation <= 0.01);
      PrintFormat(
                  "DPCC_M05_STAGE02_QUALITY status=%s target_improvement=%.8f source_degradation=%.8f continuation=PERMITTED",
                  (m_ompb_stage02_quality_pass ? "PASS" : "FAIL"), target_improvement, source_degradation);
      if(!FinishOMPBCalibrate(reason))
         return(false);
      return(BeginPriceAdapt(reason));
     }
   //+------------------------------------------------------------------+
   //| Advance one Reference, evaluation, target, or source-anchor row  |
   //+------------------------------------------------------------------+
   bool              AdvanceOMPBCalibrate(string &reason)
     {
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!ompb || !price || !decoder || !m_ompb_configured)
         return(Fail("study_forecast.ompb.advance_owner", reason));
      if(!m_ompb_reference_complete)
        {
         if(m_ompb_reference_cursor >= ArraySize(m_ompb_reference) || !SetOMPBStudyPolicy(OMPB_REFERENCE, reason))
            return(Fail("study_forecast.ompb.reference_limit:" + reason, reason));
         const int decision = m_ompb_reference[m_ompb_reference_cursor];
         float values[];
         if(!DPCCPackStudyForecastInput(m_bars, decision, values) ||
            !ForwardHistoricalState(decision, values, reason) || !decoder.Clear() || !price.CancelTrainingFrame())
            return(Fail("study_forecast.ompb.reference_forward:" + reason, reason));
         m_ompb_reference_cursor++;
         if(ompb.ReferenceCount() == m_ompb_reference_capacity)
            m_ompb_reference_complete = true;
         return(true);
        }
      if(m_ompb_evaluation_stage < 4 || m_ompb_calibration_completed)
         return(AdvanceOMPBEvaluation(reason));
      if(!m_ompb_epoch_started)
        {
         if(!m_market.Clear() || !ClearTeacherState() || !price.ResetEpochDiagnostics())
            return(Fail("study_forecast.ompb.epoch_clear", reason));
         m_cursor = 0;
         m_ompb_epoch_source_updates = 0;
         m_ompb_epoch_started = true;
        }
      if(m_ompb_source_pending)
        {
         const int source = m_ompb_reference[m_ompb_epoch_source_updates % (uint)ArraySize(m_ompb_reference)];
         if(!RunOMPBCalibrationRow(source, true, reason))
            return(false);
         m_ompb_epoch_source_updates++;
         m_ompb_source_pending = false;
        }
      else
        {
         if(m_cursor >= ArraySize(m_ompb_calibration) ||
            !RunOMPBCalibrationRow(m_ompb_calibration[m_cursor], false, reason))
            return(Fail("study_forecast.ompb.target_row:" + reason, reason));
         m_cursor++;
         m_ompb_source_pending = (m_ompb_profile.source_anchor_period > 0 &&
                                  (uint)m_cursor % m_ompb_profile.source_anchor_period == 0);
        }
      if(m_cursor == ArraySize(m_ompb_calibration) && !m_ompb_source_pending)
        {
         m_ompb_epoch++;
         m_ompb_epoch_started = false;
         if(m_ompb_epoch == m_ompb_profile.epochs)
            return(FinishOMPBCalibrate(reason));
        }
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Keep the calibrated posterior and every upstream parameter fixed |
   //+------------------------------------------------------------------+
   bool              SetPriceAdaptPolicy(const bool train_decoder, string &reason)
     {
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      const uint phase = (train_decoder ? defForecastPriceAdapt : defForecastPriceVerify);
      if(!ompb || !price || !decoder ||
         !m_market.TrainMode(false) || !m_market.SetWeightsUpdate(train_decoder) ||
         !SetTeacherFrozenPolicy() ||
         !price.SetCodebookUpdate(false) || !price.SetPricePhase(phase) || !decoder.SetPricePhase(phase) ||
         !ompb.SetSourceAnchor(false) || !ompb.SetMode(OMPB_INFERENCE))
         return(Fail("study_forecast.price_adapt.freeze_policy", reason));
      //--- Only Layer7 records a training tape and owns a permitted optimizer write.
      decoder.TrainMode(train_decoder);
      for(int i = 0; i < 7; i++)
         if(!m_market.Layer(i) || m_market.Layer(i).TrainMode())
            return(Fail("study_forecast.price_adapt.upstream_train_mode", reason));
      if(decoder.TrainMode() != train_decoder ||
         !TeacherFrozenPolicy() || price.CodebookUpdate())
         return(Fail("study_forecast.price_adapt.owner_policy", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Fingerprint only frozen parameters at adaptation boundaries      |
   //+------------------------------------------------------------------+
   bool              PriceAdaptFrozenFingerprint(ulong &fingerprint, string &reason)
     {
      fingerprint = ulong(1469598103934665603);
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(!ompb || !forecast || ompb.Mode() != OMPB_INFERENCE || ompb.SourceAnchor() ||
         forecast.CodebookUpdate() || !TeacherFrozenPolicy())
         return(Fail("study_forecast.price_adapt.frozen_owner", reason));
      for(int i = 0; i < 7; i++)
        {
         CNeuronBaseOCL *layer = m_market.Layer(i);
         if(!layer || layer.TrainMode() || !layer.AppendParameterFingerprint(fingerprint))
            return(Fail("study_forecast.price_adapt.frozen_parameter", reason));
        }
      ulong target_fingerprint = 0;
      if(!TeacherFingerprint(target_fingerprint) || target_fingerprint != m_teacher_initial_fingerprint)
         return(Fail("study_forecast.price_adapt.target_changed", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Enter decoder adaptation on FIT with the final OMPB posterior    |
   //+------------------------------------------------------------------+
   bool              BeginPriceAdapt(string &reason, const bool operator_selected = false)
     {
      if(!m_m05 || !m_full_run || !m_ompb_configured ||
         (!operator_selected && (!m_ompb_calibration_completed || m_ompb_target_updates == 0)) ||
         !SetPriceAdaptPolicy(true, reason) ||
         !PriceAdaptFrozenFingerprint(m_price_adapt_frozen_fingerprint, reason))
         return(Fail("study_forecast.price_adapt.begin:" + reason, reason));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!price || !decoder)
         return(Fail("study_forecast.price_adapt.graph", reason));
      //--- Rewind chronological inference state while retaining OMPB Reference/Current histories.
      for(int i = 0; i < 5; i++)
         if(!m_market.Layer(i).Clear())
            return(Fail("study_forecast.price_adapt.trunk_runtime_clear", reason));
      if(!price.Clear() || !decoder.Clear() || !ClearTeacherState())
         return(Fail("study_forecast.price_adapt.head_runtime_clear", reason));
      m_price_adapt_decoder_updates = decoder.UpdateCount();
      m_price_adapt_updates = 0;
      m_price_adapt_loss_sum = 0;
      m_price_adapt_epoch_limit = m_ompb_profile.price_adapt_epochs;
      if(!DPCCResolveM05PricePhaseBudget(ArraySize(m_fit), m_price_adapt_epoch_limit,
                                         m_ompb_profile.price_adapt_max_updates, m_price_adapt_update_limit, reason))
         return(Fail("study_forecast.price_adapt.phase_budget:" + reason, reason));
      m_price_adapt_epochs_completed = 0;
      m_price_phase_terminal_status = "";
      m_price_study_phase = defForecastPriceAdapt;
      m_cursor = 0;
      m_fit_limit = ArraySize(m_fit);
      m_finished = false;
      return(true);
     }
   bool              FreezePriceAdapt(string &reason)
     {
      if(!SetPriceAdaptPolicy(false, reason))
         return(false);
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      ulong frozen_after = 0;
      if(!decoder || !PriceAdaptFrozenFingerprint(frozen_after, reason) ||
         frozen_after != m_price_adapt_frozen_fingerprint ||
         (ulong)decoder.UpdateCount() != (ulong)m_price_adapt_decoder_updates + m_price_adapt_updates)
         return(Fail("study_forecast.price_adapt.frozen_boundary:" + reason, reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Finish the four Market phases; PRICE_VERIFY is no longer a gate  |
   //+------------------------------------------------------------------+
   bool              CompleteM05Training(string &reason)
     {
      if(!m_m05 || !m_ready || m_failed || m_price_adapt_epoch_limit == 0 ||
         m_price_adapt_epochs_completed != m_price_adapt_epoch_limit || m_price_adapt_updates == 0 ||
         !SetPriceAdaptPolicy(false, reason))
         return(Fail("study_forecast.M05.training_incomplete:" + reason, reason));
      m_price_study_phase = defForecastPriceAdapt;
      m_fit_limit = ArraySize(m_fit);
      m_cursor = m_fit_limit;
      m_epoch_started = false;
      m_price_phase_terminal_status = "PHASE_COMPLETED";
      m_finished = true;
      m_m05_manifest_bound = false;
      reason = "";
      return(true);
     }
   bool              RestartPriceAdaptEpoch(string &reason)
     {
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!price || !decoder || !SetPriceAdaptPolicy(true, reason))
         return(Fail("study_forecast.price_adapt.epoch_policy:" + reason, reason));
      for(int i = 0; i < 5; i++)
         if(!m_market.Layer(i) || !m_market.Layer(i).Clear())
            return(Fail("study_forecast.price_adapt.epoch_trunk_clear", reason));
      if(!price.Clear() || !decoder.Clear() || !ClearTeacherState())
         return(Fail("study_forecast.price_adapt.epoch_head_clear", reason));
      m_cursor = 0;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Fit only the decoder through the ordinary full Layer7 CNet pass  |
   //+------------------------------------------------------------------+
   bool              AdvancePriceAdapt(double &loss, double &rho_sum, uint &rho_nonzero, uint &generator_step,
                          uint &router_step, uint &confidence_step, string &reason)
     {
      if(!m_m05 || !m_full_run || m_price_study_phase != defForecastPriceAdapt ||
         m_cursor < 0 || m_cursor >= ArraySize(m_fit) || !SetPriceAdaptPolicy(true, reason))
         return(Fail("study_forecast.price_adapt.lifecycle:" + reason, reason));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioForecast *forecast = price;
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      if(!price || !decoder || decoder.UpdateCount() == UINT_MAX)
         return(Fail("study_forecast.price_adapt.owner_or_counter", reason));
      CNeuronConvOCL *heads[3];
      uint head_steps[3];
      heads[0] = price.GetGenerator();
      heads[1] = price.GetRouter();
      heads[2] = price.GetConfidenceHead();
      for(int h = 0; h < 3; h++)
        {
         if(!heads[h] || heads[h].NativeOptimizerStep() == UINT_MAX)
            return(Fail("study_forecast.price_adapt.head_counter", reason));
         head_steps[h] = heads[h].NativeOptimizerStep();
        }
      const uint decoder_before = decoder.UpdateCount();
      //--- This index comes only from FIT; future values remain post-forward labels.
      const int decision = m_fit[m_cursor];
      if(!BuildSample(decision, forecast, rank, target, reason) || !price.PriceSupervisionPrepared() ||
         !PreparePriceJointTarget(decision, decoder, reason) ||
         !decoder.PreparePriceLoss(price, GetPointer(m_price_target), m_price_lambda, m_price_huber,
                                   m_price_rho_tolerance, true, loss) || !MathIsValidNumber(loss) || loss < 0)
         return(Fail("study_forecast.price_adapt.target_or_loss:" + reason, reason));
      CBufferFloat *rho = price.GetResponsibilities();
      if(!rho || rho.Total() != 21 || !rho.BufferRead())
         return(Fail("study_forecast.price_adapt.rho", reason));
      for(int k = 0; k < 21; k++)
        {
         const float value = (*rho)[k];
         if(!MathIsValidNumber(value) || value < 0 || value > 1)
            return(Fail("study_forecast.price_adapt.rho_numeric", reason));
         rho_sum += (double)value;
         if(value > 0)
            rho_nonzero++;
        }
      if(rho_nonzero == 0 || MathAbs(rho_sum - 1.0) > (double)m_price_rho_tolerance ||
         !m_market.backPropGradient((CBufferFloat*)NULL, (CBufferFloat*)NULL, 7, false))
         return(Fail("study_forecast.price_adapt.backward_transaction", reason));
      for(int h = 0; h < 3; h++)
         if(heads[h].NativeOptimizerStep() != head_steps[h])
            return(Fail("study_forecast.price_adapt.forecast_optimizer_changed", reason));
      if(decoder.UpdateCount() != decoder_before + 1 || decoder.GenerationPhase() != 0 ||
         price.PriceSupervisionPrepared() || !decoder.Clear() || !price.CancelTrainingFrame())
         return(Fail("study_forecast.price_adapt.update_or_release", reason));
      generator_step = head_steps[0];
      router_step = head_steps[1];
      confidence_step = head_steps[2];
      m_price_adapt_loss_sum += loss;
      m_price_adapt_updates++;
      m_updates++;
      m_cursor++;
      const bool epoch_complete = (m_cursor == m_fit_limit);
      if(epoch_complete)
         m_price_adapt_epochs_completed++;
      const bool update_cap_reached = (m_price_adapt_updates >= m_price_adapt_update_limit);
      if(update_cap_reached && m_price_adapt_epochs_completed < m_price_adapt_epoch_limit)
        {
         if(!FreezePriceAdapt(reason))
            return(false);
         m_price_phase_terminal_status = "STOPPED_COMPLETE_UPDATE";
         m_finished = true;
         return(true);
        }
      if(epoch_complete && m_price_adapt_epochs_completed < m_price_adapt_epoch_limit)
        {
         if(!RestartPriceAdaptEpoch(reason))
            return(false);
         return(true);
        }
      if(epoch_complete)
        {
         if(!FreezePriceAdapt(reason))
            return(false);
         return(CompleteM05Training(reason));
        }
      return(true);
     }
   bool              WarmupM05Row(const int decision, const bool include_target, const ENUM_OMPB_MODE mode,
                     const bool source_anchor, string &reason)
     {
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioForecast *forecast = price;
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      float values[];
      if(!price || !decoder || !ompb || !DPCCPackStudyForecastInput(m_bars, decision, values) ||
         !ompb.SetMode(mode) || !ompb.SetSourceAnchor(source_anchor))
         return(Fail("M05_RESUME.warmup_input", reason));
      const bool rollback_current = (include_target && mode == OMPB_CALIBRATE && !source_anchor);
      if(rollback_current && !ompb.BeginCurrentTransaction())
         return(Fail("M05_RESUME.warmup_current_begin", reason));
      const bool forwarded = (include_target ? BuildSample(decision, forecast, rank, target, reason) :
                              ForwardHistoricalState(decision, values, reason));
      bool restored_source = true, rolled_back = true;
      if(source_anchor)
         restored_source = ompb.SetSourceAnchor(false);
      if(rollback_current)
         rolled_back = ompb.RollbackCurrentTransaction();
      if(!forwarded || !restored_source || !rolled_back || !decoder.Clear() || !price.CancelTrainingFrame())
         return(Fail("M05_RESUME.warmup_release", reason));
      return(true);
     }
   //+-------------------------------------------------------------------+
   //| Validate factual labels after causal forward; never backpropagate |
   //+-------------------------------------------------------------------+
   bool              AdvancePriceVerify(double &loss, double &rho_sum, uint &rho_nonzero, string &reason)
     {
      if(!m_m05 || !m_verify_configured)
         return(Fail("study_forecast.verify.frozen_profile:" + reason, reason));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!price || !decoder)
         return(Fail("study_forecast.verify.graph", reason));
      if(!m_verify_started)
        {
         //--- Reset transient causal state, retaining the calibrated OMPB histories.
         for(int i = 0; i < 5; i++)
            if(!m_market.Layer(i) || !m_market.Layer(i).Clear())
               return(Fail("study_forecast.verify.trunk_clear", reason));
         if(!price.Clear() || !decoder.Clear() || !ClearTeacherState() ||
            !SetPriceAdaptPolicy(false, reason) ||
            !m_market.ParameterFingerprint(m_verify_market_fingerprint) ||
            !TeacherFingerprint(m_verify_target_fingerprint) ||
            m_verify_target_fingerprint != m_teacher_initial_fingerprint)
            return(Fail("study_forecast.verify.initial_boundary:" + reason, reason));
         ArrayInitialize(m_verify_error_sum, 0);
         m_verify_snapshots = 0;
         m_verify_covered = 0;
         m_verify_min_distinct = 21;
         m_verify_max_price_error = 0;
         m_verify_coverage = 0;
         m_verify_status = "RUNNING";
         m_cursor = 0;
         m_verify_started = true;
        }
      const int count = ArraySize(m_holdout);
      if(count == 0)
        {
         m_verify_status = "INSUFFICIENT_DATA";
         m_price_phase_terminal_status = m_verify_status;
         m_finished = true;
         return(true);
        }
      if(m_cursor < 0 || m_cursor >= count || !decoder.Clear() || !price.CancelTrainingFrame() ||
         !SetPriceAdaptPolicy(false, reason))
         return(Fail("study_forecast.verify.frame:" + reason, reason));
      //--- BuildSample forwards only past/current inputs before it admits future latent labels.
      CNeuronScenarioForecast *forecast = price;
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      const int decision = m_holdout[m_cursor];
      if(!BuildSample(decision, forecast, rank, target, reason) ||
         !PreparePriceJointTarget(decision, decoder, reason) ||
         !decoder.PreparePriceLoss(price, GetPointer(m_price_target), m_price_lambda, m_price_huber,
                                   m_price_rho_tolerance, false, loss))
         return(Fail("study_forecast.verify.label_or_loss:" + reason, reason));
      CBufferFloat *rho = price.GetResponsibilities(), *normalized = decoder.GetNormalizedScenarios();
      float weights[], paths[], actual[], native[];
      if(!rho || !normalized || rho.GetData(weights) != 21 || normalized.GetData(paths) != 21 * 48 ||
         m_price_target.GetData(actual) != 48 || m_price_native.GetData(native) != 21 * 48)
         return(Fail("study_forecast.verify.metric_buffers", reason));
      rho_sum = 0;
      rho_nonzero = 0;
      for(int k = 0; k < 21; k++)
        {
         if(!MathIsValidNumber(weights[k]) || weights[k] < 0 || weights[k] > 1)
            return(Fail("study_forecast.verify.rho_numeric", reason));
         rho_sum += (double)weights[k];
         if(weights[k] > 0)
            rho_nonzero++;
        }
      if(rho_nonzero == 0 || MathAbs(rho_sum - 1) > m_price_rho_tolerance)
         return(Fail("study_forecast.verify.rho_sum", reason));
      double snapshot_error[48];
      ArrayInitialize(snapshot_error, 0);
      for(int c = 0; c < 48; c++)
        {
         if(!MathIsValidNumber(actual[c]))
            return(Fail("study_forecast.verify.target_numeric", reason));
         for(int k = 0; k < 21; k++)
           {
            const int at = k * 48 + c;
            if(!MathIsValidNumber(paths[at]) || !MathIsValidNumber(native[at]))
               return(Fail("study_forecast.verify.scenario_numeric", reason));
            snapshot_error[c] += (double)weights[k] * MathAbs((double)paths[at] - (double)actual[c]);
           }
         if(!MathIsValidNumber(snapshot_error[c]) ||
            !MathIsValidNumber(m_verify_error_sum[c] + snapshot_error[c]))
            return(Fail("study_forecast.verify.error_numeric", reason));
        }
      bool covered = true;
      for(int h = 0; h < 12; h++)
        {
         double high = native[h * 4 + 1], low = native[h * 4 + 2];
         for(int k = 1; k < 21; k++)
           {
            high = MathMax(high, (double)native[k * 48 + h * 4 + 1]);
            low = MathMin(low, (double)native[k * 48 + h * 4 + 2]);
           }
         if(DPCCHistoricalPriceTargetValue(m_bars[decision + h], 1) > high || DPCCHistoricalPriceTargetValue(
            m_bars[decision + h], 2) < low)
            covered = false;
        }
      int representatives[21];
      uint distinct = 0;
      for(int k = 0; k < 21; k++)
        {
         bool duplicate = false;
         for(uint r = 0; r < distinct && !duplicate; r++)
           {
            bool equal = true;
            for(int c = 0; c < 48 && equal; c++)
              {
               const double a = paths[k * 48 + c], b = paths[representatives[r] * 48 + c];
               const double tolerance = m_verify_profile.atol + m_verify_profile.rtol *
                                        MathMax(1.0, MathMax(MathAbs(a), MathAbs(b)));
               if(MathAbs(a - b) > tolerance)
                  equal = false;
              }
            duplicate = equal;
           }
         if(!duplicate)
            representatives[distinct++] = k;
        }
      for(int c = 0; c < 48; c++)
         m_verify_error_sum[c] += snapshot_error[c];
      m_verify_snapshots++;
      if(covered)
         m_verify_covered++;
      m_verify_min_distinct = (uint)MathMin(m_verify_min_distinct, distinct);
      m_cursor++;
      if(m_cursor == count)
        {
         ulong market_after = 0, target_after = 0;
         if(!decoder.Clear() || !price.CancelTrainingFrame() || !SetPriceAdaptPolicy(false, reason) ||
            !m_market.ParameterFingerprint(market_after) || !TeacherFingerprint(target_after) ||
            market_after != m_verify_market_fingerprint || target_after != m_verify_target_fingerprint)
            return(Fail("study_forecast.verify.final_boundary:" + reason, reason));
         for(int c = 0; c < 48; c++)
            m_verify_max_price_error = MathMax(m_verify_max_price_error, m_verify_error_sum[c] / m_verify_snapshots);
         m_verify_coverage = (double)m_verify_covered / m_verify_snapshots;
         const bool failed = (
                                (m_verify_profile.has_max_price_error && m_verify_max_price_error >
                                   m_verify_profile.max_price_error) ||
                                (m_verify_profile.has_min_scenario_coverage && m_verify_coverage <
                                   m_verify_profile.min_scenario_coverage) ||
                                (m_verify_profile.has_min_distinct_scenarios && m_verify_min_distinct <
                                   m_verify_profile.min_distinct_scenarios));
         const bool complete = (m_verify_profile.has_max_price_error && m_verify_profile.has_min_scenario_coverage &&
                                m_verify_profile.has_min_distinct_scenarios);
         m_verify_status = (failed ? "FAIL" : (complete ? "PASS" : "BLOCKED_MISSING_LIMITS"));
         m_price_phase_terminal_status = m_verify_status;
         m_finished = true;
        }
      return(true);
     }

   bool              BeginHoldout(string &reason)
     {
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      if(!ompb || !forecast || !m_market.Clear() || !ClearTeacherState() ||
         !m_market.TrainMode(false) || !m_market.SetWeightsUpdate(false) ||
         !SetTeacherFrozenPolicy() ||
         !ompb.SetMode(OMPB_BYPASS) || !ompb.SetSourceAnchor(false) || !forecast.SetCodebookUpdate(false) ||
         forecast.CodebookUpdate() || !forecast.ResetEpochDiagnostics() ||
         !m_market.ParameterFingerprint(m_holdout_market_fingerprint) ||
         !TeacherFingerprint(m_holdout_target_fingerprint))
         return(Fail("study_forecast.holdout_policy", reason));
      if(m_encoder_only)
        {
         m_decoder_market_fingerprint = m_holdout_market_fingerprint;
         m_decoder_target_fingerprint = m_holdout_target_fingerprint;
         if(m_holdout_target_fingerprint != m_teacher_initial_fingerprint)
            return(Fail("study_encoder.holdout.teacher_changed", reason));
        }
      m_holdout_started = true;
      return(true);
     }

   bool              AdvanceHoldout(string &reason)
     {
      if(!m_holdout_started && !BeginHoldout(reason))
         return(false);
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecast *forecast = dynamic_cast<CNeuronScenarioForecast*>(m_market.Layer(6));
      CNeuronBaseOCL *rank = m_market.Layer(4), *target = m_target.Layer(-1);
      if(!ompb || !forecast || !rank || !target ||
         m_market.WeightsUpdateEnabled() || !TeacherFrozenPolicy() || forecast.CodebookUpdate())
         return(Fail("study_forecast.holdout_mutation_policy", reason));
      if(!BuildSample(m_holdout[m_holdout_cursor], forecast, rank, target, reason))
         return(false);
      if(!forecast.CommitBatchDiagnostics())
         return(Fail("study_forecast.holdout_commit", reason));
      m_holdout_cursor++;
      if(m_holdout_cursor == (int)ArraySize(m_holdout))
        {
         double mix = 0, router = 0, trajectory = 0, confidence = 0, observation = 0, entropy = 0, pairwise = 0,
            inactive = 0, recovered = 0;
         ulong market_after = 0, target_after = 0;
         if(!forecast.BuildEpochCodebookDiagnostics() ||
            !forecast.ReadEpochDiagnostics(mix, router, trajectory, confidence, m_holdout_latent, observation,
                                           m_holdout_valid, m_holdout_invalid, entropy, pairwise, inactive,
                                              recovered) ||
            m_holdout_valid != (double)ArraySize(m_holdout) || m_holdout_invalid != 0 ||
            !m_market.ParameterFingerprint(market_after) || !TeacherFingerprint(target_after) ||
            market_after != m_holdout_market_fingerprint || target_after != m_holdout_target_fingerprint)
            return(Fail("study_forecast.holdout_acceptance", reason));
         m_holdout_latent /= (m_holdout_valid * 9.0 * 12.0 * 16.0);
         if(!MathIsValidNumber(m_holdout_latent))
            return(Fail("study_forecast.holdout_loss_numeric", reason));
         m_finished = true;
        }
      return(true);
     }

public:
                     CDPCCStudyForecastCore(void)
     {
      m_updates = 0;
      m_cursor = 0;
      m_holdout_cursor = 0;
      m_fit_limit = 0;
      m_max_updates = 0;
      m_ready = false;
      m_finished = false;
      m_failed = false;
      m_epoch_started = false;
      m_full_run = false;
      m_holdout_started = false;
      m_holdout_latent = 0;
      m_holdout_valid = 0;
      m_holdout_invalid = 0;
      m_holdout_market_fingerprint = 0;
      m_holdout_target_fingerprint = 0;
      m_decoder_market_fingerprint = 0;
      m_decoder_target_fingerprint = 0;
      m_restore_only = false;
      m_encoder_only = true;
      m_teacher_initial_fingerprint = 0;
      m_z_available = false;
      m_inference_split = -1;
      m_inference_cursor = -1;
      m_live_count = 0;
      m_raw_successor = 0;
      m_live_next_open = 0;
      m_live_prepared = false;
      m_price_forward_only = false;
      m_raw_identity_bound = false;
      m_ready_encoder_restored = false;
      m_ready_encoder_live = false;
      m_ready_encoder_cursor = -1;
      m_ready_encoder_generation = 0;
      m_price_joint = false;
      m_price_lambda = 0;
      m_price_huber = 0;
      m_price_rho_tolerance = 0;
      m_price_loss_sum = 0;
      m_price_joint_ompb_fingerprint = 0;
      m_price_latent_decoder_fingerprint = 0;
      m_latent_epochs_completed = 0;
      m_price_joint_updates = 0;
      m_price_study_phase = defForecastPriceJoint;
      ZeroMemory(m_ompb_profile);
      m_ompb_profile.profile_sha256 = "";
      m_ompb_profile.raw_sha256 = "";
      m_ompb_configured = false;
      m_ompb_calibration_completed = false;
      m_ompb_stage02_quality_pass = false;
      m_ompb_evaluation_stage = 0;
      m_ompb_evaluation_cursor = 0;
      m_ompb_evaluation_posterior = 0;
      ArrayInitialize(m_ompb_evaluation_loss, 0);
      ArrayInitialize(m_ompb_evaluation_valid, 0);
      ArrayInitialize(m_ompb_evaluation_invalid, 0);
      m_ompb_reference_complete = false;
      m_ompb_epoch_started = false;
      m_ompb_source_pending = false;
      m_ompb_reference_cursor = 0;
      m_ompb_epoch = 0;
      m_ompb_reference_capacity = 0;
      m_ompb_current_capacity = 0;
      m_ompb_target_updates = 0;
      m_ompb_source_updates = 0;
      m_ompb_frozen_fingerprint = 0;
      m_ompb_initial_fingerprint = 0;
      m_ompb_decoder_updates = 0;
      m_ompb_epoch_source_updates = 0;
      ArrayInitialize(m_ompb_forecast_steps, 0);
      m_m05 = false;
      m_m05_manifest_bound = false;
      m_price_adapt_frozen_fingerprint = 0;
      m_price_adapt_updates = 0;
      m_price_adapt_decoder_updates = 0;
      m_price_adapt_loss_sum = 0;
      ZeroMemory(m_verify_profile);
      m_verify_configured = false;
      m_verify_started = false;
      ArrayInitialize(m_verify_error_sum, 0);
      m_verify_max_price_error = 0;
      m_verify_coverage = 0;
      m_verify_snapshots = 0;
      m_verify_covered = 0;
      m_verify_min_distinct = 0;
      m_verify_market_fingerprint = 0;
      m_verify_target_fingerprint = 0;
      m_verify_status = "NOT_RUN";
      m_price_joint_epoch_limit = 0;
      m_price_joint_epochs_completed = 0;
      m_price_joint_update_limit = 0;
      m_price_adapt_epoch_limit = 0;
      m_price_adapt_epochs_completed = 0;
      m_price_adapt_update_limit = 0;
      m_price_phase_terminal_status = "";
      m_price_quote_basis_resolved = false;
      m_price_h1_ohlc_targets = false;
      m_price_server = "";
      m_price_symbol = "";
      m_price_timeframe = PERIOD_CURRENT;
      m_price_quote_mode = (ENUM_SYMBOL_CHART_MODE) - 1;
     }
   //+------------------------------------------------------------------+
   //| Initialize a fresh frozen historical price graph without saving  |
   //+------------------------------------------------------------------+
   bool              InitializePriceForwardLoaded(const string server, const string symbol,
                                     const ENUM_TIMEFRAMES timeframe, const string indicator_params,
                                     string &reason, const bool training_splits,
                                     const bool require_h1_ohlc_targets,
                                     const bool verify_chart_identity)
     {
      const string expected_params = (m_ompb_configured ?
                                      DPCCStudyForecastIndicatorParams(m_ompb_profile.rsi_price,
                                         m_ompb_profile.cci_price,
                                            m_ompb_profile.macd_price) :
                                      DPCCStudyForecastIndicatorParams(RSIPrice, CCIPrice, MACDPrice));
      if(m_ready || m_failed || timeframe <= PERIOD_CURRENT || PeriodSeconds(timeframe) <= 0 || server == "" ||
         ArraySize(m_bars) == 0 || (verify_chart_identity && indicator_params != expected_params))
         return(Fail("study_forecast.price_initialize.arguments_or_indicator_profile", reason));
      const bool h1_ohlc_raw = (m_bars[0].raw_version == 3);
      if((m_bars[0].raw_version != 2 && !h1_ohlc_raw) ||
         (require_h1_ohlc_targets && !h1_ohlc_raw))
         return(Fail("TARGET_TIME_UNAVAILABLE.raw_price_target_required", reason));
      if(h1_ohlc_raw)
         PrintFormat("DPCC_M05_RAW_INPUT timeframe=%s rows=%d/%d",
                     EnumToString(timeframe), ArraySize(m_bars), DPCC_RAW_V3_MAX_ROWS);
      long chart_mode = -1;
      if(verify_chart_identity)
        {
         if(!SymbolInfoInteger(symbol, SYMBOL_CHART_MODE, chart_mode) ||
            (chart_mode != SYMBOL_CHART_MODE_BID && chart_mode != SYMBOL_CHART_MODE_LAST) ||
            m_bars[0].chart_quote_mode != (ENUM_SYMBOL_CHART_MODE)chart_mode)
            return(Fail("study_forecast.price_initialize.quote_basis", reason));
         m_price_quote_mode = (ENUM_SYMBOL_CHART_MODE)chart_mode;
        }
      else
         m_price_quote_mode = m_bars[0].chart_quote_mode;
      if(m_price_quote_mode != SYMBOL_CHART_MODE_BID && m_price_quote_mode != SYMBOL_CHART_MODE_LAST)
         return(Fail("study_forecast.price_initialize.quote_basis", reason));
      if(training_splits)
        {
         if(!DPCCBuildStudyForecastSplits(m_bars, m_fit, m_holdout, reason))
            return(Fail("study_forecast.price_initialize.quote_basis_or_split:" + reason, reason));
        }
      else if(ArrayResize(m_fit, 0) < 0 || ArrayResize(m_holdout, 0) < 0)
         return(Fail("study_forecast.price_initialize.split_clear", reason));
      m_price_h1_ohlc_targets = h1_ohlc_raw;
      m_price_quote_basis_resolved = true;
      if(training_splits &&
         !DPCCFilterStudyForecastPriceTargets(m_bars, m_price_quote_mode, m_price_h1_ohlc_targets,
                                              m_fit, m_holdout, reason, timeframe))
         return(Fail("study_forecast.price_initialize.price_split:" + reason, reason));
      if(training_splits && (ArraySize(m_fit) == 0 || ArraySize(m_holdout) == 0))
         return(Fail("TARGET_TIME_UNAVAILABLE", reason));
      m_price_server = server;
      m_price_symbol = symbol;
      m_price_timeframe = timeframe;
      m_raw_identity_bound = verify_chart_identity;
      m_price_forward_only = true;
      m_encoder_only = false;
      //--- Freeze all neural parameters; native output remains caller-owned.
      if(!CreateGraphs(reason, training_splits))
         return(Fail("study_forecast.price_initialize.graph_or_buffers:" + reason, reason));
      if(training_splits && (!m_market.Clear() || !ClearTeacherState() ||
                             !m_price_native.BufferInit(21 * 12 * 4, 0) || !m_price_native.BufferCreate(
                                m_market.GetOpenCL()) ||
                             !m_market.ParameterFingerprint(m_decoder_market_fingerprint) ||
                             !TeacherFingerprint(m_decoder_target_fingerprint)))
         return(Fail("study_forecast.price_initialize.graph_or_buffers:" + reason, reason));
      m_ready = true;
      if(training_splits && !FrozenProducer(reason))
         return(false);
      reason = "";
      return(true);
     }

   bool              InitializePriceForwardFromBars(const SDPCCStudyForecastBar &bars[], const string server,
                                       const ENUM_TIMEFRAMES timeframe, const string indicator_params,
                                       const long successor_open, string &reason,
                                       const bool require_h1_ohlc_targets = false)
     {
      if(m_ready || m_failed || ArraySize(bars) == 0 || ArrayCopy(m_bars, bars) != ArraySize(bars))
         return(Fail("study_forecast.price_initialize.preloaded_bars", reason));
      m_raw_sha = "";
      m_raw_successor = successor_open;
      return(InitializePriceForwardLoaded(server, _Symbol, timeframe, indicator_params, reason, false,
                                          require_h1_ohlc_targets, false));
     }

   bool              InitializePriceForward(const string raw_path, const string raw_sha,
                               const ENUM_TIMEFRAMES timeframe, string &reason,
                               const bool common_files = false, const bool training_splits = true,
                               const bool require_h1_ohlc_targets = false,
                               const bool verify_raw_sha = true, const bool verify_source_identity = true)
     {
      string server = "", symbol = "", period = "", indicator_params = "", actual_sha = "", canonical_raw = "";
      const string expected_params = (m_ompb_configured ?
                                      DPCCStudyForecastIndicatorParams(m_ompb_profile.rsi_price,
                                         m_ompb_profile.cci_price,
                                            m_ompb_profile.macd_price) :
                                      DPCCStudyForecastIndicatorParams(RSIPrice, CCIPrice, MACDPrice));
      if(m_ready || m_failed || timeframe <= PERIOD_CURRENT || PeriodSeconds(timeframe) <= 0 ||
         !DPCCCheckpointCanonicalPath(raw_path, canonical_raw, reason) ||
         !DPCCReadStudyForecastRawEx(raw_path, raw_sha, m_bars, actual_sha, m_raw_successor, reason,
                                     server, symbol, period, indicator_params, common_files,
                                     (verify_source_identity ? expected_params : ""),
                                        verify_raw_sha,
                                     verify_raw_sha, verify_source_identity) || server == "" ||
         (verify_source_identity && (symbol != _Symbol || period != EnumToString(timeframe))))
         return(Fail("study_forecast.price_initialize.identity_or_split:" + reason, reason));
      m_raw_sha = actual_sha;
      return(InitializePriceForwardLoaded(server, (verify_source_identity ? symbol : _Symbol), timeframe,
                                          indicator_params, reason, training_splits, require_h1_ohlc_targets,
                                             verify_source_identity));
     }

   bool              RestoreReadyEncoderGraph(const string market_path, const bool common_files,
                                 const SDPCCAPNativeLoadContract &expected, string &reason,
                                 const bool allow_pending_training)
     {
      CDPCCAPRoleReader reader;
      if(!reader.Open(market_path, common_files, 1, expected.source_abi_sha256,
                      expected.max_native_bytes, 64, reason))
         return(Fail("ready_encoder.restore.open:" + reason, reason));
      const bool loaded = reader.LoadReadyMarketInto(expected, m_market, m_market.GetOpenCL(), reason,
                          allow_pending_training);
      reader.Close();
      if(!loaded || !m_price_native.BufferInit(21 * 12 * 4, 0) ||
         !m_price_native.BufferCreate(m_market.GetOpenCL()))
         return(Fail("ready_encoder.restore.native:" + reason, reason));
      if(!m_market.SetWeightsUpdate(false))
         return(Fail("ready_encoder.restore.freeze", reason));
      for(int i = 0; i < 8; i++)
        {
         CNeuronBaseOCL *layer = m_market.Layer(i);
         if(!layer)
            return(Fail("ready_encoder.restore.layer", reason));
         layer.TrainMode(false);
        }
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      if(!ompb || !forecast || !forecast.SetCodebookUpdate(false) || !forecast.CancelTrainingFrame() ||
         !forecast.SetGradientNormalization(true) || !forecast.SetPricePhase(defForecastPriceVerify) ||
         !ompb.SetSourceAnchor(false) || !ompb.SetMode(OMPB_INFERENCE))
         return(Fail("ready_encoder.restore.policy", reason));
      //--- Rebuild causal runtime by warmup; OMPB Clear retains learned parameters and raw Reference.
      for(int i = 0; i < 6; i++)
         if(!m_market.Layer(i).Clear())
            return(Fail("ready_encoder.restore.trunk_runtime", reason));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!decoder || !forecast.Clear() || !decoder.Clear())
         return(Fail("ready_encoder.restore.forecast_runtime", reason));
      m_restore_only = true;
      m_ready_encoder_restored = true;
      m_ready_encoder_live = false;
      m_ready_encoder_cursor = -1;
      m_ready_encoder_generation = 0;
      m_live_count = 0;
      m_live_next_open = m_raw_successor;
      m_live_prepared = false;
      ArrayResize(m_live_bars, 0);
      return(FrozenProducer(reason));
     }
   //+------------------------------------------------------------------+
   //| Restore an accepted Market for frozen encoder-only decisions     |
   //+------------------------------------------------------------------+
   bool              RestoreReadyEncoder(const string market_path, const bool common_files,
                            const string raw_path, const string raw_sha,
                            const ENUM_TIMEFRAMES timeframe,
                            const SDPCCAPNativeLoadContract &expected, string &reason,
                            const bool allow_pending_training = false,
                            const bool allow_unbound_history = false)
     {
      reason = "";
      string archive_sha = expected.source_archive_sha256;
      StringToLower(archive_sha);
      if(m_ready || m_failed || m_ready_encoder_restored || timeframe <= PERIOD_CURRENT ||
         PeriodSeconds(timeframe) <= 0 || (!allow_unbound_history && timeframe != PERIOD_H1) ||
         expected.role != 1 || expected.section_id != 100 || expected.encoding != 2 ||
         expected.max_native_bytes == 0 || expected.max_native_bytes > (ulong)LONG_MAX ||
         !DPCCResolverLowerSha256(expected.source_abi_sha256) ||
         !DPCCResolverLowerSha256(expected.profile_sha256) ||
         !DPCCResolverLowerSha256(expected.data_sha256) || !DPCCResolverLowerSha256(archive_sha) ||
         (!allow_unbound_history && !DPCCResolverLowerSha256(raw_sha)) || expected.market_dependency_sha256 != "" ||
         expected.task_id == "" || expected.stage == "")
         return(Fail("ready_encoder.restore.contract", reason));
      if(!InitializePriceForward(raw_path, raw_sha, timeframe, reason, common_files, false, false,
                                 !allow_unbound_history, !allow_unbound_history))
         return(false);
      return(RestoreReadyEncoderGraph(market_path, common_files, expected, reason, allow_pending_training));
     }

   bool              RestoreReadyEncoderFromBars(const string market_path, const bool common_files,
                                    const SDPCCStudyForecastBar &bars[], const string source_server,
                                    const string indicator_params, const long successor_open,
                                    const ENUM_TIMEFRAMES timeframe,
                                    const SDPCCAPNativeLoadContract &expected, string &reason,
                                    const bool allow_pending_training = false)
     {
      reason = "";
      string archive_sha = expected.source_archive_sha256;
      StringToLower(archive_sha);
      if(m_ready || m_failed || m_ready_encoder_restored || timeframe <= PERIOD_CURRENT ||
         PeriodSeconds(timeframe) <= 0 || expected.role != 1 || expected.section_id != 100 ||
         expected.encoding != 2 || expected.max_native_bytes == 0 ||
         expected.max_native_bytes > (ulong)LONG_MAX ||
         !DPCCResolverLowerSha256(expected.source_abi_sha256) ||
         !DPCCResolverLowerSha256(expected.profile_sha256) ||
         !DPCCResolverLowerSha256(expected.data_sha256) || !DPCCResolverLowerSha256(archive_sha) ||
         expected.market_dependency_sha256 != "" || expected.task_id == "" || expected.stage == "")
         return(Fail("ready_encoder.restore.contract", reason));
      if(!InitializePriceForwardFromBars(bars, source_server, timeframe, indicator_params,
                                         successor_open, reason))
         return(false);
      return(RestoreReadyEncoderGraph(market_path, common_files, expected, reason, allow_pending_training));
     }
   //+------------------------------------------------------------------+
   //| Borrow the owning context without exposing the complete CNet     |
   //+------------------------------------------------------------------+
   COpenCLMy         *ReadyEncoderContext(void)
     {
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only)
         return(NULL);
      return(m_market.GetOpenCL());
     }
   //+------------------------------------------------------------------+
   //| Borrow the accepted Market network for Action6 policy binding    |
   //+------------------------------------------------------------------+
   CNet              *ReadyMarketNetwork(void)
     {
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only)
         return(NULL);
      return(GetPointer(m_market));
     }
   //+------------------------------------------------------------------+
   //| Borrow native Decoder prices only during the current generation  |
   //+------------------------------------------------------------------+
   CBufferFloat      *ReadyMarketNativeOHLC(void)
     {
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only ||
         !m_ready_encoder_live || m_ready_encoder_generation == 0 ||
         m_price_native.GetOpenCL() != m_market.GetOpenCL() || m_price_native.Total() != 21 * 12 * 4)
         return(NULL);
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      if(!forecast || forecast.Generation() != m_ready_encoder_generation)
         return(NULL);
      return(GetPointer(m_price_native));
     }
   //+------------------------------------------------------------------+
   //| Borrow only the live encoder producer for an Action6 transaction |
   //+------------------------------------------------------------------+
   CNeuronScenarioForecastPriceOCL *ReadyEncoderForecast(void)
     {
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only || !m_ready_encoder_live)
         return(NULL);
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      if(!forecast || forecast.Generation() != m_ready_encoder_generation)
         return(NULL);
      return(forecast);
     }
   //+------------------------------------------------------------------+
   //| Copy one chronological encoder generation to the caller's GPU    |
   //+------------------------------------------------------------------+
   bool              InferReadyEncoderZ(const long server_open, CBufferFloat *destination,
                           ulong &generation, string &reason)
     {
      generation = 0;
      reason = "";
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only || m_ready_encoder_live)
        {
         reason = "ready_encoder.infer.lifecycle_or_pending_generation";
         return(false);
        }
      int decision = -1;
      if(!DPCCStudyForecastUniqueServerOpen(m_bars, server_open, decision, reason) ||
         decision < DPCC_ENCODER_INPUT_WINDOW ||
         (m_ready_encoder_cursor >= 0 && decision != m_ready_encoder_cursor + 1))
        {
         reason = "ready_encoder.infer.chronology:" + reason;
         return(false);
        }
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      COpenCLMy *context = m_market.GetOpenCL();
      const ulong count = forecast ? (ulong)forecast.Scenarios() * forecast.Variables() *
                          forecast.Horizon() * forecast.Dimension() : 0;
      if(!forecast || CheckPointer(destination) == POINTER_INVALID ||
         !NNQValid(context, destination, count) || destination.Total() != (int)count ||
         context.GetBufferSize(destination.GetIndex()) != count * sizeof(float))
        {
         reason = "ready_encoder.infer.destination";
         return(false);
        }
      for(int i = 0; i < 7; i++)
         if(!m_market.Layer(i) || m_market.Layer(i).OwnsBufferOrDeviceSlot(destination))
           {
            reason = "ready_encoder.infer.destination_alias";
            return(false);
           }
      CBufferFloat *owned[] = {GetPointer(m_state), GetPointer(m_future), GetPointer(m_zero),
                               GetPointer(m_negative), GetPointer(m_delta), GetPointer(m_price_native),
                               GetPointer(m_price_target)
                              };
      for(int i = 0; i < ArraySize(owned); i++)
         if(destination == owned[i] ||
            (owned[i].GetIndex() >= 0 && destination.GetIndex() == owned[i].GetIndex()))
           {
            reason = "ready_encoder.infer.destination_owner";
            return(false);
           }
      if(!FrozenProducer(reason))
         return(false);
      //--- Caller-selected warmup bars use this same chronological prefix and release path.
      float values[];
      if(!DPCCPackStudyForecastInput(m_bars, decision, values) || ArraySize(values) != 45)
         return(Fail("ready_encoder.infer.input", reason));
      for(int i = 0; i < 45; i++)
         if(!MathIsValidNumber(values[i]) || !m_state.Update(i, values[i]))
            return(Fail("ready_encoder.infer.input_values", reason));
      if(!m_state.BufferWrite())
         return(Fail("ready_encoder.infer.input_upload", reason));
      if(!m_market.ForwardEncoderPrefix(GetPointer(m_state), reason))
         return(Fail("ready_encoder.infer.prefix:" + reason, reason));
      if(!m_gradient_ops.CopyFinite(forecast.GetZ(), destination, (uint)count))
         return(Fail("ready_encoder.infer.z_copy", reason));
      if(forecast.Generation() == 0)
         return(Fail("ready_encoder.infer.generation", reason));
      m_ready_encoder_cursor = decision;
      m_ready_encoder_generation = forecast.Generation();
      m_ready_encoder_live = true;
      generation = m_ready_encoder_generation;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Run the accepted Market and Decoder for one historical decision  |
   //+------------------------------------------------------------------+
   bool              InferReadyMarketScenario(const long server_open, CBufferFloat *z_destination,
                                 ulong &generation, string &reason)
     {
      generation = 0;
      reason = "";
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only || m_ready_encoder_live)
        {
         reason = "ready_market.infer.lifecycle_or_pending_generation";
         return(false);
        }
      int decision = -1;
      if(!DPCCStudyForecastUniqueServerOpen(m_bars, server_open, decision, reason) ||
         decision < DPCC_ENCODER_INPUT_WINDOW ||
         (m_ready_encoder_cursor >= 0 && decision != m_ready_encoder_cursor + 1))
        {
         reason = "ready_market.infer.chronology:" + reason;
         return(false);
        }
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      COpenCLMy *context = m_market.GetOpenCL();
      const ulong z_count = forecast ? (ulong)forecast.Scenarios() * forecast.Variables() *
                            forecast.Horizon() * forecast.Dimension() : 0;
      const ulong price_count = 21 * 12 * 4;
      if(!forecast || !decoder || CheckPointer(context) == POINTER_INVALID ||
         CheckPointer(z_destination) == POINTER_INVALID || !NNQValid(context, z_destination, z_count) ||
         z_destination.Total() != (int)z_count || context.GetBufferSize(z_destination.GetIndex()) != z_count * sizeof(
            float) ||
         z_count != 21 * 9 * 12 * 16 || !NNQValid(context, GetPointer(m_price_native), price_count) ||
         m_price_native.Total() != (int)price_count || context.GetBufferSize(m_price_native.GetIndex()) !=
            price_count * sizeof(float))
        {
         reason = "ready_market.infer.output_contract";
         return(false);
        }
      for(int i = 0; i < 8; i++)
         if(!m_market.Layer(i) || m_market.Layer(i).OwnsBufferOrDeviceSlot(z_destination) ||
            m_market.Layer(i).OwnsBufferOrDeviceSlot(GetPointer(m_price_native)))
           {
            reason = "ready_market.infer.output_alias";
            return(false);
           }
      if(z_destination == GetPointer(m_price_native) || z_destination.GetIndex() == m_price_native.GetIndex())
        {
         reason = "ready_market.infer.output_alias";
         return(false);
        }
      CBufferFloat *owned[] = {GetPointer(m_state), GetPointer(m_future), GetPointer(m_future_latent),
                               GetPointer(m_zero), GetPointer(m_negative), GetPointer(m_delta),
                               GetPointer(m_price_target)
                              };
      for(int i = 0; i < ArraySize(owned); i++)
         if(z_destination == owned[i] || z_destination.GetIndex() == owned[i].GetIndex())
           {
            reason = "ready_market.infer.output_owner";
            return(false);
           }
      SDPCCHistoricalPriceSnapshot snapshot;
      float values[];
      if(!BuildHistoricalPriceSnapshot(decision, snapshot, reason) ||
         !DPCCPackStudyForecastInput(m_bars, decision, values) || ArraySize(values) != 45)
         return(Fail("ready_market.infer.input_or_snapshot:" + reason, reason));
      //--- Reuse the same causal anchor and native Decoder contract as M05 training.
      if(!decoder.Clear() || !forecast.CancelTrainingFrame() ||
         !forecast.SetPricePhase(defForecastPriceVerify) || !decoder.SetPricePhase(defForecastPriceVerify) ||
         !decoder.BindPriceAnchor(snapshot.anchor, snapshot.scale, snapshot.decision_id))
         return(Fail("ready_market.infer.release_or_anchor:" + reason, reason));
      if(m_ready_encoder_cursor < 0)
        {
         //--- Short source prefixes use every available prior bar.
         //--- A prefix shorter than 508 bars is warmed with the data available.
         const int first_decision = (int)MathMax(DPCC_ENCODER_INPUT_WINDOW, decision - 1 - DPCC_ENCODER_WARMUP_HISTORY +
            DPCC_ENCODER_INPUT_WINDOW);
         for(int warm_decision = first_decision; warm_decision < decision; warm_decision++)
           {
            float warm_values[];
            if(!DPCCPackStudyForecastInput(m_bars, warm_decision, warm_values) || ArraySize(warm_values) != 45)
               return(Fail("ready_market.infer.warmup_input", reason));
            for(int i = 0; i < 45; i++)
               if(!MathIsValidNumber(warm_values[i]) || !m_state.Update(i, warm_values[i]))
                  return(Fail("ready_market.infer.warmup_values", reason));
            if(!m_state.BufferWrite() || !m_market.ForwardEncoderPrefix(GetPointer(m_state), reason) ||
               !forecast.CancelTrainingFrame())
               return(Fail("ready_market.infer.warmup_forward:" + reason, reason));
           }
         m_ready_encoder_cursor = decision - 1;
        }
      for(int i = 0; i < 45; i++)
         if(!MathIsValidNumber(values[i]) || !m_state.Update(i, values[i]))
            return(Fail("ready_market.infer.input_values", reason));
      if(!m_state.BufferWrite() || !m_market.feedForward(GetPointer(m_state), 1, false, (CBufferFloat*)NULL) ||
         !decoder.BuildNativeScenarios(GetPointer(m_price_native), 12, snapshot.tick_size) ||
         !m_gradient_ops.CopyFinite(forecast.GetZ(), z_destination, (uint)z_count) ||
         forecast.Generation() == 0)
         return(Fail("ready_market.infer.forward_or_publish:" + reason, reason));
      m_ready_encoder_cursor = decision;
      m_ready_encoder_generation = forecast.Generation();
      m_ready_encoder_live = true;
      generation = m_ready_encoder_generation;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Rebase the restored Market before live evaluation.               |
   //+------------------------------------------------------------------+
   bool              RebaseReadyMarketLiveHistory(const SDPCCClosedHistoryRow &history[],
                                     const long first_live_open, string &reason)
     {
      reason = "";
      const int count = ArraySize(history);
      //--- Validate the restored model and its requested live boundary.
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only ||
         !m_price_forward_only || m_encoder_only || m_ready_encoder_live ||
         m_ready_encoder_generation != 0 || m_live_count != 0 ||
         m_live_next_open != m_raw_successor || count != DPCC_ENCODER_WARMUP_HISTORY ||
         m_raw_successor <= 0 || first_live_open <= 0)
        {
         reason = "ready_market.live.rebase.lifecycle_or_window";
         return(false);
        }
      SDPCCStudyForecastBar candidate[];
      //--- Copy the validated chronological warm-up bars.
      if(ArrayResize(candidate, count) != count)
        {
         reason = "ready_market.live.rebase.capacity";
         return(false);
        }
      for(int i = 0; i < count; i++)
        {
         const SDPCCClosedHistoryRow row = history[i];
         float features[];
         if(row.ordinal != 0 || row.bar.server_open <= 0 ||
            row.successor_open_server <= row.bar.server_open || row.spread < 0 ||
            row.bar.spread != row.spread ||
            (i > 0 && (history[i - 1].bar.server_open >= row.bar.server_open ||
                       history[i - 1].successor_open_server != row.bar.server_open)) ||
            row.bar.server_open >= first_live_open || !DPCCStudyForecastFeature(row.bar, features))
           {
            reason = StringFormat("ready_market.live.rebase.history.%d", i);
            return(false);
           }
         candidate[i] = row.bar;
        }
      //--- Publish the rebased history at the first live boundary.
      if(history[count - 1].successor_open_server != first_live_open ||
         ArrayResize(m_bars, count) != count || ArrayCopy(m_bars, candidate) != count)
        {
         reason = "ready_market.live.rebase.publish";
         return(false);
        }
      ArrayResize(m_live_bars, 0);
      m_live_count = 0;
      m_live_next_open = first_live_open;
      m_live_prepared = false;
      m_ready_encoder_cursor = -1;
      m_ready_encoder_generation = 0;
      m_ready_encoder_live = false;
      return(true);
     }

   bool              InferReadyMarketLive(const SDPCCClosedHistoryRow &captured,
                             const double successor_first_quote,
                             const long successor_quote_time_msc,
                             const double symbol_tick_size,
                             CBufferFloat *z_destination, ulong &generation, string &reason)
     {
      generation = 0;
      reason = "";
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only ||
         !m_price_forward_only || m_encoder_only || m_ready_encoder_live ||
         !m_price_quote_basis_resolved || m_price_timeframe != PERIOD_H1 ||
         m_price_symbol == "" || m_price_symbol != _Symbol || m_live_next_open <= 0)
        {
         reason = "ready_market.live.lifecycle_or_binding";
         return(false);
        }
      //--- The source profile and current terminal symbol must describe the same quote basis/grid.
      long chart_mode = -1;
      double current_tick_size = 0;
      if((m_price_quote_mode != SYMBOL_CHART_MODE_BID && m_price_quote_mode != SYMBOL_CHART_MODE_LAST) ||
         !SymbolInfoInteger(m_price_symbol, SYMBOL_CHART_MODE, chart_mode) ||
         chart_mode != (long)m_price_quote_mode ||
         !SymbolInfoDouble(m_price_symbol, SYMBOL_TRADE_TICK_SIZE, current_tick_size) ||
         !MathIsValidNumber(current_tick_size) || current_tick_size <= 0 ||
         !MathIsValidNumber(symbol_tick_size) || symbol_tick_size <= 0 ||
         MathAbs(current_tick_size - symbol_tick_size) > MathMax(1e-12, current_tick_size * 1e-9))
        {
         reason = "ready_market.live.quote_basis_or_tick_size";
         return(false);
        }
      const long successor_open = (long)iTime(m_price_symbol, PERIOD_H1, 0);
      const long period_seconds = (long)PeriodSeconds(PERIOD_H1);
      if(successor_open <= 0 || successor_open != captured.successor_open_server ||
         successor_open > LONG_MAX / 1000 - period_seconds || successor_quote_time_msc <= 0 ||
         successor_quote_time_msc < successor_open * 1000 ||
         successor_quote_time_msc >= (successor_open + period_seconds) * 1000 ||
         !MathIsValidNumber(successor_first_quote) || successor_first_quote <= 0)
        {
         reason = "ready_market.live.successor_quote_link";
         return(false);
        }
      const double quote_ticks = successor_first_quote / symbol_tick_size;
      if(!MathIsValidNumber(quote_ticks) || quote_ticks < 0 || quote_ticks > (double)LONG_MAX ||
         MathAbs(quote_ticks - MathRound(quote_ticks)) > MathMax(1e-7, MathAbs(quote_ticks) * 1e-12))
        {
         reason = "ready_market.live.quote_price_grid";
         return(false);
        }
      if(m_live_count == 0 && captured.bar.server_open != m_live_next_open)
        {
         int source_decision = -1;
         if(!DPCCStudyForecastUniqueServerOpen(m_bars, captured.bar.server_open, source_decision, reason))
           {
            reason = "ready_market.live.replay_start:" + reason;
            return(false);
           }
         if(source_decision < DPCC_ENCODER_INPUT_WINDOW)
           {
            reason = "ready_market.live.replay_prefix_short";
            return(false);
           }
         const int source_count = ArraySize(m_bars);
         const long source_successor = (source_decision + 1 < source_count ?
                                        m_bars[source_decision + 1].server_open : m_raw_successor);
         if(source_successor != captured.successor_open_server)
           {
            reason = "ready_market.live.replay_successor";
            return(false);
           }
         if(ArrayResize(m_bars, source_decision) != source_decision)
           {
            reason = "ready_market.live.replay_prefix_capacity";
            return(false);
           }
         m_live_next_open = captured.bar.server_open;
        }
      const long ordinal = (long)ArraySize(m_bars) + m_live_count;
      SDPCCClosedHistoryRow row;
      SDPCCStudyForecastBar prior[];
      float state_values[], price_norm[];
      if(ordinal >= INT_MAX || !DPCCRebaseStudyLiveRow(captured, m_live_next_open, ordinal, row, reason) ||
         row.successor_open_server != successor_open ||
         !MathIsValidNumber((double)row.bar.indicators[2]) || row.bar.indicators[2] == EMPTY_VALUE ||
         row.bar.indicators[2] <= 0 || !LivePredecessors(m_live_count, prior, reason) ||
         !DPCCPrepareStudyLiveInput(prior, row, m_live_next_open, ordinal, state_values, price_norm, reason) ||
         ArraySize(state_values) != 45 || ArraySize(price_norm) != 16)
        {
         if(reason == "")
            reason = "ready_market.live.row_or_atr";
         return(false);
        }
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      COpenCLMy *context = m_market.GetOpenCL();
      const ulong z_count = forecast ? (ulong)forecast.Scenarios() * forecast.Variables() *
                            forecast.Horizon() * forecast.Dimension() : 0;
      const ulong price_count = 21 * 12 * 4;
      if(!forecast || !decoder || CheckPointer(context) == POINTER_INVALID ||
         CheckPointer(z_destination) == POINTER_INVALID || !NNQValid(context, z_destination, z_count) ||
         z_destination.Total() != (int)z_count || context.GetBufferSize(z_destination.GetIndex()) != z_count * sizeof(
            float) ||
         z_count != 21 * 9 * 12 * 16 || !NNQValid(context, GetPointer(m_price_native), price_count) ||
         m_price_native.Total() != (int)price_count || context.GetBufferSize(m_price_native.GetIndex()) !=
            price_count * sizeof(float))
        {
         reason = "ready_market.live.output_contract";
         return(false);
        }
      for(int i = 0; i < 8; i++)
         if(!m_market.Layer(i) || m_market.Layer(i).OwnsBufferOrDeviceSlot(z_destination) ||
            m_market.Layer(i).OwnsBufferOrDeviceSlot(GetPointer(m_price_native)))
           {
            reason = "ready_market.live.output_alias";
            return(false);
           }
      if(z_destination == GetPointer(m_price_native) || z_destination.GetIndex() == m_price_native.GetIndex())
        {
         reason = "ready_market.live.output_alias";
         return(false);
        }
      CBufferFloat *owned[] = {GetPointer(m_state), GetPointer(m_future), GetPointer(m_future_latent),
                               GetPointer(m_zero), GetPointer(m_negative), GetPointer(m_delta),
                               GetPointer(m_price_target)
                              };
      for(int i = 0; i < ArraySize(owned); i++)
         if(z_destination == owned[i] || z_destination.GetIndex() == owned[i].GetIndex())
           {
            reason = "ready_market.live.output_owner";
            return(false);
           }
      if(ArrayResize(m_live_bars, m_live_count + 1) != m_live_count + 1)
        {
         reason = "ready_market.live.row_capacity";
         return(false);
        }
      //--- Rebuild bounded recurrent state from the pinned source before its first live successor.
      if(m_live_count == 0)
        {
         const int history_count = ArraySize(m_bars);
         if(history_count < DPCC_ENCODER_INPUT_WINDOW)
           {
            reason = "ready_market.live.pinned_warmup_history";
            return(false);
           }
         for(int i = 0; i < 8; i++)
            if(!m_market.Layer(i) || !m_market.Layer(i).Clear())
               return(Fail("ready_market.live.warmup_clear", reason));
         m_ready_encoder_cursor = -1;
         m_ready_encoder_generation = 0;
         const int first_decision = (int)MathMax(DPCC_ENCODER_INPUT_WINDOW,
                                                 history_count - DPCC_ENCODER_WARMUP_HISTORY +
                                                    DPCC_ENCODER_INPUT_WINDOW);
         for(int decision = first_decision; decision <= history_count; decision++)
           {
            float warm_values[];
            if(!DPCCPackStudyForecastInput(m_bars, decision, warm_values) || ArraySize(warm_values) != 45)
               return(Fail("ready_market.live.warmup_input", reason));
            for(int i = 0; i < 45; i++)
               if(!MathIsValidNumber(warm_values[i]) || !m_state.Update(i, warm_values[i]))
                  return(Fail("ready_market.live.warmup_values", reason));
            if(!m_state.BufferWrite() || !m_market.ForwardEncoderPrefix(GetPointer(m_state), reason) ||
               !forecast.CancelTrainingFrame())
               return(Fail("ready_market.live.warmup_forward:" + reason, reason));
           }
         m_ready_encoder_cursor = history_count;
        }
      //--- Only the successor's first quote and the just-closed bar ATR anchor the native Decoder.
      const ulong decision_id = (ulong)successor_quote_time_msc;
      if(!decoder.Clear() || !forecast.CancelTrainingFrame() ||
         !forecast.SetPricePhase(defForecastPriceVerify) || !decoder.SetPricePhase(defForecastPriceVerify) ||
         !decoder.BindPriceAnchor(successor_first_quote, (double)row.bar.indicators[2], decision_id))
         return(Fail("ready_market.live.release_or_anchor", reason));
      for(int i = 0; i < 45; i++)
         if(!MathIsValidNumber(state_values[i]) || !m_state.Update(i, state_values[i]))
            return(Fail("ready_market.live.input_values", reason));
      if(!m_state.BufferWrite() || !m_market.feedForward(GetPointer(m_state), 1, false, (CBufferFloat*)NULL) ||
         !decoder.BuildNativeScenarios(GetPointer(m_price_native), 12, symbol_tick_size) ||
         !m_gradient_ops.CopyFinite(forecast.GetZ(), z_destination, (uint)z_count) ||
         forecast.Generation() == 0)
         return(Fail("ready_market.live.forward_or_publish:" + reason, reason));
      m_live_bars[m_live_count] = row.bar;
      m_live_count++;
      m_live_next_open = row.successor_open_server;
      m_ready_encoder_generation = forecast.Generation();
      m_ready_encoder_live = true;
      generation = m_ready_encoder_generation;
      reason = "";
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Release a consumed encoder frame without clearing its history    |
   //+------------------------------------------------------------------+
   bool              ReleaseReadyEncoderZ(const ulong generation, string &reason)
     {
      reason = "";
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_ready_encoder_live ||
         generation == 0 || generation != m_ready_encoder_generation)
        {
         reason = "ready_encoder.release.identity_or_boundary";
         return(false);
        }
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      if(!forecast || forecast.Generation() != generation)
         return(Fail("ready_encoder.release.generation_or_policy:" + reason, reason));
      if(!forecast.CancelTrainingFrame())
         return(Fail("ready_encoder.release.forecast", reason));
      m_ready_encoder_live = false;
      m_ready_encoder_generation = 0;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Start a new causal history pass without reinitializing the model |
   //+------------------------------------------------------------------+
   bool              ResetReadyEncoderHistoryPass(string &reason)
     {
      reason = "";
      if(!m_ready_encoder_restored || !m_ready || m_failed || !m_restore_only ||
         m_ready_encoder_live || m_ready_encoder_generation != 0)
        {
         reason = "ready_encoder.history_pass.lifecycle_or_live_generation";
         return(false);
        }
      CNeuronScenarioForecastPriceOCL *forecast =
         dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      if(CheckPointer(forecast) == POINTER_INVALID || CheckPointer(ompb) == POINTER_INVALID ||
         forecast.GetOpenCL() != m_market.GetOpenCL() || ompb.GetOpenCL() != m_market.GetOpenCL() ||
         forecast.TrainMode() || forecast.CodebookUpdate() || ompb.Mode() != OMPB_INFERENCE ||
         ompb.SourceAnchor())
        {
         reason = "ready_encoder.history_pass.market_contract";
         return(false);
        }
      //--- CNet::Clear clears layer execution buffers. RankTCM clears its
      //--- recurrent memory; OMPB::Clear explicitly retains durable Reference.
      if(!forecast.CancelTrainingFrame() || !m_market.Clear())
        {
         reason = "ready_encoder.history_pass.market_clear";
         return(false);
        }
      m_ready_encoder_cursor = -1;
      m_ready_encoder_generation = 0;
      m_ready_encoder_live = false;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Freeze the selected loss profile before any joint-fit update     |
   //+------------------------------------------------------------------+
   bool              InitializePriceJoint(const string raw_path, const string raw_sha, const uint max_updates,
      const bool require_h1_ohlc_targets,
                             const float lambda_price, const float huber_delta, const float rho_tolerance,
                             string &reason, const bool common_files = false,
                             const ENUM_TIMEFRAMES timeframe = PERIOD_H1)
     {
      if(!MathIsValidNumber(lambda_price) || lambda_price <= 0 ||
         !MathIsValidNumber(huber_delta) || huber_delta <= 0 ||
         !MathIsValidNumber(rho_tolerance) || rho_tolerance <= 0 || rho_tolerance >= 1)
         return(Fail("study_forecast.price_joint.loss_profile", reason));
      if(!InitializePriceForward(raw_path, raw_sha, timeframe, reason, common_files, true, require_h1_ohlc_targets))
         return(false);
      if(!m_price_quote_basis_resolved || max_updates > (uint)ArraySize(m_fit))
         return(Fail("study_forecast.price_joint.quote_basis_or_fit_limit", reason));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      if(!ompb || !m_price_target.BufferInit(12 * 4, 0) ||
         !m_price_target.BufferCreate(m_market.GetOpenCL()) ||
         !ompb.AppendParameterFingerprint(m_price_joint_ompb_fingerprint))
         return(Fail("study_forecast.price_joint.target_buffer_or_ompb_boundary", reason));
      m_price_lambda = lambda_price;
      m_price_huber = huber_delta;
      m_price_rho_tolerance = rho_tolerance;
      m_teacher_initial_fingerprint = m_decoder_target_fingerprint;
      m_max_updates = max_updates;
      m_full_run = (max_updates == 0);
      m_fit_limit = (m_full_run ? ArraySize(m_fit) : (int)max_updates);
      m_price_forward_only = false;
      m_price_joint = true;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Bind resolved OMPB settings without choosing any profile values  |
   //+------------------------------------------------------------------+
   bool              ConfigureM05OMPB(const SDPCCM05OMPBProfile &profile, string &reason)
     {
      reason = "";
      if(m_ready || m_failed || m_ompb_configured ||
         profile.reference_start <= 0 || profile.reference_end <= profile.reference_start ||
         profile.reference_end > profile.calibration_start ||
         profile.calibration_start <= 0 || profile.calibration_end <= profile.calibration_start ||
         profile.epochs == 0 || profile.latent_epochs == 0 || profile.latent_start <= 0 ||
         profile.latent_end <= profile.latent_start || !DPCCResolverLowerSha256(profile.market_preset_sha256) ||
         profile.market_preset_path == "" || profile.calibration_preset_path == "" ||
         !DPCCResolverLowerSha256(profile.assigned_profile_sha256) ||
         !DPCCResolverLowerSha256(profile.market_profile_sha256) ||
         !DPCCResolverLowerSha256(profile.calibration_preset_sha256) ||
         !DPCCStudyForecastAppliedPriceValid((long)profile.rsi_price) ||
         !DPCCStudyForecastAppliedPriceValid((long)profile.cci_price) ||
         !DPCCStudyForecastAppliedPriceValid((long)profile.macd_price) ||
         !MathIsValidNumber(profile.tau) || profile.tau <= 0 || profile.tau > 1 ||
         !MathIsValidNumber(profile.lambda_dis) || profile.lambda_dis < 0 ||
         !MathIsValidNumber(profile.lambda_kl) || profile.lambda_kl < 0 ||
         !MathIsValidNumber(profile.lambda_alpha) || profile.lambda_alpha < 0 ||
         !MathIsValidNumber(profile.alpha_prior) || !MathIsValidNumber(profile.max_kl) || profile.max_kl < 0)
         return(Fail("study_forecast.ompb.required_profile", reason));
      const long reference_span = (long)profile.reference_end - (long)profile.reference_start;
      const long calibration_span = (long)profile.calibration_end - (long)profile.calibration_start;
      SDPCCM05OMPBProfile staged = profile;
      staged.reference_split = (datetime)((long)profile.reference_start + reference_span * 4 / 5);
      staged.calibration_split = (datetime)((long)profile.calibration_start + calibration_span * 4 / 5);
      if(staged.reference_split <= profile.reference_start || staged.reference_split >= profile.reference_end ||
         staged.calibration_split <= profile.calibration_start || staged.calibration_split >= profile.calibration_end)
         return(Fail("study_forecast.ompb.profile_partition", reason));
      const string profile_wire = StringFormat(
                                     "ACSRM_02CALIBRATION_ADAPTER_V2\n%I64d\n%I64d\n%I64d\n%I64d\n%u\n%u\n"
                                     "%.9g\n%.9g\n%.9g\n%.9g\n%.9g\n%.9g\n%u\n%u\n%u\n",
                                     (long)profile.reference_start, (long)profile.reference_end,
                                     (long)profile.calibration_start, (long)profile.calibration_end,
                                     profile.epochs, profile.source_anchor_period, (double)profile.tau,
                                     (double)profile.lambda_dis, (double)profile.lambda_kl, (
                                        double)profile.lambda_alpha,
                                     (double)profile.alpha_prior, (double)profile.max_kl,
                                     (uint)profile.rsi_price, (uint)profile.cci_price, (uint)profile.macd_price);
      uchar profile_bytes[];
      const int profile_count = StringToCharArray(profile_wire, profile_bytes, 0, WHOLE_ARRAY, CP_UTF8);
      if(profile_count <= 1 || ArrayResize(profile_bytes, profile_count - 1) != profile_count - 1 ||
         !DPCCSHA256Lower(profile_bytes, staged.profile_sha256, reason))
         return(Fail("study_forecast.ompb.profile_hash", reason));
      staged.raw_sha256 = "";
      staged.reference_first_bar = -1;
      staged.reference_split_bar = -1;
      staged.reference_end_bar = -1;
      staged.calibration_first_bar = -1;
      staged.calibration_split_bar = -1;
      staged.calibration_end_bar = -1;
      m_ompb_profile = staged;
      m_ompb_configured = true;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Begin latent preparation on the same eight-layer price graph     |
   //+------------------------------------------------------------------+
   bool              ConfigureM05Verify(const SDPCCM05VerifyProfile &profile, string &reason)
     {
      if(m_ready || m_failed || m_verify_configured ||
         !MathIsValidNumber(profile.atol) || profile.atol <= 0 ||
         !MathIsValidNumber(profile.rtol) || profile.rtol <= 0 ||
         (profile.has_max_price_error && (!MathIsValidNumber(profile.max_price_error) || profile.max_price_error <=
            0)) ||
         (profile.has_min_scenario_coverage && (!MathIsValidNumber(profile.min_scenario_coverage) ||
               profile.min_scenario_coverage <= 0 || profile.min_scenario_coverage > 1)) ||
         (profile.has_min_distinct_scenarios && (profile.min_distinct_scenarios < 1 || profile.min_distinct_scenarios >
            21)))
         return(Fail("study_forecast.verify.profile_domain", reason));
      m_verify_profile = profile;
      m_verify_configured = true;
      reason = "";
      return(true);
     }
   bool              OMPBCalibrationCompleted(void) const { return(m_ompb_calibration_completed); }
   bool              OMPBStage02QualityPassed(void) const { return(m_ompb_stage02_quality_pass); }
   bool              OMPBStage02QualityEvaluated(void) const { return(m_ompb_evaluation_stage >= 6); }
   uint              OMPBTrainingEpochsCompleted(void) const { return(m_ompb_epoch); }
   uint              OMPBTrainingEpochLimit(void) const { return(m_ompb_profile.epochs); }
   bool              OMPBTrainingBudgetComplete(void) const { return(m_ompb_epoch >= m_ompb_profile.epochs); }
   uint              OMPBStage02EvaluationLanes(void) const
     {
      return((uint)(m_ompb_evaluation_stage > 0 ? m_ompb_evaluation_stage : 0));
     }
   bool              OMPBStage02Evaluation(const int lane, double &loss, double &valid, double &invalid) const
     {
      if(lane < 0 || lane >= 6)
         return(false);
      loss = m_ompb_evaluation_loss[lane];
      valid = m_ompb_evaluation_valid[lane];
      invalid = m_ompb_evaluation_invalid[lane];
      return(lane < m_ompb_evaluation_stage);
     }
   //+------------------------------------------------------------------+
   //| Copy already-computed OMPB counters for the StudyForecast chart  |
   //+------------------------------------------------------------------+
   bool              M05ChartStatus(SDPCCM05ChartMetrics &status)
     {
      ZeroMemory(status);
      if(!m_m05 || !m_ready || m_failed || !m_ompb_configured ||
         m_price_study_phase != defForecastPriceOMPBCalibrate)
         return(false);
      SDPCCM05CompletedBoundary boundary;
      string reason = "";
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      if(!ompb || !M05CompletedBoundary(boundary, reason))
         return(false);
      status.subphase = boundary.subphase;
      status.epoch = m_ompb_epoch;
      status.epoch_limit = m_ompb_profile.epochs;
      status.disagreement = ompb.LastDisagreement();
      status.kl = ompb.LastKL();
      status.alpha_prior = ompb.LastAlphaPrior();
      status.invalid_fallbacks = ompb.InvalidFallbacks();
      status.kl_rejects = ompb.KLRejects();
      status.diagnostics_ready = (m_ompb_target_updates > 0 || m_ompb_source_updates > 0);
      status.evaluation_stage = m_ompb_evaluation_stage;
      return(true);
     }
   string            PriceVerifyStatus(void) const { return(m_verify_status); }
   uint              PriceVerifySnapshots(void) const { return(m_verify_snapshots); }
   double            PriceVerifyMaxError(void) const { return(m_verify_max_price_error); }
   double            PriceVerifyCoverage(void) const { return(m_verify_coverage); }
   uint              PriceVerifyMinDistinct(void) const { return(m_verify_min_distinct); }
   //+------------------------------------------------------------------+
   //| Copy the actual phase and OMPB subphase without claiming D02     |
   //+------------------------------------------------------------------+
   bool              M05CompletedBoundary(SDPCCM05CompletedBoundary &state, string &reason) const
     {
      ZeroMemory(state);
      reason = "";
      if(!m_m05 || !m_ready || m_failed || !m_ompb_configured ||
         !DPCCResolverLowerSha256(m_ompb_profile.assigned_profile_sha256) ||
         !DPCCResolverLowerSha256(m_ompb_profile.market_profile_sha256) ||
         !DPCCResolverLowerSha256(m_ompb_profile.calibration_preset_sha256))
        {
         reason = "study_forecast.M05.completed_boundary_unavailable";
         return(false);
        }
      state.stage = PriceStudyStage();
      state.subphase = state.stage;
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
         state.subphase = (!m_ompb_reference_complete ? "REFERENCE" :
                           (m_ompb_source_pending ? "SOURCE_ANCHOR" : "CALIBRATION"));
      if(m_price_study_phase == defForecastPriceOMPBCalibrate && m_ompb_reference_complete &&
         (m_ompb_evaluation_stage < 4 || m_ompb_calibration_completed))
         state.subphase = "EVALUATION_" + IntegerToString(m_ompb_evaluation_stage);
      state.profile_sha256 = m_ompb_profile.assigned_profile_sha256;
      state.market_profile_sha256 = m_ompb_profile.market_profile_sha256;
      state.source_preset_sha256 = m_ompb_profile.calibration_preset_sha256;
      state.raw_sha256 = m_raw_sha;
      state.noise_seed = m_ompb_profile.noise_seed;
      state.rng_state[0] = rnd_x;
      state.rng_state[1] = rnd_y;
      state.rng_state[2] = rnd_z;
      state.rng_state[3] = rnd_w;
      state.rng_state[4] = rnd_t;
      state.completed_updates = m_updates;
      state.price_joint_updates = m_price_joint_updates;
      state.price_adapt_updates = m_price_adapt_updates;
      state.ompb_target_updates = m_ompb_target_updates;
      state.ompb_source_updates = m_ompb_source_updates;
      state.latent_epochs_completed = m_latent_epochs_completed;
      state.price_joint_epochs_completed = m_price_joint_epochs_completed;
      state.price_adapt_epochs_completed = m_price_adapt_epochs_completed;
      state.ompb_epoch = m_ompb_epoch;
      state.ompb_epoch_source_updates = m_ompb_epoch_source_updates;
      state.next_record = PriceStudyPosition();
      state.ompb_reference_cursor = m_ompb_reference_cursor;
      state.epoch_started = m_epoch_started;
      state.ompb_reference_complete = m_ompb_reference_complete;
      state.ompb_epoch_started = m_ompb_epoch_started;
      state.ompb_source_pending = m_ompb_source_pending;
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Admit a complete Market for the downstream research stages       |
   //+------------------------------------------------------------------+
   bool              M05TrainingCompleted(void) const
     {
      return(m_m05 && m_ready && !m_failed && m_finished &&
             m_price_study_phase == defForecastPriceAdapt && m_price_adapt_epoch_limit > 0 &&
             m_price_adapt_epochs_completed == m_price_adapt_epoch_limit && m_price_adapt_updates > 0);
     }
   bool              MarketConsumerReady(string &reason) const
     {
      reason = "";
      if(!M05TrainingCompleted())
         reason = "M05_TRAINING_NOT_COMPLETED;";
      //--- Native CNet retains parameters and Adam state; recurrent history is rebuilt by warmup.
      if(!m_ompb_calibration_completed)
         reason += "D01_OMPB_CALIBRATION_NOT_COMPLETED;";
      if(!m_m05_manifest_bound)
         reason += "D01_MANIFEST_NOT_BOUND;";
      //--- Technical acceptance stays NOT_RUN; it does not block internal research stages.
      return(reason == "");
     }
   bool              MarketConsumerReady(void) const
     {
      string reason = "";
      return(MarketConsumerReady(reason));
     }
   //+------------------------------------------------------------------+
   //| Write one completed M05 boundary to the Common current/bak pair  |
   //+------------------------------------------------------------------+
   bool              SaveM05Boundary(const SDPCCExecutionControl &control, const string cause,
                        string &path, string &reason)
     {
      path = "";
      reason = "";
      m_m05_manifest_bound = false;
      SDPCCM05CompletedBoundary boundary;
      if(!M05CompletedBoundary(boundary, reason) || control.stage != DPCC_STAGE_STUDYFORECAST ||
         control.profile_sha256 != boundary.profile_sha256 ||
         control.market_profile_sha256 != boundary.market_profile_sha256 || control.task_id == "" ||
         !MissingTeacherAllowed() || HasTeacherNetwork() ||
         (cause != "PHASE_COMPLETED" && cause != "CONTROLLED_STOP" && cause != "VERIFY_COMPLETED" &&
          cause != "EPOCH_COMPLETED" && cause != "USER_ACCEPTED_LATENT_PREPARE" &&
          cause != "USER_ACCEPTED_PARTIAL_OMPB" && cause != "USER_SELECTED_PHASE"))
        {
         if(reason == "")
            reason = "M05_SAVE.completed_boundary_or_profile";
         return(false);
        }
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      if(!price || !decoder || !ompb || decoder.GenerationPhase() != 0 || price.PriceSupervisionPrepared())
        {
         reason = "M05_SAVE.incomplete_frame";
         return(false);
        }
      //--- Resolve persistence from the same assigned profile used by the producer.
      string profile_text = control.profile_text, observed_sha = "";
      if(profile_text == "" || !DPCCCheckpointTextSHA(profile_text, observed_sha, reason) ||
         observed_sha != boundary.profile_sha256)
        {
         reason = "M05_SAVE.profile_changed:" + reason;
         return(false);
        }
      CDPCCJsonDocument profile;
      if(!profile.Parse(profile_text, reason))
         return(false);
      string market_profile_sha = "";
      if(!DPCCExecutionMarketProfileSHA(profile, profile.Root(), market_profile_sha, reason) ||
         market_profile_sha != boundary.market_profile_sha256)
        {
         reason = "M05_SAVE.market_profile_changed:" + reason;
         return(false);
        }
      const int persistence = profile.FindMember(profile.Root(), "persistence");
      string directory = "", canonical = "";
      long maximum_signed = 0;
      if(!DPCCResourceReadString(profile, persistence, "task_directory", directory, reason,
                                 "profile.persistence.task_directory") ||
         !DPCCResourceReadLong(profile, persistence, "max_file_bytes", maximum_signed, reason,
                               "profile.persistence.max_file_bytes") || maximum_signed <= 0 ||
         !DPCCCheckpointCanonicalPath(directory, canonical, reason) || directory != canonical)
        {
         if(reason == "")
            reason = "M05_SAVE.persistence_required";
         return(false);
        }
      const ulong maximum = (ulong)maximum_signed;
      const string current = directory + "/Market.current.dpc";
      const string backup = directory + "/Market.bak.dpc";
      const string lock_path = directory + "/Market.writer.lock";
      //--- Bind the actual graphs, native ABI and immutable producer inputs.
      string graph = "", source_abi = "";
      if(!DPCCAPM05Graph(m_market, 8, graph, reason) ||
         !DPCCCheckpointTextSHA(DPCC_AP_CONTRACT + "\n" + DPCC_M05_MARKET_REVISION + "\n" +
                                "NATIVE_CNET_LAYERS;OMPB_HISTORY_TAIL;SECTION102_OWNER_REFERENCE_V1\n" +
                                "AUXILIARY_TARGET=" + DPCC_M05_TARGET_POLICY + "\n" +
                                "PRICE_TARGET_POLICY=" + DPCC_M05_PRICE_TARGET_POLICY + "\n" + graph, source_abi,
                                   reason))
         return(false);
      const string archive_sha = "2ed3f91b038394980f73d566a4c0c8c2fb53f651898d2d101b914811d28de3c8";
      const string state_owner = "section100.layer5";
      const string ompb_state = "{\"state_owner\":\"" + state_owner + "\"}";
      const bool consumer_ready = (M05TrainingCompleted() && m_ompb_calibration_completed);
      //--- Translate the actual phase cursor to its terminal/server bar boundary.
      int decision = -1, replay_decision = -1;
      if(m_price_study_phase == defForecastPriceOMPBCalibrate)
        {
         if(!m_ompb_reference_complete)
           {
            if(ArraySize(m_ompb_reference) > 0)
               replay_decision = m_ompb_reference[0];
            if(m_ompb_reference_cursor >= 0 && m_ompb_reference_cursor < ArraySize(m_ompb_reference))
               decision = m_ompb_reference[m_ompb_reference_cursor];
           }
         else
            if(m_ompb_evaluation_stage < 4 || m_ompb_calibration_completed)
              {
               const bool source = (m_ompb_evaluation_stage % 2 == 0);
               const int count = (source ? ArraySize(m_ompb_source_evaluation) : ArraySize(m_ompb_target_evaluation));
               if(count > 0)
                  replay_decision = (source ? m_ompb_source_evaluation[0] : m_ompb_target_evaluation[0]);
               if(m_ompb_evaluation_cursor >= 0 && m_ompb_evaluation_cursor < count)
                  decision = (source ? m_ompb_source_evaluation[m_ompb_evaluation_cursor] :
                              m_ompb_target_evaluation[m_ompb_evaluation_cursor]);
              }
            else
              {
               if(ArraySize(m_ompb_calibration) > 0)
                  replay_decision = m_ompb_calibration[0];
               if(m_cursor >= 0 && m_cursor < ArraySize(m_ompb_calibration))
                  decision = m_ompb_calibration[m_cursor];
              }
        }
      else
        {
         const int count = (m_price_study_phase == defForecastPriceVerify ? ArraySize(m_holdout) :
                            (m_price_study_phase == defForecastPriceLatentPrepare ? ArraySize(m_latent_fit) : ArraySize(
                               m_fit)));
         if(count > 0)
            replay_decision = (m_price_study_phase == defForecastPriceVerify ? m_holdout[0] :
                               (m_price_study_phase == defForecastPriceLatentPrepare ? m_latent_fit[0] : m_fit[0]));
         if(m_cursor >= 0 && m_cursor < count)
            decision = (m_price_study_phase == defForecastPriceVerify ? m_holdout[m_cursor] :
                        (m_price_study_phase == defForecastPriceLatentPrepare ? m_latent_fit[m_cursor] :
                           m_fit[m_cursor]));
        }
      const long replay_bar = (replay_decision >= 0 && replay_decision < ArraySize(m_bars) ?
                               m_bars[replay_decision].server_open : 0);
      const long next_bar = (decision >= 0 && decision < ArraySize(m_bars) ? m_bars[decision].server_open : 0);
      const uint epoch = (m_price_study_phase == defForecastPriceLatentPrepare ? m_latent_epochs_completed :
                          (m_price_study_phase == defForecastPriceJoint ? m_price_joint_epochs_completed :
                           (m_price_study_phase == defForecastPriceOMPBCalibrate ? m_ompb_epoch :
                              m_price_adapt_epochs_completed)));
      string rng = "[";
      for(int i = 0; i < 5; i++)
         rng += (i == 0 ? "" : ",") + (string)boundary.rng_state[i];
      rng += "]";
      string evaluation = "[";
      for(int i = 0; i < 6; i++)
         evaluation += (i == 0 ? "" : ",") + "{\"loss\":" + StringFormat("%.17g", m_ompb_evaluation_loss[i]) +
                       ",\"valid\":" + DoubleToString(m_ompb_evaluation_valid[i], 0) +
                       ",\"invalid\":" + DoubleToString(m_ompb_evaluation_invalid[i], 0) + "}";
      evaluation += "]";
      string verify_errors = "[";
      for(int i = 0; i < 48; i++)
         verify_errors += (i == 0 ? "" : ",") + StringFormat("%.17g", m_verify_error_sum[i]);
      verify_errors += "]";
      const string resume = "{\"stage\":" + DPCCAPJSONString(boundary.stage) +
                            ",\"subphase\":" + DPCCAPJSONString(boundary.subphase) + ",\"epoch\":" + (string)epoch +
                            ",\"next_record\":" + (string)boundary.next_record +
                            ",\"cursor\":" + (string)m_cursor + ",\"fit_limit\":" + (string)m_fit_limit +
                            ",\"holdout_cursor\":" + (string)m_holdout_cursor +
                            ",\"record_order\":\"CHRONOLOGICAL_TERMINAL_BARS\",\"completed_transitions\":0,\"policy_updates\":0" +
                            ",\"target_updates\":0,\"target_order_flag\":false,\"rng_state\":" + rng +
                            ",\"noise_seed\":" + (string)boundary.noise_seed +
                            ",\"profile_sha256\":" + DPCCAPJSONString(boundary.profile_sha256) +
                            ",\"market_profile_sha256\":" + DPCCAPJSONString(boundary.market_profile_sha256) +
                            ",\"source_preset_sha256\":" + DPCCAPJSONString(boundary.source_preset_sha256) +
                            ",\"raw_sha256\":" + DPCCAPJSONString(boundary.raw_sha256) +
                            ",\"journal_path\":null,\"journal_sha256\":null,\"time_basis\":\"TERMINAL_SERVER\"" +
                            ",\"replay_from_bar\":" + (string)replay_bar + ",\"next_bar\":" + (string)next_bar +
                            ",\"pending\":null,\"runtime_restore\":\"WARMUP_FROM_LATEST_WEIGHTS\"" +
                            ",\"cause\":" + DPCCAPJSONString(cause) + ",\"finished\":" + (m_finished ? "true" :
                               "false") +
                            ",\"terminal_status\":" + DPCCAPJSONString(m_price_phase_terminal_status) +
                            ",\"completed_updates\":" + (string)m_updates +
                            ",\"price_joint_updates\":" + (string)m_price_joint_updates +
                            ",\"price_adapt_updates\":" + (string)m_price_adapt_updates +
                            ",\"ompb_target_updates\":" + (string)m_ompb_target_updates +
                            ",\"ompb_source_updates\":" + (string)m_ompb_source_updates +
                            ",\"latent_epochs_completed\":" + (string)m_latent_epochs_completed +
                            ",\"price_joint_epochs_completed\":" + (string)m_price_joint_epochs_completed +
                            ",\"price_adapt_epochs_completed\":" + (string)m_price_adapt_epochs_completed +
                            ",\"epoch_started\":" + (m_epoch_started ? "true" : "false") +
                            ",\"ompb_epoch_started\":" + (m_ompb_epoch_started ? "true" : "false") +
                            ",\"ompb_epoch\":" + (string)m_ompb_epoch +
                            ",\"ompb_epoch_source_updates\":" + (string)m_ompb_epoch_source_updates +
                            ",\"ompb_reference_cursor\":" + (string)m_ompb_reference_cursor +
                            ",\"ompb_reference_capacity\":" + (string)m_ompb_reference_capacity +
                            ",\"ompb_current_capacity\":" + (string)m_ompb_current_capacity +
                            ",\"ompb_reference_count\":" + (string)ompb.ReferenceCount() +
                            ",\"ompb_current_count\":" + (string)ompb.CurrentCount() +
                            ",\"ompb_reference_complete\":" + (m_ompb_reference_complete ? "true" : "false") +
                            ",\"ompb_source_pending\":" + (m_ompb_source_pending ? "true" : "false") +
                            ",\"ompb_evaluation_stage\":" + (string)m_ompb_evaluation_stage +
                            ",\"ompb_evaluation_cursor\":" + (string)m_ompb_evaluation_cursor +
                            ",\"ompb_evaluation\":" + evaluation +
                            ",\"calibration_completed\":" + (m_ompb_calibration_completed ? "true" : "false") +
                            ",\"stage02_quality_pass\":" + (m_ompb_stage02_quality_pass ? "true" : "false") +
                            ",\"price_joint_loss_sum\":" + StringFormat("%.17g", m_price_loss_sum) +
                            ",\"price_adapt_loss_sum\":" + StringFormat("%.17g", m_price_adapt_loss_sum) +
                            ",\"teacher_initial_fingerprint\":" + (string)m_teacher_initial_fingerprint +
                            ",\"price_joint_ompb_fingerprint\":" + (string)m_price_joint_ompb_fingerprint +
                            ",\"latent_decoder_fingerprint\":" + (string)m_price_latent_decoder_fingerprint +
                            ",\"ompb_frozen_fingerprint\":" + (string)m_ompb_frozen_fingerprint +
                            ",\"ompb_initial_fingerprint\":" + (string)m_ompb_initial_fingerprint +
                            ",\"ompb_evaluation_posterior\":" + (string)m_ompb_evaluation_posterior +
                            ",\"price_adapt_frozen_fingerprint\":" + (string)m_price_adapt_frozen_fingerprint +
                            ",\"verify_market_fingerprint\":" + (string)m_verify_market_fingerprint +
                            ",\"verify_target_fingerprint\":" + (string)m_verify_target_fingerprint +
                            ",\"ompb_decoder_step_baseline\":" + (string)m_ompb_decoder_updates +
                            ",\"price_adapt_decoder_step_baseline\":" + (string)m_price_adapt_decoder_updates +
                            ",\"ompb_forecast_step_baselines\":[" + (string)m_ompb_forecast_steps[0] + "," +
                            (string)m_ompb_forecast_steps[1] + "," + (string)m_ompb_forecast_steps[2] + "]" +
                            ",\"verify_started\":" + (m_verify_started ? "true" : "false") +
                            ",\"verify_status\":" + DPCCAPJSONString(m_verify_status) +
                            ",\"verify_snapshots\":" + (string)m_verify_snapshots +
                            ",\"verify_covered\":" + (string)m_verify_covered +
                            ",\"verify_min_distinct\":" + (string)m_verify_min_distinct +
                            ",\"verify_max_price_error\":" + StringFormat("%.17g", m_verify_max_price_error) +
                            ",\"verify_coverage\":" + StringFormat("%.17g", m_verify_coverage) +
                            ",\"verify_error_sum\":" + verify_errors + "}";
      const string manifest = "{\"contract_id\":\"" + DPCC_AP_CONTRACT +
                              "\",\"revision\":\"" + DPCC_M05_MARKET_REVISION + "\",\"role\":\"Market\",\"task_id\":" +
                              DPCCAPJSONString(control.task_id) + ",\"stage\":" + DPCCAPJSONString(boundary.stage) +
                              ",\"graph\":" + graph + ",\"auxiliary_target_policy\":\"" + DPCC_M05_TARGET_POLICY +
                                 "\"" +
                              ",\"source_archive_sha256\":\"" + archive_sha + "\",\"source_abi_sha256\":\"" +
                                 source_abi +
                              "\",\"market_dependency_sha256\":null,\"data_sha256\":\"" + boundary.raw_sha256 +
                              "\",\"time_basis\":\"TERMINAL_SERVER\",\"profile\":{\"task_id\":" +
                              DPCCAPJSONString(control.task_id) + ",\"sha256\":\"" + boundary.profile_sha256 +
                              "\",\"market_sha256\":\"" + boundary.market_profile_sha256 +
                              "\",\"contents\":" + DPCCAPJSONString(profile_text) +
                                 "},\"source_presets\":{\"market_sha256\":\"" +
                              m_ompb_profile.market_preset_sha256 + "\",\"calibration_sha256\":\"" +
                              boundary.source_preset_sha256 + "\"},\"ompb_state_owner\":\"" + state_owner +
                              "\",\"runtime_restore\":\"WARMUP_FROM_LATEST_WEIGHTS\",\"ready\":" +
                              (consumer_ready ? "true" : "false") +
                              ",\"calibration_completed\":" + (m_ompb_calibration_completed ? "true" : "false") +
                              ",\"stage02_quality_pass\":" + (m_ompb_stage02_quality_pass ? "true" : "false") +
                              ",\"verify_status\":" + DPCCAPJSONString(m_verify_status) +
                              ",\"acceptance\":[{\"case_id\":\"A01-A15\",\"status\":\"NOT_RUN\",\"evidence_sha256\":null}]}";
      CDPCCJsonDocument metadata;
      if(!metadata.Parse(manifest, reason) || !metadata.Parse(resume, reason))
         return(false);
      //--- Reject oversized metadata before moving the previous generation.
      uchar metadata_bytes[];
      const int manifest_bytes = StringToCharArray(manifest, metadata_bytes, 0, WHOLE_ARRAY, CP_UTF8) - 1;
      const int resume_bytes = StringToCharArray(resume, metadata_bytes, 0, WHOLE_ARRAY, CP_UTF8) - 1;
      const int ompb_bytes = StringToCharArray(ompb_state, metadata_bytes, 0, WHOLE_ARRAY, CP_UTF8) - 1;
      if(manifest_bytes <= 0 || manifest_bytes > 1048576 || resume_bytes <= 0 || resume_bytes > 1048576 ||
         ompb_bytes <= 0 || ompb_bytes > 1048576 ||
         (ulong)manifest_bytes + (ulong)resume_bytes + (ulong)ompb_bytes +
         DPCC_AP_HEADER_BYTES + 4 * DPCC_AP_SECTION_BYTES + DPCC_AP_FOOTER_BYTES >= maximum)
        {
         reason = "M05_SAVE.metadata_size";
         return(false);
        }
      //--- One exclusive writer blocks all cooperative current/bak readers.
      string folders = directory + "/";
      int slash = StringFind(folders, "/");
      while(slash >= 0)
        {
         FolderCreate(StringSubstr(folders, 0, slash), FILE_COMMON);
         slash = StringFind(folders, "/", slash + 1);
        }
      const int lock = FileOpen(lock_path, FILE_READ | FILE_WRITE | FILE_BIN | FILE_COMMON);
      if(lock == INVALID_HANDLE)
        {
         reason = "M05_SAVE.writer_lock";
         return(false);
        }
      bool saved = false;
      CDPCCAPRoleWriter writer;
      do
        {
         if(FileIsExist(current, FILE_COMMON))
           {
            string current_reason = "";
            if(DPCCAPValidateMarketFile(current, maximum, current_reason))
              {
               if(!FileMove(current, FILE_COMMON, backup, FILE_COMMON | FILE_REWRITE))
                 {
                  reason = "M05_SAVE.current_to_bak";
                  break;
                 }
              }
            else
              {
               //--- An invalid current never replaces an authenticated recovery generation.
               if(!FileIsExist(backup, FILE_COMMON) || !DPCCAPValidateMarketFile(backup, maximum, reason))
                 {
                  reason = "M05_SAVE.current_invalid_without_valid_bak:" + current_reason;
                  break;
                 }
               if(!FileDelete(current, FILE_COMMON))
                 {
                  reason = "M05_SAVE.invalid_current_remove";
                  break;
                 }
              }
           }
         if(!writer.Open(current, true, 1, source_abi, 4, maximum, reason) ||
            !DPCCAPWriteJSON(writer, 1, manifest, reason) ||
            !writer.WriteMarketNativeSection(100, m_market, reason) ||
            !DPCCAPWriteJSON(writer, 102, ompb_state, reason) ||
            !DPCCAPWriteJSON(writer, 200, resume, reason) || !writer.Finish(reason))
            break;
         saved = true;
         path = current;
         m_m05_manifest_bound = true;
        }
      while(false);
      writer.Close();
      FileClose(lock);
      return(saved);
     }

   bool              InitializeM05(const string raw_path, const string raw_sha,
                      const float lambda_price, const float huber_delta, const float rho_tolerance,
                      string &reason, const bool common_files = false,
                      const ENUM_TIMEFRAMES timeframe = PERIOD_H1)
     {
      if(!m_ompb_configured || !DPCCArchitectureSHA256Encoding(raw_sha))
         return(Fail("study_forecast.M05.ompb_profile_required", reason));
      if(m_ompb_profile.price_joint_epochs == 0 || m_ompb_profile.price_joint_early_stop_patience != 0 ||
         m_ompb_profile.price_adapt_epochs == 0 || m_ompb_profile.price_adapt_early_stop_patience != 0)
         return(Fail("study_forecast.M05.profile_phase_budget", reason));
      m_price_joint_epoch_limit = m_ompb_profile.price_joint_epochs;
      m_price_joint_epochs_completed = 0;
      m_price_phase_terminal_status = "";
      //--- M05 phase budgets are profile-owned; zero here preserves the full eligible data index.
      if(!InitializePriceJoint(raw_path, raw_sha, 0, true, lambda_price, huber_delta, rho_tolerance,
                               reason, common_files, timeframe))
         return(false);
      if(!DPCCResolveM05PricePhaseBudget(ArraySize(m_fit), m_price_joint_epoch_limit,
                                         m_ompb_profile.price_joint_max_updates, m_price_joint_update_limit, reason))
         return(Fail("study_forecast.M05.price_joint_budget:" + reason, reason));
      m_price_adapt_epoch_limit = m_ompb_profile.price_adapt_epochs;
      if(!DPCCResolveM05PricePhaseBudget(ArraySize(m_fit), m_price_adapt_epoch_limit,
                                         m_ompb_profile.price_adapt_max_updates, m_price_adapt_update_limit, reason))
         return(Fail("study_forecast.M05.price_adapt_budget:" + reason, reason));
      if(HasTeacherNetwork())
         return(Fail("study_forecast.M05.unified_market_has_teacher", reason));
      if(m_raw_sha != raw_sha || !ResolveM05OMPBIdentity(reason))
         return(Fail("study_forecast.M05.ompb_source_binding:" + reason, reason));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!decoder || !decoder.AppendParameterFingerprint(m_price_latent_decoder_fingerprint))
         return(Fail("study_forecast.M05.latent_decoder_boundary", reason));
      //--- Keep donor bounds for identity, but train every Market phase on the price-eligible 2025 fit rows.
      const int latent_first = ResolveM05TimeBoundary(m_ompb_profile.latent_start);
      if(latent_first < 5 || latent_first >= ArraySize(m_bars) ||
         m_raw_successor < (long)m_ompb_profile.latent_end)
         return(Fail("study_forecast.M05.latent_window_context_or_end_unavailable", reason));
      const int latent_count = ArraySize(m_fit);
      if(latent_count <= 0 || ArrayResize(m_latent_fit, latent_count) != latent_count ||
         ArrayCopy(m_latent_fit, m_fit, 0, 0, latent_count) != latent_count)
         return(Fail("study_forecast.M05.latent_fit_copy", reason));
      m_latent_epochs_completed = 0;
      m_fit_limit = ArraySize(m_latent_fit);
      m_price_study_phase = defForecastPriceLatentPrepare;
      m_m05 = true;
      if(!ResolveOMPBFitRows(reason))
         return(false);
      return(true);
     }
   //+------------------------------------------------------------------+
   //| Restart one phase on the current native weights and Adam state   |
   //+------------------------------------------------------------------+
   bool              RestartM05Phase(const string selected_phase, string &reason, const bool rebind_history = false)
     {
      reason = "";
      if(!m_m05 || !m_ready || m_failed || !m_price_joint || m_price_forward_only || m_restore_only ||
         !m_ompb_configured || ArraySize(m_fit) == 0 ||
         (selected_phase != "LATENT_PREPARE" && selected_phase != "PRICE_JOINT" &&
          selected_phase != "OMPB_CALIBRATE" && selected_phase != "PRICE_ADAPT"))
         return(Fail("M05_SELECT.initialized_phase_required", reason));
      //--- Clear execution tapes and chronological state without resetting native optimizers.
      CNeuronOMPBOCL *ompb = dynamic_cast<CNeuronOMPBOCL*>(m_market.Layer(5));
      CNeuronScenarioForecastPriceOCL *price = dynamic_cast<CNeuronScenarioForecastPriceOCL*>(m_market.Layer(6));
      CNeuronScenarioDecoderOCL *decoder = dynamic_cast<CNeuronScenarioDecoderOCL*>(m_market.Layer(7));
      if(!ompb || !price || !decoder || !m_market.TrainMode(false) || !m_market.SetWeightsUpdate(false) ||
         !SetTeacherFrozenPolicy() || !price.CancelTrainingFrame() || !m_market.Clear() ||
         !ClearTeacherState() || !price.SetCodebookUpdate(false) || !price.SetGradientNormalization(true) ||
         !price.ResetEpochDiagnostics() || !ompb.SetSourceAnchor(false) || !ompb.SetMode(OMPB_BYPASS))
         return(Fail("M05_SELECT.runtime_reset", reason));
      if(rebind_history && !ompb.ResetReference())
         return(Fail("M05_SELECT.source_history_reset", reason));
      if(!ompb.SetTau(m_ompb_profile.tau) || !ompb.SetDisagreementMult(m_ompb_profile.lambda_dis) ||
         !ompb.SetKLDMult(m_ompb_profile.lambda_kl) || !ompb.SetAlphaMult(m_ompb_profile.lambda_alpha) ||
         !ompb.SetAlphaPrior(m_ompb_profile.alpha_prior) || !ompb.SetMaxKL(m_ompb_profile.max_kl))
         return(Fail("M05_SELECT.current_ompb_profile", reason));
      //--- Only the cumulative update count survives as provenance; phase progress starts at row zero.
      m_cursor = 0;
      m_holdout_cursor = 0;
      m_fit_limit = ArraySize(m_fit);
      m_full_run = true;
      m_finished = false;
      m_epoch_started = false;
      m_holdout_started = false;
      m_price_phase_terminal_status = "";
      m_m05_manifest_bound = false;
      m_latent_epochs_completed = 0;
      m_price_joint_epochs_completed = 0;
      m_price_joint_updates = 0;
      m_price_loss_sum = 0;
      m_price_adapt_epochs_completed = 0;
      m_price_adapt_updates = 0;
      m_price_adapt_loss_sum = 0;
      m_ompb_epoch = 0;
      m_ompb_epoch_source_updates = 0;
      m_ompb_target_updates = 0;
      m_ompb_source_updates = 0;
      m_ompb_reference_cursor = 0;
      m_ompb_reference_complete = (ompb.ReferenceCount() == m_ompb_reference_capacity);
      m_ompb_epoch_started = false;
      m_ompb_source_pending = false;
      m_ompb_calibration_completed = false;
      m_ompb_stage02_quality_pass = false;
      m_ompb_evaluation_stage = 0;
      m_ompb_evaluation_cursor = 0;
      m_ompb_evaluation_posterior = 0;
      ArrayInitialize(m_ompb_evaluation_loss, 0);
      ArrayInitialize(m_ompb_evaluation_valid, 0);
      ArrayInitialize(m_ompb_evaluation_invalid, 0);
      m_verify_started = false;
      m_verify_status = "NOT_RUN";
      m_verify_snapshots = 0;
      m_verify_covered = 0;
      m_verify_min_distinct = 0;
      m_verify_max_price_error = 0;
      m_verify_coverage = 0;
      m_verify_market_fingerprint = 0;
      m_verify_target_fingerprint = 0;
      ArrayInitialize(m_verify_error_sum, 0);
      m_price_joint_ompb_fingerprint = 0;
      m_price_latent_decoder_fingerprint = 0;
      m_ompb_initial_fingerprint = 0;
      if(!TeacherFingerprint(m_teacher_initial_fingerprint) ||
         !ompb.AppendParameterFingerprint(m_price_joint_ompb_fingerprint) ||
         !decoder.AppendParameterFingerprint(m_price_latent_decoder_fingerprint))
         return(Fail("M05_SELECT.parameter_baselines", reason));
      //--- Set the selected phase directly; prior completion and quality remain advisory.
      if(selected_phase == "OMPB_CALIBRATE")
         return(BeginOMPBCalibrate(reason));
      if(selected_phase == "PRICE_ADAPT")
         return(BeginPriceAdapt(reason, true));
      m_price_study_phase = (selected_phase == "LATENT_PREPARE" ? defForecastPriceLatentPrepare :
                             defForecastPriceJoint);
      if(m_price_study_phase == defForecastPriceLatentPrepare)
         m_fit_limit = ArraySize(m_latent_fit);
      if(m_fit_limit <= 0 || !price.SetPricePhase(m_price_study_phase) ||
         !decoder.SetPricePhase(m_price_study_phase))
         return(Fail("M05_SELECT.price_phase", reason));
      return(true);
     }
   //+------------------------------------------------------------------+
   //| AUTO resumes progress; an explicit phase loads the model only    |
   //+------------------------------------------------------------------+
   bool              RestoreM05Boundary(const SDPCCExecutionControl &control, bool &restored, string &reason,
                           const string selected_phase = "AUTO")
     {
      restored = false;
      reason = "";
      const bool model_only = (selected_phase != "AUTO");
      if(model_only && selected_phase != "LATENT_PREPARE" && selected_phase != "PRICE_JOINT" &&
         selected_phase != "OMPB_CALIBRATE" && selected_phase != "PRICE_ADAPT")
         return(Fail("M05_SELECT.phase", reason));
      if(!m_m05 || !m_ready || control.stage != DPCC_STAGE_STUDYFORECAST ||
         control.task_id == "" || control.profile_sha256 != m_ompb_profile.assigned_profile_sha256 ||
         control.market_profile_sha256 != m_ompb_profile.market_profile_sha256 ||
