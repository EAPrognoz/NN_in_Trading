   if(!cLastNonSequence.Clear())
      ReturnFalse;
   if(!cStackSequence.Clear())
      ReturnFalse;
   if(!cQuerys.Clear())
      ReturnFalse;
   if(!cFlow.ClearStates())
      ReturnFalse;
//---
   return true;
  }
