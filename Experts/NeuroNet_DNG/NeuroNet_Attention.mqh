  {
   if(!cScenariosGenerator.FeedForward(NeuronOCL))
      ReturnFalse;
   if(!CNeuronFieldPatternEmbedding::feedForward(cScenariosGenerator.AsObject()))
      ReturnFalse;
//---
   return(true);
  }
