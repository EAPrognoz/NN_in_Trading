      ReturnFalse;
   if(!cPropertyProjection.Save(file_handle))
      ReturnFalse;
   if(!cConcatenate.Save(file_handle))
      ReturnFalse;
   if(!cPooling.Save(file_handle))
      ReturnFalse;
//---
   return true;
  }
