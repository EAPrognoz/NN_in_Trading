                                         dimension, stack_size * units, embed_size,
                                         candidates, topK, optimization_type, batch))
      ReturnFalse;
   if(!cStack.Init(0, 0, OpenCL, stack_size, dimension, units, optimization, iBatch))
      ReturnFalse;
//---
   return true;
  }
