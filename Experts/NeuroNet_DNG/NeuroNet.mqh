//|                                                                  |
//+------------------------------------------------------------------+
bool CNeuronSpikeResNeXtBottleneck::Load(const int file_handle)
  {
   if(!CNeuronSpikeActivation::Load(file_handle))
      ReturnFalse;
   if(!cBottleneck.Load(file_handle))
      ReturnFalse;
//---
   return true;
  }
