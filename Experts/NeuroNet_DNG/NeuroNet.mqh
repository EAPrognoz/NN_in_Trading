                                 ENUM_OPTIMIZATION optimization_type, uint batch)
  {
   if(!CNeuronFieldPatternEmbedding::Init(numOutputs, myIndex, open_cl, (window_in + 1) / 2, scenarios, window_out, candidates, topK, optimization_type, batch))
