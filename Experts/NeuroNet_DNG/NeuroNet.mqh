//|                                                                  |
//+------------------------------------------------------------------+
bool CNeuronTMA::Load(const int file_handle)
  {
   if(!CNeuronRAFT::Load(file_handle))
      ReturnFalse;
   if(!LoadInsideLayer(file_handle, cStatesStack.AsObject()))
      ReturnFalse;
//---
   return true;
  }
