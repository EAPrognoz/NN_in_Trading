//|                                                                  |
//+------------------------------------------------------------------+
bool CNeuronDifferenceTokenizer::Load(const int file_handle)
  {
   if(!CNeuronBaseOCL::Load(file_handle))
      ReturnFalse;
   if(!cFlow.Load(file_handle))
      ReturnFalse;
//---
   return true;
  }
