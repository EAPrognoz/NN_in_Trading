//|                                                                  |
//+------------------------------------------------------------------+
bool CNeuronUniMixerBlock::Clear(void)
  {
   if(!CNeuronPerTokenSwiGLU::Clear())
      ReturnFalse;
//---
   if(!cPrepare.Clear())
      ReturnFalse;
   if(!cLastNonSequence.Clear())
      ReturnFalse;
   if(!cScenarios.Clear())
      ReturnFalse;
   if(!cFeatures.ClearStates())
      ReturnFalse;
   if(!cFlow.ClearStates())
      ReturnFalse;
   if(!cOutputProj.ClearStates())
      ReturnFalse;
//---
   return true;
  }
