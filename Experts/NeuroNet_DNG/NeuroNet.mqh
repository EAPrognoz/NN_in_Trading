   setArgument(def_k_MatMult, def_k_mm_dimension, (int)cols1)
   setArgument(def_k_MatMult, def_k_mm_multvarsecond, (int)mult_var_second)
//---
   kernelExecute(def_k_MatMult, global_work_offset, global_work_size)
//---
   return true;
  }
