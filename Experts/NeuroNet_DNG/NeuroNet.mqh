//|                                                                  |
//+------------------------------------------------------------------+
bool CNeuronDifferenceTokenizer::WeightsUpdate(CNeuronBaseOCL *source, float tau)
  {
   if(!CNeuronBaseOCL::WeightsUpdate(source, tau))
      ReturnFalse;
   CNeuronDifferenceTokenizer* Source = source;
   dWeightsUpdate(cFlow, Source, tau);
//---
   return true;
  }
