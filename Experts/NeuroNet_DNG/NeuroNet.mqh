//|                                                                  |
//+------------------------------------------------------------------+
bool CNeuronTMA::Clear(void)
  {
   if(!CNeuronRAFT::Clear())
      ReturnFalse;
   if(!cStatesStack.Clear())
      ReturnFalse;
//---
   return true;
  }
