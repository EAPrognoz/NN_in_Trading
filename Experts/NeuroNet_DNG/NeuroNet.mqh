   cPatchsFeedForward.SetOpenCL(OpenCL);
   cPatchingAgr.SetOpenCL(OpenCL);
   cProof.SetOpenCL(OpenCL);
   cToPatchVarEmb.SetOpenCL(OpenCL);
  }
