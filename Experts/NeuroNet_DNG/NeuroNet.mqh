//|                                                                  |
//+------------------------------------------------------------------+
bool CNeuronSpikeResNeXtBottleneck::Save(const int file_handle)
  {
   if(!CNeuronSpikeActivation::Save(file_handle))
      ReturnFalse;
   if(!cBottleneck.Save(file_handle))
      ReturnFalse;
//---
   return true;
  }
