void CNeuronSpikeConvBlock::TrainMode(bool flag)
  {
   CNeuronBatchNormOCL::TrainMode(flag);
   cActivation.TrainMode(bTrain);
   cConv.TrainMode(bTrain);
   cStack.TrainMode(bTrain);
  }
